# Copy this file to fixtures.local.yaml and fill in your site-specific values.
# fixtures.local.yaml is gitignored — it will not be committed.
# When present, doctrine:fixtures:load uses these values instead of the generic defaults.

api_tokens:
  - name: "my-token"
    token: "plain-text-value-used-in-api-calls"   # stored as SHA-256 hash; printed to console on fixture load
    owner: "user@example.com"
    allowed_routes:
      - "api_dhcp_lease"
    # expires_at: "2027-01-01"   # optional

saml_providers:
  - name: "My Organization"
    is_active: true
    sp_entity_id: "https://dashddi.example.com/saml/metadata"
    sp_acs_url: "https://dashddi.example.com/saml/acs"
    sp_slo_url: "https://dashddi.example.com/saml/logout"
    idp_entity_id: "https://idp.example.com/saml2/idp/metadata.php"
    idp_sso_url: "https://idp.example.com/saml2/idp/SSOService.php"
    idp_cert: "MIID..."   # base64 X.509 cert, no PEM headers

dns_servers:
  - name: "ns1.example.com"
    hostname: "ns1.example.com"
    ssh_user: "root"
    remote_zone_path: "/etc/bind/zones"
    server_type: "primary"        # primary | secondary
  - name: "ns2.example.com"
    hostname: "ns2.example.com"
    ssh_user: "root"
    remote_zone_path: "/etc/bind/zones"
    server_type: "secondary"
    primary_hostname: "ns1.example.com"

dhcp_servers:
  - name: "kea.example.com"
    hostname: "kea.example.com"
    ssh_user: "root"
    remote_path: "/etc/kea"
    control_url: "http://kea.example.com:8000"
    control_user: "admin"
    # control_password: ""        # optional

radius_servers:
  - name: "radius.example.com"
    hostname: "radius.example.com"
    ssh_user: "root"
    remote_path: "/etc/freeradius/3.0"
    # ssh_private_key: |          # omit to generate a key via the UI
    #   -----BEGIN OPENSSH PRIVATE KEY-----
    #   ...
    #   -----END OPENSSH PRIVATE KEY-----

radius_clients:
  - name: "switch-01"
    nasname: "192.168.1.1"
    shortname: "switch-01"
    secret: "change-me"
    enabled: true

clearpass_servers:
  - name: "ClearPass"
    api_url: "https://clearpass.example.com"
    client_id: "DashDDI"
    client_secret: "enc:base64encodedencryptedvalue"   # use the UI to set the real secret; copy the enc:... value from the DB
    verify_tls: true
