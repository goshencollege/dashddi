server default {
    listen {
        type   = auth
        ipaddr = *
        port   = 1812
    }

    listen {
        type   = acct
        ipaddr = *
        port   = 1813
    }

    authorize {
        # Normalise User-Name to lowercase colon-separated MAC so that the
        # authorize file matches regardless of NAS format
        # (aa:bb:cc:dd:ee:ff, aa-bb-cc-dd-ee-ff, and aabbccddeeff all work).
        update request {
            &Tmp-String-0 := "%{tolower:%{User-Name}}"
        }
        if (&Tmp-String-0 =~ /^([0-9a-f]{2})[:-]?([0-9a-f]{2})[:-]?([0-9a-f]{2})[:-]?([0-9a-f]{2})[:-]?([0-9a-f]{2})[:-]?([0-9a-f]{2})$/) {
            update request {
                &User-Name := "%{1}:%{2}:%{3}:%{4}:%{5}:%{6}"
            }
        }
        files
        if (notfound) {
            reject
        }
    }

    authenticate {
        Auth-Type Accept {
            ok
        }
    }

    post-auth {
        Post-Auth-Type REJECT {
        }
    }

    accounting {
        ok
    }

    session {
    }

    pre-proxy {
    }

    post-proxy {
    }
}
