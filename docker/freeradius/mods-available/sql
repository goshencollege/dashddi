sql {
    driver    = "rlm_sql_mysql"
    dialect   = "mysql"

    server    = "${ENV:RADIUS_DB_HOST}"
    port      = ${ENV:RADIUS_DB_PORT}
    login     = "radius"
    password  = "${ENV:RADIUS_DB_PASSWORD}"
    radius_db = "${ENV:RADIUS_DB_NAME}"

    read_groups   = no
    read_profiles = no

    # Load RADIUS clients from the radius_client table at startup.
    # Restart the container after adding or removing clients.
    read_clients = yes
    client_query = "\
        SELECT \
            nasname, \
            shortname, \
            'other'    AS type, \
            NULL       AS ports, \
            secret, \
            NULL       AS server, \
            NULL       AS community, \
            name       AS description \
        FROM radius_client \
        WHERE enabled = 1"

    # Accept the request if the MAC address is found in network_interface.
    # MAC comparison is normalised on both sides to strip separators and
    # lowercase, so any incoming format (aa:bb:..., aabbcc..., aa-bb-...) matches.
    authorize_check_query = "\
        SELECT \
            ni.id, \
            ni.mac_address, \
            'Auth-Type' AS attribute, \
            'Accept'    AS value, \
            ':='        AS op \
        FROM network_interface ni \
        WHERE LOWER(REPLACE(REPLACE(REPLACE(ni.mac_address, ':', ''), '-', ''), '.', '')) = \
              LOWER(REPLACE(REPLACE(REPLACE('%{SQL-User-Name}', ':', ''), '-', ''), '.', '')) \
        LIMIT 1"

    # Return VLAN assignment and canonical hostname for accepted MACs.
    authorize_reply_query = "\
        SELECT ni.id, ni.mac_address, 'Tunnel-Type', '13', '=' \
        FROM network_interface ni \
        JOIN subnet s ON s.id = ni.subnet_id \
        WHERE LOWER(REPLACE(REPLACE(REPLACE(ni.mac_address, ':', ''), '-', ''), '.', '')) = \
              LOWER(REPLACE(REPLACE(REPLACE('%{SQL-User-Name}', ':', ''), '-', ''), '.', '')) \
        AND s.vlan IS NOT NULL \
        UNION ALL \
        SELECT ni.id, ni.mac_address, 'Tunnel-Medium-Type', '6', '=' \
        FROM network_interface ni \
        JOIN subnet s ON s.id = ni.subnet_id \
        WHERE LOWER(REPLACE(REPLACE(REPLACE(ni.mac_address, ':', ''), '-', ''), '.', '')) = \
              LOWER(REPLACE(REPLACE(REPLACE('%{SQL-User-Name}', ':', ''), '-', ''), '.', '')) \
        AND s.vlan IS NOT NULL \
        UNION ALL \
        SELECT ni.id, ni.mac_address, 'Tunnel-Private-Group-ID', CAST(s.vlan AS CHAR), '=' \
        FROM network_interface ni \
        JOIN subnet s ON s.id = ni.subnet_id \
        WHERE LOWER(REPLACE(REPLACE(REPLACE(ni.mac_address, ':', ''), '-', ''), '.', '')) = \
              LOWER(REPLACE(REPLACE(REPLACE('%{SQL-User-Name}', ':', ''), '-', ''), '.', '')) \
        AND s.vlan IS NOT NULL \
        UNION ALL \
        SELECT ni.id, ni.mac_address, 'Filter-Id', CONCAT(iname.name, '.', d.name), '=' \
        FROM network_interface ni \
        JOIN interface_name iname \
            ON iname.network_interface_id = ni.id AND iname.is_canonical = 1 \
        JOIN domain d ON d.id = iname.domain_id \
        WHERE LOWER(REPLACE(REPLACE(REPLACE(ni.mac_address, ':', ''), '-', ''), '.', '')) = \
              LOWER(REPLACE(REPLACE(REPLACE('%{SQL-User-Name}', ':', ''), '-', ''), '.', ''))"

    safe-characters = "@abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_: /"

    pool {
        start        = ${thread[pool].start_servers}
        min          = ${thread[pool].min_spare_servers}
        max          = ${thread[pool].max_servers}
        spare        = ${thread[pool].max_spare_servers}
        uses         = 0
        retry_delay  = 30
        lifetime     = 0
        idle_timeout = 60
    }
}
