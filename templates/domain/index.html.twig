{% extends 'base.html.twig' %}
{% block title %}Domains{% endblock %}

{% block content %}
{# Domains #}
<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0"><i class="bi bi-globe me-2"></i>Domains</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('user_guide_dns') }}" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
            <a href="{{ path('domain_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Domain
            </a>
        </div>
    </div>
    {% if domains is empty %}
        <div class="card">
            <div class="card-body text-center text-muted py-4">
                <i class="bi bi-globe fs-1 d-block mb-3 opacity-25"></i>
                No domains yet. <a href="{{ path('domain_new') }}">Add the first one →</a>
            </div>
        </div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Records</th>
                            <th>Names</th>
                            <th>DNSSEC</th>
                            <th>Last Modified</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for domain in domains %}
                            <tr>
                                <td>
                                    <a href="{{ path('domain_show', {id: domain.id}) }}" class="fw-semibold text-decoration-none">
                                        {{ domain.name }}
                                    </a>
                                </td>
                                <td class="text-muted">{{ domain.description ?: '—' }}</td>
                                <td><span class="badge bg-secondary rounded-pill">{{ domain.records|length }}</span></td>
                                <td><span class="badge bg-secondary rounded-pill">{{ domain.interfaceNames|length }}</span></td>
                                <td>
                                    {% if domain.dnssecPolicy %}
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-shield-check me-1"></i>{{ domain.dnssecPolicy.name }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted small">
                                    {{ domain.updatedAt|date('Y-m-d H:i') }}
                                    {% if domain.updatedBy %}<br>{{ domain.updatedBy }}{% endif %}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('domain_edit', {id: domain.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('domain_delete', {id: domain.id}) }}" class="d-inline"
                                          onsubmit="return confirm('Delete domain {{ domain.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_domain_' ~ domain.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>

{# DNS Views #}
<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0"><i class="bi bi-eye me-2"></i>DNS Views</h2>
        <a href="{{ path('dns_view_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add View
        </a>
    </div>
    {% if views is empty %}
        <div class="card">
            <div class="card-body text-center text-muted py-4">
                <i class="bi bi-eye fs-1 d-block mb-3 opacity-25"></i>
                No views yet. <a href="{{ path('dns_view_new') }}">Add one →</a>
            </div>
        </div>
    {% else %}
        <div class="card">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for view in views %}
                        <tr>
                            <td class="fw-semibold">{{ view.name }}</td>
                            <td class="text-muted small">{{ view.description ?: '—' }}</td>
                            <td class="text-end">
                                <a href="{{ path('dns_view_edit', {id: view.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('dns_view_delete', {id: view.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Delete view {{ view.name|e('js') }}?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_dns_view_' ~ view.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
