{% extends 'base.html.twig' %}
{% block title %}{{ domain.name }}{% endblock %}

{# Pagination footer for a single section #}
{% macro pager(p) %}
<div class="card-footer d-flex align-items-center justify-content-between py-2">
    <span class="text-muted small">
        {% if p.total == 0 %}
            No results
        {% else %}
            {% set first = (p.page - 1) * p.per_page + 1 %}
            {% set last  = min(p.page * p.per_page, p.total) %}
            {{ first }}–{{ last }} of {{ p.total }}
        {% endif %}
    </span>
    {% if p.pages > 1 %}
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item {{ p.page <= 1 ? 'disabled' }}">
                <a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): p.page - 1})) }}">‹</a>
            </li>
            {% set win_start = max(1, p.page - 3) %}
            {% set win_end   = min(p.pages, p.page + 3) %}
            {% if win_start > 1 %}
                <li class="page-item"><a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): 1})) }}">1</a></li>
                {% if win_start > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            {% endif %}
            {% for n in range(win_start, win_end) %}
                <li class="page-item {{ n == p.page ? 'active' }}">
                    <a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): n})) }}">{{ n }}</a>
                </li>
            {% endfor %}
            {% if win_end < p.pages %}
                {% if win_end < p.pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                <li class="page-item"><a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): p.pages})) }}">{{ p.pages }}</a></li>
            {% endif %}
            <li class="page-item {{ p.page >= p.pages ? 'disabled' }}">
                <a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): p.page + 1})) }}">›</a>
            </li>
        </ul>
    </nav>
    {% endif %}
</div>
{% endmacro %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('domain_index') }}">Domains</a></li>
        <li class="breadcrumb-item active">{{ domain.name }}</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-globe me-2"></i>{{ domain.name }}</h1>
        {% if domain.description %}
            <p class="text-muted mb-0">{{ domain.description }}</p>
        {% endif %}
        <div class="mt-2 d-flex flex-wrap gap-1 align-items-center">
            {% set view_palettes = ['bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'bg-success-subtle text-success-emphasis border border-success-subtle', 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'bg-info-subtle text-info-emphasis border border-info-subtle', 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle'] %}
            {% for view in domain.views %}
                <span class="badge {{ view_palettes[view.id % (view_palettes|length)] }}">{{ view.name }}</span>
            {% endfor %}
            {% if domain.excludeFromInterfaces %}
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="This domain does not appear in the domain selector when adding DNS records from an interface">
                    <i class="bi bi-slash-circle me-1"></i>Excluded from interface forms
                </span>
            {% endif %}
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_dns') }}#domains" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('domain_edit', {id: domain.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('domain_delete', {id: domain.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete domain {{ domain.name|e('js') }}?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_domain_' ~ domain.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

{# Domain Aliases #}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-link-45deg me-1"></i>Domain Aliases</span>
        <span class="badge bg-secondary rounded-pill">{{ domain.aliases|length }}</span>
    </div>
    <div class="card-body pb-2">
        <p class="text-muted small mb-3">
            Alias zones share this domain's records and SOA settings but are served under a different name.
            Each alias generates its own zone file with the correct <code>$ORIGIN</code>.
        </p>
        {% if domain.aliases is not empty %}
        <div class="mb-3">
            {% for alias in domain.aliases %}
            <div class="d-inline-flex align-items-center gap-2 me-2 mb-2 px-2 py-1 border rounded bg-body-secondary">
                <code class="small">{{ alias.name }}</code>
                <form method="post" action="{{ path('domain_alias_delete', {id: domain.id, aliasId: alias.id}) }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('alias_delete_' ~ alias.id) }}">
                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 lh-1" title="Remove alias"
                            onclick="return confirm('Remove alias {{ alias.name|e('js') }}?')">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </form>
            </div>
            {% endfor %}
        </div>
        {% endif %}
        <form method="post" action="{{ path('domain_alias_add', {id: domain.id}) }}" class="d-flex gap-2">
            <input type="hidden" name="_token" value="{{ csrf_token('alias_add_' ~ domain.id) }}">
            <input type="text" name="alias_name" class="form-control form-control-sm font-monospace"
                   placeholder="e.g. example.net" style="max-width: 280px;">
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Alias
            </button>
        </form>
    </div>
</div>

{% if domain.soaNameserver or domain.soaEmail %}
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-file-earmark-code me-1"></i>SOA Record</div>
    <div class="card-body">
        <div class="row g-3">
            {% if domain.soaNameserver %}
            <div class="col-md-6">
                <div class="text-muted small">Primary Nameserver (MNAME)</div>
                <div class="font-monospace">{{ domain.soaNameserver }}</div>
            </div>
            {% endif %}
            {% if domain.soaEmail %}
            <div class="col-md-6">
                <div class="text-muted small">Responsible Email (RNAME)</div>
                <div class="font-monospace">{{ domain.soaEmail }}</div>
            </div>
            {% endif %}
            <div class="col-6 col-md-3">
                <div class="text-muted small">Refresh</div>
                <div>{{ domain.soaRefresh ?? 3600 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Retry</div>
                <div>{{ domain.soaRetry ?? 900 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Expire</div>
                <div>{{ domain.soaExpire ?? 604800 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Minimum TTL</div>
                <div>{{ domain.soaTtl ?? 3600 }}s</div>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% if domain.dnssecPolicy %}
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-shield-check me-1"></i>DNSSEC</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-muted small">Policy</div>
                <div><a href="{{ path('dnssec_policy_edit', {id: domain.dnssecPolicy.id}) }}" class="fw-semibold text-decoration-none"><code>{{ domain.dnssecPolicy.name }}</code></a></div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Inline Signing</div>
                <div><span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Yes</span></div>
            </div>
        </div>
        <div id="ds-record-result" class="mt-3" style="display:none">
            <div class="text-muted small mb-1">DS Record(s) — publish in parent zone</div>
            <pre id="ds-record-output" class="bg-body-secondary border rounded p-2 mb-1" style="white-space:pre-wrap;word-break:break-all;font-size:.85em;margin-bottom:0"></pre>
            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="ds-record-copy">
                <i class="bi bi-clipboard me-1"></i>Copy
            </button>
        </div>
        <div id="trust-chain-result" class="mt-3" style="display:none">
            <div class="text-muted small mb-2">Trust Chain Validation</div>
            <div id="trust-chain-steps" class="list-group list-group-flush small mb-2"></div>
            <div id="trust-chain-summary" class="small fw-semibold"></div>
        </div>
        <div id="key-info-result" class="mt-3" style="display:none">
            <div class="text-muted small mb-2">DNSSEC Keys</div>
            <div id="key-info-error" class="text-danger small" style="display:none"></div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-1" style="font-size:.85em">
                    <thead>
                        <tr>
                            <th>Key Tag</th>
                            <th>Type</th>
                            <th>Algorithm</th>
                            <th>Created</th>
                            <th>Published</th>
                            <th>Activated</th>
                            <th>Inactive</th>
                            <th>Deleted</th>
                        </tr>
                    </thead>
                    <tbody id="key-info-tbody"></tbody>
                </table>
            </div>
            <div id="key-info-warnings" class="text-warning small" style="display:none"></div>
        </div>
        <div class="card-footer d-flex align-items-center gap-2">
            <a href="{{ path('ksk_rollover_start') }}?domain={{ domain.id }}" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-key me-1"></i>Start KSK Rollover
            </a>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="fetch-ds-btn"
                    data-url="{{ path('domain_ds_record', {id: domain.id}) }}">
                <i class="bi bi-search me-1"></i>Fetch DS Record
            </button>
            <span id="ds-spinner" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-hidden="true"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="fetch-keys-btn"
                    data-url="{{ path('domain_keys', {id: domain.id}) }}">
                <i class="bi bi-key-fill me-1"></i>Fetch Keys
            </button>
            <span id="keys-spinner" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-hidden="true"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="validate-chain-btn"
                    data-url="{{ path('domain_validate_trust_chain', {id: domain.id}) }}">
                <i class="bi bi-shield-check me-1"></i>Validate Trust Chain
            </button>
            <span id="chain-spinner" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-hidden="true"></span>
        </div>
    </div>
</div>
{% endif %}

{# Search bar #}
<div class="mb-4">
    <form method="get" action="{{ path('domain_show', {id: domain.id}) }}" class="mb-2" id="simple-search-form">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control"
                   placeholder="Search DNS records by hostname, value, host, or IP…"
                   value="{{ q }}">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            {% if q or isAdvanced %}
                <a href="{{ path('domain_show', {id: domain.id, reset: 1}) }}" class="btn btn-outline-secondary">Clear</a>
            {% endif %}
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#advanced-search"
                    aria-expanded="{{ isAdvanced ? 'true' : 'false' }}">
                <i class="bi bi-sliders me-1"></i>Advanced
            </button>
        </div>
    </form>

    {# Advanced search #}
    <div class="collapse {{ isAdvanced ? 'show' : '' }}" id="advanced-search">
        <form method="get" action="{{ path('domain_show', {id: domain.id}) }}">
            <div class="card card-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Hostname</label>
                        <input type="text" name="hostname" class="form-control form-control-sm font-monospace"
                               value="{{ criteria.hostname ?? '' }}" placeholder="e.g. web* or mail">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Type</label>
                        <select name="type" class="form-select form-select-sm">
                            <option value="">— Any —</option>
                            {% for rt in recordTypes %}
                                <option value="{{ rt.value }}" {{ (criteria.type ?? '') == rt.value ? 'selected' }}>{{ rt.value }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Value</label>
                        <input type="text" name="value" class="form-control form-control-sm font-monospace"
                               value="{{ criteria.value ?? '' }}" placeholder="e.g. 10.0.* or target.host">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Linked Host</label>
                        <input type="text" name="host" class="form-control form-control-sm"
                               value="{{ criteria.host ?? '' }}" placeholder="e.g. server-01 or web*">
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">DNS View</label>
                        <select name="view" class="form-select form-select-sm">
                            <option value="">— Any —</option>
                            {% for view in views %}
                                <option value="{{ view.id }}" {{ (criteria.view ?? '') == (view.id ~ '') ? 'selected' }}>{{ view.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a href="{{ path('domain_show', {id: domain.id, reset: 1}) }}" class="btn btn-sm btn-outline-secondary">Clear</a>
                    <span class="text-muted small ms-2">Use <code>*</code> as a wildcard (e.g. <code>web*</code>, <code>10.0.*</code>)</span>
                </div>
            </div>
        </form>
    </div>
</div>

{# Unified DNS Records #}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-list-ul me-1"></i>DNS Records
            <span class="badge bg-secondary ms-1">{{ pag.total }}</span>
            {% if q %}<span class="text-muted small ms-1">matching "{{ q }}"</span>{% elseif isAdvanced %}<span class="text-muted small ms-1">filtered</span>{% endif %}
        </span>
        <div class="d-flex gap-2">
            <a href="{{ path('zone_import_upload', {id: domain.id}) }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-upload me-1"></i>Import Zone
            </a>
            <a href="{{ path('domain_record_new', {domainId: domain.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Record
            </a>
        </div>
    </div>
    {% if records is empty %}
        <div class="card-body text-center text-muted py-3">
            {% if q %}
                No records matched <strong>{{ q }}</strong>.
            {% elseif isAdvanced %}
                No records matched the search criteria. <a href="{{ path('domain_show', {id: domain.id, reset: 1}) }}">Clear search →</a>
            {% else %}
                No records yet. <a href="{{ path('domain_record_new', {domainId: domain.id}) }}">Add one →</a>
            {% endif %}
        </div>
    {% else %}
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Interface</th>
                    <th>TTL</th>
                    <th>Modified</th>
                    <th>Views</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            {% set type_colors = {'A': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'AAAA': 'bg-info-subtle text-info-emphasis border border-info-subtle', 'CNAME': 'bg-success-subtle text-success-emphasis border border-success-subtle', 'MX': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'NS': 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle', 'TXT': 'badge-orange-subtle', 'PTR': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'SRV': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'DS': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'CAA': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'HTTPS': 'badge-purple-subtle'} %}
            <tbody>
                {% for record in records %}
                    {% set iface_deleted = record.networkInterface and record.networkInterface.deleted %}
                    {% set vip_deleted   = record.virtualIp and record.virtualIp.deleted %}
                    <tr{% if iface_deleted or vip_deleted %} class="row-deleted"{% endif %}>
                        <td class="font-monospace">
                            {{ record.hostname }}
                            {% if record.canonical %}
                                <span class="badge bg-primary ms-1" title="Canonical — used for PTR reverse DNS">PTR</span>
                            {% endif %}
                            {% if iface_deleted %}
                                <span class="badge bg-warning text-dark ms-1" title="This interface has been deleted — this record is excluded from DNS pushes">Interface deleted</span>
                            {% endif %}
                            {% if vip_deleted %}
                                <span class="badge bg-warning text-dark ms-1" title="This virtual IP has been deleted — this record is excluded from DNS pushes">VIP deleted</span>
                            {% endif %}
                        </td>
                        <td><span class="badge {{ type_colors[record.type.value] ?? 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' }}">{{ record.type.value }}</span></td>
                        <td class="font-monospace small" style="word-break: break-all;">
                            {% if record.networkInterface %}
                                {% if record.type.value == 'A' %}
                                    <span class="text-muted">{{ record.networkInterface.ipAddress ? record.networkInterface.ipAddress.address : '—' }}</span>
                                {% elseif record.type.value == 'AAAA' %}
                                    <span class="text-muted">{{ record.networkInterface.ipv6Address ? record.networkInterface.ipv6Address.address : '—' }}</span>
                                {% else %}
                                    {{ record.value }}
                                {% endif %}
                            {% elseif record.virtualIp %}
                                {% if record.type.value == 'A' %}
                                    <span class="text-muted">{{ record.virtualIp.ipAddress ? record.virtualIp.ipAddress.address : '—' }}</span>
                                {% elseif record.type.value == 'AAAA' %}
                                    <span class="text-muted">{{ record.virtualIp.ipv6Address ? record.virtualIp.ipv6Address.address : '—' }}</span>
                                {% else %}
                                    {{ record.value }}
                                {% endif %}
                            {% else %}
                                {{ record.value }}
                            {% endif %}
                        </td>
                        <td style="white-space:nowrap">
                            {% if record.networkInterface %}
                                {% set iface = record.networkInterface %}
                                <a href="{{ path('interface_show', {id: iface.id}) }}" class="text-decoration-none small{% if iface_deleted %} text-warning-emphasis{% endif %}">
                                    {% if iface.host %}{{ iface.host.name }}: {% endif %}<span class="font-monospace">{{ iface.name ?: iface.macAddress }}</span>
                                </a>
                            {% elseif record.virtualIp %}
                                <a href="{{ path('virtual_ip_show', {id: record.virtualIp.id}) }}" class="text-decoration-none small{% if vip_deleted %} text-warning-emphasis{% endif %}">
                                    <i class="bi bi-layers text-muted me-1"></i>{{ record.virtualIp.label }}
                                </a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-muted small">{{ record.ttl ?: '—' }}</td>
                        <td class="text-muted small">
                            {{ record.updatedAt|date('Y-m-d H:i') }}
                            {% if record.updatedBy %}<br>{{ record.updatedBy }}{% endif %}
                        </td>
                        <td>
                            {% set view_palettes = ['bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'bg-success-subtle text-success-emphasis border border-success-subtle', 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'bg-info-subtle text-info-emphasis border border-info-subtle', 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle'] %}
                            {% for view in record.views %}
                                <span class="badge {{ view_palettes[view.id % (view_palettes|length)] }} me-1">{{ view.name }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endfor %}
                        </td>
                        <td class="text-end" style="white-space: nowrap;">
                            <a href="{{ path('domain_record_edit', {id: record.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('domain_record_delete', {id: record.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Delete this record?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_record_' ~ record.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        {{ _self.pager(pag) }}
    {% endif %}
</div>

<div class="text-muted small mt-3">
    Created {{ domain.createdAt|date('Y-m-d H:i') }}{% if domain.createdBy %} by {{ domain.createdBy }}{% endif %}
    &middot; Updated {{ domain.updatedAt|date('Y-m-d H:i') }}{% if domain.updatedBy %} by {{ domain.updatedBy }}{% endif %}
</div>
{% endblock %}

{% block scripts %}
{% if domain.dnssecPolicy %}
<script>
(function () {
    var btn     = document.getElementById('fetch-ds-btn');
    var spinner = document.getElementById('ds-spinner');
    var result  = document.getElementById('ds-record-result');
    var output  = document.getElementById('ds-record-output');
    var copyBtn = document.getElementById('ds-record-copy');

    if (!btn) return;

    btn.addEventListener('click', function () {
        btn.disabled = true;
        spinner.classList.remove('d-none');
        result.style.display = 'none';

        fetch(btn.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.error) {
                    output.textContent = 'Error: ' + data.error;
                } else if (!data.ds_records || data.ds_records.length === 0) {
                    output.textContent = 'No DS records found yet — BIND may still be generating keys. Try again in a moment.';
                    if (data.errors && data.errors.length) {
                        output.textContent += '\n\n' + data.errors.join('\n');
                    }
                } else {
                    output.textContent = data.ds_records.join('\n');
                    if (data.errors && data.errors.length) {
                        output.textContent += '\n\n(Warnings: ' + data.errors.join('; ') + ')';
                    }
                }
                result.style.display = '';
            })
            .catch(function (err) {
                output.textContent = 'Request failed: ' + err;
                result.style.display = '';
            })
            .finally(function () {
                btn.disabled = false;
                spinner.classList.add('d-none');
            });
    });

    copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(output.textContent).then(function () {
            copyBtn.innerHTML = '<i class="bi bi-clipboard-check me-1"></i>Copied';
            setTimeout(function () {
                copyBtn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy';
            }, 2000);
        });
    });

    var keysBtn      = document.getElementById('fetch-keys-btn');
    var keysSpinner  = document.getElementById('keys-spinner');
    var keyResult    = document.getElementById('key-info-result');
    var keyTbody     = document.getElementById('key-info-tbody');
    var keyError     = document.getElementById('key-info-error');
    var keyWarnings  = document.getElementById('key-info-warnings');

    var ALG_NAMES = {
        5: 'RSASHA1', 7: 'NSEC3RSASHA1', 8: 'RSASHA256', 10: 'RSASHA512',
        13: 'ECDSAP256SHA256', 14: 'ECDSAP384SHA384', 15: 'ED25519', 16: 'ED448'
    };

    function fmtDate(raw) {
        if (!raw) return '—';
        var s = String(raw).replace(/\D/g, '');
        if (s.length < 12) return raw;
        return s.slice(0, 4) + '-' + s.slice(4, 6) + '-' + s.slice(6, 8) + ' ' + s.slice(8, 10) + ':' + s.slice(10, 12);
    }

    function fmtAlg(num) {
        return ALG_NAMES[num] ? ALG_NAMES[num] + ' (' + num + ')' : String(num);
    }

    keysBtn.addEventListener('click', function () {
        keysBtn.disabled = true;
        keysSpinner.classList.remove('d-none');
        keyResult.style.display = 'none';

        fetch(keysBtn.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                keyError.style.display = 'none';
                keyWarnings.style.display = 'none';
                keyTbody.innerHTML = '';

                if (data.error) {
                    keyError.textContent = data.error;
                    keyError.style.display = '';
                } else if (!data.keys || data.keys.length === 0) {
                    keyError.textContent = 'No keys found yet — BIND may still be generating keys. Try again in a moment.';
                    keyError.style.display = '';
                } else {
                    data.keys.forEach(function (k) {
                        var tr = document.createElement('tr');
                        [
                            String(k.key_tag),
                            k.type === 'KSK' ? '<span class="badge bg-primary">KSK</span>' : '<span class="badge bg-secondary">ZSK</span>',
                            fmtAlg(k.algorithm),
                            fmtDate(k.created),
                            fmtDate(k.publish),
                            fmtDate(k.activate),
                            fmtDate(k.inactive),
                            fmtDate(k['delete'])
                        ].forEach(function (cell, i) {
                            var td = document.createElement('td');
                            if (i === 0) { td.className = 'font-monospace'; }
                            td.innerHTML = cell;
                            tr.appendChild(td);
                        });
                        keyTbody.appendChild(tr);
                    });
                    if (data.errors && data.errors.length) {
                        keyWarnings.textContent = 'Warnings: ' + data.errors.join('; ');
                        keyWarnings.style.display = '';
                    }
                }
                keyResult.style.display = '';
            })
            .catch(function (err) {
                keyError.textContent = 'Request failed: ' + err;
                keyError.style.display = '';
                keyResult.style.display = '';
            })
            .finally(function () {
                keysBtn.disabled = false;
                keysSpinner.classList.add('d-none');
            });
    });
    var chainBtn     = document.getElementById('validate-chain-btn');
    var chainSpinner = document.getElementById('chain-spinner');
    var chainResult  = document.getElementById('trust-chain-result');
    var chainSteps   = document.getElementById('trust-chain-steps');
    var chainSummary = document.getElementById('trust-chain-summary');

    function tcIcon(s) {
        return s === 'ok'      ? '<i class="bi bi-check-circle-fill text-success"></i>'
             : s === 'warning' ? '<i class="bi bi-exclamation-triangle-fill text-warning"></i>'
             :                   '<i class="bi bi-x-circle-fill text-danger"></i>';
    }

    function renderDsBlock(step) {
        var ok   = step.status === 'ok';
        var warn = step.status === 'warning';
        var h    = '<div class="py-1 mb-1">';
        if (step.ds_parsed && step.ds_parsed.length) {
            var signedBadge;
            if (ok) {
                var rrsigTags = step.rrsig_key_tags || [];
                var who = rrsigTags.length ? ' id=' + rrsigTags.join(', id=') : '';
                signedBadge = '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                            + '<i class="bi bi-check-lg me-1"></i>signed by' + who + '</span>';
            } else if (warn) {
                signedBadge = '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">no RRSIG</span>';
            } else {
                signedBadge = '<span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">missing</span>';
            }
            step.ds_parsed.forEach(function (ds) {
                h += '<div class="d-flex align-items-center gap-2 flex-wrap mb-1">'
                   + '<span class="badge bg-primary font-monospace">id=' + ds.key_tag + '</span>'
                   + signedBadge + '</div>';
            });
            if (step.records && step.records.length) {
                h += '<pre class="bg-body-secondary border rounded p-1 mt-1 mb-0" style="font-size:.8em;white-space:pre-wrap;word-break:break-all">'
                   + step.records.join('\n') + '</pre>';
            }
        } else {
            h += '<div class="small text-danger">' + tcIcon('error') + ' ' + step.detail + '</div>';
        }
        return h + '</div>';
    }

    function renderTrustChain(data) {
        if (data.error) {
            chainSteps.innerHTML = '<div class="text-danger small">' + data.error + '</div>';
            chainSummary.textContent = '';
            chainResult.style.display = '';
            return;
        }

        // Index DS steps by the parent zone that holds them, and signing steps by zone.
        var signingByZone = {};
        var dsByParent    = {};
        (data.steps || []).forEach(function (s) {
            if (s.type === 'signing') { signingByZone[s.zone] = s; }
            if (s.type === 'ds')     { dsByParent[s.parent]   = s; }
        });

        var html = '';

        // Root trust anchor, then the DS that lives in the root zone.
        html += '<div class="d-flex align-items-center gap-2 small text-muted mb-2">'
              + '<i class="bi bi-globe2"></i>'
              + '<span class="font-monospace fw-semibold">.</span>'
              + '<span>(root — trust anchor)</span></div>';
        if (dsByParent['.']) { html += renderDsBlock(dsByParent['.']); }

        // Each zone section: KSK first, ZSK second, outgoing DS third.
        (data.steps || []).forEach(function (step) {
            if (step.type !== 'dnskey') { return; }

            var signing          = signingByZone[step.zone] || null;
            var dnskeySignerTags = step.dnskey_signer_key_tags || [];
            var anchors          = step.anchored_by || [];

            html += '<hr class="my-2" style="opacity:.15">';
            html += '<div class="d-flex align-items-center gap-2 mb-2">'
                  + tcIcon(step.status)
                  + '<span class="font-monospace fw-semibold">' + step.zone + '</span>'
                  + '<span class="text-muted small">DNSKEY</span></div>';

            if (step.dnskeys_parsed && step.dnskeys_parsed.length) {
                // Sort indices so KSK (flags 257) renders before ZSK (flags 256).
                var order = step.dnskeys_parsed.map(function (_, i) { return i; });
                order.sort(function (a, b) {
                    return (step.dnskeys_parsed[b].flags || 0) - (step.dnskeys_parsed[a].flags || 0);
                });

                order.forEach(function (idx) {
                    var key      = step.dnskeys_parsed[idx];
                    var record   = step.records && step.records[idx];
                    var isKsk    = key.type === 'KSK';
                    var anchored = anchors.indexOf(key.key_tag) !== -1;

                    var idBadge   = '<span class="badge font-monospace ' + (anchored ? 'bg-primary' : 'bg-secondary') + '">id=' + key.key_tag + '</span>';
                    var typeBadge = isKsk
                        ? '<span class="badge bg-info-subtle text-info border border-info-subtle">KSK</span>'
                        : '<span class="badge bg-body-secondary text-body border">ZSK</span>';

                    var notes = [];
                    if (dnskeySignerTags.length) {
                        notes.push('<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                            + '<i class="bi bi-check-lg me-1"></i>signed by id=' + dnskeySignerTags.join(', id=') + '</span>');
                    }

                    if (anchored) { notes.push('<span class="text-success-emphasis small"><i class="bi bi-link-45deg me-1"></i>anchored by DS above</span>'); }

                    html += '<div class="d-flex align-items-center gap-2 flex-wrap mb-1">'
                          + idBadge + typeBadge + notes.join('') + '</div>';
                    if (record) {
                        html += '<pre class="bg-body-secondary border rounded p-1 mt-0 mb-2" style="font-size:.8em;white-space:pre-wrap;word-break:break-all">'
                              + record + '</pre>';
                    }
                });
            } else {
                html += '<div class="text-danger small">' + step.detail + '</div>';
            }

            // Outgoing DS from this zone (delegating to a child zone) — third after KSK and ZSK.
            if (dsByParent[step.zone]) { html += renderDsBlock(dsByParent[step.zone]); }

            // Zone-signing status for the managed zone.
            if (signing) {
                if (signing.status === 'ok') {
                    var soaTags = signing.soa_signer_key_tags || [];
                    var soaSignedBadge = soaTags.length
                        ? '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                          + '<i class="bi bi-check-lg me-1"></i>signed by id=' + soaTags.join(', id=') + '</span>'
                        : '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                          + '<i class="bi bi-check-lg me-1"></i>signed</span>';
                    html += '<div class="d-flex align-items-center gap-2 flex-wrap mb-1">'
                          + '<span class="badge bg-body-secondary text-body border font-monospace">SOA</span>'
                          + soaSignedBadge + '</div>';
                    if (signing.records && signing.records.length) {
                        html += '<pre class="bg-body-secondary border rounded p-1 mt-0 mb-2" style="font-size:.8em;white-space:pre-wrap;word-break:break-all">'
                              + signing.records.join('\n') + '</pre>';
                    }
                } else {
                    html += '<div class="d-flex align-items-center gap-2 small">'
                          + tcIcon('error') + ' <span class="text-danger small">' + signing.detail + '</span></div>';
                }
            }
        });

        chainSteps.innerHTML = html;

        if (data.valid) {
            chainSummary.innerHTML = '<i class="bi bi-shield-fill-check text-success me-1"></i>Trust chain is complete and valid';
            chainSummary.className = 'small fw-semibold text-success mt-1';
        } else {
            chainSummary.innerHTML = '<i class="bi bi-shield-fill-x text-danger me-1"></i>Trust chain has gaps — review the errors above';
            chainSummary.className = 'small fw-semibold text-danger mt-1';
        }
        chainResult.style.display = '';
    }

    if (chainBtn) {
        chainBtn.addEventListener('click', function () {
            chainBtn.disabled = true;
            chainSpinner.classList.remove('d-none');
            chainResult.style.display = 'none';
            chainSteps.innerHTML = '';
            chainSummary.textContent = '';
            chainSummary.className = 'small fw-semibold';

            fetch(chainBtn.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.json(); })
                .then(renderTrustChain)
                .catch(function (err) {
                    chainSteps.innerHTML = '<div class="text-danger small">Request failed: ' + err + '</div>';
                    chainResult.style.display = '';
                })
                .finally(function () {
                    chainBtn.disabled = false;
                    chainSpinner.classList.add('d-none');
                });
        });
    }
}());
</script>
{% endif %}
{% endblock %}
