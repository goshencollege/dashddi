{% extends 'base.html.twig' %}
{% block title %}{{ domain.name }}{% endblock %}

{# Pagination footer for a single section #}
{% macro pager(p) %}
<div class="card-footer d-flex align-items-center justify-content-between py-2">
    <span class="text-muted small">
        {% if p.total == 0 %}
            No results
        {% else %}
            {% set first = (p.page - 1) * p.per_page + 1 %}
            {% set last  = min(p.page * p.per_page, p.total) %}
            {{ first }}–{{ last }} of {{ p.total }}
        {% endif %}
    </span>
    {% if p.pages > 1 %}
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item {{ p.page <= 1 ? 'disabled' }}">
                <a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): p.page - 1})) }}">‹</a>
            </li>
            {% set win_start = max(1, p.page - 3) %}
            {% set win_end   = min(p.pages, p.page + 3) %}
            {% if win_start > 1 %}
                <li class="page-item"><a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): 1})) }}">1</a></li>
                {% if win_start > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            {% endif %}
            {% for n in range(win_start, win_end) %}
                <li class="page-item {{ n == p.page ? 'active' }}">
                    <a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): n})) }}">{{ n }}</a>
                </li>
            {% endfor %}
            {% if win_end < p.pages %}
                {% if win_end < p.pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                <li class="page-item"><a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): p.pages})) }}">{{ p.pages }}</a></li>
            {% endif %}
            <li class="page-item {{ p.page >= p.pages ? 'disabled' }}">
                <a class="page-link" href="{{ path('domain_show', p.link_params|merge({(p.page_param): p.page + 1})) }}">›</a>
            </li>
        </ul>
    </nav>
    {% endif %}
</div>
{% endmacro %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('domain_index') }}">Domains</a></li>
        <li class="breadcrumb-item active">{{ domain.name }}</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-globe me-2"></i>{{ domain.name }}</h1>
        {% if domain.description %}
            <p class="text-muted mb-0">{{ domain.description }}</p>
        {% endif %}
        {% if domain.views is not empty %}
            <div class="mt-2">
                {% for view in domain.views %}
                    <span class="badge bg-secondary me-1">{{ view.name }}</span>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_dns') }}#domains" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('domain_edit', {id: domain.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('domain_delete', {id: domain.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete domain {{ domain.name|e('js') }}?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_domain_' ~ domain.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

{% if domain.soaNameserver or domain.soaEmail %}
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-file-earmark-code me-1"></i>SOA Record</div>
    <div class="card-body">
        <div class="row g-3">
            {% if domain.soaNameserver %}
            <div class="col-md-6">
                <div class="text-muted small">Primary Nameserver (MNAME)</div>
                <div class="font-monospace">{{ domain.soaNameserver }}</div>
            </div>
            {% endif %}
            {% if domain.soaEmail %}
            <div class="col-md-6">
                <div class="text-muted small">Responsible Email (RNAME)</div>
                <div class="font-monospace">{{ domain.soaEmail }}</div>
            </div>
            {% endif %}
            <div class="col-6 col-md-3">
                <div class="text-muted small">Refresh</div>
                <div>{{ domain.soaRefresh ?? 3600 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Retry</div>
                <div>{{ domain.soaRetry ?? 900 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Expire</div>
                <div>{{ domain.soaExpire ?? 604800 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Minimum TTL</div>
                <div>{{ domain.soaTtl ?? 3600 }}s</div>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% if domain.dnssecPolicy %}
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-shield-check me-1"></i>DNSSEC</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-muted small">Policy</div>
                <div><a href="{{ path('dnssec_policy_edit', {id: domain.dnssecPolicy.id}) }}" class="fw-semibold text-decoration-none"><code>{{ domain.dnssecPolicy.name }}</code></a></div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Inline Signing</div>
                <div><span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Yes</span></div>
            </div>
        </div>
        <div class="card-footer">
            <a href="{{ path('ksk_rollover_start') }}?domain={{ domain.id }}" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-key me-1"></i>Start KSK Rollover
            </a>
        </div>
    </div>
</div>
{% endif %}

{# Search bar #}
<form method="get" action="{{ path('domain_show', {id: domain.id}) }}" class="mb-4">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="search" name="q" class="form-control"
               placeholder="Search DNS records…"
               value="{{ q }}">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        {% if q %}
            <a href="{{ path('domain_show', {id: domain.id}) }}" class="btn btn-outline-secondary">Clear</a>
        {% endif %}
    </div>
</form>

{# Unified DNS Records #}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-list-ul me-1"></i>DNS Records
            <span class="badge bg-secondary ms-1">{{ pag.total }}</span>
            {% if q %}<span class="text-muted small ms-1">matching "{{ q }}"</span>{% endif %}
        </span>
        <div class="d-flex gap-2">
            <a href="{{ path('zone_import_upload', {id: domain.id}) }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-upload me-1"></i>Import Zone
            </a>
            <a href="{{ path('domain_record_new', {domainId: domain.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Record
            </a>
        </div>
    </div>
    {% if records is empty %}
        <div class="card-body text-center text-muted py-3">
            {% if q %}
                No records matched <strong>{{ q }}</strong>.
            {% else %}
                No records yet. <a href="{{ path('domain_record_new', {domainId: domain.id}) }}">Add one →</a>
            {% endif %}
        </div>
    {% else %}
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Host</th>
                    <th>TTL</th>
                    <th>Modified</th>
                    <th>Views</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for record in records %}
                    {% set iface_deleted = record.networkInterface and record.networkInterface.deleted %}
                    <tr{% if iface_deleted %} class="table-warning"{% endif %}>
                        <td class="font-monospace">
                            {{ record.hostname }}
                            {% if record.canonical %}
                                <span class="badge bg-primary ms-1" title="Canonical — used for PTR reverse DNS">PTR</span>
                            {% endif %}
                            {% if iface_deleted %}
                                <span class="badge bg-warning text-dark ms-1" title="The host owning this interface has been deleted — this record is excluded from DNS pushes">Host deleted</span>
                            {% endif %}
                        </td>
                        <td><span class="badge bg-secondary">{{ record.type.value }}</span></td>
                        <td class="font-monospace small" style="word-break: break-all;">
                            {% if record.networkInterface %}
                                {% if record.type.value == 'A' %}
                                    <span class="text-muted">{{ record.networkInterface.ipAddress ? record.networkInterface.ipAddress.address : '—' }}</span>
                                {% elseif record.type.value == 'AAAA' %}
                                    <span class="text-muted">{{ record.networkInterface.ipv6Address ? record.networkInterface.ipv6Address.address : '—' }}</span>
                                {% else %}
                                    {{ record.value }}
                                {% endif %}
                            {% else %}
                                {{ record.value }}
                            {% endif %}
                        </td>
                        <td style="white-space:nowrap">
                            {% if record.networkInterface and record.networkInterface.host %}
                                <a href="{{ path('host_show', {id: record.networkInterface.host.id}) }}" class="text-decoration-none small{% if iface_deleted %} text-warning-emphasis{% endif %}">
                                    {{ record.networkInterface.host.name }}
                                </a>
                                {% if iface_deleted %}
                                    <span class="text-muted small ms-1">(deleted)</span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-muted small">{{ record.ttl ?: '—' }}</td>
                        <td class="text-muted small">
                            {{ record.updatedAt|date('Y-m-d H:i') }}
                            {% if record.updatedBy %}<br>{{ record.updatedBy }}{% endif %}
                        </td>
                        <td>
                            {% for view in record.views %}
                                <span class="badge bg-secondary me-1">{{ view.name }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endfor %}
                        </td>
                        <td class="text-end" style="white-space: nowrap;">
                            <a href="{{ path('domain_record_edit', {id: record.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('domain_record_delete', {id: record.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Delete this record?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_record_' ~ record.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        {{ _self.pager(pag) }}
    {% endif %}
</div>

<div class="text-muted small mt-3">
    Created {{ domain.createdAt|date('Y-m-d H:i') }}{% if domain.createdBy %} by {{ domain.createdBy }}{% endif %}
    &middot; Updated {{ domain.updatedAt|date('Y-m-d H:i') }}{% if domain.updatedBy %} by {{ domain.updatedBy }}{% endif %}
</div>
{% endblock %}
