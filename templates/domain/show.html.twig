{% extends 'base.html.twig' %}
{% block title %}{{ domain.name }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('domain_index') }}">Domains</a></li>
        <li class="breadcrumb-item active">{{ domain.name }}</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-globe me-2"></i>{{ domain.name }}</h1>
        {% if domain.description %}
            <p class="text-muted mb-0">{{ domain.description }}</p>
        {% endif %}
        {% if domain.views is not empty %}
            <div class="mt-2">
                {% for view in domain.views %}
                    <span class="badge bg-secondary me-1">{{ view.name }}</span>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <div>
        <a href="{{ path('domain_edit', {id: domain.id}) }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('domain_delete', {id: domain.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete domain {{ domain.name|e('js') }}?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_domain_' ~ domain.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

{% if domain.soaNameserver or domain.soaEmail %}
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-file-earmark-code me-1"></i>SOA Record</div>
    <div class="card-body">
        <div class="row g-3">
            {% if domain.soaNameserver %}
            <div class="col-md-6">
                <div class="text-muted small">Primary Nameserver (MNAME)</div>
                <div class="font-monospace">{{ domain.soaNameserver }}</div>
            </div>
            {% endif %}
            {% if domain.soaEmail %}
            <div class="col-md-6">
                <div class="text-muted small">Responsible Email (RNAME)</div>
                <div class="font-monospace">{{ domain.soaEmail }}</div>
            </div>
            {% endif %}
            <div class="col-6 col-md-3">
                <div class="text-muted small">Refresh</div>
                <div>{{ domain.soaRefresh ?? 3600 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Retry</div>
                <div>{{ domain.soaRetry ?? 900 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Expire</div>
                <div>{{ domain.soaExpire ?? 604800 }}s</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Minimum TTL</div>
                <div>{{ domain.soaTtl ?? 3600 }}s</div>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% if domain.dnssecPolicy or domain.keyDirectory %}
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-shield-check me-1"></i>DNSSEC</div>
    <div class="card-body">
        <div class="row g-3">
            {% if domain.dnssecPolicy %}
            <div class="col-md-4">
                <div class="text-muted small">Policy</div>
                <div><a href="{{ path('dnssec_policy_edit', {id: domain.dnssecPolicy.id}) }}" class="fw-semibold text-decoration-none"><code>{{ domain.dnssecPolicy.name }}</code></a></div>
            </div>
            {% endif %}
            {% if domain.keyDirectory %}
            <div class="col-md-4">
                <div class="text-muted small">Key Directory</div>
                <div class="font-monospace">{{ domain.keyDirectory }}</div>
            </div>
            {% endif %}
            <div class="col-md-4">
                <div class="text-muted small">Inline Signing</div>
                <div>
                    {% if domain.dnssecPolicy and domain.keyDirectory %}
                        <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Yes</span>
                    {% else %}
                        <span class="badge bg-secondary">No</span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% if domain.keyDirectory %}
        <div class="card-footer">
            <a href="{{ path('ksk_rollover_start') }}?domain={{ domain.id }}" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-key me-1"></i>Start KSK Rollover
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endif %}

{# Standalone DNS Records #}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul me-1"></i>DNS Records ({{ domain.records|length }})</span>
        <a href="{{ path('domain_record_new', {domainId: domain.id}) }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Record
        </a>
    </div>
    {% if domain.records is empty %}
        <div class="card-body text-center text-muted py-3">
            No records yet. <a href="{{ path('domain_record_new', {domainId: domain.id}) }}">Add one →</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="">
                    <tr>
                        <th>Hostname</th>
                        <th>Type</th>
                        <th>Value</th>
                        <th>TTL</th>
                        <th>Modified</th>
                        <th>Views</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for record in domain.records %}
                        <tr>
                            <td class="font-monospace">{{ record.hostname }}</td>
                            <td><span class="badge bg-secondary">{{ record.type.value }}</span></td>
                            <td class="font-monospace small">{{ record.value }}</td>
                            <td class="text-muted small">{{ record.ttl ?: '—' }}</td>
                            <td class="text-muted small">
                                {{ record.updatedAt|date('Y-m-d H:i') }}
                                {% if record.updatedBy %}<br>{{ record.updatedBy }}{% endif %}
                            </td>
                            <td>
                                {% for view in record.views %}
                                    <span class="badge bg-secondary me-1">{{ view.name }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endfor %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('domain_record_edit', {id: record.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('domain_record_delete', {id: record.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Delete this record?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_record_' ~ record.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Interface names using this domain #}
{% if domain.interfaceNames is not empty %}
<div class="card">
    <div class="card-header"><i class="bi bi-hdd-network me-1"></i>Interface Names Using This Domain ({{ domain.interfaceNames|length }})</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="">
                <tr><th>FQDN</th><th>Host</th><th>IPv4</th><th>IPv6</th><th>TTL</th><th>Views</th></tr>
            </thead>
            <tbody>
                {% for ifaceName in domain.interfaceNames %}
                    {% set iface = ifaceName.networkInterface %}
                    <tr>
                        <td class="font-monospace">{{ ifaceName.fullyQualifiedName }}</td>
                        <td>
                            {% if iface and iface.host %}
                                <a href="{{ path('host_show', {id: iface.host.id}) }}">{{ iface.host.name }}</a>
                            {% else %}—{% endif %}
                        </td>
                        <td class="font-monospace small">
                            {% if iface and iface.ipAddress %}
                                {{ iface.ipAddress.address }}
                            {% else %}—{% endif %}
                        </td>
                        <td class="font-monospace small">
                            {% if iface and iface.ipv6Address %}
                                {{ iface.ipv6Address.address }}
                            {% else %}—{% endif %}
                        </td>
                        <td class="text-muted small">{{ ifaceName.ttl ?: '—' }}</td>
                        <td>
                            {% for view in ifaceName.views %}
                                <span class="badge bg-secondary me-1">{{ view.name }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endfor %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<div class="text-muted small mt-3">
    Created {{ domain.createdAt|date('Y-m-d H:i') }}{% if domain.createdBy %} by {{ domain.createdBy }}{% endif %}
    &middot; Updated {{ domain.updatedAt|date('Y-m-d H:i') }}{% if domain.updatedBy %} by {{ domain.updatedBy }}{% endif %}
</div>
{% endblock %}
