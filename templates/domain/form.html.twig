{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('domain_index') }}">Domains</a></li>
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-globe me-1"></i>{{ title }}</div>
            <div class="card-body">
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>
                <hr class="my-3">
                <h6 class="text-muted mb-3">SOA Record</h6>
                <div class="mb-3">
                    {{ form_label(form.soaNameserver) }}
                    {{ form_widget(form.soaNameserver, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.soaNameserver) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.soaEmail) }}
                    {{ form_widget(form.soaEmail, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.soaEmail) }}
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        {{ form_label(form.soaRefresh) }}
                        {{ form_widget(form.soaRefresh, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.soaRefresh) }}
                    </div>
                    <div class="col-6">
                        {{ form_label(form.soaRetry) }}
                        {{ form_widget(form.soaRetry, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.soaRetry) }}
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        {{ form_label(form.soaExpire) }}
                        {{ form_widget(form.soaExpire, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.soaExpire) }}
                    </div>
                    <div class="col-6">
                        {{ form_label(form.soaTtl) }}
                        {{ form_widget(form.soaTtl, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.soaTtl) }}
                    </div>
                </div>
                <hr class="my-3">
                <div class="mb-4">
                    <label class="form-label fw-semibold">BIND9 Views</label>
                    <div class="d-flex flex-wrap gap-3">
                        {% for viewWidget in form.views %}
                            <div class="form-check">
                                {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label'}}) }}
                            </div>
                        {% else %}
                            <span class="text-muted small">No views configured yet. <a href="{{ path('dns_view_index') }}">Add views →</a></span>
                        {% endfor %}
                    </div>
                </div>
                <hr class="my-3">
                <h6 class="text-muted mb-3"><i class="bi bi-shield-check me-1"></i>DNSSEC</h6>
                <div class="mb-4">
                    {{ form_label(form.dnssecPolicy) }}
                    {{ form_widget(form.dnssecPolicy, {attr: {class: 'form-select'}}) }}
                    <div class="form-text">
                        Policy must be defined under <a href="{{ path('dnssec_policy_index') }}">DNSSEC Policies</a>.
                        The key directory is configured on the <a href="{{ path('dns_server_index') }}">DNS server</a> and a per-zone subdirectory is created automatically.
                    </div>
                    {{ form_errors(form.dnssecPolicy) }}
                </div>
                <hr class="my-3">
                <h6 class="text-muted mb-3"><i class="bi bi-arrow-repeat me-1"></i>Dynamic DNS (DDNS)</h6>
                <div class="mb-3 form-check">
                    {{ form_widget(form.ddnsEnabled, {attr: {class: 'form-check-input'}}) }}
                    {{ form_label(form.ddnsEnabled, null, {label_attr: {class: 'form-check-label'}}) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.ddnsDnsServer) }}
                    {{ form_widget(form.ddnsDnsServer, {attr: {class: 'form-select'}}) }}
                    {{ form_help(form.ddnsDnsServer) }}
                    {{ form_errors(form.ddnsDnsServer) }}
                    <div class="form-text">
                        Configure DDNS algorithm on the <a href="{{ path('servers_index') }}">DNS server</a>.
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('domain_index') }}" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
