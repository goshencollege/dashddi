{% extends 'base.html.twig' %}
{% block title %}RADIUS Clients{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-shield-check me-2"></i>RADIUS Clients</h1>
    <a href="{{ path('radius_client_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Client
    </a>
</div>

<div class="alert alert-info mb-4">
    <i class="bi bi-info-circle me-2"></i>
    <strong>FreeRADIUS container commands</strong> — run these on the host where the stack is deployed:
    <table class="table table-sm mb-0 mt-2">
        <tbody>
            <tr>
                <td class="text-nowrap pe-3 text-muted small">Start (first time or after setup)</td>
                <td><code>docker compose --profile radius up -d freeradius</code></td>
            </tr>
            <tr>
                <td class="text-nowrap pe-3 text-muted small">Restart after client changes</td>
                <td><code>docker compose --profile radius restart freeradius</code></td>
            </tr>
            <tr>
                <td class="text-nowrap pe-3 text-muted small">Stop</td>
                <td><code>docker compose stop freeradius</code></td>
            </tr>
        </tbody>
    </table>
    <div class="mt-2 small text-muted">
        If FreeRADIUS was not enabled during <code>setup.sh</code>, the
        <em>Start</em> command above will build and launch it. The read-only
        <code>radius</code> database user must exist first — see the
        <code>setup.sh</code> RADIUS section or create it manually.
    </div>
</div>

{% if clients is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-25"></i>
            No RADIUS clients configured. <a href="{{ path('radius_client_new') }}">Add one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>IP / Network</th>
                        <th>Short Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for client in clients %}
                        <tr class="{{ not client.enabled ? 'text-muted' }}">
                            <td class="fw-semibold">{{ client.name }}</td>
                            <td><code>{{ client.nasname }}</code></td>
                            <td class="text-muted small">{{ client.shortname ?? '—' }}</td>
                            <td class="text-muted small">{{ client.description ?? '—' }}</td>
                            <td>
                                {% if client.enabled %}
                                    <span class="badge bg-success">Enabled</span>
                                {% else %}
                                    <span class="badge bg-secondary">Disabled</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">{{ client.updatedAt|date('Y-m-d H:i') }}</td>
                            <td class="text-end">
                                <a href="{{ path('radius_client_edit', {id: client.id}) }}"
                                   class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('radius_client_delete', {id: client.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Remove RADIUS client \'{{ client.name|e('js') }}\'?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete_radius_client_' ~ client.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}
