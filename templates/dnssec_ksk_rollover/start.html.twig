{% extends 'base.html.twig' %}
{% block title %}Start KSK Rollover{% endblock %}

{% block content %}
<div class="row justify-content-center">
<div class="col-lg-6">

<div class="d-flex align-items-center mb-3 gap-2">
    <a href="{{ path('ksk_rollover_index') }}" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 mb-0"><i class="bi bi-key me-2"></i>Start KSK Rollover</h1>
</div>

<div class="alert alert-info">
    <strong>What this does:</strong> Generates a new KSK on the DNS server using the algorithm from the selected policy (defaulting to the zone's own policy), calls <code>rndc loadkeys</code>, then walks you through the manual registrar DS update and old-key retirement.
</div>

{{ form_start(form) }}

<div class="card mb-3">
    <div class="card-header fw-semibold">Rollover Target</div>
    <div class="card-body row g-3">
        <div class="col-12">
            {{ form_label(form.zone, 'Zone') }}
            {{ form_widget(form.zone) }}
            {{ form_errors(form.zone) }}
            <div class="form-text">Forward zones and reverse zones (subnets) with a DNSSEC policy are listed. Reverse zone names are shown after →.</div>
        </div>
        <div class="col-12">
            {{ form_label(form.dnsServer, 'DNS Server') }}
            {{ form_widget(form.dnsServer) }}
            {{ form_errors(form.dnsServer) }}
        </div>
        <div class="col-12">
            {{ form_label(form.dnssecPolicy) }}
            {{ form_widget(form.dnssecPolicy) }}
            {{ form_errors(form.dnssecPolicy) }}
            <div class="form-text">Defaults to the zone's assigned policy. Override to generate a key for a different algorithm (algorithm migration).</div>
        </div>
    </div>
</div>

<script>
(function () {
    var zoneMap = {{ zonePolicyMap|json_encode|raw }};
    var zoneEl  = document.querySelector('[name="ksk_rollover_start[zone]"]');
    var polEl   = document.querySelector('[name="ksk_rollover_start[dnssecPolicy]"]');
    if (!zoneEl || !polEl) return;
    function syncPolicy() {
        var mapped = zoneMap[zoneEl.value];
        polEl.value = (mapped !== undefined) ? String(mapped) : '';
    }
    zoneEl.addEventListener('change', syncPolicy);
    syncPolicy();
}());
</script>

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-play-fill me-1"></i>Generate New KSK &amp; Load Keys
    </button>
    <a href="{{ path('ksk_rollover_index') }}" class="btn btn-outline-secondary">Cancel</a>
</div>

{{ form_end(form) }}

</div>
</div>
{% endblock %}
