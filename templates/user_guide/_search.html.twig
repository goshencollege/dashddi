{# Searches across all user guide pages. Included on the guide index and via _breadcrumb.html.twig on every guide sub-page. #}
<div class="user-guide-search position-relative" data-ug-search>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="Search the user guide…" autocomplete="off"
               aria-label="Search the user guide" data-ug-search-input>
        <button class="btn btn-outline-secondary d-none" type="button" aria-label="Clear search" data-ug-search-clear>
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1050; max-height: 420px; overflow-y: auto;" data-ug-search-results></div>
</div>

<script>
(function () {
    var searchUrl = '{{ path('user_guide_search') }}';

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function escapeRegExp(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlight(text, query) {
        var pattern = new RegExp('(' + escapeRegExp(query) + ')', 'ig');
        return escapeHtml(text).replace(pattern, '<mark>$1</mark>');
    }

    document.querySelectorAll('[data-ug-search]').forEach(function (root) {
        var input = root.querySelector('[data-ug-search-input]');
        var clearBtn = root.querySelector('[data-ug-search-clear]');
        var resultsEl = root.querySelector('[data-ug-search-results]');
        var debounceTimer = null;
        var abortController = null;
        var activeIndex = -1;

        function hideResults() {
            resultsEl.classList.add('d-none');
            resultsEl.innerHTML = '';
            activeIndex = -1;
        }

        function setActive(index) {
            var items = resultsEl.querySelectorAll('.list-group-item');
            items.forEach(function (item) { item.classList.remove('active'); });
            if (index >= 0 && index < items.length) {
                items[index].classList.add('active');
                items[index].scrollIntoView({ block: 'nearest' });
            }
            activeIndex = index;
        }

        function renderResults(results, query) {
            if (!results.length) {
                resultsEl.innerHTML = '<div class="list-group-item text-muted small">No matches for "' + escapeHtml(query) + '"</div>';
                resultsEl.classList.remove('d-none');
                return;
            }

            resultsEl.innerHTML = results.map(function (r) {
                return '<a href="' + r.url + '" class="list-group-item list-group-item-action">'
                    + '<div class="d-flex justify-content-between align-items-center">'
                    + '<span class="fw-semibold"><i class="bi ' + r.icon + ' me-1 text-muted"></i>' + highlight(r.sectionTitle, query) + '</span>'
                    + '<span class="text-muted small ms-2 text-nowrap">' + escapeHtml(r.pageTitle) + '</span>'
                    + '</div>'
                    + '<div class="text-muted small mt-1">' + highlight(r.snippet, query) + '</div>'
                    + '</a>';
            }).join('');
            resultsEl.classList.remove('d-none');
        }

        function runSearch(query) {
            if (abortController) {
                abortController.abort();
            }
            abortController = new AbortController();

            fetch(searchUrl + '?q=' + encodeURIComponent(query), { signal: abortController.signal })
                .then(function (response) { return response.json(); })
                .then(function (data) { renderResults(data.results || [], query); })
                .catch(function (err) {
                    if (err.name !== 'AbortError') {
                        hideResults();
                    }
                });
        }

        input.addEventListener('input', function () {
            var query = input.value.trim();
            clearBtn.classList.toggle('d-none', query === '');

            clearTimeout(debounceTimer);
            if (query.length < 2) {
                hideResults();
                return;
            }
            debounceTimer = setTimeout(function () { runSearch(query); }, 200);
        });

        input.addEventListener('keydown', function (e) {
            var items = resultsEl.querySelectorAll('.list-group-item-action');
            if (!items.length) {
                return;
            }
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                setActive(Math.min(activeIndex + 1, items.length - 1));
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                setActive(Math.max(activeIndex - 1, 0));
            } else if (e.key === 'Enter' && activeIndex >= 0) {
                e.preventDefault();
                items[activeIndex].click();
            } else if (e.key === 'Escape') {
                hideResults();
                input.blur();
            }
        });

        clearBtn.addEventListener('click', function () {
            input.value = '';
            clearBtn.classList.add('d-none');
            hideResults();
            input.focus();
        });

        document.addEventListener('click', function (e) {
            if (!root.contains(e.target)) {
                hideResults();
            }
        });
    });
})();
</script>
