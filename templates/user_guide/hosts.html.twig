            <a href="#interfaces" class="list-group-item list-group-item-action py-1">Network Interfaces</a>
            <a href="#leases" class="list-group-item list-group-item-action py-1">DHCP Leases</a>
            <a href="#bulk" class="list-group-item list-group-item-action py-1">Bulk Operations</a>
            <a href="#csv-import" class="list-group-item list-group-item-action py-1">Importing from CSV</a>
            <a href="#soft-delete" class="list-group-item list-group-item-action py-1">Deleted Hosts</a>
        </div>
    </div>
</div>

</div>{# /row #}
{% endblock %}
