{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('clearpass_server_index') }}">ClearPass Servers</a></li>
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
            <div class="card-body">
                {{ form_start(form) }}

                {% for field in ['name', 'apiUrl', 'clientId', 'clientSecret', 'description'] %}
                    <div class="mb-3">
                        {{ form_label(form[field], null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form[field], {attr: {class: 'form-control' ~ (form[field].vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form[field]) }}
                        {% if field == 'clientSecret' and server.id %}
                            <div class="form-text">Leave blank to keep the existing secret.</div>
                        {% endif %}
                    </div>
                {% endfor %}

                <div class="mb-3 form-check">
                    {{ form_widget(form.verifyTls, {attr: {class: 'form-check-input'}}) }}
                    {{ form_label(form.verifyTls, null, {label_attr: {class: 'form-check-label'}}) }}
                    {{ form_errors(form.verifyTls) }}
                    <div class="form-text">Disable only for self-signed certificates in test environments.</div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <a href="{{ path('clearpass_server_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
