{% extends 'base.html.twig' %}
{% block title %}API Tokens{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-key me-2"></i>API Tokens</h1>
    <a href="{{ path('api_token_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Token
    </a>
</div>

<p class="text-muted mb-4">
    Tokens allow programmatic access to API endpoints without SAML authentication.
    Send the token in the <code>Authorization: Bearer &lt;token&gt;</code> header.
</p>

{% if tokens is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-key fs-1 d-block mb-3 opacity-25"></i>
            No API tokens yet. <a href="{{ path('api_token_new') }}">Create one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Allowed Endpoints</th>
                        <th>Expires</th>
                        <th>Last Used</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for token in tokens %}
                        <tr class="{{ token.expired ? 'table-warning' }}">
                            <td class="fw-semibold">
                                {{ token.name }}
                                {% if token.expired %}
                                    <span class="badge bg-warning text-dark ms-1">Expired</span>
                                {% endif %}
                            </td>
                            <td>
                                {% for route in token.allowedRoutes %}
                                    <code class="d-block small">{{ route }}</code>
                                {% endfor %}
                            </td>
                            <td class="text-muted small">
                                {{ token.expiresAt ? token.expiresAt|date('Y-m-d') : '—' }}
                            </td>
                            <td class="text-muted small">
                                {{ token.lastUsedAt ? token.lastUsedAt|date('Y-m-d H:i') : 'Never' }}
                            </td>
                            <td class="text-muted small">{{ token.createdAt|date('Y-m-d') }}</td>
                            <td class="text-end">
                                <a href="{{ path('api_token_edit', {id: token.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('api_token_delete', {id: token.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Revoke token \'{{ token.name|e('js') }}\'? Any scripts using it will immediately lose access.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_api_token_' ~ token.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Revoke
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}
