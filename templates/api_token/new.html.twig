{% extends 'base.html.twig' %}
{% block title %}New API Token{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-key me-2"></i>New API Token</h1>
    <a href="{{ path('api_token_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

{{ form_start(form, {attr: {class: 'card'}}) }}
<div class="card-body">
    <div class="mb-3">
        {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
        {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Allowed Endpoints</label>
        <div class="border rounded p-3">
            {% for choice in form.allowedRoutes %}
                <div class="form-check">
                    {{ form_widget(choice, {attr: {class: 'form-check-input'}}) }}
                    {{ form_label(choice, null, {label_attr: {class: 'form-check-label font-monospace small'}}) }}
                </div>
            {% endfor %}
        </div>
        {{ form_errors(form.allowedRoutes) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.expiresAt, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
        {{ form_widget(form.expiresAt, {attr: {class: 'form-control', style: 'max-width:200px'}}) }}
        {{ form_errors(form.expiresAt) }}
        <div class="form-text">{{ form_help(form.expiresAt) }}</div>
    </div>
</div>
<div class="card-footer d-flex justify-content-end gap-2">
    <a href="{{ path('api_token_index') }}" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-key me-1"></i>Generate Token
    </button>
</div>
{{ form_end(form) }}
{% endblock %}
