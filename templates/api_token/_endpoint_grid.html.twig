{# Render the real checkboxes hidden — marks the parent field as rendered so form_end doesn't re-render it #}
<div class="d-none" id="allowedRoutes-container">{{ form_widget(form.allowedRoutes) }}</div>
{{ form_errors(form.allowedRoutes) }}

{# Grid is built by the script below #}
<div id="endpoint-grid-container" class="table-responsive mb-3"></div>

<script>
(function () {
    const groups = [
        { label: 'Buildings',      path: '/api/buildings',       routes: ['api_buildings_index',      'api_buildings_show',      'api_buildings_create',      'api_buildings_update',      'api_buildings_delete'     ] },
        { label: 'DNS Servers',    path: '/api/dns-servers',     routes: ['api_dns_servers_index',    'api_dns_servers_show',    'api_dns_servers_create',    'api_dns_servers_update',    'api_dns_servers_delete'   ], actions: [{ label: 'Push Config',       route: 'api_dns_servers_push'          }] },
        { label: 'DHCP Servers',   path: '/api/dhcp-servers',    routes: ['api_dhcp_servers_index',   'api_dhcp_servers_show',   'api_dhcp_servers_create',   'api_dhcp_servers_update',   'api_dhcp_servers_delete'  ], actions: [{ label: 'Push Config',       route: 'api_dhcp_servers_push'         }] },
        { label: 'Hosts',          path: '/api/hosts',           routes: ['api_hosts_index',          'api_hosts_show',          'api_hosts_create',          'api_hosts_update',          'api_hosts_delete'         ], actions: [{ label: 'Restore Deleted',   route: 'api_hosts_restore'             }] },
        { label: 'Interfaces',     path: '/api/interfaces',      routes: ['api_interfaces_index',     'api_interfaces_show',     'api_interfaces_create',     'api_interfaces_update',     'api_interfaces_delete'    ], actions: [{ label: 'Restore Deleted',   route: 'api_interfaces_restore'        }] },
        { label: 'Interface Names',path: '/api/interface-names', routes: ['api_interface_names_index','api_interface_names_show','api_interface_names_create','api_interface_names_update','api_interface_names_delete'] },
        { label: 'Subnets',        path: '/api/subnets',         routes: ['api_subnets_index',        'api_subnets_show',        'api_subnets_create',        'api_subnets_update',        'api_subnets_delete'       ] },
        { label: 'Address Blocks', path: '/api/address-blocks',  routes: ['api_address_blocks_index', 'api_address_blocks_show', 'api_address_blocks_create', 'api_address_blocks_update', 'api_address_blocks_delete'] },
        { label: 'Domains',        path: '/api/domains',         routes: ['api_domains_index',        'api_domains_show',        'api_domains_create',        'api_domains_update',        'api_domains_delete'       ] },
        { label: 'Domain Records', path: '/api/domain-records',  routes: ['api_domain_records_index', 'api_domain_records_show', 'api_domain_records_create', 'api_domain_records_update', 'api_domain_records_delete'] },
        { label: 'Tags',           path: '/api/tags',            routes: ['api_tags_search',          null,                      'api_tags_create',           null,                        null                       ] },
        { label: 'DHCP Leases',    path: '/api/dhcp/lease',      routes: [null,                       null,                      null,                        null,                        null                       ], actions: [{ label: 'Receive Lease',     route: 'api_dhcp_lease'                }] },
        { label: 'Switches',       path: '/api/switch',          routes: [null,                       null,                      null,                        null,                        null                       ], actions: [
            { label: 'Port Status',        route: 'api_switch_port_status'        },
            { label: 'Bounce Port',        route: 'api_switch_port_bounce'        },
            { label: 'PoE Bounce',         route: 'api_switch_port_poe_bounce'    },
            { label: 'Reauthenticate Port',route: 'api_switch_port_reauthenticate'},
        ]},
    ];
    const colLabels = ['List', 'Detail', 'Create', 'Update', 'Delete'];
    const knownRoutes = new Set(groups.flatMap(g => [
        ...g.routes.filter(Boolean),
        ...(g.actions || []).map(a => a.route),
    ]));

    // Map route name → hidden checkbox
    const hiddenMap = {};
    document.querySelectorAll('#allowedRoutes-container input[type="checkbox"]').forEach(cb => {
        hiddenMap[cb.value] = cb;
    });

    function makeCheck(routeName, extraClass = '') {
        const hidden = hiddenMap[routeName];
        if (!hidden) return null;
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.className = 'form-check-input' + (extraClass ? ' ' + extraClass : '');
        input.dataset.route = routeName;
        input.checked = hidden.checked;
        input.addEventListener('change', () => { hidden.checked = input.checked; });
        return input;
    }

    // ── CRUD grid ────────────────────────────────────────────────────────────
    const table = document.createElement('table');
    table.className = 'table table-bordered table-sm align-middle mb-0';

    const thead = table.createTHead();
    const hRow = thead.insertRow();
    ['Resource', ...colLabels, 'Actions', 'All'].forEach((text, i) => {
        const th = document.createElement('th');
        th.textContent = text;
        if (i > 0) th.className = 'text-center';
        if (text === 'All') th.title = 'Toggle all for this row';
        hRow.appendChild(th);
    });

    const tbody = table.createTBody();
    groups.forEach(group => {
        const row = tbody.insertRow();

        const nameCell = row.insertCell();
        nameCell.innerHTML = `<span class="fw-semibold">${group.label}</span><br><code class="small text-muted fw-normal">${group.path}</code>`;

        const rowChecks = [];
        group.routes.forEach(routeName => {
            const cell = row.insertCell();
            cell.className = 'text-center';
            const check = routeName ? makeCheck(routeName, 'endpoint-check') : null;
            if (check) { cell.appendChild(check); rowChecks.push(check); }
            else        { cell.innerHTML = '<span class="text-body-tertiary">—</span>'; }
        });

        // Actions column
        const actionsCell = row.insertCell();
        actionsCell.className = 'text-center';
        const actions = group.actions || [];
        if (actions.length) {
            const wrap = document.createElement('div');
            wrap.className = 'd-flex flex-column gap-1 align-items-start px-1';
            actions.forEach(({ label, route }) => {
                const check = makeCheck(route, 'endpoint-check');
                if (!check) return;
                rowChecks.push(check);
                const lbl = document.createElement('label');
                lbl.className = 'form-check-label small d-flex align-items-center gap-1 text-nowrap';
                lbl.appendChild(check);
                const span = document.createElement('span');
                span.textContent = label;
                lbl.appendChild(span);
                wrap.appendChild(lbl);
            });
            actionsCell.appendChild(wrap);
        } else {
            actionsCell.innerHTML = '<span class="text-body-tertiary">—</span>';
        }

        // "All" toggle
        const allCell = row.insertCell();
        allCell.className = 'text-center';
        if (rowChecks.length) {
            const allCheck = document.createElement('input');
            allCheck.type = 'checkbox';
            allCheck.className = 'form-check-input';
            allCheck.title = 'Select / deselect all';
            const sync = () => {
                const n = rowChecks.filter(c => c.checked).length;
                allCheck.checked       = n === rowChecks.length;
                allCheck.indeterminate = n > 0 && n < rowChecks.length;
            };
            allCheck.addEventListener('change', () => rowChecks.forEach(c => {
                c.checked = allCheck.checked;
                hiddenMap[c.dataset.route].checked = allCheck.checked;
            }));
            rowChecks.forEach(c => c.addEventListener('change', sync));
            sync();
            allCell.appendChild(allCheck);
        } else {
            allCell.innerHTML = '<span class="text-body-tertiary">—</span>';
        }
    });

    const tableWrap = document.createElement('div');
    tableWrap.className = 'table-responsive mb-3';
    tableWrap.appendChild(table);
    document.getElementById('endpoint-grid-container').appendChild(tableWrap);
})();
</script>
