{% extends 'base.html.twig' %}
{% block title %}Edit Token — {{ token.name }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-key me-2"></i>Edit Token: {{ token.name }}</h1>
    <div class="d-flex gap-2">
        <form method="post" action="{{ path('api_token_regenerate', {id: token.id}) }}"
              onsubmit="return confirm('Regenerate token \'{{ token.name|e('js') }}\'? The current token will stop working immediately.')">
            <input type="hidden" name="_token" value="{{ csrf_token('regenerate_api_token_' ~ token.id) }}">
            <button type="submit" class="btn btn-outline-warning">
                <i class="bi bi-arrow-clockwise me-1"></i>Regenerate Token
            </button>
        </form>
        <a href="{{ path('api_token_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

{{ form_start(form, {attr: {class: 'card mb-3'}}) }}
<div class="card-body">
    <div class="mb-3">
        {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
        {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.allowedCidrs, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
        {{ form_widget(form.allowedCidrs, {attr: {class: 'form-control font-monospace'}}) }}
        {{ form_errors(form.allowedCidrs) }}
        <div class="form-text">{{ form_help(form.allowedCidrs) }}</div>
    </div>

    <div class="mb-3">
        {{ form_label(form.expiresAt, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
        {{ form_widget(form.expiresAt, {attr: {class: 'form-control', style: 'max-width:200px'}}) }}
        {{ form_errors(form.expiresAt) }}
        <div class="form-text">{{ form_help(form.expiresAt) }}</div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Allowed Endpoints</label>
        {% include 'api_token/_endpoint_grid.html.twig' %}
    </div>
</div>
<div class="card-footer d-flex justify-content-end gap-2">
    <a href="{{ path('api_token_index') }}" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>Save Changes
    </button>
</div>
{{ form_end(form) }}
{% endblock %}
