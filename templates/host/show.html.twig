{% extends 'base.html.twig' %}
{% block title %}{{ host.name }}{% endblock %}

{% macro sectionToggle(id, collapsedSections) %}
    {% set isCollapsed = id in collapsedSections %}
    <button type="button" class="btn btn-sm btn-link text-body p-0 section-toggle-btn" data-bs-toggle="collapse"
            data-bs-target="#section-{{ id }}" data-section="{{ id }}"
            aria-expanded="{{ isCollapsed ? 'false' : 'true' }}" aria-controls="section-{{ id }}"
            title="{{ isCollapsed ? 'Expand' : 'Collapse' }} section">
        <i class="bi {{ isCollapsed ? 'bi-chevron-right' : 'bi-chevron-down' }} section-chevron"></i>
    </button>
{% endmacro %}

{# Combines lastAuthAt/lastDhcpAt into one "last seen" value, labeled with which
   of auth (ClearPass), switch scan, or dhcp actually produced it. #}
{% macro lastSeen(lastAuthAt, lastDhcpAt, source, format) %}
    {% set seen = null %}
    {% if lastAuthAt and lastDhcpAt %}
        {% set seen = lastAuthAt > lastDhcpAt ? lastAuthAt : lastDhcpAt %}
    {% elseif lastAuthAt %}
        {% set seen = lastAuthAt %}
    {% elseif lastDhcpAt %}
        {% set seen = lastDhcpAt %}
    {% endif %}
    {% if seen %}
        {{ seen|date(format) }}
        {% if lastAuthAt and seen == lastAuthAt %}
            <br><span class="text-info-emphasis">{{ source == 'live_scan' ? 'switch scan' : 'auth' }}</span>
        {% else %}
            <br><span class="text-success-emphasis">dhcp</span>
        {% endif %}
    {% else %}
        —
    {% endif %}
{% endmacro %}

{% block stylesheets %}
<style>
.host-interfaces-table { --vip-row-bg: rgba(0,0,0,.05); }
[data-bs-theme="dark"] .host-interfaces-table { --vip-row-bg: rgba(255,255,255,.05); }
.host-interfaces-table .vip-row { --bs-table-bg: var(--vip-row-bg); }
.host-interfaces-table .vip-row > td:first-child { padding-left: 2rem !important; }

/* Group hover for multi-device switch ports (JS-managed; !important overrides
   Bootstrap's --bs-table-bg mechanism) — same pattern as the host list's
   host/interface tree table. */
#switch-ports-table { --switch-group-hover: rgba(0,0,0,.1); --switch-row-hover: rgba(0,0,0,.18); }
[data-bs-theme="dark"] #switch-ports-table { --switch-group-hover: rgba(255,255,255,.12); --switch-row-hover: rgba(255,255,255,.22); }
#switch-ports-table .group-hovered > td { background-color: var(--switch-group-hover) !important; }
#switch-ports-table .row-hovered > td   { background-color: var(--switch-row-hover)   !important; }
</style>
{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        <li class="breadcrumb-item active">{{ host.name }}</li>
    </ol>
</nav>

{% if host.deleted %}
<div class="alert alert-warning d-flex align-items-center justify-content-between mb-3" role="alert">
    <div>
        <i class="bi bi-trash me-2"></i>
        <strong>This host was deleted</strong> on {{ host.deletedAt|date('Y-m-d H:i') }}.
        It is excluded from all DNS, DHCP, and ClearPass pushes.
    </div>
    <form method="post" action="{{ path('host_restore', {id: host.id}) }}" class="ms-3 flex-shrink-0">
        <input type="hidden" name="_token" value="{{ csrf_token('restore_host_' ~ host.id) }}">
        <button type="submit" class="btn btn-warning btn-sm text-nowrap">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Restore Host &amp; Interfaces
        </button>
    </form>
</div>
{% endif %}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-pc-display me-2"></i>{{ host.name }}</h1>
        {% if host.location %}
            <p class="text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>{{ host.location }}</p>
        {% endif %}
        {% if host.tags is not empty %}
            <div>
                {% for tag in host.tags %}
                    <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                {% endfor %}
            </div>
        {% endif %}
        {% if host.notes %}
            <p class="text-muted mt-2 mb-0" style="white-space:pre-wrap">{{ host.notes }}</p>
        {% endif %}
        {% if host.duid %}
            <p class="text-muted mt-2 mb-0"><i class="bi bi-key me-1"></i>DUID: <code>{{ host.duidDisplay }}</code></p>
        {% endif %}
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_hosts') }}#interfaces" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('activity_log_index', {host_id: host.id, entity_type: 'Host', entity_name: host.name}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-1"></i>View Logs
        </a>
        {% if not host.deleted %}
        <a href="{{ path('host_edit', {id: host.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('host_delete', {id: host.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete host {{ host.name|e('js') }} and all its interfaces?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_host_' ~ host.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
        {% endif %}
    </div>
</div>

<div class="card mb-3">
    {% set activeInterfaces  = host.interfaces|filter(i => not i.deleted) %}
    {% set deletedInterfaces = host.interfaces|filter(i => i.deleted) %}
    {% set ifacesCollapsed = 'interfaces' in collapsedSections %}
    <div class="card-header d-flex justify-content-between align-items-center section-header-toggle" style="cursor:pointer">
        <span class="d-flex align-items-center gap-2">
            {{ _self.sectionToggle('interfaces', collapsedSections) }}
            <span>
                <i class="bi bi-hdd-network me-1"></i>Interfaces ({{ activeInterfaces|length }}
                {%- if deletedInterfaces|length > 0 %}, <span class="text-warning-emphasis">{{ deletedInterfaces|length }} deleted</span>{% endif %})
            </span>
        </span>
        <div class="d-flex align-items-center gap-2">
            {% if not host.deleted %}
            <a href="{{ path('interface_new', {id: host.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Interface
            </a>
            {% if activeInterfaces|length > 0 %}
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#create-interface-dns-records-panel">
                <i class="bi bi-hdd-network me-1"></i>Create DNS Records
            </button>
            {% endif %}
            {% endif %}
        </div>
    </div>
    <div class="collapse{{ ifacesCollapsed ? '' : ' show' }}" id="section-interfaces">
    {% if not host.deleted and activeInterfaces|length > 0 %}
    <div class="collapse" id="create-interface-dns-records-panel">
        <div class="card-body border-bottom">
            <p class="text-muted small mb-2">
                Creates an A and/or AAAA record (whichever addresses are present) for every named interface on this host, in the domain you choose, with hostname <code>&lt;interface name&gt;.{{ host.name }}</code>. Unnamed interfaces, and interfaces whose name isn't a valid DNS label, are skipped.
            </p>
            <form method="post" action="{{ path('host_create_interface_dns_records', {id: host.id}) }}" class="d-flex align-items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('create_interface_dns_records_' ~ host.id) }}">
                <select name="domain_id" class="form-select form-select-sm" style="max-width:20rem" required>
                    <option value="">-- Select a domain --</option>
                    {% for domain in domains %}
                        <option value="{{ domain.id }}">{{ domain.name }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                    <i class="bi bi-hdd-network me-1"></i>Create Records
                </button>
            </form>
        </div>
    </div>
    {% endif %}
    {% if host.interfaces is empty %}
        <div class="card-body text-center text-muted py-4">
            No interfaces yet. <a href="{{ path('interface_new', {id: host.id}) }}">Add one →</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover mb-0 host-interfaces-table">
                <thead>
                    <tr>
                        <th>Interface</th>
                        <th>Subnet</th>
                        <th>IPv4</th>
                        <th>IPv6</th>
                        <th>DNS Names</th>
                        <th>Last Seen</th>
                        <th>Last Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for iface in host.interfaces %}
                        <tr class="{{ iface.deleted ? 'row-deleted' : '' }}">
                            <td class="small">
                                <a href="{{ path('interface_show', {id: iface.id}) }}" class="text-decoration-none">
                                    {% if iface.name %}
                                        <div class="fw-semibold">{{ iface.name }}</div>
                                    {% endif %}
                                    {% set vendor = mac_vendor(iface.macAddress) %}
                                    <div class="font-monospace text-muted"{% if vendor %} title="{{ vendor }}"{% endif %}>{{ iface.macAddress }}</div>
                                </a>
                                {% if iface.deleted %}
                                    <span class="badge text-bg-warning mt-1">Deleted {{ iface.deletedAt|date('Y-m-d') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ iface.subnet ? iface.subnet.name : '—' }}</td>
                            <td class="ip-address">
                                {% if iface.ipAddress %}
                                    {{ iface.ipAddress.address }}
                                    {% if iface.lastDhcpIp and iface.lastDhcpIp != iface.ipAddress.address %}
                                        <span class="text-muted">({{ iface.lastDhcpIp }})</span>
                                    {% endif %}
                                {% elseif iface.lastDhcpIp %}
                                    <span class="text-muted">({{ iface.lastDhcpIp }})</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="ip-address small">{{ iface.ipv6Address ? iface.ipv6Address.address : '—' }}</td>
                            <td class="font-monospace">
                                {% set fqdn_types = {} %}
                                {% for record in iface.domainRecords %}
                                    {% if record.domain and record.type.value in ['A', 'AAAA'] %}
                                        {% set fqdn = record.fullyQualifiedHostname %}
                                        {% set t = record.type.value %}
                                        {% if fqdn_types[fqdn] is defined %}
                                            {% set fqdn_types = fqdn_types|merge({(fqdn): fqdn_types[fqdn]|merge([t])}) %}
                                        {% else %}
                                            {% set fqdn_types = fqdn_types|merge({(fqdn): [t]}) %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                                {% if fqdn_types is empty %}
                                    <span class="text-muted">—</span>
                                {% else %}
                                    {% for fqdn, types in fqdn_types %}
                                        {% set has_a    = 'A'    in types %}
                                        {% set has_aaaa = 'AAAA' in types %}
                                        <div class="d-flex align-items-center" style="max-width:14rem">
                                            {% if has_a and has_aaaa %}
                                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0" style="border-radius:0.375rem 0 0 0.375rem;border-right-width:0">A</span><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1" style="border-radius:0 0.375rem 0.375rem 0;border-left-width:0">AAAA</span>
                                            {% elseif has_a %}
                                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0 me-1">A</span>
                                            {% elseif has_aaaa %}
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1">AAAA</span>
                                            {% endif %}
                                            <span class="text-truncate" style="min-width:0" title="{{ fqdn }}">{{ fqdn }}</span>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </td>
                            <td class="text-muted small">
                                {{ _self.lastSeen(iface.lastAuthAt, iface.lastDhcpAt, lastSeenSources[iface.id]|default(null), 'Y-m-d') }}
                            </td>
                            <td class="text-muted small">
                                {{ iface.updatedAt|date('Y-m-d H:i') }}
                                {% if iface.updatedBy %}<br>{{ iface.updatedBy }}{% endif %}
                            </td>
                            <td class="text-end">
                                {% if iface.deleted %}
                                    <form method="post" action="{{ path('interface_restore', {id: iface.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('restore_interface_' ~ iface.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                {% else %}
                                    <a href="{{ path('interface_edit', {id: iface.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('interface_delete', {id: iface.id}) }}" class="d-inline"
                                          onsubmit="return confirm({% if activeInterfaces|length == 1 %}'Delete this interface? It is the only active interface on {{ host.name|e('js') }}, so the host will also be deleted.'{% else %}'Delete this interface from {{ host.name|e('js') }}?'{% endif %})">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_interface_' ~ iface.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% for vip in vip_map[iface.id] ?? [] %}
                            <tr class="vip-row">
                                <td class="small">
                                    <i class="bi bi-layers text-muted me-1"></i>
                                    <a href="{{ path('virtual_ip_show', {id: vip.id, from: 'interface', interfaceId: iface.id}) }}" class="text-decoration-none">{{ vip.label }}</a>
                                    <div>
                                        <span class="badge bg-secondary">{{ vip.protocol.label() }}</span>
                                        {% if vip.vrid %}<span class="text-muted small ms-1">VRID&nbsp;{{ vip.vrid }}</span>{% endif %}
                                    </div>
                                </td>
                                <td>{{ vip.subnet ? vip.subnet.name : '—' }}</td>
                                <td class="ip-address">{{ vip.ipAddress ? vip.ipAddress.address : '—' }}</td>
                                <td class="ip-address small">{{ vip.ipv6Address ? vip.ipv6Address.address : '—' }}</td>
                                <td class="font-monospace">
                                    {% set fqdn_types = {} %}
                                    {% for record in vip.domainRecords %}
                                        {% if record.domain and record.type.value in ['A', 'AAAA'] %}
                                            {% set fqdn = record.fullyQualifiedHostname %}
                                            {% set t = record.type.value %}
                                            {% if fqdn_types[fqdn] is defined %}
                                                {% set fqdn_types = fqdn_types|merge({(fqdn): fqdn_types[fqdn]|merge([t])}) %}
                                            {% else %}
                                                {% set fqdn_types = fqdn_types|merge({(fqdn): [t]}) %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if fqdn_types is empty %}
                                        <span class="text-muted">—</span>
                                    {% else %}
                                        {% for fqdn, types in fqdn_types %}
                                            {% set has_a    = 'A'    in types %}
                                            {% set has_aaaa = 'AAAA' in types %}
                                            <div class="d-flex align-items-center" style="max-width:14rem">
                                                {% if has_a and has_aaaa %}
                                                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0" style="border-radius:0.375rem 0 0 0.375rem;border-right-width:0">A</span><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1" style="border-radius:0 0.375rem 0.375rem 0;border-left-width:0">AAAA</span>
                                                {% elseif has_a %}
                                                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0 me-1">A</span>
                                                {% elseif has_aaaa %}
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1">AAAA</span>
                                                {% endif %}
                                                <span class="text-truncate" style="min-width:0" title="{{ fqdn }}">{{ fqdn }}</span>
                                            </div>
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                <td class="text-muted small">—</td>
                                <td class="text-muted small">
                                    {{ vip.updatedAt|date('Y-m-d H:i') }}
                                    {% if vip.updatedBy %}<br>{{ vip.updatedBy }}{% endif %}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('virtual_ip_edit', {id: vip.id, from: 'interface', interfaceId: iface.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('virtual_ip_remove_member', {id: vip.id, interfaceId: iface.id}) }}" class="d-inline"
                                          onsubmit="return confirm('Remove this interface from {{ vip.label|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remove_member_' ~ vip.id ~ '_' ~ iface.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-warning me-1" title="Unlink from this VIP">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('virtual_ip_delete', {id: vip.id}) }}" class="d-inline"
                                          onsubmit="return confirm('Delete {{ vip.label|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_vip_' ~ vip.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete this VIP">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    </div>
</div>

{% if switchPorts is not empty %}
<div class="card mb-3">
    {% set switchPortsCollapsed = 'switch-ports' in collapsedSections %}
    <div class="card-header d-flex align-items-center gap-2 section-header-toggle" style="cursor:pointer">
        {{ _self.sectionToggle('switch-ports', collapsedSections) }}
        <span><i class="bi bi-diagram-3 me-1"></i>Switch Ports ({{ switchPorts|length }})</span>
    </div>
    <div class="collapse{{ switchPortsCollapsed ? '' : ' show' }}" id="section-switch-ports">
    <div class="card-body py-2 text-muted small border-bottom">
        Reflects each connected device's last known ClearPass authentication, refreshed roughly every 15 minutes.
        {% if switchInfoMaxAgeDays %}
            Devices not seen in over {{ switchInfoMaxAgeDays }} day{{ switchInfoMaxAgeDays != 1 ? 's' : '' }} are hidden.
        {% else %}
            Only devices actively authenticating through this switch are shown.
        {% endif %}
    </div>
    {% if arubaSwitch %}
    <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom flex-wrap">
        <button type="button" class="btn btn-sm btn-outline-primary" id="switch-scan-btn" data-switch-ip="{{ switchTargetIp }}">
            <i class="bi bi-search me-1"></i>Query Switch
        </button>
        <span class="text-muted small" id="switch-scan-status">Last scanned: never</span>
        <span class="text-muted small" id="switch-ports-selected-count">0 selected</span>
        <div class="d-flex gap-2 ms-auto">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="bulk-status-btn" disabled>
                <i class="bi bi-arrow-clockwise me-1"></i>Check Status
            </button>
            <button type="button" class="btn btn-sm btn-outline-info" id="bulk-reauth-btn" disabled>
                <i class="bi bi-shield-check me-1"></i>Reauthenticate
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning" id="bulk-bounce-btn" disabled>
                <i class="bi bi-power me-1"></i>Bounce Port
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning" id="bulk-poe-bounce-btn" disabled>
                <i class="bi bi-lightning me-1"></i>PoE Bounce
            </button>
        </div>
    </div>
    {% endif %}
    <div id="switch-scan-alert"></div>
    <div id="switch-scan-raw"></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="switch-ports-table">
            <thead>
                <tr>
                    {% if arubaSwitch %}
                    <th style="width:2rem">
                        <input type="checkbox" class="form-check-input" id="switch-ports-select-all" title="Select all">
                    </th>
                    {% endif %}
                    <th>Port</th>
                    {% if arubaSwitch %}
                    <th>Live Status</th>
                    {% endif %}
                    <th>Connected Device</th>
                    {% if arubaSwitch %}
                    <th>Live MAC(s)</th>
                    <th>Applied Policy</th>
                    <th>LLDP Neighbor</th>
                    <th>Discrepancies</th>
                    <th>Last Seen</th>
                    <th class="text-end">Actions</th>
                    {% else %}
                    <th>Last Seen</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for port, ifaces in switchPorts %}
                    {% set detailsId = 'port-details-' ~ loop.index0 %}
                    {% set primaryIface = ifaces[0] %}
                    {% set deviceLabel = ifaces|length > 1 ? (ifaces|length ~ ' devices') : (primaryIface.host ? primaryIface.host.name : primaryIface.macAddress) %}
                    <tr>
                        {% if arubaSwitch %}
                        <td>
                            <input type="checkbox" class="form-check-input switch-port-checkbox"
                                   data-mac="{{ primaryIface.macAddress }}" data-target="{{ detailsId }}"
                                   data-label="{{ (port ~ ' (' ~ deviceLabel ~ ')')|e('html_attr') }}">
                        </td>
                        {% endif %}
                        <td class="font-monospace">{{ port }}</td>
                        {% if arubaSwitch %}
                        <td class="text-muted small">—</td>
                        {% endif %}
                        <td class="small">
                            {% for iface in ifaces %}
                                <a href="{{ path('interface_show', {id: iface.id}) }}" class="text-decoration-none d-block{% if not loop.last %} mb-1{% endif %}">
                                    {% if iface.host %}
                                        <div class="fw-semibold">{{ iface.host.name }}{% if iface.name %} &middot; {{ iface.name }}{% endif %}</div>
                                    {% endif %}
                                    {% set vendor = mac_vendor(iface.macAddress) %}
                                    <div class="font-monospace text-muted"{% if vendor %} title="{{ vendor }}"{% endif %}>{{ iface.macAddress }}</div>
                                </a>
                            {% endfor %}
                        </td>
                        {% set lastSeenCell %}{{ _self.lastSeen(primaryIface.lastAuthAt, primaryIface.lastDhcpAt, lastSeenSources[primaryIface.id]|default(null), 'Y-m-d H:i') }}{% endset %}
                        {% if arubaSwitch %}
                        <td class="text-muted small">—</td>
                        <td class="text-muted small">—</td>
                        <td class="text-muted small">—</td>
                        <td class="text-muted small">—</td>
                        <td class="text-muted small">{{ lastSeenCell }}</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary port-status-btn" data-mac="{{ primaryIface.macAddress }}" data-target="{{ detailsId }}" title="Check Status">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info port-reauth-btn" data-mac="{{ primaryIface.macAddress }}" data-target="{{ detailsId }}"
                                    data-confirm="Reauthenticate port {{ port|e('js') }} ({{ deviceLabel|e('js') }})?" title="Reauthenticate">
                                <i class="bi bi-shield-check"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning port-bounce-btn" data-mac="{{ primaryIface.macAddress }}" data-target="{{ detailsId }}"
                                    data-confirm="Bounce port {{ port|e('js') }} ({{ deviceLabel|e('js') }})? This will briefly disconnect {{ ifaces|length > 1 ? 'its connected clients' : 'the client' }}." title="Bounce Port">
                                <i class="bi bi-power"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning port-poe-bounce-btn" data-mac="{{ primaryIface.macAddress }}" data-target="{{ detailsId }}"
                                    data-confirm="PoE bounce port {{ port|e('js') }} ({{ deviceLabel|e('js') }})? This will cut power and disconnect {{ ifaces|length > 1 ? 'its connected clients' : 'the client' }}." title="PoE Bounce">
                                <i class="bi bi-lightning"></i>
                            </button>
                        </td>
                        {% else %}
                        <td class="text-muted small">{{ lastSeenCell }}</td>
                        {% endif %}
                    </tr>
                    {% if arubaSwitch %}
                    <tr id="{{ detailsId }}" class="d-none">
                        <td colspan="10" class="p-0">
                            <div id="{{ detailsId }}-body" class="p-2 text-muted small">
                                Click an action button above to load live port-access data from the switch.
                            </div>
                        </td>
                    </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    </div>
</div>
{% endif %}

