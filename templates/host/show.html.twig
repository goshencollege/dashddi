    </div>
    <div class="collapse{{ sshKeysCollapsed ? '' : ' show' }}" id="section-ssh-host-keys">
    <div class="card-body py-2">
        {% if host.sshHostKeys|length > 0 %}
        <table class="table table-sm table-borderless mb-2 small">
            <thead class="text-muted">
                <tr>
                    <th>Algorithm</th>
                    <th>Fingerprint (SHA-256)</th>
                    {% if not host.deleted %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody class="font-monospace">
                {% for key in host.sshHostKeys %}
                <tr>
                    <td class="text-nowrap pe-3">{{ key.algorithm }}</td>
                    <td>{{ key.fingerprint }}</td>
                    {% if not host.deleted %}
                    <td class="text-end">
                        <form method="post" action="{{ path('host_delete_ssh_host_key', {id: host.id, keyId: key.id}) }}"
                              onsubmit="return confirm('Remove the {{ key.algorithm }} host key?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_ssh_host_key_' ~ key.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="text-muted small mb-2">No SSH host keys stored yet. Keys are learned automatically on first connection, or you can add them manually below.</p>
        {% endif %}
        {% if not host.deleted %}
        {% set scan_targets = [] %}
        {% for iface in host.interfaces %}
            {% if not iface.deleted %}
                {% if iface.ipAddress is not null %}
                    {% set scan_targets = scan_targets|merge([{label: (iface.primaryName ~ ' – ' ~ iface.ipAddress.address), ip: iface.ipAddress.address}]) %}
                {% endif %}
                {% if iface.ipv6Address is not null %}
                    {% set scan_targets = scan_targets|merge([{label: (iface.primaryName ~ ' – ' ~ iface.ipv6Address.address), ip: iface.ipv6Address.address}]) %}
                {% endif %}
            {% endif %}
        {% endfor %}
        <form method="post" action="{{ path('host_scan_ssh_host_keys', {id: host.id}) }}" class="mb-2">
            <input type="hidden" name="_token" value="{{ csrf_token('scan_ssh_host_keys_' ~ host.id) }}">
            {% if scan_targets|length == 0 %}
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                <i class="bi bi-radar me-1"></i>Scan with ssh-keyscan
            </button>
            <span class="text-muted small ms-1">No IP addresses on this host.</span>
            {% elseif scan_targets|length == 1 %}
            <input type="hidden" name="scan_target" value="{{ scan_targets[0].ip }}">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-radar me-1"></i>Scan {{ scan_targets[0].ip }}
            </button>
            {% else %}
            <div class="input-group input-group-sm" style="max-width:32rem;">
                <select name="scan_target" class="form-select form-select-sm">
                    {% for t in scan_targets %}
                    <option value="{{ t.ip }}">{{ t.label }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-radar me-1"></i>Scan
                </button>
            </div>
            {% endif %}
        </form>
        <details>
            <summary class="small text-secondary" style="cursor:pointer;">Add / replace keys manually</summary>
            <form method="post" action="{{ path('host_add_ssh_host_keys', {id: host.id}) }}" class="mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('add_ssh_host_keys_' ~ host.id) }}">
                <textarea name="ssh_host_public_key" class="form-control form-control-sm font-monospace mb-1" rows="4"
                          placeholder="Paste one or more public host keys — bare key lines or ssh-keyscan output accepted:&#10;ssh-ed25519 AAAA...&#10;ecdsa-sha2-nistp256 AAAA..."></textarea>
                <div class="form-text small mb-2">Accepts output from <code>ssh-keyscan hostname</code> or the contents of <code>/etc/ssh/ssh_host_*_key.pub</code>. Existing keys for the same algorithm are replaced.</div>
                <button type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-floppy me-1"></i>Save keys
                </button>
            </form>
        </details>
        {% endif %}
    </div>
    </div>
</div>
{% endif %}

