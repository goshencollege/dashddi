{% block scripts %}
<script>
(function () {
    const collapsedUrl = {{ path('api_preference_host_collapsed_sections')|json_encode|raw }};

    function save(section, collapsed) {
        fetch(collapsedUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ section: section, collapsed: collapsed }),
        }).catch(() => {});
    }

    document.querySelectorAll('.section-toggle-btn[data-section]').forEach(function (btn) {
        const target  = document.getElementById(btn.getAttribute('data-bs-target').slice(1));
        const chevron = btn.querySelector('.section-chevron');
        if (!target) return;

        // Swap the chevron glyph directly on click, the same way the host list's
        // tree view toggles its chevron — every click on this button always
        // toggles the section exactly once, so flipping the icon class here in
        // lockstep with the click needs no dependency on Bootstrap's own
        // collapse events to keep it in sync.
        if (chevron) {
            btn.addEventListener('click', function () {
                chevron.classList.toggle('bi-chevron-down');
                chevron.classList.toggle('bi-chevron-right');
            });
        }

        target.addEventListener('shown.bs.collapse', function (e) {
            if (e.target === target) save(btn.dataset.section, false);
        });
        target.addEventListener('hidden.bs.collapse', function (e) {
            if (e.target === target) save(btn.dataset.section, true);
        });
    });

    // Clicking anywhere in a section header toggles it, except on other interactive
    // controls (links/buttons) it contains — those keep their own behavior untouched.
    // Delegates to the chevron button's own click rather than toggling the collapse
    // directly, since Bootstrap's collapse data-api listens in the capture phase on
    // document: putting data-bs-toggle on the header itself would let it intercept
    // and preventDefault() clicks on nested links (e.g. "Add Interface") before any
    // bubble-phase handler here could stop it.
    document.querySelectorAll('.section-header-toggle').forEach(function (header) {
        const btn = header.querySelector('.section-toggle-btn');
        if (!btn) return;

        header.addEventListener('click', function (e) {
            if (btn.contains(e.target)) return;
            const interactive = e.target.closest('a, button, input, select, textarea, label');
            if (interactive && interactive !== header) return;
            btn.click();
        });
    });
})();
</script>
{% if switchPorts is not empty and arubaSwitch %}
<script>
(function () {
    const statusUrl    = {{ path('api_switch_port_status')|json_encode|raw }};
    const reauthUrl    = {{ path('api_switch_port_reauthenticate')|json_encode|raw }};
    const bounceUrl    = {{ path('api_switch_port_bounce')|json_encode|raw }};
    const poeBounceUrl = {{ path('api_switch_port_poe_bounce')|json_encode|raw }};
    const scanUrl      = {{ path('api_switch_scan')|json_encode|raw }};
    const ifaceUrlTpl  = {{ path('interface_show', {id: 0})|json_encode|raw }};

    const table  = document.getElementById('switch-ports-table');
    const tbody  = table.querySelector('tbody');

    // Group hover — a port's sub-rows (one per live device, plus the spacer row
    // that carries the port-level cells) all highlight together, the same
    // pattern used for host/interface rows on the host list page. Delegated on
    // the table itself so it keeps working after tbody is replaced wholesale on
    // every scan re-render.
    let hoveredPortGroup = null;
    table.addEventListener('mouseover', function (e) {
        const row = e.target.closest('tr.switch-port-row');
        if (!row) return;
        const id = row.dataset.portGroup;
        if (!id) return;

        if (id !== hoveredPortGroup) {
            table.querySelectorAll('.group-hovered, .row-hovered')
                .forEach(r => r.classList.remove('group-hovered', 'row-hovered'));
            table.querySelectorAll(`.switch-port-row[data-port-group="${id}"]`)
                .forEach(r => r.classList.add('group-hovered'));
            hoveredPortGroup = id;
        }

        table.querySelectorAll('.row-hovered')
            .forEach(r => { r.classList.remove('row-hovered'); r.classList.add('group-hovered'); });
        row.classList.replace('group-hovered', 'row-hovered');
    });

    table.addEventListener('mouseleave', function () {
        table.querySelectorAll('.group-hovered, .row-hovered')
            .forEach(r => r.classList.remove('group-hovered', 'row-hovered'));
        hoveredPortGroup = null;
    });

    // Escape HTML entities in any string sourced from API responses.
    function esc(s) { const d = document.createElement('div'); d.textContent = String(s ?? ''); return d.innerHTML; }
    function escAttr(s) { return esc(s).replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
    function ifaceUrl(id) { return ifaceUrlTpl.replace(/\/0$/, '/' + id); }

    function renderClients(data) {
        if (data.error) {
            return `<div class="alert alert-danger mb-0 py-2">${esc(data.error)}</div>`;
        }
        const rawId = 'raw-' + Math.random().toString(36).slice(2);
        let rawContent = data.raw || '';
        try { rawContent = JSON.stringify(JSON.parse(rawContent), null, 2); } catch (e) { /* plain text */ }
        const rawPanel = rawContent ? `
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">Source: ${esc(data.via)}</span>
                <button class="btn btn-link btn-sm p-0 text-muted small" onclick="document.getElementById('${rawId}').classList.toggle('d-none')">raw</button>
            </div>
            <div id="${rawId}" class="d-none mt-1 alert alert-success p-0"><pre class="mb-0 p-2 small" style="max-height:200px;overflow:auto">${esc(rawContent)}</pre></div>` : `<span class="text-muted small">Source: ${esc(data.via)}</span>`;
        if (!data.clients || data.clients.length === 0) {
            return `<div><span class="text-muted">No port-access clients found on this port.</span></div>${rawPanel}`;
        }
        const rows = data.clients.map(c => `
            <tr>
                <td class="font-monospace">${esc(c.mac ?? '—')}</td>
                <td>${esc(c.vlan ?? '—')}</td>
                <td>${esc(c.role ?? '—')}</td>
                <td>${esc(c.status ?? '—')}</td>
                <td>${esc(c.auth_method ?? '—')}</td>
            </tr>`).join('');
        return `<div class="table-responsive mb-1">
            <table class="table table-sm mb-0">
                <thead><tr>
                    <th>MAC</th><th>VLAN</th><th>Role</th><th>Status</th><th>Auth Method</th>
                </tr></thead>
                <tbody>${rows}</tbody>
            </table>
        </div>
        ${rawPanel}`;
    }

    function showBody(targetId) {
        const row = document.getElementById(targetId);
        row.classList.remove('d-none');
        return document.getElementById(targetId + '-body');
    }

    // Fetches and renders live port-access data for one MAC into its details row.
    // Returns a promise resolving to the response data (rejects on error, after rendering it).
    function checkStatus(mac, target) {
        const body = showBody(target);
        body.innerHTML = '<span class="text-muted">Loading…</span>';

        return fetch(statusUrl + '?mac=' + encodeURIComponent(mac))
            .then(r => {
                if (!r.ok) {
                    if (r.status === 401 || r.status === 403) throw new Error('Session expired — please reload the page and try again.');
                    throw new Error(`Server returned ${r.status} ${r.statusText}. Check the switch connection and server logs.`);
                }
                return r.json();
            })
            .then(data => { body.innerHTML = renderClients(data); return data; })
            .catch(err => {
                const msg = err instanceof SyntaxError ? 'Unexpected response from server — the switch may be unreachable or the session may have expired. Please reload the page.' : err.message;
                body.innerHTML = `<div class="alert alert-danger mb-0 py-2">${msg}</div>`;
                throw err;
            });
    }

    // Posts a port action (reauth/bounce/poe-bounce) for one MAC and renders the result into its details row.
    // Returns a promise resolving to {success, error, output} (never rejects — network/HTTP errors resolve as a failure).
    function runAction(url, mac, target, busyLabel, successMsg) {
        const body = showBody(target);
        body.innerHTML = `<span class="text-muted">${busyLabel}…</span>`;

        return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mac }) })
            .then(r => {
                if (!r.ok) {
                    if (r.status === 401 || r.status === 403) throw new Error('Session expired — please reload the page and try again.');
                    throw new Error(`Server returned ${r.status} ${r.statusText}. Check the switch connection and server logs.`);
                }
                return r.json();
            })
            .then(data => {
                const out = data.output ? `<pre class="mt-2 mb-0 p-2 border rounded small" style="max-height:120px;overflow:auto">${esc(data.output)}</pre>` : '';
                body.innerHTML = data.success
                    ? `<div class="alert alert-success mb-0 py-2"><i class="bi bi-check-lg me-1"></i>${successMsg}${out}</div>`
                    : `<div class="alert alert-danger mb-0 py-2">Failed: ${esc(data.error)}${out}</div>`;
                return data;
            })
            .catch(err => {
                const msg = err instanceof SyntaxError ? 'Unexpected response from server — the switch may be unreachable or the session may have expired. Please reload the page.' : err.message;
                body.innerHTML = `<div class="alert alert-danger mb-0 py-2">${msg}</div>`;
                return { success: false, error: msg, output: null };
            });
    }

    // ── Single-row actions (event delegation — works for rows rendered after a scan too) ──
    const actionButtons = [
        { selector: '.port-status-btn',    kind: 'status' },
        { selector: '.port-reauth-btn',    kind: 'reauth', url: reauthUrl,    busyLabel: 'Reauthenticating', successMsg: 'Reauthentication triggered.' },
        { selector: '.port-bounce-btn',    kind: 'bounce', url: bounceUrl,    busyLabel: 'Bouncing',          successMsg: 'Port bounced successfully.' },
        { selector: '.port-poe-bounce-btn',kind: 'poe',    url: poeBounceUrl, busyLabel: 'PoE bouncing',      successMsg: 'PoE bounce complete.' },
    ];

    tbody.addEventListener('click', function (e) {
        for (const a of actionButtons) {
            const btn = e.target.closest(a.selector);
            if (!btn) continue;
            if (btn.dataset.confirm && !confirm(btn.dataset.confirm)) return;

            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            const done = () => { btn.disabled = false; btn.innerHTML = orig; };

            if (a.kind === 'status') {
                checkStatus(btn.dataset.mac, btn.dataset.target).catch(() => {}).finally(done);
            } else {
                runAction(a.url, btn.dataset.mac, btn.dataset.target, a.busyLabel, a.successMsg).finally(done);
            }
            return;
        }

        const toggle = e.target.closest('.live-macs-toggle');
        if (toggle) {
            const body = showBody(toggle.dataset.target);
            body.innerHTML = renderLiveMacsTable(JSON.parse(toggle.dataset.macs));
        }
    });

    // ── Bulk actions ─────────────────────────────────────────────────────────
    const selectAll  = document.getElementById('switch-ports-select-all');
    const countLabel = document.getElementById('switch-ports-selected-count');
    const bulkButtons = {
        status:    document.getElementById('bulk-status-btn'),
        reauth:    document.getElementById('bulk-reauth-btn'),
        bounce:    document.getElementById('bulk-bounce-btn'),
        poeBounce: document.getElementById('bulk-poe-bounce-btn'),
    };

    // Rows are rebuilt after each scan, so checkboxes are always re-queried live
    // rather than cached in an array.
    function checkboxes() { return Array.from(tbody.querySelectorAll('.switch-port-checkbox')); }
    function selectedCheckboxes() { return checkboxes().filter(cb => cb.checked); }

    // Re-enables/disables the bulk buttons and the select-all checkbox based on the
    // current selection, without touching the count label (bulk runs overwrite it
    // with a progress/summary message while in flight).
    function refreshBulkButtons() {
        const all = checkboxes();
        const n   = all.filter(cb => cb.checked).length;
        Object.values(bulkButtons).forEach(btn => { btn.disabled = n === 0; });
        if (selectAll) {
            selectAll.checked = n > 0 && n === all.length;
            selectAll.indeterminate = n > 0 && n < all.length;
        }
        return n;
    }

    function updateSelectionUI() {
        const n = refreshBulkButtons();
        countLabel.textContent = n === 0 ? '0 selected' : (n + ' selected');
    }

    tbody.addEventListener('change', function (e) {
        if (e.target.matches('.switch-port-checkbox')) updateSelectionUI();
    });
    if (selectAll) {
        selectAll.addEventListener('click', function () {
            checkboxes().forEach(cb => { cb.checked = selectAll.checked; });
            updateSelectionUI();
        });
    }

    // Shift-click a checkbox to toggle every port between it and the last one clicked.
    let lastCheckedCb = null;
    document.addEventListener('click', function (e) {
        const cb = e.target;
        if (!cb.matches('.switch-port-checkbox')) return;

        if (e.shiftKey && lastCheckedCb) {
            const all = checkboxes();
            const a = all.indexOf(lastCheckedCb);
            const b = all.indexOf(cb);
            if (a !== -1 && b !== -1) {
                const [lo, hi] = a < b ? [a, b] : [b, a];
                all.slice(lo, hi + 1).forEach(box => { box.checked = cb.checked; });
                updateSelectionUI();
            }
        }

        lastCheckedCb = cb;
    });

    // Runs `work` for each selected port, one at a time (a switch only tolerates so many
    // concurrent SSH/REST sessions), updating the count label with progress and a final
    // succeeded/failed summary. `work` must resolve to {success} rather than reject.
    async function runBulk(confirmMessage, work) {
        const selected = selectedCheckboxes();
        if (selected.length === 0) return;
        if (confirmMessage && !confirm(confirmMessage(selected.length))) return;

        checkboxes().forEach(cb => { cb.disabled = true; });
        Object.values(bulkButtons).forEach(btn => { btn.disabled = true; });
        if (selectAll) selectAll.disabled = true;

        let succeeded = 0, failed = 0;
        for (let i = 0; i < selected.length; i++) {
            countLabel.textContent = `Running on port ${i + 1} of ${selected.length}…`;
            const result = await work(selected[i].dataset.mac, selected[i].dataset.target);
            (result && result.success === false) ? failed++ : succeeded++;
        }

        checkboxes().forEach(cb => { cb.disabled = false; });
        if (selectAll) selectAll.disabled = false;
        refreshBulkButtons();
        countLabel.textContent = failed > 0
            ? `Done: ${succeeded} succeeded, ${failed} failed.`
            : `Done: ${succeeded} succeeded.`;
    }

    bulkButtons.status.addEventListener('click', () => runBulk(
        null,
        (mac, target) => checkStatus(mac, target).catch(() => ({ success: false })),
    ));
    bulkButtons.reauth.addEventListener('click', () => runBulk(
        n => `Reauthenticate ${n} selected port${n !== 1 ? 's' : ''}?`,
        (mac, target) => runAction(reauthUrl, mac, target, 'Reauthenticating', 'Reauthentication triggered.'),
    ));
    bulkButtons.bounce.addEventListener('click', () => runBulk(
        n => `Bounce ${n} selected port${n !== 1 ? 's' : ''}? This will briefly disconnect each client.`,
        (mac, target) => runAction(bounceUrl, mac, target, 'Bouncing', 'Port bounced successfully.'),
    ));
    bulkButtons.poeBounce.addEventListener('click', () => runBulk(
        n => `PoE bounce ${n} selected port${n !== 1 ? 's' : ''}? This will cut power and disconnect each client.`,
        (mac, target) => runAction(poeBounceUrl, mac, target, 'PoE bouncing', 'PoE bounce complete.'),
    ));

    // ── Query Switch (live scan + correlation) ──────────────────────────────
    function renderLiveMacsTable(macs) {
        if (!macs.length) return '<span class="text-muted">No live MAC/client entries on this port.</span>';
        const rows = macs.map(m => `
            <tr>
                <td class="font-monospace">${esc(m.mac)}</td>
                <td>${m.known ? `<a href="${ifaceUrl(m.interfaceId)}">${esc(m.hostName ?? m.interfaceName ?? 'known device')}</a>` : '<span class="text-muted">unregistered</span>'}</td>
                <td>${esc(m.role ?? '—')}</td>
                <td>${esc(m.status ?? '—')}</td>
                <td>${esc(m.authMethod ?? '—')}</td>
            </tr>`).join('');
        return `<div class="table-responsive mb-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>MAC</th><th>Device</th><th>Role</th><th>Status</th><th>Auth Method</th></tr></thead>
                <tbody>${rows}</tbody>
            </table>
        </div>`;
    }

    function renderConnectedDevice(port) {
        if (port.cached.length > 0) {
            return port.cached.map(c => `
                <a href="${ifaceUrl(c.interfaceId)}" class="text-decoration-none d-block mb-1">
                    ${c.hostName ? `<div class="fw-semibold">${esc(c.hostName)}${c.name ? ' &middot; ' + esc(c.name) : ''}</div>` : ''}
                    <div class="font-monospace text-muted">${esc(c.mac)}</div>
                </a>`).join('');
        }
        const knownLive = port.live.macs.find(m => m.known);
        if (knownLive) {
            return `<a href="${ifaceUrl(knownLive.interfaceId)}" class="text-decoration-none d-block">
                <div class="fw-semibold">${esc(knownLive.hostName ?? knownLive.interfaceName)} <span class="badge bg-info-subtle text-info-emphasis">new</span></div>
                <div class="font-monospace text-muted">${esc(knownLive.mac)}</div>
            </a>`;
        }
        if (port.live.macs.length > 0) {
            return '<span class="text-muted">Unregistered device(s)</span>';
        }
        return '<span class="text-muted">—</span>';
    }

    // Mirrors the `lastSeen` Twig macro at the top of this file: combines
    // lastAuthAt/lastDhcpAt into one "last seen" value, labeled with whichever of
    // auth (ClearPass), switch scan, or dhcp actually produced it.
    function renderLastSeen(port) {
        const c = port.cached[0];
        if (!c) return '—';

        const authAt = c.lastAuthAt ? new Date(c.lastAuthAt) : null;
        const dhcpAt = c.lastDhcpAt ? new Date(c.lastDhcpAt) : null;
        const seen = authAt && dhcpAt ? (authAt > dhcpAt ? authAt : dhcpAt) : (authAt || dhcpAt);
        if (!seen) return '—';

        const formatted = seen.toISOString().slice(0, 16).replace('T', ' ');
        const isAuth = authAt !== null && seen.getTime() === authAt.getTime();
        const label = isAuth ? (c.lastSeenSource === 'live_scan' ? 'switch scan' : 'auth') : 'dhcp';
        const cls   = isAuth ? 'text-info-emphasis' : 'text-success-emphasis';
        return `${formatted}<br><span class="${cls}">${label}</span>`;
    }

    function renderLiveStatus(live) {
        if (live.status === null && live.speed === null) return '<span class="text-muted">—</span>';
        const s = (live.status ?? '').toLowerCase();
        const cls = s.includes('up') ? 'success' : (s.includes('down') ? 'secondary' : 'warning');
        return `<span class="badge bg-${cls}-subtle text-${cls}-emphasis">${esc(live.status ?? 'unknown')}</span>` +
            (live.speed ? `<div class="text-muted small">${esc(live.speed)}</div>` : '');
    }

    function renderLiveMacs(port, detailsId) {
        if (port.live.macs.length === 0) return '<span class="text-muted">—</span>';
        if (port.live.isUplink) {
            return `<button type="button" class="btn btn-link btn-sm p-0 live-macs-toggle" data-target="${detailsId}" data-macs='${escAttr(JSON.stringify(port.live.macs))}'>
                ${port.live.macs.length} devices (uplink)
            </button>`;
        }
        return port.live.macs.map(m => {
            const cls = m.known ? 'bg-light text-dark' : 'bg-secondary-subtle text-secondary-emphasis';
            const title = m.known ? esc(m.hostName ?? m.interfaceName ?? '') : 'unregistered';
            return `<span class="badge ${cls} font-monospace me-1 mb-1" title="${escAttr(title)}">${esc(m.mac)}</span>`;
        }).join(' ');
    }

    function renderAppliedPolicy(live) {
        const roles = Array.from(new Set(live.macs.map(m => m.role).filter(r => r !== null && r !== '')));
        return roles.length ? roles.map(r => esc(r)).join(', ') : '<span class="text-muted">—</span>';
    }

    // Builds one row per live MAC on a (non-uplink) port, aligning connected
    // device / MAC / applied policy for each — a port with several clients (e.g.
    // a phone and PC daisy-chained together) gets one sub-row per device instead
    // of cramming them all into single cells. Also adds a row for any cached
    // device not confirmed live at all here (the "stale" discrepancy case), so
    // it isn't silently dropped from the table.
    function buildDeviceRows(port) {
        const cachedIfaceIds = new Set(port.cached.map(c => c.interfaceId));
        const liveIfaceIds   = new Set(port.live.macs.filter(m => m.known).map(m => m.interfaceId));

        const rows = port.live.macs.map(m => ({
            mac: m.mac,
            known: m.known,
            interfaceId: m.interfaceId,
            hostName: m.hostName,
            interfaceName: m.interfaceName,
            role: m.role,
            isNew: m.known && !cachedIfaceIds.has(m.interfaceId),
        }));

        port.cached.forEach(c => {
            if (!liveIfaceIds.has(c.interfaceId)) {
                rows.push({
                    mac: c.mac, known: true, interfaceId: c.interfaceId,
                    hostName: c.hostName, interfaceName: c.name, role: null, isNew: false,
                });
            }
        });

        return rows;
    }

    function renderDeviceCell(row) {
        if (!row) return '<span class="text-muted">—</span>';
        if (!row.known) return '<span class="text-muted">Unregistered</span>';
        const badge = row.isNew ? ' <span class="badge bg-info-subtle text-info-emphasis">new</span>' : '';
        return `<a href="${ifaceUrl(row.interfaceId)}" class="text-decoration-none d-block">${esc(row.hostName ?? row.interfaceName ?? '—')}${badge}</a>`;
    }

    function renderDeviceMacCell(row) {
        if (!row) return '<span class="text-muted">—</span>';
        const cls = row.known ? 'bg-light text-dark' : 'bg-secondary-subtle text-secondary-emphasis';
        return `<span class="badge ${cls} font-monospace">${esc(row.mac)}</span>`;
    }

    function renderDevicePolicyCell(row) {
        if (!row || !row.role) return '<span class="text-muted">—</span>';
        return esc(row.role);
    }

    function renderLldp(live) {
        if (!live.lldpNeighborName && !live.lldpNeighborPort) return '<span class="text-muted">—</span>';
        return esc(live.lldpNeighborName ?? '?') + (live.lldpNeighborPort ? ` (${esc(live.lldpNeighborPort)})` : '');
    }

    function renderDiscrepancyBadges(discrepancies) {
        if (discrepancies.length === 0) {
            return '<span class="badge bg-success-subtle text-success-emphasis"><i class="bi bi-check-lg"></i> OK</span>';
        }
        const badgeClass = { unregistered: 'info', moved: 'warning', stale: 'secondary' };
        return discrepancies.map(d => {
            const cls = badgeClass[d.type] ?? 'warning';
            return `<span class="badge bg-${cls}-subtle text-${cls}-emphasis d-block mb-1" title="${escAttr(d.message)}">${esc(d.type.replace('_', ' '))}</span>`;
        }).join('');
    }

    function renderDiscrepancies(port) {
        return renderDiscrepancyBadges(port.discrepancies);
    }

    // Discrepancies each carry their own `mac`, so a sub-row can show only the
    // ones about that specific device instead of dumping every discrepancy for
    // the port onto one row.
    function renderDeviceDiscrepancies(port, row) {
        if (!row) return renderDiscrepancyBadges(port.discrepancies);
        const mac = row.mac.toLowerCase();
        return renderDiscrepancyBadges(port.discrepancies.filter(d => d.mac && d.mac.toLowerCase() === mac));
    }

    function resolveActionMac(port) {
        if (port.cached.length > 0) return port.cached[0].mac;
        const knownLive = port.live.macs.find(m => m.known);
        return knownLive ? knownLive.mac : null;
    }

    function renderPortRow(port, index) {
        const detailsId = 'port-details-scan-' + index;
        const mac = resolveActionMac(port);
        const label = port.cached.length > 1 ? `${port.cached.length} devices` : (port.cached[0]?.hostName ?? mac ?? port.port);

        const checkboxCell = (rowspan) => mac
            ? `<td rowspan="${rowspan}"><input type="checkbox" class="form-check-input switch-port-checkbox" data-mac="${escAttr(mac)}" data-target="${detailsId}" data-label="${escAttr(port.port + ' (' + label + ')')}"></td>`
            : `<td rowspan="${rowspan}"></td>`;

        const actionsCell = (rowspan) => mac ? `
            <td class="text-end text-nowrap" rowspan="${rowspan}">
                <button type="button" class="btn btn-sm btn-outline-secondary port-status-btn" data-mac="${escAttr(mac)}" data-target="${detailsId}" title="Check Status"><i class="bi bi-arrow-clockwise"></i></button>
                <button type="button" class="btn btn-sm btn-outline-info port-reauth-btn" data-mac="${escAttr(mac)}" data-target="${detailsId}" data-confirm="Reauthenticate port ${escAttr(port.port)}?" title="Reauthenticate"><i class="bi bi-shield-check"></i></button>
                <button type="button" class="btn btn-sm btn-outline-warning port-bounce-btn" data-mac="${escAttr(mac)}" data-target="${detailsId}" data-confirm="Bounce port ${escAttr(port.port)}? This will briefly disconnect connected clients." title="Bounce Port"><i class="bi bi-power"></i></button>
                <button type="button" class="btn btn-sm btn-outline-warning port-poe-bounce-btn" data-mac="${escAttr(mac)}" data-target="${detailsId}" data-confirm="PoE bounce port ${escAttr(port.port)}? This will cut power and disconnect connected clients." title="PoE Bounce"><i class="bi bi-lightning"></i></button>
            </td>` : `<td rowspan="${rowspan}"></td>`;

        const lastSeen = renderLastSeen(port);

        const detailsRow = `
        <tr id="${detailsId}" class="d-none">
            <td colspan="10" class="p-0">
                <div id="${detailsId}-body" class="p-2 text-muted small">Click an action button above to load live port-access data from the switch.</div>
            </td>
        </tr>`;

        // Uplink ports keep the existing single collapsed row — exploding a trunk's
        // dozens of MACs into visible sub-rows would be exactly the noise that
        // collapse was built to avoid.
        if (port.live.isUplink) {
            return `<tr class="switch-port-row" data-port-group="${escAttr(port.port)}">
                ${checkboxCell(1)}
                <td class="font-monospace">${esc(port.port)}</td>
                <td class="small">${renderLiveStatus(port.live)}</td>
                <td class="small">${renderConnectedDevice(port)}</td>
                <td class="small">${renderLiveMacs(port, detailsId)}</td>
                <td class="small">${renderAppliedPolicy(port.live)}</td>
                <td class="small">${renderLldp(port.live)}</td>
                <td class="small">${renderDiscrepancies(port)}</td>
                <td class="text-muted small">${lastSeen}</td>
                ${actionsCell(1)}
            </tr>${detailsRow}`;
        }

        const rows = buildDeviceRows(port);
        if (rows.length === 0) rows.push(null);
        const rowspan = rows.length;

        // LLDP has no per-mac list of its own — just the one neighbor's own MAC
        // (when the switch reports one) — so match it to whichever row is that
        // device. If it doesn't match any row (unreported MAC, or none at all
        // reported), fall back to showing it on the first row rather than
        // dropping it silently.
        const lldpMac = port.live.lldpNeighborMac ? port.live.lldpNeighborMac.toLowerCase() : null;
        let lldpRowIndex = lldpMac ? rows.findIndex(r => r && r.mac.toLowerCase() === lldpMac) : -1;
        if (lldpRowIndex === -1 && (port.live.lldpNeighborName || port.live.lldpNeighborPort)) {
            lldpRowIndex = 0;
        }

        // With more than one sub-row, the port-level cells (Port/Live Status/Last
        // Seen/Actions) live in their own minimal-height spacer row instead of
        // sharing a row with the first device — otherwise hovering that first
        // device's row would highlight those tall rowspan'd cells too, making it
        // look like the whole port highlighted instead of just that one device.
        // The spacer row is an EXTRA row on top of the `rowspan` device rows, so
        // the port-level cells must span rowspan + 1 rows (the spacer itself plus
        // every device row) — spanning only `rowspan` leaves the last device row
        // uncovered, and its cells land in the wrong columns as a result.
        const portRowSpan = rowspan + 1;
        const spacerRow = rowspan > 1 ? `
        <tr class="switch-port-spacer-row switch-port-row" data-port-group="${escAttr(port.port)}">
            ${checkboxCell(portRowSpan)}
            <td class="font-monospace" rowspan="${portRowSpan}">${esc(port.port)}</td>
            <td class="small" rowspan="${portRowSpan}">${renderLiveStatus(port.live)}</td>
            <td colspan="5" class="p-0" style="line-height:0"></td>
            <td class="text-muted small" rowspan="${portRowSpan}">${lastSeen}</td>
            ${actionsCell(portRowSpan)}
        </tr>` : '';

        const trs = rows.map((row, i) => {
            const lldpCell = i === lldpRowIndex ? renderLldp(port.live) : '<span class="text-muted">—</span>';

            if (rowspan === 1) {
                return `<tr class="switch-port-row" data-port-group="${escAttr(port.port)}">
                    ${checkboxCell(1)}
                    <td class="font-monospace">${esc(port.port)}</td>
                    <td class="small">${renderLiveStatus(port.live)}</td>
                    <td class="small">${renderDeviceCell(row)}</td>
                    <td class="small">${renderDeviceMacCell(row)}</td>
                    <td class="small">${renderDevicePolicyCell(row)}</td>
                    <td class="small">${lldpCell}</td>
                    <td class="small">${renderDeviceDiscrepancies(port, row)}</td>
                    <td class="text-muted small">${lastSeen}</td>
                    ${actionsCell(1)}
                </tr>`;
            }
            return `<tr class="switch-port-row" data-port-group="${escAttr(port.port)}">
                <td class="small">${renderDeviceCell(row)}</td>
                <td class="small">${renderDeviceMacCell(row)}</td>
                <td class="small">${renderDevicePolicyCell(row)}</td>
                <td class="small">${lldpCell}</td>
                <td class="small">${renderDeviceDiscrepancies(port, row)}</td>
            </tr>`;
        }).join('');

        return spacerRow + trs + detailsRow;
    }

    function renderPortsTable(ports) {
        const rows = Object.values(ports).map((port, i) => renderPortRow(port, i));
        tbody.innerHTML = rows.join('');
        updateSelectionUI();
    }

    function renderRawOutput(raw) {
        const commands = [
            { key: 'interfaceBrief', label: 'show interface brief' },
            { key: 'portAccess',     label: 'show port-access clients' },
            { key: 'macTable',       label: 'show mac-address-table' },
            { key: 'lldp',           label: 'show lldp neighbor-info' },
        ];
        const panels = commands.map(c => `
            <div class="mb-2">
                <div class="text-muted small fw-semibold">${esc(c.label)}</div>
                <pre class="small p-2 border rounded mb-0" style="max-height:250px;overflow:auto">${esc(raw[c.key] || '(empty)')}</pre>
            </div>`).join('');
        return `<div class="m-3">
            <button type="button" class="btn btn-link btn-sm p-0 text-muted small" id="switch-scan-raw-toggle">Show raw switch output (for debugging parser issues)</button>
            <div id="switch-scan-raw-panel" class="d-none mt-2">${panels}</div>
        </div>`;
    }

    const scanBtn    = document.getElementById('switch-scan-btn');
    const scanStatus = document.getElementById('switch-scan-status');
    const scanAlert  = document.getElementById('switch-scan-alert');
    const scanRaw    = document.getElementById('switch-scan-raw');

    scanRaw.addEventListener('click', function (e) {
        if (e.target.id === 'switch-scan-raw-toggle') {
            document.getElementById('switch-scan-raw-panel').classList.toggle('d-none');
        }
    });

    if (scanBtn) {
        scanBtn.addEventListener('click', function () {
            const switchIp = scanBtn.dataset.switchIp;
            if (!switchIp) {
                scanAlert.innerHTML = '<div class="alert alert-warning mb-0 m-3 py-2">No switch IP is known for this host yet — it needs at least one recorded ClearPass authentication first.</div>';
                return;
            }

            scanAlert.innerHTML = '';
            const orig = scanBtn.innerHTML;
            scanBtn.disabled = true;
            scanBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Scanning…';
            scanStatus.textContent = 'Scanning switch — this can take a few seconds…';

            fetch(scanUrl + '?switch_ip=' + encodeURIComponent(switchIp))
                .then(r => {
                    if (!r.ok) {
                        if (r.status === 401 || r.status === 403) throw new Error('Session expired — please reload the page and try again.');
                        throw new Error(`Server returned ${r.status} ${r.statusText}.`);
                    }
                    return r.json();
                })
                .then(data => {
                    if (data.error) throw new Error(data.error);
                    renderPortsTable(data.ports);
                    scanRaw.innerHTML = renderRawOutput(data.raw || {});
                    scanStatus.textContent = 'Last scanned: ' + new Date().toLocaleTimeString();
                })
                .catch(err => {
                    const msg = err instanceof SyntaxError ? 'Unexpected response from server — the switch may be unreachable.' : err.message;
                    scanAlert.innerHTML = `<div class="alert alert-danger mb-0 m-3 py-2">Unable to query switch: ${esc(msg)}. Showing last known data only.</div>`;
                    scanStatus.textContent = 'Last scanned: never';
                })
                .finally(() => { scanBtn.disabled = false; scanBtn.innerHTML = orig; });
        });
    }
})();
</script>
{% endif %}
{% endblock %}
