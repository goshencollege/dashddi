{% extends 'base.html.twig' %}
{% block title %}{{ host.name }}{% endblock %}

{% block stylesheets %}
<style>
.host-interfaces-table { --vip-row-bg: rgba(0,0,0,.05); }
[data-bs-theme="dark"] .host-interfaces-table { --vip-row-bg: rgba(255,255,255,.05); }
.host-interfaces-table .vip-row { --bs-table-bg: var(--vip-row-bg); }
.host-interfaces-table .vip-row > td:first-child { padding-left: 2rem !important; }
</style>
{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        <li class="breadcrumb-item active">{{ host.name }}</li>
    </ol>
</nav>

{% if host.deleted %}
<div class="alert alert-warning d-flex align-items-center justify-content-between mb-3" role="alert">
    <div>
        <i class="bi bi-trash me-2"></i>
        <strong>This host was deleted</strong> on {{ host.deletedAt|date('Y-m-d H:i') }}.
        It is excluded from all DNS, DHCP, and ClearPass pushes.
    </div>
    <form method="post" action="{{ path('host_restore', {id: host.id}) }}" class="ms-3 flex-shrink-0">
        <input type="hidden" name="_token" value="{{ csrf_token('restore_host_' ~ host.id) }}">
        <button type="submit" class="btn btn-warning btn-sm text-nowrap">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Restore Host &amp; Interfaces
        </button>
    </form>
</div>
{% endif %}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-pc-display me-2"></i>{{ host.name }}</h1>
        {% if host.location %}
            <p class="text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>{{ host.location }}</p>
        {% endif %}
        {% if host.tags is not empty %}
            <div>
                {% for tag in host.tags %}
                    <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                {% endfor %}
            </div>
        {% endif %}
        {% if host.notes %}
            <p class="text-muted mt-2 mb-0" style="white-space:pre-wrap">{{ host.notes }}</p>
        {% endif %}
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_hosts') }}#interfaces" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('activity_log_index', {host_id: host.id, entity_type: 'Host', entity_name: host.name}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-1"></i>View Logs
        </a>
        {% if not host.deleted %}
        <a href="{{ path('host_edit', {id: host.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('host_delete', {id: host.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete host {{ host.name|e('js') }} and all its interfaces?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_host_' ~ host.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
        {% endif %}
    </div>
</div>

<div class="card mb-3">
    {% set activeInterfaces  = host.interfaces|filter(i => not i.deleted) %}
    {% set deletedInterfaces = host.interfaces|filter(i => i.deleted) %}
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-hdd-network me-1"></i>Interfaces ({{ activeInterfaces|length }}
            {%- if deletedInterfaces|length > 0 %}, <span class="text-warning-emphasis">{{ deletedInterfaces|length }} deleted</span>{% endif %})
        </span>
        {% if not host.deleted %}
        <span>
            <a href="{{ path('interface_new', {id: host.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Interface
            </a>
            {% if activeInterfaces|length > 0 %}
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#create-interface-dns-records-panel">
                <i class="bi bi-hdd-network me-1"></i>Create DNS Records
            </button>
            {% endif %}
        </span>
        {% endif %}
    </div>
    {% if not host.deleted and activeInterfaces|length > 0 %}
    <div class="collapse" id="create-interface-dns-records-panel">
        <div class="card-body border-bottom">
            <p class="text-muted small mb-2">
                Creates an A and/or AAAA record (whichever addresses are present) for every named interface on this host, in the domain you choose, with hostname <code>&lt;interface name&gt;.{{ host.name }}</code>. Unnamed interfaces, and interfaces whose name isn't a valid DNS label, are skipped.
            </p>
            <form method="post" action="{{ path('host_create_interface_dns_records', {id: host.id}) }}" class="d-flex align-items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('create_interface_dns_records_' ~ host.id) }}">
                <select name="domain_id" class="form-select form-select-sm" style="max-width:20rem" required>
                    <option value="">-- Select a domain --</option>
                    {% for domain in domains %}
                        <option value="{{ domain.id }}">{{ domain.name }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                    <i class="bi bi-hdd-network me-1"></i>Create Records
                </button>
            </form>
        </div>
    </div>
    {% endif %}
    {% if host.interfaces is empty %}
        <div class="card-body text-center text-muted py-4">
            No interfaces yet. <a href="{{ path('interface_new', {id: host.id}) }}">Add one →</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover mb-0 host-interfaces-table">
                <thead>
                    <tr>
                        <th>Interface</th>
                        <th>Subnet</th>
                        <th>IPv4</th>
                        <th>IPv6</th>
                        <th>DNS Names</th>
                        <th>Last Seen</th>
                        <th>Last Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for iface in host.interfaces %}
                        <tr class="{{ iface.deleted ? 'row-deleted' : '' }}">
                            <td class="small">
                                <a href="{{ path('interface_show', {id: iface.id}) }}" class="text-decoration-none">
                                    {% if iface.name %}
                                        <div class="fw-semibold">{{ iface.name }}</div>
                                    {% endif %}
                                    <div class="font-monospace text-muted">{{ iface.macAddress }}</div>
                                </a>
                                {% if iface.deleted %}
                                    <span class="badge text-bg-warning mt-1">Deleted {{ iface.deletedAt|date('Y-m-d') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ iface.subnet ? iface.subnet.name : '—' }}</td>
                            <td class="ip-address">
                                {% if iface.ipAddress %}
                                    {{ iface.ipAddress.address }}
                                    {% if iface.lastDhcpIp and iface.lastDhcpIp != iface.ipAddress.address %}
                                        <span class="text-muted">({{ iface.lastDhcpIp }})</span>
                                    {% endif %}
                                {% elseif iface.lastDhcpIp %}
                                    <span class="text-muted">({{ iface.lastDhcpIp }})</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="ip-address small">{{ iface.ipv6Address ? iface.ipv6Address.address : '—' }}</td>
                            <td class="font-monospace">
                                {% set fqdn_types = {} %}
                                {% for record in iface.domainRecords %}
                                    {% if record.domain and record.type.value in ['A', 'AAAA'] %}
                                        {% set fqdn = record.fullyQualifiedHostname %}
                                        {% set t = record.type.value %}
                                        {% if fqdn_types[fqdn] is defined %}
                                            {% set fqdn_types = fqdn_types|merge({(fqdn): fqdn_types[fqdn]|merge([t])}) %}
                                        {% else %}
                                            {% set fqdn_types = fqdn_types|merge({(fqdn): [t]}) %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                                {% if fqdn_types is empty %}
                                    <span class="text-muted">—</span>
                                {% else %}
                                    {% for fqdn, types in fqdn_types %}
                                        {% set has_a    = 'A'    in types %}
                                        {% set has_aaaa = 'AAAA' in types %}
                                        <div class="d-flex align-items-center" style="max-width:14rem">
                                            {% if has_a and has_aaaa %}
                                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0" style="border-radius:0.375rem 0 0 0.375rem;border-right-width:0">A</span><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1" style="border-radius:0 0.375rem 0.375rem 0;border-left-width:0">AAAA</span>
                                            {% elseif has_a %}
                                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0 me-1">A</span>
                                            {% elseif has_aaaa %}
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1">AAAA</span>
                                            {% endif %}
                                            <span class="text-truncate" style="min-width:0" title="{{ fqdn }}">{{ fqdn }}</span>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </td>
                            <td class="text-muted small">
                                {% set lastSeen = null %}
                                {% if iface.lastAuthAt and iface.lastDhcpAt %}
                                    {% set lastSeen = iface.lastAuthAt > iface.lastDhcpAt ? iface.lastAuthAt : iface.lastDhcpAt %}
                                {% elseif iface.lastAuthAt %}
                                    {% set lastSeen = iface.lastAuthAt %}
                                {% elseif iface.lastDhcpAt %}
                                    {% set lastSeen = iface.lastDhcpAt %}
                                {% endif %}
                                {% if lastSeen %}
                                    {{ lastSeen|date('Y-m-d') }}
                                    {% if iface.lastAuthAt == lastSeen %}<br><span class="text-info-emphasis">auth</span>{% else %}<br><span class="text-success-emphasis">dhcp</span>{% endif %}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="text-muted small">
                                {{ iface.updatedAt|date('Y-m-d H:i') }}
                                {% if iface.updatedBy %}<br>{{ iface.updatedBy }}{% endif %}
                            </td>
                            <td class="text-end">
                                {% if iface.deleted %}
                                    <form method="post" action="{{ path('interface_restore', {id: iface.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('restore_interface_' ~ iface.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                {% else %}
                                    <a href="{{ path('interface_edit', {id: iface.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('interface_delete', {id: iface.id}) }}" class="d-inline"
                                          onsubmit="return confirm({% if activeInterfaces|length == 1 %}'Delete this interface? It is the only active interface on {{ host.name|e('js') }}, so the host will also be deleted.'{% else %}'Delete this interface from {{ host.name|e('js') }}?'{% endif %})">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_interface_' ~ iface.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% for vip in vip_map[iface.id] ?? [] %}
                            <tr class="vip-row">
                                <td class="small">
                                    <i class="bi bi-layers text-muted me-1"></i>
                                    <a href="{{ path('virtual_ip_show', {id: vip.id, from: 'interface', interfaceId: iface.id}) }}" class="text-decoration-none">{{ vip.label }}</a>
                                    <div>
                                        <span class="badge bg-secondary">{{ vip.protocol.label() }}</span>
                                        {% if vip.vrid %}<span class="text-muted small ms-1">VRID&nbsp;{{ vip.vrid }}</span>{% endif %}
                                    </div>
                                </td>
                                <td>{{ vip.subnet ? vip.subnet.name : '—' }}</td>
                                <td class="ip-address">{{ vip.ipAddress ? vip.ipAddress.address : '—' }}</td>
                                <td class="ip-address small">{{ vip.ipv6Address ? vip.ipv6Address.address : '—' }}</td>
                                <td class="font-monospace">
                                    {% set fqdn_types = {} %}
                                    {% for record in vip.domainRecords %}
                                        {% if record.domain and record.type.value in ['A', 'AAAA'] %}
                                            {% set fqdn = record.fullyQualifiedHostname %}
                                            {% set t = record.type.value %}
                                            {% if fqdn_types[fqdn] is defined %}
                                                {% set fqdn_types = fqdn_types|merge({(fqdn): fqdn_types[fqdn]|merge([t])}) %}
                                            {% else %}
                                                {% set fqdn_types = fqdn_types|merge({(fqdn): [t]}) %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if fqdn_types is empty %}
                                        <span class="text-muted">—</span>
                                    {% else %}
                                        {% for fqdn, types in fqdn_types %}
                                            {% set has_a    = 'A'    in types %}
                                            {% set has_aaaa = 'AAAA' in types %}
                                            <div class="d-flex align-items-center" style="max-width:14rem">
                                                {% if has_a and has_aaaa %}
                                                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0" style="border-radius:0.375rem 0 0 0.375rem;border-right-width:0">A</span><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1" style="border-radius:0 0.375rem 0.375rem 0;border-left-width:0">AAAA</span>
                                                {% elseif has_a %}
                                                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle flex-shrink-0 me-1">A</span>
                                                {% elseif has_aaaa %}
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle flex-shrink-0 me-1">AAAA</span>
                                                {% endif %}
                                                <span class="text-truncate" style="min-width:0" title="{{ fqdn }}">{{ fqdn }}</span>
                                            </div>
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                <td class="text-muted small">—</td>
                                <td class="text-muted small">
                                    {{ vip.updatedAt|date('Y-m-d H:i') }}
                                    {% if vip.updatedBy %}<br>{{ vip.updatedBy }}{% endif %}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('virtual_ip_edit', {id: vip.id, from: 'interface', interfaceId: iface.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('virtual_ip_remove_member', {id: vip.id, interfaceId: iface.id}) }}" class="d-inline"
                                          onsubmit="return confirm('Remove this interface from {{ vip.label|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remove_member_' ~ vip.id ~ '_' ~ iface.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-warning me-1" title="Unlink from this VIP">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('virtual_ip_delete', {id: vip.id}) }}" class="d-inline"
                                          onsubmit="return confirm('Delete {{ vip.label|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_vip_' ~ vip.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete this VIP">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{% if host.sshHostKeys|length > 0 or not host.deleted %}
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-shield-lock me-1"></i>SSH Host Keys</div>
    <div class="card-body py-2">
        {% if host.sshHostKeys|length > 0 %}
        <table class="table table-sm table-borderless mb-2 small">
            <thead class="text-muted">
                <tr>
                    <th>Algorithm</th>
                    <th>Fingerprint (SHA-256)</th>
                    {% if not host.deleted %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody class="font-monospace">
                {% for key in host.sshHostKeys %}
                <tr>
                    <td class="text-nowrap pe-3">{{ key.algorithm }}</td>
                    <td>{{ key.fingerprint }}</td>
                    {% if not host.deleted %}
                    <td class="text-end">
                        <form method="post" action="{{ path('host_delete_ssh_host_key', {id: host.id, keyId: key.id}) }}"
                              onsubmit="return confirm('Remove the {{ key.algorithm }} host key?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_ssh_host_key_' ~ key.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="text-muted small mb-2">No SSH host keys stored yet. Keys are learned automatically on first connection, or you can add them manually below.</p>
        {% endif %}
        {% if not host.deleted %}
        {% set scan_targets = [] %}
        {% for iface in host.interfaces %}
            {% if not iface.deleted %}
                {% if iface.ipAddress is not null %}
                    {% set scan_targets = scan_targets|merge([{label: (iface.primaryName ~ ' – ' ~ iface.ipAddress.address), ip: iface.ipAddress.address}]) %}
                {% endif %}
                {% if iface.ipv6Address is not null %}
                    {% set scan_targets = scan_targets|merge([{label: (iface.primaryName ~ ' – ' ~ iface.ipv6Address.address), ip: iface.ipv6Address.address}]) %}
                {% endif %}
            {% endif %}
        {% endfor %}
        <form method="post" action="{{ path('host_scan_ssh_host_keys', {id: host.id}) }}" class="mb-2">
            <input type="hidden" name="_token" value="{{ csrf_token('scan_ssh_host_keys_' ~ host.id) }}">
            {% if scan_targets|length == 0 %}
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                <i class="bi bi-radar me-1"></i>Scan with ssh-keyscan
            </button>
            <span class="text-muted small ms-1">No IP addresses on this host.</span>
            {% elseif scan_targets|length == 1 %}
            <input type="hidden" name="scan_target" value="{{ scan_targets[0].ip }}">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-radar me-1"></i>Scan {{ scan_targets[0].ip }}
            </button>
            {% else %}
            <div class="input-group input-group-sm" style="max-width:32rem;">
                <select name="scan_target" class="form-select form-select-sm">
                    {% for t in scan_targets %}
                    <option value="{{ t.ip }}">{{ t.label }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-radar me-1"></i>Scan
                </button>
            </div>
            {% endif %}
        </form>
        <details>
            <summary class="small text-secondary" style="cursor:pointer;">Add / replace keys manually</summary>
            <form method="post" action="{{ path('host_add_ssh_host_keys', {id: host.id}) }}" class="mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('add_ssh_host_keys_' ~ host.id) }}">
                <textarea name="ssh_host_public_key" class="form-control form-control-sm font-monospace mb-1" rows="4"
                          placeholder="Paste one or more public host keys — bare key lines or ssh-keyscan output accepted:&#10;ssh-ed25519 AAAA...&#10;ecdsa-sha2-nistp256 AAAA..."></textarea>
                <div class="form-text small mb-2">Accepts output from <code>ssh-keyscan hostname</code> or the contents of <code>/etc/ssh/ssh_host_*_key.pub</code>. Existing keys for the same algorithm are replaced.</div>
                <button type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-floppy me-1"></i>Save keys
                </button>
            </form>
        </details>
        {% endif %}
    </div>
</div>
{% endif %}

{% set snipeLink = host.snipeItAssetLink %}
{% if snipeLink %}
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-box-seam me-1"></i>Snipe-IT Asset</div>
    <div class="card-body py-2">
        <dl class="row mb-0 small">
            <dt class="col-sm-3">Asset Name</dt>
            <dd class="col-sm-9">
                {{ snipeLink.snipeAssetName }}
                {% if snipeLink.snipeAssetName != host.name %}
                    <span class="text-muted ms-2">(DashDDI name: <strong>{{ host.name }}</strong>)</span>
                {% endif %}
            </dd>
            {% if snipeLink.snipeAssetTag %}
            <dt class="col-sm-3">Asset Tag</dt>
            <dd class="col-sm-9 font-monospace">
              <a href="{{ snipeLink.server.webUrl }}/hardware/{{ snipeLink.snipeAssetId }}" target="_blank" rel="noopener noreferrer">
                {{ snipeLink.snipeAssetTag }}
              </a>
            </dd>
            {% endif %}
            <dt class="col-sm-3">Server</dt>
            <dd class="col-sm-9">{{ snipeLink.server.name }}</dd>
            <dt class="col-sm-3">Last Synced</dt>
            <dd class="col-sm-9">{{ snipeLink.syncedAt|date('Y-m-d H:i') }}</dd>
        </dl>
    </div>
</div>
{% endif %}

{% if not host.deleted %}
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-key me-1"></i>Host API Token</span>
        <a href="{{ path('user_guide_settings') }}#host-scoped-tokens" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank">
            <i class="bi bi-question-circle"></i>
        </a>
    </div>
    {% if newToken %}
    <div class="card-body pb-2">
        <div class="alert alert-success mb-3">
            <strong>Token generated.</strong> Copy it now — it will not be shown again.
            <div class="input-group mt-2">
                <input type="text" class="form-control font-monospace" id="hostTokenValue" value="{{ newToken }}" readonly>
                <button class="btn btn-outline-secondary" type="button"
                        onclick="navigator.clipboard.writeText(document.getElementById('hostTokenValue').value)">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>
    </div>
    {% endif %}
    {% set apiToken = host.apiToken %}
    {% if apiToken %}
    <div class="card-body py-2">
        <dl class="row mb-0 small">
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">{{ apiToken.createdAt|date('Y-m-d H:i') }} by {{ apiToken.ownerIdentifier }}</dd>
            <dt class="col-sm-3">Expires</dt>
            <dd class="col-sm-9 {{ apiToken.expired ? 'text-danger fw-bold' : '' }}">
                {{ apiToken.expiresAt ? apiToken.expiresAt|date('Y-m-d') : '—' }}
                {% if apiToken.expired %}<span class="badge bg-danger ms-1">Expired</span>{% endif %}
            </dd>
            <dt class="col-sm-3">Last Used</dt>
            <dd class="col-sm-9">{{ apiToken.lastUsedAt ? apiToken.lastUsedAt|date('Y-m-d H:i') : 'Never' }}</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <form method="post" action="{{ path('host_token_generate', {id: host.id}) }}"
              onsubmit="return confirm('Regenerate the token for {{ host.name|e('js') }}? The existing token will stop working immediately.')">
            <input type="hidden" name="_token" value="{{ csrf_token('host_token_' ~ host.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-repeat me-1"></i>Regenerate
            </button>
        </form>
        <form method="post" action="{{ path('host_token_revoke', {id: host.id}) }}"
              onsubmit="return confirm('Revoke the API token for {{ host.name|e('js') }}? This cannot be undone.')">
            <input type="hidden" name="_token" value="{{ csrf_token('host_token_' ~ host.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Revoke
            </button>
        </form>
    </div>
    {% else %}
    <div class="card-body">
        <p class="text-muted small mb-3">
            A host-scoped token grants <code>/api/self</code> access restricted to this host's IP addresses.
            Use it with an ACME DNS-01 hook to automate certificate renewal.
        </p>
        <form method="post" action="{{ path('host_token_generate', {id: host.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('host_token_' ~ host.id) }}">
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Generate Token
            </button>
        </form>
    </div>
    {% endif %}
</div>
{% endif %}

<div class="text-muted small">
    Created {{ host.createdAt|date('Y-m-d H:i') }}{% if host.createdBy %} by {{ host.createdBy }}{% endif %}
    &middot; Updated {{ host.updatedAt|date('Y-m-d H:i') }}{% if host.updatedBy %} by {{ host.updatedBy }}{% endif %}
</div>
{% endblock %}
