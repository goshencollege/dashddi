<div class="card mb-3">
    {% set sshKeysCollapsed = 'ssh-host-keys' in collapsedSections %}
    <div class="card-header d-flex align-items-center gap-2 section-header-toggle" style="cursor:pointer">
        {{ _self.sectionToggle('ssh-host-keys', collapsedSections) }}
