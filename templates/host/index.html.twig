{% extends 'base.html.twig' %}
{% block title %}Hosts{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css">
<style>
/* Theme-aware custom properties (dark covers: dark, purple, green, rainbow) */
.host-tree-table {
    --tree-iface-bg:      rgba(0,0,0,.025);
    --tree-vip-bg:        rgba(0,0,0,.05);
    --tree-group-hover:   rgba(0,0,0,.1);
    --tree-row-hover:     rgba(0,0,0,.18);
}
[data-bs-theme="dark"] .host-tree-table {
    --tree-iface-bg:      rgba(255,255,255,.025);
    --tree-vip-bg:        rgba(255,255,255,.05);
    --tree-group-hover:   rgba(255,255,255,.12);
    --tree-row-hover:     rgba(255,255,255,.22);
}
.host-tree-table td, .host-tree-table th { padding-top: 0.3rem; padding-bottom: 0.3rem; }
.host-tree-table thead th { position: sticky; top: 0; z-index: 2; background-color: var(--bs-body-bg); padding-top: 0.46rem; padding-bottom: 0.46rem; }
.host-tree-table thead th::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; border-bottom: 2px solid var(--bs-border-color); }
.host-tree-table thead th:first-child { border-left: 1px solid var(--bs-border-color); }
.host-tree-table thead th:last-child  { border-right: 1px solid var(--bs-border-color); }
.host-tree-table .toggle-cell { width: 1.75rem; padding-right: 0; text-align: center; }
.host-tree-table .tree-toggle { border: none; background: none; padding: 0; line-height: 1; color: #6c757d; }
.host-tree-table .tree-toggle:hover { color: var(--bs-body-color); }
.host-tree-table .iface-row { --bs-table-bg: var(--tree-iface-bg); }
.host-tree-table .iface-name-cell { padding-left: 2rem !important; }
.host-tree-table .vip-row { --bs-table-bg: var(--tree-vip-bg); }
.host-tree-table .vip-row > td:nth-child(3) { padding-left: 3.5rem !important; }
.host-tree-table td:nth-child(3) { white-space: nowrap; }
.host-tree-table td:nth-last-child(2) { white-space: nowrap; }
.host-tree-table .iface-row > td:nth-child(2) { padding-left: 2rem !important; }
/* Group box: left/right borders run continuously through every row in the group */
.host-tree-table .host-row > td:first-child,
.host-tree-table .iface-row > td:first-child { border-left: 1px solid var(--bs-border-color); }
.host-tree-table .host-row > td:last-child,
.host-tree-table .iface-row > td:last-child { border-right: 1px solid var(--bs-border-color); }
/* Top edge of each group; thicker line between consecutive groups; none on first row (header provides it) */
.host-tree-table .host-row > td { border-top: 1px solid var(--bs-border-color); }
.host-tree-table .host-row + .host-row > td,
.host-tree-table .iface-row + .host-row > td { border-top: 2px solid var(--bs-border-color); }
.host-tree-table tbody tr:first-child > td { border-top: none; }
/* Group hover (JS-managed; !important overrides Bootstrap's --bs-table-bg mechanism) */
.host-tree-table .group-hovered > td { background-color: var(--tree-group-hover) !important; }
.host-tree-table .row-hovered > td   { background-color: var(--tree-row-hover)   !important; }
</style>
{{ include('_tom_select_dark.html.twig') }}
{% endblock %}

{# Renders a sortable column header link with an active-sort indicator. #}
{% macro sort_header(col, label, sort, dir, link_params) %}
    {% set next_dir = (sort == col and dir == 'asc') ? 'desc' : 'asc' %}
    <a href="{{ path('host_index', link_params|merge({sort: col, dir: next_dir, page: 1})) }}"
       class="text-decoration-none text-reset d-inline-flex align-items-center gap-1">
        {{- label -}}
        {% if sort == col %}
            <i class="bi bi-arrow-{{ dir == 'asc' ? 'up' : 'down' }}-short"></i>
        {% else %}
            <i class="bi bi-arrow-down-up text-muted" style="font-size:.75em;opacity:.4"></i>
        {% endif %}
    </a>
{% endmacro %}

{# Renders Bootstrap pagination controls and a result-count footer line. #}
{% macro pager(pagination) %}
{% set p = pagination %}
<div class="card-footer d-flex align-items-center justify-content-between py-2">
    <span class="text-muted small">
        {% set first = (p.page - 1) * p.per_page + 1 %}
        {% set last  = min(p.page * p.per_page, p.total) %}
        {% if p.total == 0 %}
            No results
        {% elseif p.total == 1 %}
            1 host
        {% else %}
            {{ first }}–{{ last }} of {{ p.total }} hosts
        {% endif %}
    </span>
    {% if p.pages > 1 %}
    <nav aria-label="Host list pages">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item {{ p.page <= 1 ? 'disabled' }}">
                <a class="page-link" href="{{ path('host_index', p.link_params|merge({page: p.page - 1})) }}" aria-label="Previous">‹</a>
            </li>
            {% set win_start = max(1, p.page - 3) %}
            {% set win_end   = min(p.pages, p.page + 3) %}
            {% if win_start > 1 %}
                <li class="page-item"><a class="page-link" href="{{ path('host_index', p.link_params|merge({page: 1})) }}">1</a></li>
                {% if win_start > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            {% endif %}
            {% for n in range(win_start, win_end) %}
                <li class="page-item {{ n == p.page ? 'active' }}">
                    <a class="page-link" href="{{ path('host_index', p.link_params|merge({page: n})) }}">{{ n }}</a>
                </li>
            {% endfor %}
            {% if win_end < p.pages %}
                {% if win_end < p.pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                <li class="page-item"><a class="page-link" href="{{ path('host_index', p.link_params|merge({page: p.pages})) }}">{{ p.pages }}</a></li>
            {% endif %}
            <li class="page-item {{ p.page >= p.pages ? 'disabled' }}">
                <a class="page-link" href="{{ path('host_index', p.link_params|merge({page: p.page + 1})) }}" aria-label="Next">›</a>
            </li>
        </ul>
    </nav>
    {% endif %}
</div>
{% endmacro %}

{% block content %}
<div class="list-page-content">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-pc-display me-2"></i>Hosts</h1>
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('user_guide_hosts') }}" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('host_index', showDeleted ? {} : {deleted: 1}) }}"
           class="btn btn-sm {{ showDeleted ? 'btn-warning' : 'btn-outline-secondary' }}">
            <i class="bi bi-trash me-1"></i>{{ showDeleted ? 'Show Active' : 'Deleted' }}
        </a>
        {% if not showDeleted %}
        <a href="{{ path('host_import') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-upload me-1"></i>Import CSV
        </a>
        <a href="{{ path('host_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Host
        </a>
        {% endif %}
    </div>
</div>
{% if showDeleted %}
<div class="alert alert-warning py-2 mb-3">
    <i class="bi bi-trash me-1"></i>Showing deleted hosts. <a href="{{ path('host_index') }}">Return to active hosts →</a>
</div>
{% endif %}

<div class="mb-4">
    {# Simple search #}
    <form method="get" action="{{ path('host_index') }}" class="mb-2" id="simple-search-form">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="q" id="q-input" class="form-control" placeholder="Search by name, location, subnet, IP address, MAC, or DNS name…" value="{{ query }}">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            {% if query or isAdvanced %}
                <a href="{{ path('host_index', {reset: 1}) }}" class="btn btn-outline-secondary">Clear</a>
            {% endif %}
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#advanced-search"
                    aria-expanded="{{ isAdvanced ? 'true' : 'false' }}">
                <i class="bi bi-sliders me-1"></i>Advanced
            </button>
        </div>
    </form>

    {# Advanced search — OR-groups condition builder #}
    <div class="collapse" id="advanced-search">
        <div class="card card-body p-3">
            <div id="filter-builder">
                {# Condition groups rendered by JavaScript #}
            </div>
            <div class="mt-2 d-flex gap-2 align-items-center flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="add-group-btn">
                    <i class="bi bi-plus-circle me-1"></i>Add OR group
                </button>
                <button type="button" class="btn btn-sm btn-primary" onclick="builderSearch()">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a href="{{ path('host_index', {reset: 1}) }}" class="btn btn-sm btn-outline-secondary">Clear</a>
                <span class="text-muted small ms-2">Use <code>*</code> as a wildcard in text fields (e.g. <code>web*</code>, <code>*.example.com</code>)</span>
            </div>
        </div>
    </div>
</div>

{% if hosts is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            {% if query %}
                <i class="bi bi-search fs-1 d-block mb-3 opacity-25"></i>
                No hosts matched <strong>{{ query }}</strong>. <a href="{{ path('host_index', {reset: 1}) }}">Clear search →</a>
            {% else %}
                <i class="bi bi-pc-display fs-1 d-block mb-3 opacity-25"></i>
                No hosts yet. <a href="{{ path('host_new') }}">Add the first one →</a>
            {% endif %}
        </div>
    </div>
{% else %}

    {# ── Tree view: hosts with collapsible interface sub-rows ── #}
    <div class="list-scroll-card">
        <div class="card">
            <div id="bulk-bar" class="card-header py-1">
                <div class="d-flex align-items-center gap-2">
                    <div id="host-bulk-section" class="d-none d-flex align-items-center gap-2">
                        <span id="host-selected-count" class="text-muted small">0 hosts selected</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="host-add-tag-btn">
                            <i class="bi bi-tag me-1"></i>Add Tag
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="host-remove-tag-btn">
                            <i class="bi bi-tag me-1"></i>Remove Tag
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="host-merge-btn">
                            <i class="bi bi-union me-1"></i>Merge Hosts
                        </button>
                        {% if showDeleted %}
                        <button type="button" class="btn btn-sm btn-outline-warning" id="host-restore-btn">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Restore Selected Hosts
                        </button>
                        {% else %}
                        <button type="button" class="btn btn-sm btn-outline-danger" id="host-delete-btn">
                            <i class="bi bi-trash me-1"></i>Delete Selected Hosts
                        </button>
                        {% endif %}
                    </div>
                    <div id="bulk-bar-separator" class="vr d-none mx-2"></div>
                    <div id="iface-bulk-section" class="d-none d-flex align-items-center gap-2">
                        <span id="iface-selected-count" class="text-muted small">0 interfaces selected</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="iface-edit-btn"
                                data-bs-toggle="modal" data-bs-target="#bulk-iface-edit-modal">
                            <i class="bi bi-pencil me-1"></i>Edit Selected Interfaces
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="iface-delete-btn">
                            <i class="bi bi-trash me-1"></i>Delete Selected Interfaces
                        </button>
                    </div>
                    <div class="flex-grow-1"></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="bulk-clear-btn">
                        <i class="bi bi-x-lg me-1"></i>Clear Selections
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="expand-all-btn">
                        <i class="bi bi-arrows-expand me-1"></i>Expand All
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="collapse-all-btn">
                        <i class="bi bi-arrows-collapse me-1"></i>Collapse All
                    </button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table mb-0 host-tree-table">
                    <thead>
                        <tr>
                            <th class="toggle-cell"></th>
                            <th class="ps-2" style="width:1%">
                                <div class="d-flex gap-2 align-items-center">
                                    <input type="checkbox" class="form-check-input" id="select-all-hosts" title="Select all hosts on this page">
                                    <input type="checkbox" class="form-check-input" id="select-all-ifaces" title="Select all interfaces on this page">
                                </div>
                            </th>
                            <th style="min-width:13rem; width:1%">{{ _self.sort_header('name', 'Name', sort, dir, pagination.link_params) }}</th>
                            <th>Tags</th>
                            <th>Subnet</th>
                            <th>{{ _self.sort_header('ip', 'IPv4', sort, dir, pagination.link_params) }}</th>
                            <th>IPv6</th>
                            <th>DNS Names</th>
                            <th style="width:1%; white-space:nowrap">{{ _self.sort_header('updated', 'Last Modified', sort, dir, pagination.link_params) }}</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for host in hosts %}
                            <tr class="host-row{{ host.deleted ? ' row-deleted' : '' }}" data-host-id="{{ host.id }}">
                                <td class="toggle-cell">
                                    {% if host.interfaces is not empty %}
                                    <button type="button" class="tree-toggle" data-host="{{ host.id }}" aria-label="Toggle interfaces">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                    {% endif %}
                                </td>
                                <td class="ps-2">
                                    <input type="checkbox" class="form-check-input bulk-host-cb" value="{{ host.id }}">
                                </td>
                                <td>
                                    <a href="{{ path('host_show', {id: host.id}) }}" class="fw-semibold text-decoration-none">
                                        {{ host.name }}
                                    </a>
                                    {% if host.deleted %}
                                        <span class="badge text-bg-warning ms-1">Deleted</span>
                                    {% endif %}
                                    {% set snipeLink = host.snipeItAssetLink %}
                                    {% if snipeLink and snipeLink.snipeAssetName != host.name %}
                                        <span class="text-muted small ms-1">· <i class="bi bi-box-seam me-1"></i>{{ snipeLink.snipeAssetName }}</span>
                                    {% endif %}
                                    {% if host.location %}
                                        <span class="text-muted small ms-1">· {{ host.location }}</span>
                                    {% endif %}
                                    {% if host.interfaces is empty %}
                                        <span class="text-muted small ms-1 fst-italic">· No interfaces</span>
                                    {% endif %}
                                </td>
                                <td colspan="5">
                                    {% for tag in host.tags %}
                                        <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endfor %}
                                </td>
                                <td class="text-muted small">
                                    {{ host.updatedAt|date('Y-m-d') }}{% if host.updatedBy %} · {{ host.updatedBy }}{% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end align-items-center">
                                        {% if host.deleted %}
                                            <form method="post" action="{{ path('host_restore', {id: host.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('restore_host_' ~ host.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Restore">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        {% else %}
                                            <a href="{{ path('host_edit', {id: host.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('host_delete', {id: host.id}) }}"
                                                  onsubmit="return confirm('Delete host {{ host.name|e('js') }}?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_host_' ~ host.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                            {% for iface in host.interfaces %}
                                {% set row_deleted = iface.deleted or host.deleted %}
                                <tr class="iface-row{{ row_deleted ? ' row-deleted' : '' }}" data-parent-host="{{ host.id }}">
                                    <td class="toggle-cell"></td>
                                    <td class="ps-2">
                                        <input type="checkbox" class="form-check-input bulk-iface-cb" value="{{ iface.id }}">
                                    </td>
                                    <td class="iface-name-cell small">
                                        {% if iface.name %}
                                            <a href="{{ path('interface_show', {id: iface.id}) }}" class="text-decoration-none fw-semibold">{{ iface.name }} <span class="font-monospace text-muted">({{ iface.macAddress }})</span></a>
                                        {% else %}
                                            <a href="{{ path('interface_show', {id: iface.id}) }}" class="text-decoration-none font-monospace text-muted">{{ iface.macAddress }}</a>
                                        {% endif %}
                                        {% if iface.deleted %}
                                            <span class="badge text-bg-warning mt-1">Interface deleted</span>
                                        {% endif %}
                                    </td>
                                    <td></td>
                                    <td class="small">{{ iface.subnet ? iface.subnet.name : '—' }}</td>
                                    <td class="ip-address small">
                                        {% if iface.ipAddress %}
                                            {{ iface.ipAddress.address }}
                                            {% if iface.lastDhcpIp and iface.lastDhcpIp != iface.ipAddress.address %}
                                                <span class="text-muted">({{ iface.lastDhcpIp }})</span>
                                            {% endif %}
                                        {% elseif iface.lastDhcpIp %}
                                            <span class="text-muted">({{ iface.lastDhcpIp }})</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="ip-address small">
                                        {% if iface.ipv6Address %}
                                            {{ iface.ipv6Address.address }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="small font-monospace">
                                        {% set fqdn_types = {} %}
                                        {% for record in iface.domainRecords %}
                                            {% if record.domain and record.type.value in ['A', 'AAAA'] %}
                                                {% set fqdn = record.fullyQualifiedHostname %}
                                                {% set t = record.type.value %}
                                                {% if fqdn_types[fqdn] is defined %}
                                                    {% set fqdn_types = fqdn_types|merge({(fqdn): fqdn_types[fqdn]|merge([t])}) %}
                                                {% else %}
                                                    {% set fqdn_types = fqdn_types|merge({(fqdn): [t]}) %}
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                        {% if fqdn_types is empty %}
                                            <span class="text-muted">—</span>
                                        {% else %}
                                            {% for fqdn, types in fqdn_types %}
                                                {% set has_a    = 'A'    in types %}
                                                {% set has_aaaa = 'AAAA' in types %}
                                                <div>
                                                    {{ fqdn }}
                                                    {% if has_a and has_aaaa %}
                                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle ms-1" style="border-radius:0.375rem 0 0 0.375rem;border-right-width:0">A</span><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" style="border-radius:0 0.375rem 0.375rem 0;border-left-width:0">AAAA</span>
                                                    {% elseif has_a %}
                                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle ms-1">A</span>
                                                    {% elseif has_aaaa %}
                                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1">AAAA</span>
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                    <td class="text-muted small">
                                        {{ iface.updatedAt|date('Y-m-d') }}{% if iface.updatedBy %} · {{ iface.updatedBy }}{% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end align-items-center">
                                            {% if row_deleted %}
                                                <form method="post" action="{{ path('interface_restore', {id: iface.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('restore_interface_' ~ iface.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Restore">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <a href="{{ path('interface_edit', {id: iface.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form method="post" action="{{ path('interface_delete', {id: iface.id}) }}"
                                                      onsubmit="return confirm({% if host.interfaces|filter(i => not i.deleted)|length == 1 %}'Delete interface {{ iface.macAddress|e('js') }}? It is the only active interface on {{ host.name|e('js') }}, so the host will also be deleted.'{% else %}'Delete interface {{ iface.macAddress|e('js') }} from {{ host.name|e('js') }}?'{% endif %})">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_interface_' ~ iface.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                                {% for vip in vip_map[iface.id] ?? [] %}
                                <tr class="iface-row vip-row" data-parent-host="{{ host.id }}">
                                    <td class="toggle-cell"></td>
                                    <td></td>
                                    <td class="small">
                                        <i class="bi bi-layers text-muted me-1"></i>
                                        <a href="{{ path('virtual_ip_show', {id: vip.id, from: 'interface', interfaceId: iface.id}) }}" class="text-decoration-none">{{ vip.label }}</a>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ vip.protocol.label() }}</span>
                                        {% if vip.vrid %}<span class="text-muted small ms-1">VRID&nbsp;{{ vip.vrid }}</span>{% endif %}
                                    </td>
                                    <td></td>
                                    <td class="ip-address small">{{ vip.ipAddress ? vip.ipAddress.address : '—' }}</td>
                                    <td class="ip-address small">{{ vip.ipv6Address ? vip.ipv6Address.address : '—' }}</td>
                                    <td class="small font-monospace">
                                        {% set fqdn_types = {} %}
                                        {% for record in vip.domainRecords %}
                                            {% if record.domain and record.type.value in ['A', 'AAAA'] %}
                                                {% set fqdn = record.fullyQualifiedHostname %}
                                                {% set t = record.type.value %}
                                                {% if fqdn_types[fqdn] is defined %}
                                                    {% set fqdn_types = fqdn_types|merge({(fqdn): fqdn_types[fqdn]|merge([t])}) %}
                                                {% else %}
                                                    {% set fqdn_types = fqdn_types|merge({(fqdn): [t]}) %}
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                        {% if fqdn_types is empty %}
                                            <span class="text-muted">—</span>
                                        {% else %}
                                            {% for fqdn, types in fqdn_types %}
                                                {% set has_a    = 'A'    in types %}
                                                {% set has_aaaa = 'AAAA' in types %}
                                                <div>
                                                    {{ fqdn }}
                                                    {% if has_a and has_aaaa %}
                                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle ms-1" style="border-radius:0.375rem 0 0 0.375rem;border-right-width:0">A</span><span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" style="border-radius:0 0.375rem 0.375rem 0;border-left-width:0">AAAA</span>
                                                    {% elseif has_a %}
                                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle ms-1">A</span>
                                                    {% elseif has_aaaa %}
                                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1">AAAA</span>
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                    <td class="text-muted small">
                                        {{ vip.updatedAt|date('Y-m-d') }}{% if vip.updatedBy %} · {{ vip.updatedBy }}{% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('virtual_ip_edit', {id: vip.id, from: 'interface', interfaceId: iface.id}) }}" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ _self.pager(pagination) }}
        </div>
    </div>

{% endif %}
</div>{# /list-page-content #}

