{% extends 'base.html.twig' %}
{% block title %}Hosts{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css">
{% endblock %}

{# Renders Bootstrap pagination controls and a result-count footer line. #}
{% macro pager(pagination) %}
{% set p = pagination %}
<div class="card-footer d-flex align-items-center justify-content-between py-2">
    <span class="text-muted small">
        {% set first = (p.page - 1) * p.per_page + 1 %}
        {% set last  = min(p.page * p.per_page, p.total) %}
        {% if p.total == 0 %}
            No results
        {% elseif p.total == 1 %}
            1 host
        {% else %}
            {{ first }}–{{ last }} of {{ p.total }} hosts
        {% endif %}
    </span>
    {% if p.pages > 1 %}
    <nav aria-label="Host list pages">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item {{ p.page <= 1 ? 'disabled' }}">
                <a class="page-link" href="{{ path('host_index', p.link_params|merge({page: p.page - 1})) }}" aria-label="Previous">‹</a>
            </li>
            {% set win_start = max(1, p.page - 3) %}
            {% set win_end   = min(p.pages, p.page + 3) %}
            {% if win_start > 1 %}
                <li class="page-item"><a class="page-link" href="{{ path('host_index', p.link_params|merge({page: 1})) }}">1</a></li>
                {% if win_start > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            {% endif %}
            {% for n in range(win_start, win_end) %}
                <li class="page-item {{ n == p.page ? 'active' }}">
                    <a class="page-link" href="{{ path('host_index', p.link_params|merge({page: n})) }}">{{ n }}</a>
                </li>
            {% endfor %}
            {% if win_end < p.pages %}
                {% if win_end < p.pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                <li class="page-item"><a class="page-link" href="{{ path('host_index', p.link_params|merge({page: p.pages})) }}">{{ p.pages }}</a></li>
            {% endif %}
            <li class="page-item {{ p.page >= p.pages ? 'disabled' }}">
                <a class="page-link" href="{{ path('host_index', p.link_params|merge({page: p.page + 1})) }}" aria-label="Next">›</a>
            </li>
        </ul>
    </nav>
    {% endif %}
</div>
{% endmacro %}

{% block content %}
<div class="list-page-content">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-pc-display me-2"></i>Hosts</h1>
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('user_guide_hosts') }}" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        {% if not showDeleted %}
        <div class="btn-group btn-group-sm" role="group" id="view-mode-toggle" aria-label="View mode">
            <button type="button" class="btn btn-outline-secondary{{ hostViewMode == 'host' ? ' active' }}" data-mode="host">
                <i class="bi bi-pc-display me-1"></i>By Host
            </button>
            <button type="button" class="btn btn-outline-secondary{{ hostViewMode == 'interface' ? ' active' }}" data-mode="interface">
                <i class="bi bi-hdd-network me-1"></i>By Interface
            </button>
        </div>
        {% endif %}
        <a href="{{ path('host_index', showDeleted ? {} : {deleted: 1}) }}"
           class="btn btn-sm {{ showDeleted ? 'btn-warning' : 'btn-outline-secondary' }}">
            <i class="bi bi-trash me-1"></i>{{ showDeleted ? 'Show Active' : 'Deleted' }}
        </a>
        {% if not showDeleted %}
        <a href="{{ path('host_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Host
        </a>
        {% endif %}
    </div>
</div>
{% if showDeleted %}
<div class="alert alert-warning py-2 mb-3">
    <i class="bi bi-trash me-1"></i>Showing deleted hosts. <a href="{{ path('host_index') }}">Return to active hosts →</a>
</div>
{% endif %}

<div class="mb-4">
    {# Simple search #}
    <form method="get" action="{{ path('host_index') }}" class="mb-2" id="simple-search-form">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control" placeholder="Search by name, location, subnet, IP address, MAC, or DNS name…" value="{{ query }}">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            {% if query or isAdvanced %}
                <a href="{{ path('host_index', {reset: 1}) }}" class="btn btn-outline-secondary">Clear</a>
            {% endif %}
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#advanced-search"
                    aria-expanded="{{ isAdvanced ? 'true' : 'false' }}">
                <i class="bi bi-sliders me-1"></i>Advanced
            </button>
        </div>
    </form>

    {# Advanced search #}
    <div class="collapse {{ isAdvanced ? 'show' : '' }}" id="advanced-search">
        <form method="get" action="{{ path('host_index') }}">
            <div class="card card-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Host Name</label>
                        <input type="text" name="name" class="form-control form-control-sm" value="{{ criteria.name ?? '' }}" placeholder="e.g. web* or server-01">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Building</label>
                        <select name="building" class="form-select form-select-sm">
                            <option value="">— Any —</option>
                            {% for b in buildings %}
                                <option value="{{ b.id }}" {{ (criteria.building ?? '') == (b.id ~ '') ? 'selected' }}>{{ b.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Room</label>
                        <input type="text" name="room" class="form-control form-control-sm" value="{{ criteria.room ?? '' }}" placeholder="e.g. 101 or 1*">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Subnet</label>
                        <select name="subnet" class="form-select form-select-sm">
                            <option value="">— Any —</option>
                            <option value="none" {{ (criteria.subnet ?? '') == 'none' ? 'selected' }}>— No subnet —</option>
                            {% for subnet in subnets %}
                                <option value="{{ subnet.id }}" {{ (criteria.subnet ?? '') == (subnet.id ~ '') ? 'selected' }}>
                                    {{ subnet }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">IP Address</label>
                        <input type="text" name="ip" class="form-control form-control-sm font-monospace" value="{{ criteria.ip ?? '' }}" placeholder="e.g. 10.0.1.*">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">MAC Address</label>
                        <input type="text" name="mac" class="form-control form-control-sm font-monospace" value="{{ criteria.mac ?? '' }}" placeholder="e.g. aa:bb:*">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">DNS Name</label>
                        <input type="text" name="dns" class="form-control form-control-sm font-monospace" value="{{ criteria.dns ?? '' }}" placeholder="e.g. web*.example.com">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Tag</label>
                        <select name="tag" class="form-select form-select-sm">
                            <option value="">— Any —</option>
                            {% for tag in tags %}
                                <option value="{{ tag.id }}" {{ (criteria.tag ?? '') == (tag.id ~ '') ? 'selected' }}>{{ tag.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a href="{{ path('host_index', {reset: 1}) }}" class="btn btn-sm btn-outline-secondary">Clear</a>
                    <span class="text-muted small ms-2">Use <code>*</code> as a wildcard (e.g. <code>web*</code>, <code>*.example.com</code>)</span>
                </div>
            </div>
        </form>
    </div>
</div>

{% if hosts is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            {% if query %}
                <i class="bi bi-search fs-1 d-block mb-3 opacity-25"></i>
                No hosts matched <strong>{{ query }}</strong>. <a href="{{ path('host_index', {reset: 1}) }}">Clear search →</a>
            {% else %}
                <i class="bi bi-pc-display fs-1 d-block mb-3 opacity-25"></i>
                No hosts yet. <a href="{{ path('host_new') }}">Add the first one →</a>
            {% endif %}
        </div>
    </div>
{% else %}

    {# ── By Host view ── #}
    <div id="view-host" class="list-scroll-card {{ hostViewMode == 'host' ? '' : 'd-none' }}">
        <div class="card">
            <div id="host-bulk-bar" class="card-header d-none py-2">
                <div class="d-flex align-items-center gap-2">
                    <span id="host-selected-count" class="text-muted small">0 hosts selected</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="host-add-tag-btn">
                        <i class="bi bi-tag me-1"></i>Add Tag
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="host-remove-tag-btn">
                        <i class="bi bi-tag me-1"></i>Remove Tag
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger ms-auto" id="host-delete-btn">
                        <i class="bi bi-trash me-1"></i>Delete Selected
                    </button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width:2.25rem">
                                <input type="checkbox" class="form-check-input" id="select-all-hosts" title="Select all on this page">
                            </th>
                            <th style="min-width: 13rem">Name</th>
                            <th>Tags</th>
                            <th>IPv4</th>
                            <th>IPv6</th>
                            <th>DNS Names</th>
                            <th>Last Modified</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for host in hosts %}
                            <tr class="{{ host.deleted ? 'row-deleted' : '' }}">
                                <td class="ps-3">
                                    <input type="checkbox" class="form-check-input bulk-host-cb" value="{{ host.id }}">
                                </td>
                                <td>
                                    <a href="{{ path('host_show', {id: host.id}) }}" class="fw-semibold text-decoration-none">
                                        {{ host.name }}
                                    </a>
                                    {% if host.deleted %}
                                        <span class="badge text-bg-warning ms-1">Deleted</span>
                                    {% endif %}
                                    {% set snipeLink = host.snipeItAssetLink %}
                                    {% if snipeLink and snipeLink.snipeAssetName != host.name %}
                                        <div class="text-muted small"><i class="bi bi-box-seam me-1"></i>{{ snipeLink.snipeAssetName }}</div>
                                    {% endif %}
                                    {% if host.location %}
                                        <div class="text-muted small">{{ host.location }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% for tag in host.tags %}
                                        <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endfor %}
                                </td>
                                <td class="ip-address small">
                                    {% set any_ip = false %}
                                    {% for iface in host.interfaces %}
                                        {% set lease = lease_map[iface.macAddress] ?? null %}
                                        {% set static_ip = iface.ipAddress ? iface.ipAddress.address : null %}
                                        {% set lease_ip = lease ? lease.ipAddress : null %}
                                        {% if static_ip %}
                                            {% set any_ip = true %}
                                            <div>{{ static_ip }}{% if lease_ip and lease_ip != static_ip %} <span class="text-muted">({{ lease_ip }})</span>{% endif %}</div>
                                        {% elseif lease_ip %}
                                            {% set any_ip = true %}
                                            <div class="text-muted">({{ lease_ip }})</div>
                                        {% endif %}
                                    {% endfor %}
                                    {% if not any_ip %}<span class="text-muted">—</span>{% endif %}
                                </td>
                                <td class="ip-address small">
                                    {% set ipv6s = [] %}
                                    {% for iface in host.interfaces %}
                                        {% if iface.ipv6Address %}
                                            {% set ipv6s = ipv6s|merge([iface.ipv6Address.address]) %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if ipv6s is empty %}
                                        <span class="text-muted">—</span>
                                    {% else %}
                                        {% for ip in ipv6s %}<div>{{ ip }}</div>{% endfor %}
                                    {% endif %}
                                </td>
                                <td class="small font-monospace">
                                    {% set fqdns = [] %}
                                    {% for iface in host.interfaces %}
                                        {% for iname in iface.names %}
                                            {% if iname.domain %}
                                                {% set fqdns = fqdns|merge([iname.fullyQualifiedName]) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}
                                    {% if fqdns is empty %}
                                        <span class="text-muted">—</span>
                                    {% else %}
                                        {% for fqdn in fqdns %}<div>{{ fqdn }}</div>{% endfor %}
                                    {% endif %}
                                </td>
                                <td class="text-muted small">
                                    {{ host.updatedAt|date('Y-m-d H:i') }}
                                    {% if host.updatedBy %}<br><span class="text-muted">{{ host.updatedBy }}</span>{% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end align-items-center">
                                        {% if host.deleted %}
                                            <form method="post" action="{{ path('host_restore', {id: host.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('restore_host_' ~ host.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Restore">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        {% else %}
                                            <a href="{{ path('host_edit', {id: host.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('host_delete', {id: host.id}) }}"
                                                  onsubmit="return confirm('Delete host {{ host.name|e('js') }}?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_host_' ~ host.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ _self.pager(pagination) }}
        </div>
    </div>

    {# ── By Interface view ── #}
    <div id="view-interface" class="list-scroll-card {{ hostViewMode == 'interface' ? '' : 'd-none' }}">
        <div class="card">
            <div id="iface-bulk-bar" class="card-header d-none py-2">
                <div class="d-flex align-items-center gap-2">
                    <span id="iface-selected-count" class="text-muted small">0 interfaces selected</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" id="iface-edit-btn"
                            data-bs-toggle="modal" data-bs-target="#bulk-iface-edit-modal">
                        <i class="bi bi-pencil me-1"></i>Edit Selected
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="iface-delete-btn">
                        <i class="bi bi-trash me-1"></i>Delete Selected
                    </button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width:2.25rem">
                                <input type="checkbox" class="form-check-input" id="select-all-ifaces" title="Select all on this page">
                            </th>
                            <th style="min-width: 11rem">Host</th>
                            <th>Tags</th>
                            <th style="min-width: 10rem">Interface</th>
                            <th>Subnet</th>
                            <th>IPv4</th>
                            <th>IPv6</th>
                            <th>DNS Names</th>
                            <th>Last Modified</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for host in hosts %}
                            {% for iface in host.interfaces %}
                                {% set row_deleted = iface.deleted or host.deleted %}
                                <tr class="{{ row_deleted ? 'row-deleted' : '' }}">
                                    <td class="ps-3">
                                        <input type="checkbox" class="form-check-input bulk-iface-cb" value="{{ iface.id }}">
                                    </td>
                                    <td>
                                        <a href="{{ path('host_show', {id: host.id}) }}" class="fw-semibold text-decoration-none">
                                            {{ host.name }}
                                        </a>
                                        {% if host.deleted %}
                                            <span class="badge text-bg-warning ms-1">Deleted</span>
                                        {% endif %}
                                        {% set snipeLink = host.snipeItAssetLink %}
                                        {% if snipeLink and snipeLink.snipeAssetName != host.name %}
                                            <div class="text-muted small"><i class="bi bi-box-seam me-1"></i>{{ snipeLink.snipeAssetName }}</div>
                                        {% endif %}
                                        {% if host.location %}
                                            <div class="text-muted small">{{ host.location }}</div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% for tag in host.tags %}
                                            <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endfor %}
                                    </td>
                                    <td class="small">
                                        {% if iface.name %}
                                            <div class="fw-semibold">{{ iface.name }}</div>
                                        {% endif %}
                                        <div class="font-monospace text-muted">{{ iface.macAddress }}</div>
                                        {% if iface.deleted %}
                                            <span class="badge text-bg-warning mt-1">Interface deleted</span>
                                        {% endif %}
                                    </td>
                                    <td class="small">{{ iface.subnet ? iface.subnet.name : '—' }}</td>
                                    <td class="ip-address small">
                                        {% set lease = lease_map[iface.macAddress] ?? null %}
                                        {% set lease_ip = lease ? lease.ipAddress : null %}
                                        {% if iface.ipAddress %}
                                            {{ iface.ipAddress.address }}
                                            {% if lease_ip and lease_ip != iface.ipAddress.address %}
                                                <span class="text-muted">({{ lease_ip }})</span>
                                            {% endif %}
                                        {% elseif lease_ip %}
                                            <span class="text-muted">({{ lease_ip }})</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="ip-address small">
                                        {% if iface.ipv6Address %}
                                            {{ iface.ipv6Address.address }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="small font-monospace">
                                        {% set fqdns = [] %}
                                        {% for iname in iface.names %}
                                            {% if iname.domain %}
                                                {% set fqdns = fqdns|merge([iname.fullyQualifiedName]) %}
                                            {% endif %}
                                        {% endfor %}
                                        {% if fqdns is empty %}
                                            <span class="text-muted">—</span>
                                        {% else %}
                                            {% for fqdn in fqdns %}<div>{{ fqdn }}</div>{% endfor %}
                                        {% endif %}
                                    </td>
                                    <td class="text-muted small">
                                        {{ iface.updatedAt|date('Y-m-d H:i') }}
                                        {% if iface.updatedBy %}<br><span class="text-muted">{{ iface.updatedBy }}</span>{% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end align-items-center">
                                            {% if row_deleted %}
                                                <form method="post" action="{{ path('interface_restore', {id: iface.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('restore_interface_' ~ iface.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Restore">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <a href="{{ path('interface_edit', {id: iface.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form method="post" action="{{ path('interface_delete', {id: iface.id}) }}"
                                                      onsubmit="return confirm({% if host.interfaces|filter(i => not i.deleted)|length == 1 %}'Delete interface {{ iface.macAddress|e('js') }}? It is the only active interface on {{ host.name|e('js') }}, so the host will also be deleted.'{% else %}'Delete interface {{ iface.macAddress|e('js') }} from {{ host.name|e('js') }}?'{% endif %})">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_interface_' ~ iface.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td class="ps-3"></td>
                                    <td>
                                        <a href="{{ path('host_show', {id: host.id}) }}" class="fw-semibold text-decoration-none">
                                            {{ host.name }}
                                        </a>
                                        {% if host.location %}
                                            <div class="text-muted small">{{ host.location }}</div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% for tag in host.tags %}
                                            <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endfor %}
                                    </td>
                                    <td colspan="6" class="text-muted small fst-italic">No interfaces</td>
                                    <td class="text-muted small">
                                        {{ host.updatedAt|date('Y-m-d H:i') }}
                                        {% if host.updatedBy %}<br><span class="text-muted">{{ host.updatedBy }}</span>{% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end align-items-center">
                                            <a href="{{ path('host_edit', {id: host.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="{{ path('host_delete', {id: host.id}) }}"
                                                  onsubmit="return confirm('Delete host {{ host.name|e('js') }}?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_host_' ~ host.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ _self.pager(pagination) }}
        </div>
    </div>

{% endif %}
</div>{# /list-page-content #}

{# Tag selection modal (shared for add/remove on selected hosts) #}
<div class="modal fade" id="bulk-tag-modal" tabindex="-1" aria-labelledby="bulk-tag-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulk-tag-modal-label">Add Tag to Selected Hosts</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="bulk-tag-select">Tag</label>
                <select id="bulk-tag-select" class="form-select" placeholder="Search tags…"></select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="bulk-tag-submit">Add Tag</button>
            </div>
        </div>
    </div>
</div>

{# Bulk edit interfaces modal #}
<div class="modal fade" id="bulk-iface-edit-modal" tabindex="-1" aria-labelledby="bulk-iface-edit-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulk-iface-edit-modal-label">Bulk Edit Interfaces</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Changes apply to all selected interfaces. Fields left at "Keep current" are unchanged.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="bulk-iface-subnet">Subnet</label>
                    <select id="bulk-iface-subnet" class="form-select">
                        <option value="">— Keep current subnet —</option>
                        {% for subnet in subnets %}
                            <option value="{{ subnet.id }}">{{ subnet.name }}{% if subnet.ipv4Cidr %} ({{ subnet.ipv4Cidr }}){% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header fw-semibold"><i class="bi bi-4-square me-1"></i>IPv4 Assignment</div>
                            <div class="card-body" id="bulk-ipv4-options">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="bulk_ipv4" id="bulk_ipv4_keep" value="keep" checked>
                                    <label class="form-check-label" for="bulk_ipv4_keep">Keep current assignment</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="bulk_ipv4" id="bulk_ipv4_none" value="none">
                                    <label class="form-check-label" for="bulk_ipv4_none">Remove IPv4 address</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="bulk_ipv4" id="bulk_ipv4_auto" value="auto">
                                    <label class="form-check-label" for="bulk_ipv4_auto">Auto-assign next available</label>
                                </div>
                            </div>
                            <p id="bulk-ipv4-container-notice" class="text-muted small px-3 pb-2 mb-0" style="display:none">
                                IP assignment is not available for container subnets.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header fw-semibold"><i class="bi bi-6-square me-1"></i>IPv6 Assignment</div>
                            <div class="card-body" id="bulk-ipv6-options">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="bulk_ipv6" id="bulk_ipv6_keep" value="keep" checked>
                                    <label class="form-check-label" for="bulk_ipv6_keep">Keep current assignment</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="bulk_ipv6" id="bulk_ipv6_none" value="none">
                                    <label class="form-check-label" for="bulk_ipv6_none">Remove IPv6 address</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="bulk_ipv6" id="bulk_ipv6_auto" value="auto">
                                    <label class="form-check-label" for="bulk_ipv6_auto">Auto-assign (EUI-64 from MAC)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="bulk_ipv6" id="bulk_ipv6_auto_v4" value="auto_v4">
                                    <label class="form-check-label" for="bulk_ipv6_auto_v4">Auto-assign (last IPv4 octet)</label>
                                </div>
                            </div>
                            <p id="bulk-ipv6-container-notice" class="text-muted small px-3 pb-2 mb-0" style="display:none">
                                IP assignment is not available for container subnets.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="bulk-iface-edit-submit">
                    <i class="bi bi-check-lg me-1"></i>Apply Changes
                </button>
            </div>
        </div>
    </div>
</div>

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<script>
// --- View mode toggle ---
document.getElementById('view-mode-toggle')?.addEventListener('click', function (e) {
    const btn = e.target.closest('[data-mode]');
    if (!btn) return;
    const mode = btn.dataset.mode;
    this.querySelectorAll('[data-mode]').forEach(b => b.classList.toggle('active', b === btn));
    document.getElementById('view-host').classList.toggle('d-none', mode !== 'host');
    document.getElementById('view-interface').classList.toggle('d-none', mode !== 'interface');
    fetch('/api/preference/host-view-mode', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode }),
    });
});

// --- Bulk selection ---
const hostSelected = new Set();
const ifaceSelected = new Set();

function updateHostToolbar() {
    const count = hostSelected.size;
    document.getElementById('host-bulk-bar').classList.toggle('d-none', count === 0);
    document.getElementById('host-selected-count').textContent =
        count + ' host' + (count !== 1 ? 's' : '') + ' selected';
    const all = document.querySelectorAll('.bulk-host-cb');
    const sa  = document.getElementById('select-all-hosts');
    if (sa) {
        sa.checked       = all.length > 0 && count === all.length;
        sa.indeterminate = count > 0 && count < all.length;
    }
}

function updateIfaceToolbar() {
    const count = ifaceSelected.size;
    document.getElementById('iface-bulk-bar').classList.toggle('d-none', count === 0);
    document.getElementById('iface-selected-count').textContent =
        count + ' interface' + (count !== 1 ? 's' : '') + ' selected';
    const all = document.querySelectorAll('.bulk-iface-cb');
    const sa  = document.getElementById('select-all-ifaces');
    if (sa) {
        sa.checked       = all.length > 0 && count === all.length;
        sa.indeterminate = count > 0 && count < all.length;
    }
}

document.addEventListener('change', function (e) {
    if (e.target.matches('.bulk-host-cb')) {
        e.target.checked ? hostSelected.add(e.target.value) : hostSelected.delete(e.target.value);
        updateHostToolbar();
    } else if (e.target.matches('.bulk-iface-cb')) {
        e.target.checked ? ifaceSelected.add(e.target.value) : ifaceSelected.delete(e.target.value);
        updateIfaceToolbar();
    } else if (e.target.id === 'select-all-hosts') {
        document.querySelectorAll('.bulk-host-cb').forEach(cb => {
            cb.checked = e.target.checked;
            e.target.checked ? hostSelected.add(cb.value) : hostSelected.delete(cb.value);
        });
        updateHostToolbar();
    } else if (e.target.id === 'select-all-ifaces') {
        document.querySelectorAll('.bulk-iface-cb').forEach(cb => {
            cb.checked = e.target.checked;
            e.target.checked ? ifaceSelected.add(cb.value) : ifaceSelected.delete(cb.value);
        });
        updateIfaceToolbar();
    }
});

// --- Bulk host delete ---
document.getElementById('host-delete-btn')?.addEventListener('click', async function () {
    const count = hostSelected.size;
    if (!confirm(`Delete ${count} host${count !== 1 ? 's' : ''} and all their interfaces? This cannot be undone.`)) return;
    const resp = await fetch('{{ path('host_bulk') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', ids: [...hostSelected], _token: '{{ csrf_token('bulk_hosts') }}' }),
    });
    const data = await resp.json();
    if (resp.ok) { location.reload(); } else { alert(data.error ?? 'Error'); }
});

// --- Bulk interface delete ---
document.getElementById('iface-delete-btn')?.addEventListener('click', async function () {
    const count = ifaceSelected.size;
    if (!confirm(`Delete ${count} interface${count !== 1 ? 's' : ''}? This cannot be undone.`)) return;
    const resp = await fetch('{{ path('interface_bulk') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', ids: [...ifaceSelected], _token: '{{ csrf_token('bulk_interfaces') }}' }),
    });
    const data = await resp.json();
    if (resp.ok) { location.reload(); } else { alert(data.error ?? 'Error'); }
});

// --- Bulk interface edit modal ---
(function () {
    const containerSubnetIds = new Set({{ containerSubnetIds|default([])|json_encode }});
    const subnetSelect = document.getElementById('bulk-iface-subnet');

    function setBulkContainerMode(isContainer) {
        ['ipv4', 'ipv6'].forEach(prefix => {
            const options = document.getElementById('bulk-' + prefix + '-options');
            const notice  = document.getElementById('bulk-' + prefix + '-container-notice');
            if (options) options.style.display = isContainer ? 'none' : '';
            if (notice)  notice.style.display  = isContainer ? '' : 'none';
        });
        if (isContainer) {
            document.getElementById('bulk_ipv4_keep').checked = true;
            document.getElementById('bulk_ipv6_keep').checked = true;
        }
    }

    if (subnetSelect) {
        subnetSelect.addEventListener('change', function () {
            const val = parseInt(this.value, 10);
            setBulkContainerMode(val && containerSubnetIds.has(val));
        });
    }

    document.getElementById('bulk-iface-edit-submit')?.addEventListener('click', async function () {
        const subnetId     = subnetSelect?.value || '';
        const ipv4Mode     = document.querySelector('input[name="bulk_ipv4"]:checked')?.value ?? 'keep';
        const ipv6Mode     = document.querySelector('input[name="bulk_ipv6"]:checked')?.value ?? 'keep';
        const count        = ifaceSelected.size;

        const resp = await fetch('{{ path('interface_bulk') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'edit',
                ids: [...ifaceSelected],
                _token: '{{ csrf_token('bulk_interfaces') }}',
                subnet_id: subnetId || null,
                ipv4Assignment: ipv4Mode,
                ipv6Assignment: ipv6Mode,
            }),
        });
        const data = await resp.json();
        if (resp.ok) {
            location.reload();
        } else {
            alert(data.error ?? 'Error updating interfaces');
        }
    });

    // Reset modal state when it opens
    document.getElementById('bulk-iface-edit-modal')?.addEventListener('show.bs.modal', function () {
        if (subnetSelect) subnetSelect.value = '';
        document.getElementById('bulk_ipv4_keep').checked = true;
        document.getElementById('bulk_ipv6_keep').checked = true;
        setBulkContainerMode(false);
    });
})();

// --- Tag modal (add / remove on selected hosts) ---
const bulkTagModalEl = document.getElementById('bulk-tag-modal');
let bulkTagModal = null;
let bulkTagSelect = null;
let bulkTagAction = 'add-tag';

if (bulkTagModalEl) {
    bulkTagModal = new bootstrap.Modal(bulkTagModalEl);

    bulkTagSelect = new TomSelect('#bulk-tag-select', {
        valueField: 'value',
        labelField: 'text',
        searchField: 'text',
        maxOptions: 20,
        plugins: ['remove_button'],
        load(query, callback) {
            fetch('/api/tags?q=' + encodeURIComponent(query))
                .then(r => r.json()).then(callback).catch(() => callback());
        },
        onInitialize() {
            fetch('/api/tags').then(r => r.json()).then(tags => this.addOptions(tags));
        },
    });

    document.getElementById('host-add-tag-btn')?.addEventListener('click', function () {
        bulkTagAction = 'add-tag';
        document.getElementById('bulk-tag-modal-label').textContent = 'Add Tag to Selected Hosts';
        document.getElementById('bulk-tag-submit').textContent = 'Add Tag';
        bulkTagSelect.clear();
        bulkTagModal.show();
    });

    document.getElementById('host-remove-tag-btn')?.addEventListener('click', function () {
        bulkTagAction = 'remove-tag';
        document.getElementById('bulk-tag-modal-label').textContent = 'Remove Tag from Selected Hosts';
        document.getElementById('bulk-tag-submit').textContent = 'Remove Tag';
        bulkTagSelect.clear();
        bulkTagModal.show();
    });

    document.getElementById('bulk-tag-submit')?.addEventListener('click', async function () {
        const tagId = bulkTagSelect.getValue();
        if (!tagId) { alert('Please select a tag.'); return; }
        const resp = await fetch('{{ path('host_bulk') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: bulkTagAction,
                ids: [...hostSelected],
                tagId,
                _token: '{{ csrf_token('bulk_hosts') }}',
            }),
        });
        const data = await resp.json();
        if (resp.ok) { bulkTagModal.hide(); location.reload(); }
        else { alert(data.error ?? 'Error'); }
    });
}
</script>
{% endblock scripts %}
{% endblock content %}
