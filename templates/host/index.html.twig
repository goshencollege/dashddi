{% extends 'base.html.twig' %}
{% block title %}Hosts{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-pc-display me-2"></i>Hosts</h1>
    <a href="{{ path('host_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Host
    </a>
</div>

<form method="get" action="{{ path('host_index') }}" class="mb-4">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="search" name="q" class="form-control" placeholder="Search by name, location, subnet, IP address, or MAC…" value="{{ query }}">
        {% if query %}
            <a href="{{ path('host_index') }}" class="btn btn-outline-secondary">Clear</a>
        {% else %}
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        {% endif %}
    </div>
</form>

{% if hosts is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            {% if query %}
                <i class="bi bi-search fs-1 d-block mb-3 opacity-25"></i>
                No hosts matched <strong>{{ query }}</strong>. <a href="{{ path('host_index') }}">Clear search →</a>
            {% else %}
                <i class="bi bi-pc-display fs-1 d-block mb-3 opacity-25"></i>
                No hosts yet. <a href="{{ path('host_new') }}">Add the first one →</a>
            {% endif %}
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="">
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th>IP Addresses</th>
                        <th>Added</th>
                        <th>Last Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for host in hosts %}
                        <tr>
                            <td>
                                <a href="{{ path('host_show', {id: host.id}) }}" class="fw-semibold text-decoration-none">
                                    {{ host.name }}
                                </a>
                            </td>
                            <td class="text-muted">{{ host.location ?: '—' }}</td>
                            <td class="ip-address small">
                                {% set ips = [] %}
                                {% for iface in host.interfaces %}
                                    {% if iface.ipAddress %}
                                        {% set ips = ips|merge([iface.ipAddress.address]) %}
                                    {% endif %}
                                    {% if iface.ipv6Address %}
                                        {% set ips = ips|merge([iface.ipv6Address.address]) %}
                                    {% endif %}
                                {% endfor %}
                                {% if ips is empty %}
                                    <span class="text-muted">—</span>
                                {% else %}
                                    {% for ip in ips %}
                                        <div>{{ ip }}</div>
                                    {% endfor %}
                                {% endif %}
                            </td>
                            <td class="text-muted small">
                                {{ host.createdAt|date('Y-m-d') }}
                                {% if host.createdBy %}<br><span class="text-muted">{{ host.createdBy }}</span>{% endif %}
                            </td>
                            <td class="text-muted small">
                                {{ host.updatedAt|date('Y-m-d H:i') }}
                                {% if host.updatedBy %}<br><span class="text-muted">{{ host.updatedBy }}</span>{% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('host_edit', {id: host.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('host_delete', {id: host.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Delete host {{ host.name|e('js') }}?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_host_' ~ host.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if query %}
            <div class="card-footer text-muted small">{{ hosts|length }} result{{ hosts|length != 1 ? 's' }} for "{{ query }}"</div>
        {% endif %}
    </div>
{% endif %}
{% endblock %}
