{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<script>
// ============================================================
// Filter Builder — OR-groups condition builder
// ============================================================

const FILTER_BUILDINGS = [{% for b in buildings %}{"id":{{ b.id }},"name":{{ b.name|json_encode|raw }}}{% if not loop.last %},{% endif %}{% endfor %}];
const FILTER_SUBNETS   = [{"id":"none","name":"— No subnet —"}{% for s in subnets %},{"id":{{ s.id }},"name":{{ s.name|json_encode|raw }}}{% endfor %}];
const FILTER_TAGS      = [{% for t in tags %}{"id":{{ t.id }},"name":{{ t.name|json_encode|raw }}}{% if not loop.last %},{% endif %}{% endfor %}];

const FIELDS = {
    name:          { label: 'Host Name',     type: 'text' },
    building:      { label: 'Building',      type: 'select', options: FILTER_BUILDINGS },
    room:          { label: 'Room',          type: 'text' },
    subnet:        { label: 'Subnet',        type: 'select', options: FILTER_SUBNETS },
    ip:            { label: 'IP Address',    type: 'text' },
    mac:           { label: 'MAC Address',   type: 'text' },
    dns:           { label: 'DNS Name',      type: 'text' },
    tag:           { label: 'Tag',           type: 'tag', options: FILTER_TAGS },
    dhcp_mismatch: { label: 'DHCP Mismatch', type: 'bool' },
    last_dhcp:     { label: 'Last DHCP',     type: 'date' },
    last_auth:     { label: 'Last Auth',     type: 'date' },
    switch_ip:     { label: 'Switch IP',     type: 'text' },
    switch_port:   { label: 'Switch Port',   type: 'text' },
};

const TEXT_OPS = [
    { value: 'contains',         label: 'contains',             wrap: v => `*${v}*` },
    { value: 'not_contains',     label: 'does not contain',     wrap: v => `!*${v}*` },
    { value: 'starts_with',      label: 'starts with',          wrap: v => `${v}*` },
    { value: 'not_starts_with',  label: 'does not start with',  wrap: v => `!${v}*` },
    { value: 'ends_with',        label: 'ends with',            wrap: v => `*${v}` },
    { value: 'not_ends_with',    label: 'does not end with',    wrap: v => `!*${v}` },
    { value: 'equals',           label: 'equals',               wrap: v => v },
    { value: 'not_equals',       label: 'does not equal',       wrap: v => `!${v}` },
];

const SELECT_OPS = [
    { value: 'is',     label: 'is',     wrap: v => v },
    { value: 'is_not', label: 'is not', wrap: v => `!${v}` },
];

const DATE_OPS = [
    { value: 'after',     label: 'after',     inputs: 1, wrap: v => `>${v[0]}` },
    { value: 'before',    label: 'before',    inputs: 1, wrap: v => `<${v[0]}` },
    { value: 'between',   label: 'between',   inputs: 2, wrap: v => `${v[0]}..${v[1]}` },
    { value: 'never',     label: 'never',     inputs: 0, wrap: () => 'null' },
    { value: 'has_value', label: 'has value', inputs: 0, wrap: () => '!null' },
];

const BOOL_OPS = [
    { value: 'true',  label: 'is true'  },
    { value: 'false', label: 'is false' },
];

// Tag field: "is/is not" show a dropdown; text ops show a free-text input.
// Both serialise to a name string and match via LIKE in the repository.
const TAG_OPS = [
    { value: 'is',              label: 'is',                  inputType: 'select', wrap: v => `${v}` },
    { value: 'is_not',          label: 'is not',              inputType: 'select', wrap: v => `!${v}` },
    { value: 'contains',        label: 'contains',            inputType: 'text',   wrap: v => `*${v}*` },
    { value: 'not_contains',    label: 'does not contain',    inputType: 'text',   wrap: v => `!*${v}*` },
    { value: 'starts_with',     label: 'starts with',         inputType: 'text',   wrap: v => `${v}*` },
    { value: 'not_starts_with', label: 'does not start with', inputType: 'text',   wrap: v => `!${v}*` },
    { value: 'ends_with',       label: 'ends with',           inputType: 'text',   wrap: v => `*${v}` },
    { value: 'not_ends_with',   label: 'does not end with',   inputType: 'text',   wrap: v => `!*${v}` },
    { value: 'equals',          label: 'equals',              inputType: 'text',   wrap: v => `${v}` },
    { value: 'not_equals',      label: 'does not equal',      inputType: 'text',   wrap: v => `!${v}` },
];

function getOps(type) {
    if (type === 'text')   return TEXT_OPS;
    if (type === 'select') return SELECT_OPS;
    if (type === 'date')   return DATE_OPS;
    if (type === 'tag')    return TAG_OPS;
    if (type === 'bool')   return BOOL_OPS;
    return [];
}

// Parse a rawValue back into {op, bareValues[]} for pre-filling the builder UI.
function parseRawValue(type, raw) {
    if (type === 'flag') return { op: 'is_set', bareValues: [] };
    if (type === 'bool') return { op: raw === '!1' ? 'false' : 'true', bareValues: [] };
    if (type === 'date') {
        if (raw === 'null')  return { op: 'never',     bareValues: [] };
        if (raw === '!null') return { op: 'has_value', bareValues: [] };
        if (raw.startsWith('>')) return { op: 'after',  bareValues: [raw.slice(1)] };
        if (raw.startsWith('<')) return { op: 'before', bareValues: [raw.slice(1)] };
        if (raw.includes('..')) {
            const [d1, d2] = raw.split('..', 2);
            return { op: 'between', bareValues: [d1, d2] };
        }
        return { op: 'after', bareValues: [raw] };
    }
    if (type === 'select') {
        if (raw.startsWith('!')) return { op: 'is_not', bareValues: [raw.slice(1)] };
        return { op: 'is', bareValues: [raw] };
    }
    if (type === 'tag') {
        const neg = raw.startsWith('!');
        const v   = neg ? raw.slice(1) : raw;
        const sw  = v.startsWith('*'), ew = v.endsWith('*');
        if (sw && ew && v.length > 2) return { op: neg ? 'not_contains'    : 'contains',    bareValues: [v.slice(1, -1)] };
        if (ew && !sw)                 return { op: neg ? 'not_starts_with' : 'starts_with', bareValues: [v.slice(0, -1)] };
        if (sw && !ew)                 return { op: neg ? 'not_ends_with'   : 'ends_with',   bareValues: [v.slice(1)] };
        // no wildcards: use dropdown if name matches a known tag, otherwise text equals
        const knownTag = (FILTER_TAGS || []).some(t => String(t.name) === v);
        if (knownTag) return { op: neg ? 'is_not' : 'is', bareValues: [v] };
        return { op: neg ? 'not_equals' : 'equals', bareValues: [v] };
    }
    // text
    const neg = raw.startsWith('!');
    const v   = neg ? raw.slice(1) : raw;
    const sw  = v.startsWith('*'), ew = v.endsWith('*');
    if (sw && ew && v.length > 2) return { op: neg ? 'not_contains'    : 'contains',    bareValues: [v.slice(1, -1)] };
    if (ew && !sw)                 return { op: neg ? 'not_starts_with' : 'starts_with', bareValues: [v.slice(0, -1)] };
    if (sw && !ew)                 return { op: neg ? 'not_ends_with'   : 'ends_with',   bareValues: [v.slice(1)] };
    return { op: neg ? 'not_equals' : 'equals', bareValues: [v] };
}

// Serialize builder rows back to the raw q-token value.
function buildRawValue(fieldKey, opValue, bareValues) {
    const def = FIELDS[fieldKey];
    if (!def) return '';
    if (def.type === 'flag') return '1';
    if (def.type === 'bool') return opValue === 'false' ? '!1' : '1';
    const ops = getOps(def.type);
    const op  = ops.find(o => o.value === opValue);
    return op ? op.wrap(bareValues) : '';
}

// ------- q-string parse/build -------

function splitOrRespectingParens(str) {
    const sep = ' OR ', parts = [];
    let depth = 0, cur = '';
    for (let i = 0; i < str.length; i++) {
        if      (str[i] === '(') { depth++; cur += str[i]; }
        else if (str[i] === ')') { depth--; cur += str[i]; }
        else if (depth === 0 && str.startsWith(sep, i)) { parts.push(cur); cur = ''; i += sep.length - 1; }
        else { cur += str[i]; }
    }
    if (cur) parts.push(cur);
    return parts;
}

function parseQ(q) {
    if (!q || !q.trim()) return [];
    const groups = [];
    for (let part of splitOrRespectingParens(q)) {
        part = part.trim();
        if (part.startsWith('(') && part.endsWith(')')) part = part.slice(1, -1).trim();
        const conditions = [];
        for (const token of part.split(' AND ')) {
            const t = token.trim();
            const m = t.match(/^([a-z_]+):(\"[^\"]*\"|[^\s]+)$/);
            if (!m || !FIELDS[m[1]]) continue;
            let raw = m[2];
            if (raw.startsWith('"') && raw.endsWith('"')) raw = raw.slice(1, -1);
            conditions.push({ field: m[1], rawValue: raw });
        }
        if (conditions.length) groups.push(conditions);
    }
    return groups;
}

function buildQ(groups) {
    if (!groups.length) return '';
    const strs = groups.map(g =>
        g.map(c => {
            const v = c.rawValue.includes(' ') ? `"${c.rawValue}"` : c.rawValue;
            return `${c.field}:${v}`;
        }).join(' AND ')
    );
    if (strs.length === 1) return strs[0];
    return strs.map((s, i) => groups[i].length > 1 ? `(${s})` : s).join(' OR ');
}

// ------- DOM helpers -------

function getBuilderGroups() {
    const groups = [];
    document.querySelectorAll('#filter-builder .filter-group').forEach(groupEl => {
        const conditions = [];
        groupEl.querySelectorAll('.filter-row').forEach(rowEl => {
            const fieldKey = rowEl.querySelector('.field-sel').value;
            const def = FIELDS[fieldKey];
            if (!def) return;
            let rawValue;
            if (def.type === 'flag') {
                rawValue = '1';
            } else if (def.type === 'bool') {
                const opValue = rowEl.querySelector('.op-sel').value;
                rawValue = opValue === 'false' ? '!1' : '1';
            } else if (def.type === 'date') {
                const opValue = rowEl.querySelector('.op-sel').value;
                const inputs  = Array.from(rowEl.querySelectorAll('.date-input')).map(i => i.value).filter(Boolean);
                rawValue = buildRawValue(fieldKey, opValue, inputs);
                if (!rawValue) return;
            } else if (def.type === 'select') {
                const opValue = rowEl.querySelector('.op-sel').value;
                const sel     = rowEl.querySelector('.val-sel');
                if (!sel || !sel.value) return;
                rawValue = buildRawValue(fieldKey, opValue, [sel.value]);
            } else if (def.type === 'tag') {
                const opValue = rowEl.querySelector('.op-sel').value;
                const tagOp   = TAG_OPS.find(o => o.value === opValue);
                if (tagOp && tagOp.inputType === 'select') {
                    const sel = rowEl.querySelector('.val-sel');
                    if (!sel || !sel.value) return;
                    rawValue = buildRawValue(fieldKey, opValue, [sel.value]);
                } else {
                    const inp = rowEl.querySelector('.val-input');
                    if (!inp || !inp.value.trim()) return;
                    rawValue = buildRawValue(fieldKey, opValue, [inp.value.trim()]);
                }
            } else {
                const opValue = rowEl.querySelector('.op-sel').value;
                const inp     = rowEl.querySelector('.val-input');
                if (!inp || !inp.value.trim()) return;
                rawValue = buildRawValue(fieldKey, opValue, [inp.value.trim()]);
            }
            conditions.push({ field: fieldKey, rawValue });
        });
        if (conditions.length) groups.push(conditions);
    });
    return groups;
}

function builderSearch() {
    const q = buildQ(getBuilderGroups());
    document.getElementById('q-input').value = q;
    document.getElementById('simple-search-form').submit();
}

function updateGroupSeparators() {
    document.querySelectorAll('#filter-builder .filter-group').forEach((g, i) => {
        const sep = g.querySelector('.filter-or-sep');
        if (sep) sep.style.display = i === 0 ? 'none' : '';
    });
}

function updateRemoveButtons() {
    const builder    = document.getElementById('filter-builder');
    const groupCount = builder.querySelectorAll('.filter-group').length;
    builder.querySelectorAll('.filter-group').forEach(groupEl => {
        const btn = groupEl.querySelector('.remove-group-btn');
        if (btn) btn.style.display = groupCount <= 1 ? 'none' : '';
    });
}

function updateValueArea(rowEl, fieldKey, opValue, bareValues) {
    const def = FIELDS[fieldKey];
    const area = rowEl.querySelector('.value-area');
    area.innerHTML = '';

    if (def.type === 'flag' || def.type === 'bool') return;

    if (def.type === 'select') {
        const sel = document.createElement('select');
        sel.className = 'form-select form-select-sm val-sel';
        sel.style.maxWidth = '220px';
        const ph = new Option('— Select —', '');
        sel.appendChild(ph);
        (def.options || []).forEach(opt => sel.appendChild(new Option(opt.name, opt.id)));
        if (bareValues && bareValues[0]) sel.value = String(bareValues[0]);
        area.appendChild(sel);
        return;
    }

    if (def.type === 'tag') {
        const tagOp = TAG_OPS.find(o => o.value === opValue);
        if (tagOp && tagOp.inputType === 'select') {
            const sel = document.createElement('select');
            sel.className = 'form-select form-select-sm val-sel';
            sel.style.maxWidth = '220px';
            sel.appendChild(new Option('— Select —', ''));
            (def.options || []).forEach(opt => sel.appendChild(new Option(opt.name, opt.name)));
            if (bareValues && bareValues[0]) sel.value = String(bareValues[0]);
            area.appendChild(sel);
        } else {
            const inp = document.createElement('input');
            inp.type = 'text'; inp.className = 'form-control form-control-sm val-input'; inp.style.maxWidth = '220px';
            if (bareValues && bareValues[0] !== undefined) inp.value = bareValues[0];
            inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); builderSearch(); } });
            area.appendChild(inp);
        }
        return;
    }

    if (def.type === 'date') {
        const dateOp = DATE_OPS.find(o => o.value === opValue);
        if (!dateOp || dateOp.inputs === 0) return;
        const makeDate = (val) => {
            const inp = document.createElement('input');
            inp.type = 'date'; inp.className = 'form-control form-control-sm date-input'; inp.style.maxWidth = '160px';
            if (val) inp.value = val;
            return inp;
        };
        if (dateOp.inputs === 1) {
            area.appendChild(makeDate(bareValues?.[0]));
        } else {
            area.appendChild(makeDate(bareValues?.[0]));
            const lbl = document.createElement('span');
            lbl.className = 'small text-muted align-self-center'; lbl.textContent = 'and';
            area.appendChild(lbl);
            area.appendChild(makeDate(bareValues?.[1]));
        }
        return;
    }

    // text
    const inp = document.createElement('input');
    inp.type = 'text'; inp.className = 'form-control form-control-sm val-input'; inp.style.maxWidth = '220px';
    if (bareValues && bareValues[0] !== undefined) inp.value = bareValues[0];
    inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); builderSearch(); } });
    area.appendChild(inp);
}

function updateRow(rowEl, fieldKey, rawValue) {
    const def = FIELDS[fieldKey];
    if (!def) return;
    rowEl.querySelector('.field-sel').value = fieldKey;

    const opSel = rowEl.querySelector('.op-sel');
    opSel.innerHTML = '';
    opSel.style.display = (def.type === 'flag') ? 'none' : '';

    let parsedOp = null, parsedBare = [];
    if (rawValue != null) {
        const p = parseRawValue(def.type, rawValue);
        parsedOp = p.op; parsedBare = p.bareValues;
    }

    const ops     = getOps(def.type);
    const defOp   = def.type === 'date' ? 'after' : (def.type === 'select' || def.type === 'tag' ? 'is' : def.type === 'bool' ? 'true' : 'contains');
    ops.forEach(o => opSel.appendChild(new Option(o.label, o.value)));
    opSel.value = parsedOp || defOp;

    updateValueArea(rowEl, fieldKey, opSel.value, parsedBare);
}

function readCurrentBareValues(rowEl) {
    const dates = Array.from(rowEl.querySelectorAll('.date-input')).map(i => i.value);
    if (dates.length) return dates;
    const sel = rowEl.querySelector('.val-sel');
    if (sel) return [sel.value];
    const inp = rowEl.querySelector('.val-input');
    if (inp) return [inp.value];
    return [];
}

function addCondition(groupEl, fieldKey, rawValue) {
    const conditionsEl = groupEl.querySelector('.filter-conditions');
    const rowEl = document.createElement('div');
    rowEl.className = 'filter-row d-flex gap-2 align-items-center mb-1 flex-wrap';

    const fieldSel = document.createElement('select');
    fieldSel.className = 'form-select form-select-sm field-sel';
    fieldSel.style.maxWidth = '155px';
    Object.entries(FIELDS).forEach(([k, d]) => {
        fieldSel.appendChild(new Option(d.label, k, false, k === (fieldKey || 'name')));
    });

    const opSel = document.createElement('select');
    opSel.className = 'form-select form-select-sm op-sel';
    opSel.style.maxWidth = '185px';

    const valueArea = document.createElement('div');
    valueArea.className = 'value-area d-flex gap-1 align-items-center';
    valueArea.style.minWidth = '160px';

    const andLabel = document.createElement('span');
    andLabel.className = 'and-label text-muted small fw-bold';
    andLabel.style.cssText = 'min-width:2.2rem;display:inline-block';

    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-sm btn-outline-danger remove-row-btn py-0';
    removeBtn.title = 'Remove condition';
    removeBtn.innerHTML = '<i class="bi bi-x"></i>';
    removeBtn.addEventListener('click', () => {
        conditionsEl.removeChild(rowEl);
        const builder = document.getElementById('filter-builder');
        if (!conditionsEl.querySelector('.filter-row')) {
            builder.removeChild(groupEl);
            updateGroupSeparators();
            if (!builder.querySelector('.filter-group')) addGroup([]);
        } else {
            updateAndLabels(groupEl);
        }
        updateRemoveButtons();
    });

    rowEl.appendChild(removeBtn);
    rowEl.appendChild(andLabel);
    rowEl.appendChild(fieldSel);
    rowEl.appendChild(opSel);
    rowEl.appendChild(valueArea);
    conditionsEl.appendChild(rowEl);

    updateRow(rowEl, fieldKey || 'name', rawValue != null ? rawValue : null);

    fieldSel.addEventListener('change', () => updateRow(rowEl, fieldSel.value, null));
    opSel.addEventListener('change', () => {
        const bare = readCurrentBareValues(rowEl);
        updateValueArea(rowEl, fieldSel.value, opSel.value, bare);
    });
    updateAndLabels(groupEl);
    updateRemoveButtons();
}

function updateAndLabels(groupEl) {
    groupEl.querySelectorAll('.filter-row').forEach((row, i) => {
        const lbl = row.querySelector('.and-label');
        if (lbl) lbl.textContent = i === 0 ? '' : 'AND';
    });
}

function addGroup(conditions) {
    const builder  = document.getElementById('filter-builder');
    const isFirst  = !builder.querySelector('.filter-group');
    const groupEl  = document.createElement('div');
    groupEl.className = 'filter-group mb-2';

    const sep = document.createElement('div');
    sep.className = 'text-muted small fw-bold my-1 filter-or-sep';
    sep.textContent = 'OR';
    sep.style.display = isFirst ? 'none' : '';

    const card = document.createElement('div');
    card.className = 'card';
    const cardBody = document.createElement('div');
    cardBody.className = 'card-body py-2 px-3';

    const conditionsEl = document.createElement('div');
    conditionsEl.className = 'filter-conditions';

    const footer = document.createElement('div');
    footer.className = 'd-flex align-items-center justify-content-between mt-1';

    const addCondBtn = document.createElement('button');
    addCondBtn.type = 'button';
    addCondBtn.className = 'btn btn-link btn-sm p-0 text-secondary';
    addCondBtn.innerHTML = '<i class="bi bi-plus-circle me-1"></i>Add condition';
    addCondBtn.addEventListener('click', () => addCondition(groupEl));

    const removeGroupBtn = document.createElement('button');
    removeGroupBtn.type = 'button';
    removeGroupBtn.className = 'btn btn-sm btn-link text-danger p-0 remove-group-btn';
    removeGroupBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i>Remove group';
    removeGroupBtn.addEventListener('click', () => {
        builder.removeChild(groupEl);
        updateGroupSeparators();
        updateRemoveButtons();
    });

    footer.appendChild(addCondBtn);
    footer.appendChild(removeGroupBtn);

    cardBody.appendChild(conditionsEl);
    cardBody.appendChild(footer);
    card.appendChild(cardBody);
    groupEl.appendChild(sep);
    groupEl.appendChild(card);
    builder.appendChild(groupEl);

    if (conditions && conditions.length) {
        conditions.forEach(c => addCondition(groupEl, c.field, c.rawValue));
    } else {
        addCondition(groupEl);
    }

    updateRemoveButtons();
}

function initBuilder() {
    const qInput = document.getElementById('q-input');
    if (!qInput) return;
    const groups = parseQ(qInput.value);
    if (groups.length) {
        groups.forEach(g => addGroup(g));
    } else {
        addGroup([]);
    }
}

document.getElementById('add-group-btn').addEventListener('click', () => addGroup([]));
initBuilder();
</script>
<script>
// --- Tree expand/collapse (persisted in localStorage; default: expanded) ---
const collapsedHosts = new Set(
    JSON.parse(localStorage.getItem('host-tree-collapsed') || '[]')
);

function applyCollapseState() {
    document.querySelectorAll('.host-row').forEach(row => {
        const id = row.dataset.hostId;
        const collapsed = collapsedHosts.has(id);
        const icon = row.querySelector('.tree-toggle i');
        if (icon) icon.className = collapsed ? 'bi bi-chevron-right' : 'bi bi-chevron-down';
        document.querySelectorAll(`.iface-row[data-parent-host="${id}"]`).forEach(r => {
            r.classList.toggle('d-none', collapsed);
        });
    });
}

document.addEventListener('click', function (e) {
    const btn = e.target.closest('.tree-toggle');
    if (!btn) return;
    const id = btn.dataset.host;
    collapsedHosts.has(id) ? collapsedHosts.delete(id) : collapsedHosts.add(id);
    localStorage.setItem('host-tree-collapsed', JSON.stringify([...collapsedHosts]));
    applyCollapseState();
});

applyCollapseState();

document.getElementById('expand-all-btn')?.addEventListener('click', function () {
    collapsedHosts.clear();
    localStorage.setItem('host-tree-collapsed', '[]');
    applyCollapseState();
});

document.getElementById('collapse-all-btn')?.addEventListener('click', function () {
    document.querySelectorAll('.host-row[data-host-id]').forEach(r => collapsedHosts.add(r.dataset.hostId));
    localStorage.setItem('host-tree-collapsed', JSON.stringify([...collapsedHosts]));
    applyCollapseState();
});

// --- Group hover ---
let hoveredGroupId = null;
const treeTable = document.querySelector('.host-tree-table');

treeTable?.addEventListener('mouseover', function (e) {
    const row = e.target.closest('tr.host-row, tr.iface-row');
    if (!row) return;
    const id = row.dataset.hostId || row.dataset.parentHost;
    if (!id) return;

    if (id !== hoveredGroupId) {
        treeTable.querySelectorAll('.group-hovered, .row-hovered')
            .forEach(r => r.classList.remove('group-hovered', 'row-hovered'));
        treeTable.querySelector(`.host-row[data-host-id="${id}"]`)
            ?.classList.add('group-hovered');
        treeTable.querySelectorAll(`.iface-row[data-parent-host="${id}"]`)
            .forEach(r => r.classList.add('group-hovered'));
        hoveredGroupId = id;
    }

    treeTable.querySelectorAll('.row-hovered')
        .forEach(r => { r.classList.remove('row-hovered'); r.classList.add('group-hovered'); });
    row.classList.replace('group-hovered', 'row-hovered');
});

treeTable?.addEventListener('mouseleave', function () {
    treeTable.querySelectorAll('.group-hovered, .row-hovered')
        .forEach(r => r.classList.remove('group-hovered', 'row-hovered'));
    hoveredGroupId = null;
});

// --- Bulk selection ---
const hostSelected = new Set();
const ifaceSelected = new Set();

function updateBulkBar() {
    const hCount = hostSelected.size;
    const iCount = ifaceSelected.size;
    const any = hCount > 0 || iCount > 0;
    document.getElementById('host-bulk-section').classList.toggle('d-none', hCount === 0);
    document.getElementById('iface-bulk-section').classList.toggle('d-none', iCount === 0);
    document.getElementById('bulk-bar-separator').classList.toggle('d-none', hCount === 0 || iCount === 0);
    document.getElementById('bulk-clear-btn').classList.toggle('d-none', !any);
    document.getElementById('host-merge-btn')?.classList.toggle('d-none', hCount < 2);
    document.getElementById('host-selected-count').textContent =
        hCount + ' host' + (hCount !== 1 ? 's' : '') + ' selected';
    document.getElementById('iface-selected-count').textContent =
        iCount + ' interface' + (iCount !== 1 ? 's' : '') + ' selected';
    const allHosts = document.querySelectorAll('.bulk-host-cb');
    const saHosts  = document.getElementById('select-all-hosts');
    if (saHosts) {
        saHosts.checked       = allHosts.length > 0 && hCount === allHosts.length;
        saHosts.indeterminate = hCount > 0 && hCount < allHosts.length;
    }
    const allIfaces = document.querySelectorAll('.bulk-iface-cb');
    const saIfaces  = document.getElementById('select-all-ifaces');
    if (saIfaces) {
        saIfaces.checked       = allIfaces.length > 0 && iCount === allIfaces.length;
        saIfaces.indeterminate = iCount > 0 && iCount < allIfaces.length;
    }
}

function updateHostToolbar() { updateBulkBar(); }
function updateIfaceToolbar() { updateBulkBar(); }

document.addEventListener('change', function (e) {
    if (e.target.matches('.bulk-host-cb')) {
        e.target.checked ? hostSelected.add(e.target.value) : hostSelected.delete(e.target.value);
        updateHostToolbar();
    } else if (e.target.matches('.bulk-iface-cb')) {
        e.target.checked ? ifaceSelected.add(e.target.value) : ifaceSelected.delete(e.target.value);
        updateIfaceToolbar();
    } else if (e.target.id === 'select-all-hosts') {
        document.querySelectorAll('.bulk-host-cb').forEach(cb => {
            cb.checked = e.target.checked;
            e.target.checked ? hostSelected.add(cb.value) : hostSelected.delete(cb.value);
        });
        updateHostToolbar();
    } else if (e.target.id === 'select-all-ifaces') {
        document.querySelectorAll('.bulk-iface-cb').forEach(cb => {
            cb.checked = e.target.checked;
            e.target.checked ? ifaceSelected.add(cb.value) : ifaceSelected.delete(cb.value);
        });
        updateIfaceToolbar();
    }
});

// --- Shift-select range (hosts and interfaces independently) ---
let lastCheckedCb = null;

document.addEventListener('click', function (e) {
    const cb = e.target;
    if (!cb.matches('.bulk-host-cb, .bulk-iface-cb')) return;

    const isHost = cb.matches('.bulk-host-cb');
    const selector = isHost ? '.bulk-host-cb' : '.bulk-iface-cb';
    const selectedSet = isHost ? hostSelected : ifaceSelected;

    if (e.shiftKey && lastCheckedCb && lastCheckedCb.matches(selector)) {
        const all = [...document.querySelectorAll(selector)];
        const a = all.indexOf(lastCheckedCb);
        const b = all.indexOf(cb);
        const [lo, hi] = a < b ? [a, b] : [b, a];
        all.slice(lo, hi + 1).forEach(box => {
            box.checked = cb.checked;
            cb.checked ? selectedSet.add(box.value) : selectedSet.delete(box.value);
        });
        updateBulkBar();
    }

    lastCheckedCb = cb;
});

// --- Bulk host delete ---
document.getElementById('host-delete-btn')?.addEventListener('click', async function () {
    const count = hostSelected.size;
    if (!confirm(`Delete ${count} host${count !== 1 ? 's' : ''} and all their interfaces? This cannot be undone.`)) return;
    const resp = await fetch('{{ path('host_bulk') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', ids: [...hostSelected], _token: '{{ csrf_token('bulk_hosts') }}' }),
    });
    const data = await resp.json();
    if (resp.ok) { location.reload(); } else { alert(data.error ?? 'Error'); }
});

// --- Bulk host restore ---
document.getElementById('host-restore-btn')?.addEventListener('click', async function () {
    const count = hostSelected.size;
    if (!confirm(`Restore ${count} host${count !== 1 ? 's' : ''} and all their interfaces?`)) return;
    const resp = await fetch('{{ path('host_bulk') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'restore', ids: [...hostSelected], _token: '{{ csrf_token('bulk_hosts') }}' }),
    });
    const data = await resp.json();
    if (resp.ok) { location.reload(); } else { alert(data.error ?? 'Error'); }
});

// --- Clear all selections ---
document.getElementById('bulk-clear-btn')?.addEventListener('click', function () {
    hostSelected.clear();
    ifaceSelected.clear();
    document.querySelectorAll('.bulk-host-cb, .bulk-iface-cb').forEach(cb => cb.checked = false);
    lastCheckedCb = null;
    updateBulkBar();
});

// --- Bulk interface delete ---
document.getElementById('iface-delete-btn')?.addEventListener('click', async function () {
    const count = ifaceSelected.size;
    if (!confirm(`Delete ${count} interface${count !== 1 ? 's' : ''}? This cannot be undone.`)) return;
    const resp = await fetch('{{ path('interface_bulk') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', ids: [...ifaceSelected], _token: '{{ csrf_token('bulk_interfaces') }}' }),
    });
    const data = await resp.json();
    if (resp.ok) { location.reload(); } else { alert(data.error ?? 'Error'); }
});

// --- Bulk interface edit modal ---
(function () {
    const containerSubnetIds = new Set({{ containerSubnetIds|default([])|json_encode }});
    const subnetSelect = document.getElementById('bulk-iface-subnet');

    function setBulkContainerMode(isContainer) {
        ['ipv4', 'ipv6'].forEach(prefix => {
            const options = document.getElementById('bulk-' + prefix + '-options');
            const notice  = document.getElementById('bulk-' + prefix + '-container-notice');
            if (options) options.style.display = isContainer ? 'none' : '';
            if (notice)  notice.style.display  = isContainer ? '' : 'none';
        });
        if (isContainer) {
            document.getElementById('bulk_ipv4_keep').checked = true;
            document.getElementById('bulk_ipv6_keep').checked = true;
        }
    }

    if (subnetSelect) {
        subnetSelect.addEventListener('change', function () {
            const val = parseInt(this.value, 10);
            setBulkContainerMode(val && containerSubnetIds.has(val));
        });
    }

    document.getElementById('bulk-iface-edit-submit')?.addEventListener('click', async function () {
        const subnetId     = subnetSelect?.value || '';
        const ipv4Mode     = document.querySelector('input[name="bulk_ipv4"]:checked')?.value ?? 'keep';
        const ipv6Mode     = document.querySelector('input[name="bulk_ipv6"]:checked')?.value ?? 'keep';
        const count        = ifaceSelected.size;

        const resp = await fetch('{{ path('interface_bulk') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'edit',
                ids: [...ifaceSelected],
                _token: '{{ csrf_token('bulk_interfaces') }}',
                subnet_id: subnetId || null,
                ipv4Assignment: ipv4Mode,
                ipv6Assignment: ipv6Mode,
            }),
        });
        const data = await resp.json();
        if (resp.ok) {
            location.reload();
        } else {
            alert(data.error ?? 'Error updating interfaces');
        }
    });

    // Reset modal state when it opens
    document.getElementById('bulk-iface-edit-modal')?.addEventListener('show.bs.modal', function () {
        if (subnetSelect) subnetSelect.value = '';
        document.getElementById('bulk_ipv4_keep').checked = true;
        document.getElementById('bulk_ipv6_keep').checked = true;
        setBulkContainerMode(false);
    });
})();

// --- Tag modal (add / remove on selected hosts) ---
const bulkTagModalEl = document.getElementById('bulk-tag-modal');
let bulkTagModal = null;
let bulkTagSelect = null;
let bulkTagAction = 'add-tag';

if (bulkTagModalEl) {
    bulkTagModal = new bootstrap.Modal(bulkTagModalEl);

    bulkTagSelect = new TomSelect('#bulk-tag-select', {
        valueField: 'value',
        labelField: 'text',
        searchField: 'text',
        preload: true,
        plugins: ['remove_button'],
        persist: false,
        load(query, callback) {
            fetch('/api/tags?q=' + encodeURIComponent(query))
                .then(r => r.json()).then(callback).catch(() => callback());
        },
        create(input, callback) {
            fetch('/api/tags', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: input }),
            })
                .then(r => r.json().then(data => ({ ok: r.ok, data })))
                .then(({ ok, data }) => { ok ? callback(data) : callback(); })
                .catch(() => callback());
        },
    });

    document.getElementById('host-add-tag-btn')?.addEventListener('click', function () {
        bulkTagAction = 'add-tag';
        document.getElementById('bulk-tag-modal-label').textContent = 'Add Tag to Selected Hosts';
        document.getElementById('bulk-tag-submit').textContent = 'Add Tag';
        bulkTagSelect.clear();
        bulkTagModal.show();
    });

    document.getElementById('host-remove-tag-btn')?.addEventListener('click', function () {
        bulkTagAction = 'remove-tag';
        document.getElementById('bulk-tag-modal-label').textContent = 'Remove Tag from Selected Hosts';
        document.getElementById('bulk-tag-submit').textContent = 'Remove Tag';
        bulkTagSelect.clear();
        bulkTagModal.show();
    });

    document.getElementById('bulk-tag-submit')?.addEventListener('click', async function () {
        const tagIds = bulkTagSelect.getValue();
        if (!tagIds.length) { alert('Please select at least one tag.'); return; }
        const resp = await fetch('{{ path('host_bulk') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: bulkTagAction,
                ids: [...hostSelected],
                tagIds,
                _token: '{{ csrf_token('bulk_hosts') }}',
            }),
        });
        const data = await resp.json();
        if (resp.ok) { bulkTagModal.hide(); location.reload(); }
        else { alert(data.error ?? 'Error'); }
    });
}

// --- Merge hosts ---
const mergeHostModalEl = document.getElementById('merge-host-modal');
const mergeHostModal   = mergeHostModalEl ? new bootstrap.Modal(mergeHostModalEl) : null;

function escHtml(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function getHostInfo(id) {
    const row      = document.querySelector(`tr.host-row[data-host-id="${id}"]`);
    const nameEl   = row?.querySelector('td:nth-child(3) a.fw-semibold');
    const name     = nameEl ? nameEl.textContent.trim() : 'Host #' + id;
    const ifaceCount = document.querySelectorAll(`tr.iface-row[data-parent-host="${id}"]`).length;
    return { name, ifaceCount };
}

document.getElementById('host-merge-btn')?.addEventListener('click', function () {
    let bestId = null, bestCount = -1;
    for (const id of hostSelected) {
        const { ifaceCount } = getHostInfo(id);
        if (ifaceCount > bestCount) { bestCount = ifaceCount; bestId = id; }
    }

    const list = document.getElementById('merge-host-list');
    list.innerHTML = '';
    for (const id of hostSelected) {
        const { name, ifaceCount } = getHostInfo(id);
        const ifaceText = ifaceCount === 1 ? '1 interface' : ifaceCount + ' interfaces';
        const div = document.createElement('div');
        div.className = 'form-check mb-2';
        div.innerHTML =
            `<input class="form-check-input" type="radio" name="merge_primary" id="merge_primary_${id}" value="${id}"${id === bestId ? ' checked' : ''}>`
            + `<label class="form-check-label" for="merge_primary_${id}">`
            + `<strong>${escHtml(name)}</strong>`
            + ` <span class="text-muted small">(${escHtml(ifaceText)})</span>`
            + `</label>`;
        list.appendChild(div);
    }
    mergeHostModal?.show();
});

document.getElementById('merge-host-submit')?.addEventListener('click', async function () {
    const primaryId = document.querySelector('input[name="merge_primary"]:checked')?.value;
    if (!primaryId) { alert('Please select a primary host.'); return; }
    const resp = await fetch('{{ path('host_bulk') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            action: 'merge',
            ids: [...hostSelected],
            primaryId: parseInt(primaryId, 10),
            _token: '{{ csrf_token('bulk_hosts') }}',
        }),
    });
    const data = await resp.json();
    if (resp.ok) { mergeHostModal?.hide(); location.reload(); }
    else { alert(data.error ?? 'Error'); }
});
</script>
{% endblock scripts %}
