{% extends 'base.html.twig' %}
{% block title %}Denied MAC Addresses{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-shield-slash me-2"></i>Denied MAC Addresses</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_dhcp') }}#denied-mac-addresses" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('denied_mac_address_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Deny a MAC Address
        </a>
    </div>
</div>

<p class="text-muted">
    Devices with a MAC address listed here are refused a DHCP lease on every subnet and server, as soon as the
    DHCP configuration is next pushed.
</p>

{% if deniedMacAddresses is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-shield-slash fs-1 d-block mb-3 opacity-25"></i>
            No denied MAC addresses yet. <a href="{{ path('denied_mac_address_new') }}">Deny one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>MAC Address</th>
                    <th>Reason</th>
                    <th>Added by</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for denied in deniedMacAddresses %}
                    <tr>
                        <td class="fw-semibold font-monospace">{{ denied.macAddress }}</td>
                        <td class="text-muted">{{ denied.reason ?: '—' }}</td>
                        <td class="text-muted">
                            {{ denied.createdBy ?: '—' }}
                            <span class="d-block small">{{ denied.createdAt|date('Y-m-d H:i') }}</span>
                        </td>
                        <td class="text-end">
                            <a href="{{ path('denied_mac_address_edit', {id: denied.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('denied_mac_address_delete', {id: denied.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Stop denying MAC address {{ denied.macAddress|e('js') }}?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_denied_mac_address_' ~ denied.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
