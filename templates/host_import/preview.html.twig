{% extends 'base.html.twig' %}
{% block title %}Host Import Preview{% endblock %}

{% block stylesheets %}
<style>
:root                    { --import-iface-bg: rgba(0,0,0,.03); }
[data-bs-theme="dark"]   { --import-iface-bg: rgba(255,255,255,.04); }
.import-iface-row        { --bs-table-bg: var(--import-iface-bg); }
</style>
{% endblock %}

{% block content %}
{% set newHosts      = preview.hosts|filter(h => h.status == 'new')|length %}
{% set existingHosts = preview.hosts|filter(h => h.status == 'existing')|length %}
{% set noIfaceHosts  = preview.hosts|filter(h => h.status == 'no_valid_interfaces')|length %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-list-check me-2"></i>Host Import Preview</h1>
    <a href="{{ path('host_import') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Upload Different File
    </a>
</div>

{# Summary banner #}
<div class="alert {{ newHosts > 0 ? 'alert-info' : 'alert-secondary' }} d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-clipboard-check fs-4"></i>
    <div>
        {% if newHosts > 0 %}
            <strong>{{ newHosts }} host{{ newHosts != 1 ? 's' : '' }} ready to import.</strong>
        {% else %}
            <strong>Nothing new to import.</strong>
        {% endif %}
        {% if existingHosts > 0 %}
            {{ existingHosts }} skipped — hostname already exists.
        {% endif %}
        {% if noIfaceHosts > 0 %}
            {{ noIfaceHosts }} skipped — all interfaces already exist or have conflicts.
        {% endif %}
    </div>
</div>

{# Hosts table #}
<div class="card mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Building</th>
                    <th>Room</th>
                    <th>Tags</th>
                    <th>Interfaces</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for h in preview.hosts %}
                {# Host row #}
                <tr class="{{ h.status != 'new' ? 'text-muted' : '' }}">
                    <td class="fw-semibold">{{ h.hostname }}</td>
                    <td>
                        {% if h.building_name %}
                            {{ h.building_name }}
                            {% if h.unknown_building %}
                                <span class="badge bg-warning text-dark ms-1" title="Building not found — will be left blank">
                                    <i class="bi bi-exclamation-triangle"></i> not found
                                </span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ h.room ?: '—' }}</td>
                    <td>
                        {% for tag in h.tags %}
                            {% if tag in h.unknown_tags %}
                                <span class="badge bg-warning text-dark" title="Tag not found — will be skipped">{{ tag }}</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ tag }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endfor %}
                    </td>
                    <td>{{ h.interfaces|length }}</td>
                    <td>
                        {% if h.status == 'new' %}
                            <span class="badge bg-success"><i class="bi bi-plus-lg me-1"></i>Create</span>
                        {% elseif h.status == 'existing' %}
                            <span class="badge bg-secondary"><i class="bi bi-check me-1"></i>Skip — exists</span>
                        {% else %}
                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Skip — no valid interfaces</span>
                        {% endif %}
                    </td>
                </tr>
                {# Interface sub-rows #}
                {% if h.status == 'new' or h.status == 'no_valid_interfaces' %}
                    {% for i in h.interfaces %}
                    <tr class="import-iface-row {{ i.status != 'new' ? 'text-muted' : '' }}">
                        <td class="ps-4 small font-monospace">{{ i.mac }}</td>
                        <td class="small" colspan="2">
                            {% if i.name %}<span class="text-muted">{{ i.name }}</span>{% endif %}
                        </td>
                        <td class="small">
                            {% if i.subnet_cidr %}
                                {% if i.subnet_name %}
                                    {{ i.subnet_name }}
                                    <span class="text-muted small d-block ip-address">{{ i.subnet_cidr }}</span>
                                {% else %}
                                    <span class="ip-address">{{ i.subnet_cidr }}</span>
                                    <span class="badge bg-warning text-dark ms-1" title="Subnet not found — IP will not be assigned">not found</span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="small ip-address">
                            {% if i.ip_address %}{{ i.ip_address }}{% endif %}
                            {% if i.ipv6_address %}<br><span class="text-muted small">{{ i.ipv6_address }}</span>{% endif %}
                            {% if not i.ip_address and not i.ipv6_address %}<span class="text-muted">—</span>{% endif %}
                        </td>
                        <td>
                            {% if i.status == 'new' %}
                                <span class="badge bg-success"><i class="bi bi-plus-lg me-1"></i>Create</span>
                            {% elseif i.status == 'existing' %}
                                <span class="badge bg-secondary" title="Host: {{ i.existing_host }}">
                                    <i class="bi bi-check me-1"></i>Skip — MAC exists{% if i.existing_host %} on {{ i.existing_host }}{% endif %}
                                </span>
                            {% else %}
                                <span class="badge bg-warning text-dark" title="{{ i.conflict_reason }}">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Skip — conflict
                                </span>
                                <span class="d-block text-danger small mt-1">{{ i.conflict_reason }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Confirm / Cancel #}
<div class="d-flex gap-2 mt-2">
    {% if newHosts > 0 %}
    <form method="post" action="{{ path('host_import_confirm') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('host_import_confirm') }}">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-cloud-upload me-1"></i>Confirm Import ({{ newHosts }} host{{ newHosts != 1 ? 's' : '' }})
        </button>
    </form>
    {% endif %}
    <a href="{{ path('host_import') }}" class="btn btn-outline-secondary">
        <i class="bi bi-x-lg me-1"></i>Cancel
    </a>
    <a href="{{ path('host_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-list me-1"></i>Back to Hosts
    </a>
</div>
{% endblock %}
