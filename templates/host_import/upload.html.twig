{% extends 'base.html.twig' %}
{% block title %}Import Hosts from CSV{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-upload me-2"></i>Import Hosts from CSV</h1>
    <a href="{{ path('host_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Hosts
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-4">
                <p class="text-muted mb-4">
                    Upload a CSV file to bulk-import hosts and their interfaces.
                    You will be shown a preview of proposed changes before anything is created.
                    Each row represents one interface; rows sharing the same hostname are grouped into a single host.
                </p>

                <form method="post" action="{{ path('host_import') }}" enctype="multipart/form-data">

                    <div class="mb-4">
                        <label for="csv_file" class="form-label fw-semibold">CSV File</label>
                        <input type="file" class="form-control" id="csv_file" name="csv_file"
                               accept=".csv,.txt" required>
                        <div class="form-text">
                            <a href="{{ path('host_import_template') }}">
                                <i class="bi bi-download me-1"></i>Download blank template
                            </a>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i>Parse &amp; Preview Changes
                        </button>
                        <a href="{{ path('host_index') }}" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <strong><i class="bi bi-table me-1"></i>CSV Columns</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Column</th>
                            <th>Required</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td><code>hostname</code></td><td><span class="badge bg-danger">Required</span></td><td>Host name. Rows with the same hostname are merged into one host.</td></tr>
                        <tr><td><code>mac_address</code></td><td><span class="badge bg-danger">Required</span></td><td>MAC address in any standard format (<code>aa:bb:cc:dd:ee:ff</code>, <code>AA-BB-CC-DD-EE-FF</code>, <code>aabbccddeeff</code>).</td></tr>
                        <tr><td><code>building</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Must match an existing building name exactly (case-insensitive). Left blank if not found.</td></tr>
                        <tr><td><code>room</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Room number or label.</td></tr>
                        <tr><td><code>host_notes</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Free-form notes for the host. Taken from the first row for each hostname.</td></tr>
                        <tr><td><code>tags</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Semicolon-separated tag names (e.g. <code>tag1;tag2</code>). Must match existing tags; unrecognized tags are skipped.</td></tr>
                        <tr><td><code>interface_name</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Interface label (e.g. <code>eth0</code>).</td></tr>
                        <tr><td><code>subnet</code></td><td><span class="badge bg-secondary">Optional</span></td><td>CIDR notation (e.g. <code>192.168.1.0/24</code>). Must match an existing subnet.</td></tr>
                        <tr><td><code>ip_address</code></td><td><span class="badge bg-secondary">Optional</span></td><td>IPv4 address to assign, or <code>auto</code> to assign the next available address. Requires <code>subnet</code> to be set and resolvable.</td></tr>
                        <tr><td><code>ipv6_address</code></td><td><span class="badge bg-secondary">Optional</span></td><td>IPv6 address to assign, <code>auto</code> to assign the next available address, or <code>auto_v4</code> to derive from the assigned IPv4 address. Requires <code>subnet</code> to be set and resolvable.</td></tr>
                        <tr><td><code>dns_name</code></td><td><span class="badge bg-secondary">Optional</span></td><td>FQDN for this interface (e.g. <code>myhost.example.com</code>). The longest matching known domain is used to split the label from the domain. Import is blocked if no matching domain is found.</td></tr>
                        <tr><td><code>interface_notes</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Free-form notes for the interface.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
