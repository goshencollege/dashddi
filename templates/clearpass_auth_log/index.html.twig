{% extends 'base.html.twig' %}
{% block title %}ClearPass Auth Logs{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% block content %}
<div class="list-page-content">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-shield-lock me-2"></i>ClearPass Authentication Logs</h1>
    <a href="{{ path('user_guide_integrations') }}#clearpass" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('clearpass_auth_log_index') }}" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">MAC Address</label>
                <input type="text" name="mac" class="form-control form-control-sm"
                       placeholder="e.g. aa:bb:cc" value="{{ filter_mac }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Username</label>
                <input type="text" name="username" class="form-control form-control-sm"
                       placeholder="e.g. user@domain" value="{{ filter_username }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Role</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for r in roles %}
                        <option value="{{ r }}" {{ filter_role == r ? 'selected' : '' }}>{{ r }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small text-muted mb-1">VLAN</label>
                <select name="vlan" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for v in vlans %}
                        <option value="{{ v }}" {{ filter_vlan == v ? 'selected' : '' }}>{{ v }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Protocol</label>
                <select name="protocol" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for p in protocols %}
                        <option value="{{ p }}" {{ filter_protocol == p ? 'selected' : '' }}>{{ p }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Service</label>
                <select name="service" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for s in services %}
                        <option value="{{ s }}" {{ filter_service == s ? 'selected' : '' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Switch IP</label>
                <input type="text" name="nas_ip" class="form-control form-control-sm"
                       placeholder="e.g. 10.0.0.1" value="{{ filter_nas_ip }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Switch Port</label>
                <input type="text" name="nas_port_id" class="form-control form-control-sm"
                       placeholder="e.g. GigabitEthernet" value="{{ filter_nas_port_id }}">
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a href="{{ path('clearpass_auth_log_index') }}" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card list-scroll-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul me-1"></i>Results</span>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fst-italic" id="refresh-label"></span>
            <div class="btn-group btn-group-sm" id="refresh-controls" role="group" aria-label="Auto-refresh">
                <button type="button" class="btn btn-outline-secondary active" data-interval="0">Off</button>
                <button type="button" class="btn btn-outline-secondary" data-interval="30">30s</button>
                <button type="button" class="btn btn-outline-secondary" data-interval="60">60s</button>
            </div>
            <span class="text-muted small"><span id="record-count">{{ total }}</span> record(s)</span>
        </div>
    </div>
    <div id="table-wrapper">
        {% include 'clearpass_auth_log/_table.html.twig' %}
    </div>
</div>{# /list-scroll-card #}
</div>{# /list-page-content #}
{% endblock %}

{% block scripts %}
<script>
(function () {
    var TABLE_URL = '{{ path('clearpass_auth_log_table') }}';
    var wrapper   = document.getElementById('table-wrapper');
    var label     = document.getElementById('refresh-label');
    var countEl   = document.getElementById('record-count');

    var intervalSecs = 0;
    var tickCount    = 0;
    var tickTimer    = null;
    var fetching     = false;

    function buildUrl() {
        return TABLE_URL + (window.location.search || '');
    }

    function doRefresh() {
        if (fetching) { return; }
        fetching = true;
        if (label) { label.textContent = 'Refreshing…'; }
        fetch(buildUrl(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                wrapper.innerHTML = html;
                var el = wrapper.querySelector('[data-record-count]');
                if (el && countEl) { countEl.textContent = el.getAttribute('data-record-count'); }
            })
            .catch(function () {})
            .finally(function () {
                fetching = false;
                tickCount = 0;
                updateLabel();
            });
    }

    function updateLabel() {
        if (!label) { return; }
        if (intervalSecs === 0) {
            label.textContent = '';
        } else {
            var left = intervalSecs - tickCount;
            label.textContent = left > 0 ? 'Next in ' + left + 's' : 'Refreshing…';
        }
    }

    function tick() {
        tickCount++;
        if (tickCount >= intervalSecs) {
            tickCount = 0;
            doRefresh();
        } else {
            updateLabel();
        }
    }

    function startRefresh(secs) {
        clearInterval(tickTimer);
        intervalSecs = secs;
        tickCount    = 0;
        if (secs > 0) {
            tickTimer = setInterval(tick, 1000);
            updateLabel();
        } else {
            if (label) { label.textContent = ''; }
        }
    }

    document.querySelectorAll('#refresh-controls button').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('#refresh-controls button').forEach(function (b) {
                b.classList.remove('active');
            });
            this.classList.add('active');
            startRefresh(parseInt(this.dataset.interval, 10));
        });
    });
})();
</script>
{% endblock %}
