{% extends 'base.html.twig' %}
{% block title %}ClearPass Auth Logs{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% block content %}
<div class="list-page-content">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-shield-lock me-2"></i>ClearPass Authentication Logs</h1>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('clearpass_auth_log_index') }}" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">MAC Address</label>
                <input type="text" name="mac" class="form-control form-control-sm"
                       placeholder="e.g. aa:bb:cc" value="{{ filter_mac }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Username</label>
                <input type="text" name="username" class="form-control form-control-sm"
                       placeholder="e.g. user@domain" value="{{ filter_username }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for s in statuses %}
                        <option value="{{ s }}" {{ filter_status == s ? 'selected' : '' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Role</label>
                <select name="role" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for r in roles %}
                        <option value="{{ r }}" {{ filter_role == r ? 'selected' : '' }}>{{ r }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small text-muted mb-1">VLAN</label>
                <select name="vlan" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for v in vlans %}
                        <option value="{{ v }}" {{ filter_vlan == v ? 'selected' : '' }}>{{ v }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Protocol</label>
                <select name="protocol" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for p in protocols %}
                        <option value="{{ p }}" {{ filter_protocol == p ? 'selected' : '' }}>{{ p }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Service</label>
                <select name="service" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    {% for s in services %}
                        <option value="{{ s }}" {{ filter_service == s ? 'selected' : '' }}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Switch IP</label>
                <input type="text" name="nas_ip" class="form-control form-control-sm"
                       placeholder="e.g. 10.0.0.1" value="{{ filter_nas_ip }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Switch Port</label>
                <input type="text" name="nas_port_id" class="form-control form-control-sm"
                       placeholder="e.g. GigabitEthernet" value="{{ filter_nas_port_id }}">
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a href="{{ path('clearpass_auth_log_index') }}" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card list-scroll-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul me-1"></i>Results</span>
        <span class="text-muted small">{{ total }} record(s)</span>
    </div>
    {% if logs|length == 0 %}
        <div class="card-body text-center text-muted py-4">No authentication log records found.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>MAC Address</th>
                        <th>Username</th>
                        <th>Status</th>
                        <th>Protocol</th>
                        <th>Service</th>
                        <th>Switch IP</th>
                        <th>Switch Port</th>
                        <th>Role</th>
                        <th>VLAN</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        {% set iface = interface_map[log.macAddress] ?? null %}
                        <tr>
                            <td>
                                {% if iface %}
                                    <a href="{{ path('interface_show', {id: iface.id}) }}"><code>{{ log.macAddress }}</code></a>
                                {% else %}
                                    <code>{{ log.macAddress }}</code>
                                {% endif %}
                            </td>
                            <td>{{ log.username ?: '—' }}</td>
                            <td>
                                {% if log.authStatus == 'Access-Accept' %}
                                    <span class="badge bg-success">{{ log.authStatus }}</span>
                                {% elseif log.authStatus == 'Access-Reject' %}
                                    <span class="badge bg-danger">{{ log.authStatus }}</span>
                                {% elseif log.authStatus %}
                                    <span class="badge bg-secondary">{{ log.authStatus }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>{{ log.authProtocol ?: '—' }}</td>
                            <td>{{ log.service ?: '—' }}</td>
                            <td>{{ log.nasIp ?: '—' }}</td>
                            <td>{{ log.nasPortId ?: '—' }}</td>
                            <td>{{ log.role ?: '—' }}</td>
                            <td>{{ log.vlan ?: '—' }}</td>
                            <td class="text-nowrap">{{ log.authTimestamp|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if total > per_page %}
            <div class="card-footer d-flex justify-content-between align-items-center">
                <span class="text-muted small">Page {{ page }} of {{ (total / per_page)|round(0, 'ceil') }}</span>
                <div>
                    {% set pagerParams = {mac: filter_mac, username: filter_username, status: filter_status, role: filter_role, vlan: filter_vlan, protocol: filter_protocol, service: filter_service, nas_ip: filter_nas_ip, nas_port_id: filter_nas_port_id} %}
                    {% if page > 1 %}
                        <a href="{{ path('clearpass_auth_log_index', pagerParams|merge({page: page - 1})) }}"
                           class="btn btn-sm btn-outline-secondary me-1">
                            <i class="bi bi-chevron-left"></i> Prev
                        </a>
                    {% endif %}
                    {% if page * per_page < total %}
                        <a href="{{ path('clearpass_auth_log_index', pagerParams|merge({page: page + 1})) }}"
                           class="btn btn-sm btn-outline-secondary">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% endif %}
</div>{# /list-scroll-card #}
</div>{# /list-page-content #}
{% endblock %}
