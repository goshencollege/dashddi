<span data-record-count="{{ total }}" class="d-none"></span>
{% if logs|length == 0 %}
    <div class="card-body text-center text-muted py-4">No authentication log records found.</div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>MAC Address</th>
                    <th>Username</th>
                    <th>Protocol</th>
                    <th>Service</th>
                    <th>Switch IP</th>
                    <th>Switch Port</th>
                    <th>Role</th>
                    <th>VLAN</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    {% set iface = interface_map[log.macAddress] ?? null %}
                    <tr>
                        <td>
                            {% if iface %}
                                <a href="{{ path('interface_show', {id: iface.id}) }}"><code>{{ log.macAddress }}</code></a>
                            {% else %}
                                <code>{{ log.macAddress }}</code>
                            {% endif %}
                        </td>
                        <td>{{ log.username ?: '—' }}</td>
                        <td>{{ log.authProtocol ?: '—' }}</td>
                        <td>{{ log.service ?: '—' }}</td>
                        <td>{{ log.nasIp ?: '—' }}</td>
                        <td>{{ log.nasPortId ?: '—' }}</td>
                        <td>{{ log.role ?: '—' }}</td>
                        <td>{{ log.vlan ?: '—' }}</td>
                        <td class="text-nowrap">{{ log.authTimestamp|date('Y-m-d H:i') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total > per_page %}
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page {{ page }} of {{ (total / per_page)|round(0, 'ceil') }}</span>
            <div>
                {% set pagerParams = {mac: filter_mac, username: filter_username, role: filter_role, vlan: filter_vlan, protocol: filter_protocol, service: filter_service, nas_ip: filter_nas_ip, nas_port_id: filter_nas_port_id} %}
                {% if page > 1 %}
                    <a href="{{ path('clearpass_auth_log_index', pagerParams|merge({page: page - 1})) }}"
                       class="btn btn-sm btn-outline-secondary me-1">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                {% endif %}
                {% if page * per_page < total %}
                    <a href="{{ path('clearpass_auth_log_index', pagerParams|merge({page: page + 1})) }}"
                       class="btn btn-sm btn-outline-secondary">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endif %}
