{% extends 'base.html.twig' %}
{% block title %}Recommendations{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% block content %}
<div class="list-page-content">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-lightbulb me-2"></i>Recommendations</h1>
</div>

{# ── Unlinked DNS Records ─────────────────────────────────────────────────── #}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-link-45deg me-1"></i>
            <strong>Unlinked DNS Records</strong>
            <span class="badge bg-secondary ms-2">{{ unlinked_dns|length }}</span>
        </span>
    </div>
    <div class="card-body pb-0">
        <p class="text-muted small mb-3">
            These A and AAAA records have an IP address that matches a network interface, but the record is not
            linked to that interface. Linking the record lets DashDDI manage it automatically and keep it in sync.
        </p>
    </div>

    {% if unlinked_dns is empty %}
        <div class="card-body pt-0">
            <div class="alert alert-success mb-0">
                <i class="bi bi-check-circle me-1"></i>No unlinked DNS records found.
            </div>
        </div>
    {% else %}
        <form method="post" action="{{ path('recommendation_apply_link_dns') }}" id="unlinked-dns-form">
            <input type="hidden" name="_token" value="{{ csrf_token('link_dns_bulk') }}">

            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom border-top">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="select-all-dns">
                    <label class="form-check-label small text-muted" for="select-all-dns">Select all</label>
                </div>
                <button type="submit" class="btn btn-sm btn-success" id="bulk-apply-btn" disabled
                        onclick="return confirm('Link ' + document.getElementById('selected-count').textContent + ' DNS record(s) to their matching interfaces?')">
                    <i class="bi bi-link-45deg me-1"></i>
                    Implement Selected (<span id="selected-count">0</span>)
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 2.25rem"></th>
                            <th>Domain</th>
                            <th>Hostname</th>
                            <th>Type</th>
                            <th>IP Address</th>
                            <th>Matching Interface / Host</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in unlinked_dns %}
                        <tr class="dns-row">
                            <td>
                                <input class="form-check-input dns-checkbox" type="checkbox"
                                       name="ids[]" value="{{ row.record_id }}">
                            </td>
                            <td>
                                <a href="{{ path('domain_show', {id: row.domain_id}) }}">{{ row.domain_name }}</a>
                            </td>
                            <td class="font-monospace">{{ row.hostname }}</td>
                            <td><span class="badge bg-primary-subtle text-primary-emphasis">{{ row.record_type }}</span></td>
                            <td class="font-monospace">{{ row.ip }}</td>
                            <td>
                                <a href="{{ path('interface_show', {id: row.iface_id}) }}">{{ row.host_name }}</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </form>
    {% endif %}
</div>

</div>

{% if unlinked_dns is not empty %}
<script>
(function () {
    const selectAll  = document.getElementById('select-all-dns');
    const applyBtn   = document.getElementById('bulk-apply-btn');
    const countSpan  = document.getElementById('selected-count');
    const checkboxes = document.querySelectorAll('.dns-checkbox');

    function updateState() {
        const checked = document.querySelectorAll('.dns-checkbox:checked').length;
        countSpan.textContent = checked;
        applyBtn.disabled = checked === 0;
        selectAll.indeterminate = checked > 0 && checked < checkboxes.length;
        selectAll.checked = checked === checkboxes.length;
    }

    selectAll.addEventListener('change', function () {
        checkboxes.forEach(cb => { cb.checked = this.checked; });
        updateState();
    });

    checkboxes.forEach(cb => cb.addEventListener('change', updateState));

    // Highlight row when its checkbox is checked
    checkboxes.forEach(cb => cb.addEventListener('change', function () {
        this.closest('tr').classList.toggle('table-active', this.checked);
    }));
})();
</script>
{% endif %}
{% endblock %}
