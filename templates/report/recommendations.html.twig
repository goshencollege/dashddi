    }

    selectAll.addEventListener('change', function () {
        checkboxes.forEach(cb => {
            cb.checked = this.checked;
            cb.closest('tr').classList.toggle('table-active', this.checked);
        });
        lastChecked = null;
        updateState();
    });

    checkboxes.forEach(cb => {
        cb.addEventListener('click', function (e) {
            if (e.shiftKey && lastChecked !== null && lastChecked !== this) {
                const a = checkboxes.indexOf(lastChecked);
                const b = checkboxes.indexOf(this);
                const [from, to] = a < b ? [a, b] : [b, a];
                checkboxes.slice(from, to + 1).forEach(c => {
                    c.checked = this.checked;
                    c.closest('tr').classList.toggle('table-active', this.checked);
                });
            } else {
                this.closest('tr').classList.toggle('table-active', this.checked);
