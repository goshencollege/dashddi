<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ current_theme() }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}IPAM{% endblock %} – IP Address Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .navbar-brand { font-weight: 600; letter-spacing: .5px; }
        .table-hover tbody tr:hover { background-color: rgba(13,110,253,.05); }
        .ip-address { font-family: monospace; }
        thead { background-color: var(--bs-tertiary-bg); }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('dashboard') }}">
            <i class="bi bi-diagram-3-fill me-2"></i>IPAM
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'host' or app.request.attributes.get('_route') starts with 'interface' ? 'active' }}"
                       href="{{ path('host_index') }}">
                        <i class="bi bi-pc-display me-1"></i>Hosts
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'subnet' or app.request.attributes.get('_route') starts with 'vrf' ? 'active' }}"
                       href="{{ path('subnet_index') }}">
                        <i class="bi bi-diagram-2 me-1"></i>Subnets
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'domain' or app.request.attributes.get('_route') starts with 'dns_view' ? 'active' }}"
                       href="{{ path('domain_index') }}">
                        <i class="bi bi-globe me-1"></i>Domains
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'building' ? 'active' }}"
                       href="{{ path('building_index') }}">
                        <i class="bi bi-building me-1"></i>Buildings
                    </a>
                </li>
            </ul>
            {% if app.user %}
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item me-2">
                    <button id="theme-toggle" class="btn btn-sm btn-outline-light" title="Toggle dark mode"
                            data-current="{{ current_theme() }}">
                        <i class="bi {{ current_theme() == 'dark' ? 'bi-sun' : 'bi-moon' }}"></i>
                    </button>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i>{{ app.user.displayName }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text text-muted small">{{ app.user.email }}</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a href="{{ path('saml_logout') }}" class="dropdown-item">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            {% endif %}
        </div>
    </div>
</nav>

<div class="container mb-5">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', function () {
        const html = document.documentElement;
        const next = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';

        html.setAttribute('data-bs-theme', next);
        btn.setAttribute('data-current', next);
        btn.querySelector('i').className = next === 'dark' ? 'bi bi-sun' : 'bi bi-moon';

        fetch('{{ path('api_preference_theme') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ theme: next }),
        });
    });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
