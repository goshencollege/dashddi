{% set _theme = current_theme() %}
{% set _bsTheme = _theme in ['dark', 'purple', 'green', 'rainbow'] ? 'dark' : 'light' %}
<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ _bsTheme }}" data-theme="{{ _theme }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}IPAM{% endblock %} – IP Address Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .navbar-brand { font-weight: 600; letter-spacing: .5px; }
        .table-hover tbody tr:hover { background-color: rgba(13,110,253,.05); }
        .ip-address { font-family: monospace; }
        thead { background-color: var(--bs-tertiary-bg); }
        .theme-swatch {
            display: inline-block; width: 13px; height: 13px;
            border-radius: 50%; flex-shrink: 0;
            border: 1px solid rgba(255,255,255,.25);
        }

        /* ── Purple theme (OBNOXIOUS) ───────────────────────────── */
        @keyframes purple-slide {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        [data-theme="purple"] .navbar {
            background: linear-gradient(270deg, #1a0033, #8800ff, #ff00cc, #8800ff, #1a0033) !important;
            background-size: 300% 300% !important;
            animation: purple-slide 4s ease infinite;
            box-shadow: 0 2px 20px rgba(255,0,204,.55) !important;
        }
        [data-theme="purple"] thead {
            background: linear-gradient(90deg, #6600ff, #ff00ff) !important;
        }
        [data-theme="purple"] thead th, [data-theme="purple"] thead td {
            color: #ffff00 !important;
            text-shadow: 0 0 8px #ff00ff;
        }
        [data-theme="purple"] {
            --bs-primary:                #cc00ff;
            --bs-primary-rgb:            204, 0, 255;
            --bs-link-color:             #ff66ff;
            --bs-link-color-rgb:         255, 102, 255;
            --bs-link-hover-color:       #ffff00;
        }
        [data-theme="purple"] .btn-primary {
            --bs-btn-bg:                 #cc00ff;
            --bs-btn-border-color:       #ff00ff;
            --bs-btn-hover-bg:           #ff00cc;
            --bs-btn-hover-border-color: #ff66ff;
            --bs-btn-active-bg:          #9900cc;
            box-shadow: 0 0 12px rgba(204,0,255,.6);
        }
        [data-theme="purple"] .btn-outline-primary {
            --bs-btn-color:              #ff66ff;
            --bs-btn-border-color:       #cc00ff;
            --bs-btn-hover-bg:           #cc00ff;
            --bs-btn-hover-border-color: #ff00ff;
            --bs-btn-hover-color:        #ffff00;
        }
        [data-theme="purple"] .bg-primary       { background-color: #cc00ff !important; }
        [data-theme="purple"] .text-primary      { color: #ff66ff !important; }
        [data-theme="purple"] .nav-link.active   { color: #ffff00 !important; text-shadow: 0 0 10px #ff00ff; }
        [data-theme="purple"] .form-control:focus,
        [data-theme="purple"] .form-select:focus {
            border-color: #ff00ff;
            box-shadow: 0 0 0 .25rem rgba(255,0,255,.45), 0 0 12px rgba(204,0,255,.4);
        }
        [data-theme="purple"] .table-hover tbody tr:hover {
            background-color: rgba(204,0,255,.18);
            box-shadow: inset 0 0 8px rgba(255,0,204,.15);
        }
        [data-theme="purple"] h1, [data-theme="purple"] h2,
        [data-theme="purple"] h3, [data-theme="purple"] h4 {
            text-shadow: 0 0 12px rgba(204,0,255,.7);
        }

        /* ── Green theme (OBNOXIOUS) ────────────────────────────── */
        @keyframes green-pulse {
            0%, 100% { box-shadow: 0 2px 15px rgba(0,255,65,.4) !important; }
            50%       { box-shadow: 0 2px 35px rgba(0,255,65,.9) !important; }
        }
        @keyframes green-scan {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        [data-theme="green"] .navbar {
            background: linear-gradient(270deg, #001a00, #006600, #00ff41, #006600, #001a00) !important;
            background-size: 300% 300% !important;
            animation: green-scan 3s ease infinite;
            box-shadow: 0 2px 25px rgba(0,255,65,.6) !important;
        }
        [data-theme="green"] thead {
            background: linear-gradient(90deg, #003300, #00cc44) !important;
        }
        [data-theme="green"] thead th, [data-theme="green"] thead td {
            color: #00ff41 !important;
            text-shadow: 0 0 8px #00ff41;
        }
        [data-theme="green"] {
            --bs-primary:                #00ff41;
            --bs-primary-rgb:            0, 255, 65;
            --bs-link-color:             #00ff41;
            --bs-link-color-rgb:         0, 255, 65;
            --bs-link-hover-color:       #ccff00;
        }
        [data-theme="green"] .btn-primary {
            --bs-btn-bg:                 #00cc44;
            --bs-btn-border-color:       #00ff41;
            --bs-btn-hover-bg:           #00ff41;
            --bs-btn-hover-border-color: #ccff00;
            --bs-btn-active-bg:          #009933;
            --bs-btn-color:              #001a00;
            --bs-btn-hover-color:        #001a00;
            box-shadow: 0 0 12px rgba(0,255,65,.55);
            text-shadow: none;
        }
        [data-theme="green"] .btn-outline-primary {
            --bs-btn-color:              #00ff41;
            --bs-btn-border-color:       #00ff41;
            --bs-btn-hover-bg:           #00cc44;
            --bs-btn-hover-border-color: #00ff41;
            --bs-btn-hover-color:        #001a00;
        }
        [data-theme="green"] .bg-primary       { background-color: #00cc44 !important; }
        [data-theme="green"] .text-primary      { color: #00ff41 !important; }
        [data-theme="green"] .nav-link.active   { color: #00ff41 !important; text-shadow: 0 0 10px #00ff41; }
        [data-theme="green"] .form-control:focus,
        [data-theme="green"] .form-select:focus {
            border-color: #00ff41;
            box-shadow: 0 0 0 .25rem rgba(0,255,65,.4), 0 0 14px rgba(0,255,65,.35);
        }
        [data-theme="green"] .table-hover tbody tr:hover {
            background-color: rgba(0,255,65,.12);
            box-shadow: inset 0 0 8px rgba(0,255,65,.1);
        }
        [data-theme="green"] h1, [data-theme="green"] h2,
        [data-theme="green"] h3, [data-theme="green"] h4 {
            color: #00ff41;
            text-shadow: 0 0 10px rgba(0,255,65,.6);
        }

        /* ── Rainbow theme ──────────────────────────────────────── */
        @keyframes rainbow-swirl {
            0%   { background-position: 0% 0%; }
            25%  { background-position: 100% 0%; }
            50%  { background-position: 100% 100%; }
            75%  { background-position: 0% 100%; }
            100% { background-position: 0% 0%; }
        }
        @keyframes navbar-hue {
            0%   { filter: hue-rotate(0deg); }
            100% { filter: hue-rotate(360deg); }
        }
        [data-theme="rainbow"] html {
            background: radial-gradient(ellipse at 20% 20%, #ff0055 0%, #ff8800 16%, #ffff00 32%, #00ff88 48%, #0088ff 64%, #8800ff 80%, #ff0055 100%),
                        radial-gradient(ellipse at 80% 80%, #ff00cc 0%, #ffff00 25%, #00ffcc 50%, #0044ff 75%, #ff0055 100%);
            background-size: 300% 300%, 300% 300%;
            background-blend-mode: screen;
            animation: rainbow-swirl 8s ease infinite;
            min-height: 100%;
        }
        [data-theme="rainbow"] body {
            background: transparent !important;
        }
        [data-theme="rainbow"] .navbar {
            background: linear-gradient(90deg, #ff0055, #ff8800, #ffff00, #00ff88, #0088ff, #8800ff, #ff0055) !important;
            background-size: 200% 100% !important;
            animation: rainbow-swirl 5s linear infinite;
            box-shadow: 0 3px 25px rgba(255,255,255,.3) !important;
        }
        [data-theme="rainbow"] .navbar-brand,
        [data-theme="rainbow"] .navbar .nav-link,
        [data-theme="rainbow"] .navbar .btn {
            color: #fff !important;
            text-shadow: 0 1px 4px rgba(0,0,0,.8);
        }
        [data-theme="rainbow"] .container {
            background: rgba(10,10,20,.72);
            border-radius: .75rem;
            padding: 1.5rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 30px rgba(0,0,0,.4);
        }
        [data-theme="rainbow"] thead {
            background: linear-gradient(90deg, #ff0055, #ff8800, #ffff00, #00ff88, #0088ff, #8800ff) !important;
        }
        [data-theme="rainbow"] thead th, [data-theme="rainbow"] thead td {
            color: #fff !important;
            text-shadow: 0 1px 4px rgba(0,0,0,.8);
        }
        [data-theme="rainbow"] {
            --bs-primary:                #ff88cc;
            --bs-primary-rgb:            255, 136, 204;
            --bs-link-color:             #88ffee;
            --bs-link-color-rgb:         136, 255, 238;
            --bs-link-hover-color:       #ffff88;
        }
        [data-theme="rainbow"] .btn-primary {
            background: linear-gradient(135deg, #ff0055, #ff8800, #ffff00) !important;
            border-color: transparent !important;
            color: #fff !important;
            text-shadow: 0 1px 3px rgba(0,0,0,.6);
            box-shadow: 0 0 14px rgba(255,100,100,.5);
        }
        [data-theme="rainbow"] .btn-primary:hover {
            background: linear-gradient(135deg, #00ff88, #0088ff, #8800ff) !important;
            box-shadow: 0 0 18px rgba(100,100,255,.6);
        }
        [data-theme="rainbow"] .nav-link.active {
            color: #ffff00 !important;
            text-shadow: 0 0 8px #fff;
        }
        [data-theme="rainbow"] .form-control:focus,
        [data-theme="rainbow"] .form-select:focus {
            border-color: #ff88cc;
            box-shadow: 0 0 0 .25rem rgba(255,136,204,.35), 0 0 12px rgba(255,100,255,.3);
        }
        [data-theme="rainbow"] .table-hover tbody tr:hover {
            background-color: rgba(255,255,255,.07);
        }
        [data-theme="rainbow"] h1, [data-theme="rainbow"] h2,
        [data-theme="rainbow"] h3, [data-theme="rainbow"] h4 {
            background: linear-gradient(90deg, #ff8888, #ffcc44, #88ff88, #44ccff, #cc88ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-xxl">
        <a class="navbar-brand" href="{{ path('dashboard') }}">
            <i class="bi bi-diagram-3-fill me-2"></i>IPAM
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'host' or app.request.attributes.get('_route') starts with 'interface' ? 'active' }}"
                       href="{{ path('host_index') }}">
                        <i class="bi bi-pc-display me-1"></i>Hosts
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'subnet' or app.request.attributes.get('_route') starts with 'vrf' ? 'active' }}"
                       href="{{ path('subnet_index') }}">
                        <i class="bi bi-diagram-2 me-1"></i>Subnets
                    </a>
                </li>
                {% set dnsActive = app.request.attributes.get('_route') starts with 'domain'
                    or app.request.attributes.get('_route') starts with 'dns_view'
                    or app.request.attributes.get('_route') starts with 'dns_acl'
                    or app.request.attributes.get('_route') starts with 'dnssec_policy'
                    or app.request.attributes.get('_route') starts with 'ksk_rollover' %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle {{ dnsActive ? 'active' }}" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-globe me-1"></i>DNS
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'domain' ? 'active' }}"
                               href="{{ path('domain_index') }}">
                                <i class="bi bi-globe me-1"></i>Domains
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'dns_view' ? 'active' }}"
                               href="{{ path('dns_view_index') }}">
                                <i class="bi bi-eye me-1"></i>Views
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'dns_acl' ? 'active' }}"
                               href="{{ path('dns_acl_index') }}">
                                <i class="bi bi-list-check me-1"></i>ACLs
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'dnssec_policy' ? 'active' }}"
                               href="{{ path('dnssec_policy_index') }}">
                                <i class="bi bi-shield-check me-1"></i>DNSSEC Policies
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'ksk_rollover' ? 'active' }}"
                               href="{{ path('ksk_rollover_index') }}">
                                <i class="bi bi-key me-1"></i>KSK Rollovers
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'dhcp_server' or app.request.attributes.get('_route') starts with 'dns_server' or app.request.attributes.get('_route') starts with 'servers' ? 'active' }}"
                       href="{{ path('servers_index') }}">
                        <i class="bi bi-server me-1"></i>Servers
                    </a>
                </li>
                {% set settingsActive = app.request.attributes.get('_route') starts with 'building' or app.request.attributes.get('_route') starts with 'tag' %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle {{ settingsActive ? 'active' }}" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-gear me-1"></i>Other Settings
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'building' ? 'active' }}"
                               href="{{ path('building_index') }}">
                                <i class="bi bi-building me-1"></i>Buildings
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'tag' ? 'active' }}"
                               href="{{ path('tag_index') }}">
                                <i class="bi bi-tags me-1"></i>Tags
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            {% if app.user %}
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item dropdown me-2">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false" title="Change theme" id="theme-picker">
                        <i class="bi bi-palette2"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header">Theme</h6></li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'light' ? 'active' }}" data-theme="light">
                                <span class="theme-swatch" style="background:#f8f9fa; border-color:#ced4da;"></span>
                                Light
                                {% if _theme == 'light' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'dark' ? 'active' }}" data-theme="dark">
                                <span class="theme-swatch" style="background:#212529;"></span>
                                Dark
                                {% if _theme == 'dark' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'purple' ? 'active' }}" data-theme="purple">
                                <span class="theme-swatch" style="background:#cc00ff; border-color:#ff00cc;"></span>
                                Purple
                                {% if _theme == 'purple' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'green' ? 'active' }}" data-theme="green">
                                <span class="theme-swatch" style="background:#00ff41; border-color:#00cc44;"></span>
                                Green
                                {% if _theme == 'green' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'rainbow' ? 'active' }}" data-theme="rainbow">
                                <span class="theme-swatch" style="background: linear-gradient(135deg,#ff0055,#ff8800,#ffff00,#00ff88,#0088ff,#8800ff); border-color:transparent;"></span>
                                Rainbow
                                {% if _theme == 'rainbow' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i>{{ app.user.displayName }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text text-muted small">{{ app.user.email }}</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a href="{{ path('saml_logout') }}" class="dropdown-item">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            {% endif %}
        </div>
    </div>
</nav>

<div class="{% block container_class %}container-xxl{% endblock %} mb-5">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    const darkBased = ['dark', 'purple', 'green', 'rainbow'];

    document.querySelectorAll('.theme-option').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const theme   = this.dataset.theme;
            const bsTheme = darkBased.includes(theme) ? 'dark' : 'light';
            const html    = document.documentElement;

            html.setAttribute('data-bs-theme', bsTheme);
            html.setAttribute('data-theme',    theme);

            // Update checkmarks
            document.querySelectorAll('.theme-option').forEach(function (b) {
                const icon = b.querySelector('.bi-check');
                if (icon) icon.remove();
                b.classList.remove('active');
            });
            const check = document.createElement('i');
            check.className = 'bi bi-check ms-auto';
            this.appendChild(check);
            this.classList.add('active');

            fetch('{{ path('api_preference_theme') }}', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ theme: theme }),
            });
        });
    });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
