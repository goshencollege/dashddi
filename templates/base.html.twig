{% set _theme = current_theme() %}
{% set _bsTheme = _theme in ['dark', 'purple', 'green'] ? 'dark' : 'light' %}
<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ _bsTheme }}" data-theme="{{ _theme }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}IPAM{% endblock %} – IP Address Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .navbar-brand { font-weight: 600; letter-spacing: .5px; }
        .table-hover tbody tr:hover { background-color: rgba(13,110,253,.05); }
        .ip-address { font-family: monospace; }
        thead { background-color: var(--bs-tertiary-bg); }
        .theme-swatch {
            display: inline-block; width: 13px; height: 13px;
            border-radius: 50%; flex-shrink: 0;
            border: 1px solid rgba(255,255,255,.25);
        }

        /* ── Purple theme ───────────────────────────────────────── */
        [data-theme="purple"] .navbar {
            background-color: #3b0764 !important;
        }
        [data-theme="purple"] thead {
            background-color: #4c1d95 !important;
        }
        [data-theme="purple"] {
            --bs-primary:                #9333ea;
            --bs-primary-rgb:            147, 51, 234;
            --bs-link-color:             #c084fc;
            --bs-link-color-rgb:         192, 132, 252;
            --bs-link-hover-color:       #d8b4fe;
        }
        [data-theme="purple"] .btn-primary {
            --bs-btn-bg:                 #7c3aed;
            --bs-btn-border-color:       #7c3aed;
            --bs-btn-hover-bg:           #6d28d9;
            --bs-btn-hover-border-color: #6d28d9;
            --bs-btn-active-bg:          #5b21b6;
        }
        [data-theme="purple"] .btn-outline-primary {
            --bs-btn-color:              #c084fc;
            --bs-btn-border-color:       #c084fc;
            --bs-btn-hover-bg:           #7c3aed;
            --bs-btn-hover-border-color: #7c3aed;
            --bs-btn-hover-color:        #fff;
        }
        [data-theme="purple"] .bg-primary       { background-color: #7c3aed !important; }
        [data-theme="purple"] .text-primary      { color: #c084fc !important; }
        [data-theme="purple"] .nav-link.active   { color: #c084fc !important; }
        [data-theme="purple"] .form-control:focus,
        [data-theme="purple"] .form-select:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 .25rem rgba(168,85,247,.25);
        }
        [data-theme="purple"] .table-hover tbody tr:hover {
            background-color: rgba(147,51,234,.12);
        }

        /* ── Green theme ────────────────────────────────────────── */
        [data-theme="green"] .navbar {
            background-color: #064e3b !important;
        }
        [data-theme="green"] thead {
            background-color: #065f46 !important;
        }
        [data-theme="green"] {
            --bs-primary:                #059669;
            --bs-primary-rgb:            5, 150, 105;
            --bs-link-color:             #34d399;
            --bs-link-color-rgb:         52, 211, 153;
            --bs-link-hover-color:       #6ee7b7;
        }
        [data-theme="green"] .btn-primary {
            --bs-btn-bg:                 #059669;
            --bs-btn-border-color:       #059669;
            --bs-btn-hover-bg:           #047857;
            --bs-btn-hover-border-color: #047857;
            --bs-btn-active-bg:          #065f46;
        }
        [data-theme="green"] .btn-outline-primary {
            --bs-btn-color:              #34d399;
            --bs-btn-border-color:       #34d399;
            --bs-btn-hover-bg:           #059669;
            --bs-btn-hover-border-color: #059669;
            --bs-btn-hover-color:        #fff;
        }
        [data-theme="green"] .bg-primary       { background-color: #059669 !important; }
        [data-theme="green"] .text-primary      { color: #34d399 !important; }
        [data-theme="green"] .nav-link.active   { color: #34d399 !important; }
        [data-theme="green"] .form-control:focus,
        [data-theme="green"] .form-select:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 .25rem rgba(16,185,129,.25);
        }
        [data-theme="green"] .table-hover tbody tr:hover {
            background-color: rgba(5,150,105,.12);
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('dashboard') }}">
            <i class="bi bi-diagram-3-fill me-2"></i>IPAM
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'host' or app.request.attributes.get('_route') starts with 'interface' ? 'active' }}"
                       href="{{ path('host_index') }}">
                        <i class="bi bi-pc-display me-1"></i>Hosts
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'subnet' or app.request.attributes.get('_route') starts with 'vrf' ? 'active' }}"
                       href="{{ path('subnet_index') }}">
                        <i class="bi bi-diagram-2 me-1"></i>Subnets
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'domain' or app.request.attributes.get('_route') starts with 'dns_view' ? 'active' }}"
                       href="{{ path('domain_index') }}">
                        <i class="bi bi-globe me-1"></i>Domains
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'dhcp_server' ? 'active' }}"
                       href="{{ path('dhcp_server_index') }}">
                        <i class="bi bi-hdd-network me-1"></i>DHCP
                    </a>
                </li>
                {% set settingsActive = app.request.attributes.get('_route') starts with 'building' or app.request.attributes.get('_route') starts with 'tag' %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle {{ settingsActive ? 'active' }}" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-gear me-1"></i>Other Settings
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'building' ? 'active' }}"
                               href="{{ path('building_index') }}">
                                <i class="bi bi-building me-1"></i>Buildings
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'tag' ? 'active' }}"
                               href="{{ path('tag_index') }}">
                                <i class="bi bi-tags me-1"></i>Tags
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            {% if app.user %}
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item dropdown me-2">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false" title="Change theme" id="theme-picker">
                        <i class="bi bi-palette2"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header">Theme</h6></li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'light' ? 'active' }}" data-theme="light">
                                <span class="theme-swatch" style="background:#f8f9fa; border-color:#ced4da;"></span>
                                Light
                                {% if _theme == 'light' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'dark' ? 'active' }}" data-theme="dark">
                                <span class="theme-swatch" style="background:#212529;"></span>
                                Dark
                                {% if _theme == 'dark' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'purple' ? 'active' }}" data-theme="purple">
                                <span class="theme-swatch" style="background:#7c3aed;"></span>
                                Purple
                                {% if _theme == 'purple' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2 theme-option {{ _theme == 'green' ? 'active' }}" data-theme="green">
                                <span class="theme-swatch" style="background:#059669;"></span>
                                Green
                                {% if _theme == 'green' %}<i class="bi bi-check ms-auto"></i>{% endif %}
                            </button>
                        </li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i>{{ app.user.displayName }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text text-muted small">{{ app.user.email }}</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a href="{{ path('saml_logout') }}" class="dropdown-item">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
            {% endif %}
        </div>
    </div>
</nav>

<div class="container mb-5">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    const darkBased = ['dark', 'purple', 'green'];

    document.querySelectorAll('.theme-option').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const theme   = this.dataset.theme;
            const bsTheme = darkBased.includes(theme) ? 'dark' : 'light';
            const html    = document.documentElement;

            html.setAttribute('data-bs-theme', bsTheme);
            html.setAttribute('data-theme',    theme);

            // Update checkmarks
            document.querySelectorAll('.theme-option').forEach(function (b) {
                const icon = b.querySelector('.bi-check');
                if (icon) icon.remove();
                b.classList.remove('active');
            });
            const check = document.createElement('i');
            check.className = 'bi bi-check ms-auto';
            this.appendChild(check);
            this.classList.add('active');

            fetch('{{ path('api_preference_theme') }}', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ theme: theme }),
            });
        });
    });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
