{% extends 'base.html.twig' %}
{% block title %}DHCP Lease Log{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% block content %}
<div class="list-page-content">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-journal-text me-2"></i>DHCP Lease Log</h1>
    <a href="{{ path('user_guide_dhcp') }}#leases" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('dhcp_lease_index') }}" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">MAC Address</label>
                <input type="text" name="mac" class="form-control form-control-sm"
                       placeholder="e.g. aa:bb:cc" value="{{ filter_mac }}">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">IP Address</label>
                <input type="text" name="ip" class="form-control form-control-sm"
                       placeholder="e.g. 192.168" value="{{ filter_ip }}">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Subnet</label>
                <select name="subnet" class="form-select form-select-sm">
                    <option value="">— All subnets —</option>
                    {% for s in subnets %}
                        <option value="{{ s.id }}" {{ filter_subnet == s.id ? 'selected' : '' }}>
                            {{ s.name }}{% if s.ipv4Cidr %} ({{ s.ipv4Cidr }}){% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>
            {% if servers|length > 1 %}
            <div class="col-md-auto">
                <label class="form-label small text-muted mb-1">DHCP Server</label>
                <select name="server" class="form-select form-select-sm">
                    <option value="">— All servers —</option>
                    {% for srv in servers %}
                        <option value="{{ srv.id }}" {{ filter_server == srv.id ? 'selected' : '' }}>
                            {{ srv.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
            <div class="col-md-auto">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a href="{{ path('dhcp_lease_index') }}" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="list-scroll-card">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-1"></i>Results</span>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small fst-italic" id="refresh-label"></span>
                <div class="btn-group btn-group-sm" id="refresh-controls" role="group" aria-label="Auto-refresh">
                    <button type="button" class="btn btn-outline-secondary active" data-interval="0">Off</button>
                    <button type="button" class="btn btn-outline-secondary" data-interval="30">30s</button>
                    <button type="button" class="btn btn-outline-secondary" data-interval="60">60s</button>
                </div>
                <span class="text-muted small"><span id="record-count">{{ total }}</span> record(s)</span>
            </div>
        </div>
        <div id="table-wrapper" class="table-scroll-wrapper">
            {% include 'dhcp_lease/_table.html.twig' %}
        </div>
    </div>
</div>{# /list-scroll-card #}
</div>{# /list-page-content #}
{% endblock %}

{% block scripts %}
<script>
(function () {
    var TABLE_URL = '{{ path('dhcp_lease_table') }}';
    var wrapper   = document.getElementById('table-wrapper');
    var label     = document.getElementById('refresh-label');
    var countEl   = document.getElementById('record-count');

    var intervalSecs = 0;
    var tickCount    = 0;
    var tickTimer    = null;
    var fetching     = false;

    function buildUrl() {
        return TABLE_URL + (window.location.search || '');
    }

    function doRefresh() {
        if (fetching) { return; }
        fetching = true;
        var scrollTop = wrapper.scrollTop;
        if (label) { label.textContent = 'Refreshing…'; }
        fetch(buildUrl(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) {
                if (r.status === 401) {
                    clearInterval(tickTimer);
                    window.location.reload();
                    return null;
                }
                return r.text();
            })
            .then(function (html) {
                if (html === null) { return; }
                wrapper.innerHTML = html;
                wrapper.scrollTop = scrollTop;
                var el = wrapper.querySelector('[data-record-count]');
                if (el && countEl) { countEl.textContent = el.getAttribute('data-record-count'); }
            })
            .catch(function () {})
            .finally(function () {
                fetching = false;
                tickCount = 0;
                updateLabel();
            });
    }

    function updateLabel() {
        if (!label) { return; }
        if (intervalSecs === 0) {
            label.textContent = '';
        } else {
            var left = intervalSecs - tickCount;
            label.textContent = left > 0 ? 'Next in ' + left + 's' : 'Refreshing…';
        }
    }

    function tick() {
        tickCount++;
        if (tickCount >= intervalSecs) {
            tickCount = 0;
            doRefresh();
        } else {
            updateLabel();
        }
    }

    function startRefresh(secs) {
        clearInterval(tickTimer);
        intervalSecs = secs;
        tickCount    = 0;
        if (secs > 0) {
            tickTimer = setInterval(tick, 1000);
            updateLabel();
        } else {
            if (label) { label.textContent = ''; }
        }
    }

    document.querySelectorAll('#refresh-controls button').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('#refresh-controls button').forEach(function (b) {
                b.classList.remove('active');
            });
            this.classList.add('active');
            startRefresh(parseInt(this.dataset.interval, 10));
        });
    });
})();
</script>
{% endblock %}
