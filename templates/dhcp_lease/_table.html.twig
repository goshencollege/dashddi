<span data-record-count="{{ leases|length }}" class="d-none"></span>
{% if leases|length == 0 %}
    <div class="card-body text-center text-muted py-4">No lease records found.</div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>MAC Address</th>
                    <th>IP Address</th>
                    <th>Subnet</th>
                    <th>Hostname</th>
                    <th>Lease Start</th>
                    <th>Expires</th>
                    {% if servers|length > 1 %}<th>Server</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for lease in leases %}
                    {% set iface = interface_map[lease.macAddress] ?? null %}
                    {% set vendor = mac_vendor(lease.macAddress) %}
                    <tr>
                        <td>
                            {% if iface %}
                                <a href="{{ path('interface_show', {id: iface.id}) }}"><code{% if vendor %} title="{{ vendor }}"{% endif %}>{{ lease.macAddress }}</code></a>
                            {% else %}
                                <code{% if vendor %} title="{{ vendor }}"{% endif %}>{{ lease.macAddress }}</code>
                            {% endif %}
                        </td>
                        <td><code>{{ lease.ipAddress }}</code></td>
                        <td>
                            {% if lease.subnet %}
                                <a href="{{ path('subnet_show', {id: lease.subnet.id}) }}">{{ lease.subnet.name }}</a>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ lease.hostname ?: '—' }}</td>
                        <td class="text-nowrap">{{ lease.leaseStart|date('Y-m-d H:i') }}</td>
                        <td class="text-nowrap">
                            {% if lease.leaseExpires %}
                                {{ lease.leaseExpires|date('Y-m-d H:i') }}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        {% if servers|length > 1 %}
                        <td>
                            {% if lease.dhcpServer %}
                                <span class="text-nowrap">{{ lease.dhcpServer.name }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if page > 1 or has_more %}
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page {{ page }}</span>
            <div>
                {% if page > 1 %}
                    <a href="{{ path('dhcp_lease_index', {mac: filter_mac, ip: filter_ip, subnet: filter_subnet, server: filter_server, page: page - 1}) }}"
                       class="btn btn-sm btn-outline-secondary me-1">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                {% endif %}
                {% if has_more %}
                    <a href="{{ path('dhcp_lease_index', {mac: filter_mac, ip: filter_ip, subnet: filter_subnet, server: filter_server, page: page + 1}) }}"
                       class="btn btn-sm btn-outline-secondary">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endif %}
