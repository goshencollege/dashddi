{% extends 'base.html.twig' %}
{% block title %}DNSSEC Policies{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-shield-check me-2"></i>DNSSEC Policies</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_dns') }}#dnssec" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('dnssec_policy_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Policy
        </a>
    </div>
</div>

{% if policies is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-25"></i>
            No DNSSEC policies yet. <a href="{{ path('dnssec_policy_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Keys</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for policy in policies %}
                        <tr>
                            <td class="fw-semibold"><code>{{ policy.name }}</code></td>
                            <td class="text-muted">{{ policy.description ?: '—' }}</td>
                            <td>
                                {% for key in policy.keys %}
                                    <span class="badge bg-secondary me-1">{{ key.type|upper }} / {{ key.algorithm }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endfor %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('dnssec_policy_edit', {id: policy.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('dnssec_policy_delete', {id: policy.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Delete policy {{ policy.name|e('js') }}?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_dnssec_policy_' ~ policy.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}
