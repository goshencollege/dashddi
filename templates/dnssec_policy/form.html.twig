{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('dnssec_policy_index') }}">DNSSEC Policies</a></li>
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        {{ form_start(form) }}

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-shield-check me-1"></i>{{ title }}</div>
            <div class="card-body">
                <div class="mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="mb-0">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-clock me-1"></i>Timing</div>
            <div class="card-body">
                <div class="form-text mb-3">All durations accept ISO 8601 format (e.g. <code>PT1H</code>, <code>P14D</code>) or seconds.</div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {{ form_label(form.dnskeyTtl) }}
                        {{ form_widget(form.dnskeyTtl, {attr: {class: 'form-control font-monospace'}}) }}
                        {{ form_errors(form.dnskeyTtl) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.maxZoneTtl) }}
                        {{ form_widget(form.maxZoneTtl, {attr: {class: 'form-control font-monospace'}}) }}
                        {{ form_errors(form.maxZoneTtl) }}
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {{ form_label(form.signaturesValidity) }}
                        {{ form_widget(form.signaturesValidity, {attr: {class: 'form-control font-monospace'}}) }}
                        {{ form_errors(form.signaturesValidity) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.signaturesRefresh) }}
                        {{ form_widget(form.signaturesRefresh, {attr: {class: 'form-control font-monospace'}}) }}
                        {{ form_errors(form.signaturesRefresh) }}
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {{ form_label(form.publishSafety) }}
                        {{ form_widget(form.publishSafety, {attr: {class: 'form-control font-monospace'}}) }}
                        {{ form_errors(form.publishSafety) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.retireSafety) }}
                        {{ form_widget(form.retireSafety, {attr: {class: 'form-control font-monospace'}}) }}
                        {{ form_errors(form.retireSafety) }}
                    </div>
                </div>
                <div class="row g-3 mb-0">
                    <div class="col-md-6">
                        {{ form_label(form.purgeKeys) }}
                        {{ form_widget(form.purgeKeys, {attr: {class: 'form-control font-monospace'}}) }}
                        {{ form_errors(form.purgeKeys) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.nsec3param) }}
                        {{ form_widget(form.nsec3param, {attr: {class: 'form-control font-monospace'}}) }}
                        <div class="form-text">Parameters: <code>iterations optout saltlength</code></div>
                        {{ form_errors(form.nsec3param) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-key me-1"></i>Keys</div>
            <div class="card-body">
                {% set proto = form.keys.vars.prototype %}
                {% set protoHtml %}
                <div class="row g-2 mb-2 key-entry align-items-center">
                    <div class="col-md-2">{{ form_widget(proto.type, {attr: {class: 'form-select form-select-sm'}}) }}</div>
                    <div class="col-md-5">{{ form_widget(proto.algorithm, {attr: {class: 'form-select form-select-sm'}}) }}</div>
                    <div class="col-md-3">{{ form_widget(proto.lifetime, {attr: {class: 'form-control form-control-sm', placeholder: 'e.g. unlimited, P30D'}}) }}</div>
                    <div class="col-md-2"><button type="button" class="btn btn-outline-danger btn-sm remove-key-entry w-100"><i class="bi bi-x-lg"></i></button></div>
                </div>
                {% endset %}

                <div class="row g-2 mb-2 text-muted small fw-semibold">
                    <div class="col-md-2">Type</div>
                    <div class="col-md-5">Algorithm</div>
                    <div class="col-md-3">Lifetime</div>
                    <div class="col-md-2"></div>
                </div>

                <div id="keys-container"
                     data-prototype="{{ protoHtml|e('html_attr') }}"
                     data-index="{{ form.keys|length }}">
                    {% for entry in form.keys %}
                        <div class="row g-2 mb-2 key-entry align-items-center">
                            <div class="col-md-2">{{ form_widget(entry.type, {attr: {class: 'form-select form-select-sm'}}) }}</div>
                            <div class="col-md-5">{{ form_widget(entry.algorithm, {attr: {class: 'form-select form-select-sm'}}) }}</div>
                            <div class="col-md-3">{{ form_widget(entry.lifetime, {attr: {class: 'form-control form-control-sm'}}) }}</div>
                            <div class="col-md-2"><button type="button" class="btn btn-outline-danger btn-sm remove-key-entry w-100"><i class="bi bi-x-lg"></i></button></div>
                        </div>
                    {% endfor %}
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="add-key-entry">
                    <i class="bi bi-plus-lg me-1"></i>Add key
                </button>
                {{ form_errors(form.keys) }}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-code-square me-1"></i>Additional Options</div>
            <div class="card-body">
                <div class="form-text mb-2">Raw BIND statements inserted verbatim inside the <code>dnssec-policy</code> block.</div>
                {{ form_widget(form.extraOptions, {attr: {class: 'form-control font-monospace', rows: 4}}) }}
                {{ form_errors(form.extraOptions) }}
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a href="{{ path('dnssec_policy_index') }}" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Save
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
document.getElementById('add-key-entry').addEventListener('click', function () {
    const container = document.getElementById('keys-container');
    const index     = parseInt(container.dataset.index, 10);
    const html      = container.dataset.prototype.replace(/__name__/g, index);
    const div       = document.createElement('div');
    div.innerHTML   = html.trim();
    container.appendChild(div.firstElementChild);
    container.dataset.index = index + 1;
});

document.addEventListener('click', function (e) {
    const btn = e.target.closest('.remove-key-entry');
    if (btn) btn.closest('.key-entry').remove();
});
</script>
{% endblock %}
