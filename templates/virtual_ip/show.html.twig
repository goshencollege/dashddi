{% extends 'base.html.twig' %}
{% block title %}{{ vip.label }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        {% if from == 'interface' and interface %}
            <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
            {% if interface.host %}
                <li class="breadcrumb-item"><a href="{{ path('host_show', {id: interface.host.id}) }}">{{ interface.host.name }}</a></li>
            {% endif %}
            <li class="breadcrumb-item"><a href="{{ path('interface_show', {id: interface.id}) }}">{{ interface.name ?: interface.macAddress }}</a></li>
        {% else %}
            <li class="breadcrumb-item"><a href="{{ path('subnet_index') }}">Subnets</a></li>
            {% if vip.subnet %}
                <li class="breadcrumb-item"><a href="{{ path('subnet_show', {id: vip.subnet.id}) }}">{{ vip.subnet.name }}</a></li>
            {% endif %}
        {% endif %}
        <li class="breadcrumb-item active">{{ vip.label }}</li>
    </ol>
</nav>

{% if vip.deleted %}
<div class="alert alert-warning d-flex align-items-center justify-content-between mb-3">
    <div>
        <i class="bi bi-trash me-2"></i>
        <strong>This virtual IP was deleted</strong> on {{ vip.deletedAt|date('Y-m-d H:i') }}.
    </div>
    <form method="post" action="{{ path('virtual_ip_restore', {id: vip.id}) }}" class="ms-3 flex-shrink-0">
        <input type="hidden" name="_token" value="{{ csrf_token('restore_vip_' ~ vip.id) }}">
        <button type="submit" class="btn btn-warning btn-sm text-nowrap">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
        </button>
    </form>
</div>
{% endif %}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-layers me-2"></i>{{ vip.label }}</h1>
        <span class="badge bg-secondary me-1">{{ vip.protocol.label() }}</span>
        {% if vip.vrid %}<span class="badge bg-outline-secondary border">VRID {{ vip.vrid }}</span>{% endif %}
    </div>
    {% if not vip.deleted %}
    <div class="d-flex gap-2">
        <a href="{{ path('virtual_ip_edit', {id: vip.id, from: from, interfaceId: interface ? interface.id : null}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('virtual_ip_delete', {id: vip.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete virtual IP {{ vip.label|e('js') }}?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_vip_' ~ vip.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
    {% endif %}
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-info-circle me-1"></i>Details</div>
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th class="text-muted fw-normal ps-3" style="width:20%">Subnet</th>
                        <td style="width:30%">
                            {% if vip.subnet %}
                                <a href="{{ path('subnet_show', {id: vip.subnet.id}) }}">{{ vip.subnet.name }}</a>
                            {% else %}—{% endif %}
                        </td>
                        <th class="text-muted fw-normal ps-3" style="width:20%">Protocol</th>
                        <td>{{ vip.protocol.label() }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">IPv4 Address</th>
                        <td class="ip-address">{{ vip.ipAddress ? vip.ipAddress.address : '—' }}</td>
                        <th class="text-muted fw-normal ps-3">VRID / Group ID</th>
                        <td>{{ vip.vrid ?: '—' }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">IPv6 Address</th>
                        <td class="ip-address small">{{ vip.ipv6Address ? vip.ipv6Address.address : '—' }}</td>
                        <td colspan="2"></td>
                    </tr>
                    {% if vip.notes %}
                    <tr>
                        <th class="text-muted fw-normal ps-3">Notes</th>
                        <td colspan="3" style="white-space:pre-wrap">{{ vip.notes }}</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-hdd-network me-1"></i>Member Interfaces</div>
    {% if vip.memberInterfaces is empty %}
        <div class="card-body text-muted text-center py-3">No member interfaces assigned.</div>
    {% else %}
        <table class="table table-sm mb-0">
            <thead><tr><th>MAC Address</th><th>Name</th><th>Host</th><th>IPv4</th></tr></thead>
            <tbody>
                {% for iface in vip.memberInterfaces %}
                <tr>
                    <td><a href="{{ path('interface_show', {id: iface.id}) }}"><code>{{ iface.macAddress }}</code></a></td>
                    <td class="text-muted">{{ iface.name ?: '—' }}</td>
                    <td>
                        {% if iface.host %}
                            <a href="{{ path('host_show', {id: iface.host.id}) }}">{{ iface.host.name }}</a>
                        {% else %}—{% endif %}
                    </td>
                    <td class="ip-address">{{ iface.ipAddress ? iface.ipAddress.address : '—' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-globe me-1"></i>DNS Records</span>
        {% if not vip.deleted %}
        <a href="{{ path('virtual_ip_domain_record_new', {id: vip.id}) }}" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Record
        </a>
        {% endif %}
    </div>
    {% if vip.domainRecords is empty %}
        <div class="card-body text-muted text-center py-3">No DNS records assigned.</div>
    {% else %}
        <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>View</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            {% set type_colors = {'A': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'AAAA': 'bg-info-subtle text-info-emphasis border border-info-subtle', 'CNAME': 'bg-success-subtle text-success-emphasis border border-success-subtle', 'MX': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'NS': 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle', 'TXT': 'badge-orange-subtle', 'PTR': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'SRV': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'DS': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'CAA': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'HTTPS': 'badge-purple-subtle'} %}
            <tbody>
                {% for record in vip.domainRecords %}
                <tr>
                    <td class="font-monospace small">
                        {{ record.fullyQualifiedHostname }}
                        {% if record.canonical %}
                            <span class="badge bg-primary ms-1" title="Canonical — used for PTR reverse DNS">PTR</span>
                        {% endif %}
                    </td>
                    <td><span class="badge {{ type_colors[record.type.value] ?? 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' }}">{{ record.type.value }}</span></td>
                    <td class="font-monospace small">
                        {% if record.type.value == 'A' %}
                            {{ vip.ipAddress ? vip.ipAddress.address : '—' }}
                        {% elseif record.type.value == 'AAAA' %}
                            {{ vip.ipv6Address ? vip.ipv6Address.address : '—' }}
                        {% else %}
                            {{ record.value }}
                        {% endif %}
                    </td>
                    <td class="small">
                        {% if record.views is empty %}
                            <span class="text-muted">No views</span>
                        {% else %}
                            {% set view_palettes = ['bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'bg-success-subtle text-success-emphasis border border-success-subtle', 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'bg-info-subtle text-info-emphasis border border-info-subtle', 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle'] %}
                            {% for view in record.views %}
                                <span class="badge {{ view_palettes[view.id % (view_palettes|length)] }}">{{ view.name }}</span>
                            {% endfor %}
                        {% endif %}
                    </td>
                    <td class="text-end" style="white-space:nowrap">
                        <a href="{{ path('domain_record_edit', {id: record.id, from: 'virtual-ip'}) }}" class="btn btn-sm btn-outline-secondary me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('domain_record_unlink', {id: record.id}) }}"
                              class="d-inline" onsubmit="return confirm('Unlink this record from the VIP? The record will remain in the domain.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('unlink_record_' ~ record.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-warning me-1" title="Unlink from VIP">
                                <i class="bi bi-slash-circle"></i>
                            </button>
                        </form>
                        <form method="post" action="{{ path('domain_record_delete', {id: record.id}) }}" class="d-inline"
                              onsubmit="return confirm('Delete this DNS record?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_record_' ~ record.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
</div>
{% endblock %}
