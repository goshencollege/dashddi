{% extends 'base.html.twig' %}
{% block title %}Start Disable DNSSEC{% endblock %}

{% block content %}
<div class="row justify-content-center">
<div class="col-lg-6">

<div class="d-flex align-items-center mb-3 gap-2">
    <a href="{{ path('dnssec_disable_index') }}" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 mb-0"><i class="bi bi-shield-x me-2"></i>Start Disable DNSSEC</h1>
</div>

<div class="alert alert-warning">
    <strong>What this does:</strong> Walks you through safely decommissioning DNSSEC for a zone — removing the DS record at your registrar first, then retiring the zone's keys, so validating resolvers never see a broken trust chain. This is a one-way process; to switch algorithms instead, use <a href="{{ path('ksk_rollover_start') }}">KSK Rollover</a>.
</div>

{{ form_start(form) }}

<div class="card mb-3">
    <div class="card-header fw-semibold">Zone to Disable</div>
    <div class="card-body row g-3">
        <div class="col-12">
            {{ form_label(form.zone, 'Zone') }}
            {{ form_widget(form.zone) }}
            {{ form_errors(form.zone) }}
            <div class="form-text">Forward zones and reverse zones (subnets) with a DNSSEC policy are listed. Reverse zone names are shown after →.</div>
        </div>
        <div class="col-12">
            {{ form_label(form.dnsServer, 'DNS Server') }}
            {{ form_widget(form.dnsServer) }}
            {{ form_errors(form.dnsServer) }}
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-warning text-dark">
        <i class="bi bi-shield-x me-1"></i>Start Disable Request
    </button>
    <a href="{{ path('dnssec_disable_index') }}" class="btn btn-outline-secondary">Cancel</a>
</div>

{{ form_end(form) }}

</div>
</div>
{% endblock %}
