{% extends 'base.html.twig' %}
{% block title %}Disable DNSSEC{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-shield-x me-2"></i>Disable DNSSEC</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_dns') }}#dnssec" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('dnssec_disable_start') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Start Disable Request
        </a>
    </div>
</div>

{% if requests is empty %}
    <div class="alert alert-secondary">No DNSSEC disable requests recorded yet.</div>
{% else %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Zone</th>
                    <th>DNS Server</th>
                    <th>Status</th>
                    <th>Keys Retired</th>
                    <th>Started</th>
                    <th>Completed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for r in requests %}
                <tr>
                    <td>{{ r.zoneName }}</td>
                    <td>{{ r.dnsServer ? r.dnsServer.name : '—' }}</td>
                    <td><span class="badge {{ r.status.badgeClass() }}">{{ r.status.label() }}</span></td>
                    <td class="font-monospace">{{ r.retiredKeys|length ?: '—' }}</td>
                    <td>{{ r.startedAt|date('Y-m-d H:i') }}</td>
                    <td>{{ r.completedAt ? r.completedAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>
                        <a href="{{ path('dnssec_disable_show', {id: r.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
