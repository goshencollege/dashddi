        <section id="host-self" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Host Self-Service <code class="small fw-normal text-muted">/api/self</code></h2>
            <p class="text-muted small mb-1">Endpoints accessible only with a <strong>host-scoped token</strong>. Requests are accepted only from IP addresses assigned to the token's host's network interfaces — any other source is rejected with <code>401</code>. These endpoints are designed for ACME DNS-01 certificate automation running directly on the host. See <a href="{{ path('user_guide_integrations') }}#api-self">the integrations guide</a> for setup examples.</p>
            <table class="table table-sm table-borderless mb-4 small">
                <tbody>
                    <tr><td style="width:3.5rem"><span class="badge bg-primary font-monospace">GET</span></td><td><code>/api/self/host</code></td><td class="text-muted">Return host info, interfaces, and publicly-reachable DNS records</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/self/dns-challenge</code></td><td class="text-muted">Create an ACME DNS-01 challenge TXT record</td></tr>
                    <tr><td><span class="badge bg-danger font-monospace">DELETE</span></td><td><code>/api/self/dns-challenge</code></td><td class="text-muted">Delete the ACME challenge TXT record after validation</td></tr>
                </tbody>
            </table>

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-self-host',
                method: 'GET', path: '/api/self/host', name: 'Get host info',
                notes: 'Returns the host associated with the token, its network interfaces, and the DNS records linked to each interface. Only records in domains with at least one public DNS view (marked as public in DNS → Views) are included; domains with no view restriction are treated as globally accessible.',
                response_example: '{\n  "id": 7,\n  "name": "web01",\n  "interfaces": [\n    {\n      "id": 12,\n      "name": "eth0",\n      "mac": "aa:bb:cc:dd:ee:ff",\n      "ipv4": "10.0.0.5",\n      "ipv6": null,\n      "records": [\n        {\n          "id": 44,\n          "hostname": "web01",\n          "fqdn": "web01.example.com",\n          "type": "A",\n          "value": "10.0.0.5",\n          "domain_id": 3\n        }\n      ]\n    }\n  ]\n}',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-self-challenge-create',
                method: 'POST', path: '/api/self/dns-challenge', name: 'Create challenge TXT record',
                notes: 'Creates a <code>_acme-challenge.*</code> TXT record for ACME DNS-01 validation. The <code>fqdn</code> must match a DNS record already assigned to one of the host\'s interfaces. The challenge record is assigned to all views the domain is part of (not just the views of the source record), so Let\'s Encrypt can reach it via whichever view is externally reachable. The domain must have at least one public view (marked as public in DNS → Views); requests for domains with only internal views return <code>422</code>.',
                body: [
                    {name: 'fqdn', type: 'string', required: true, desc: 'Fully-qualified domain name to certify (e.g. <code>web01.example.com</code>). For an apex record, pass the bare domain (e.g. <code>example.com</code>).'},
                    {name: 'validation', type: 'string', required: true, desc: 'ACME token value provided by the CA (the string that must appear in the TXT record).'},
                ],
                response_example: '{\n  "id": 99,\n  "hostname": "_acme-challenge.web01"\n}',
                response_status: '201',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-self-challenge-delete',
                method: 'DELETE', path: '/api/self/dns-challenge', name: 'Delete challenge TXT record',
                notes: 'Removes the matching <code>_acme-challenge.*</code> TXT record after validation is complete. The request body is identical to the create request — both <code>fqdn</code> and <code>validation</code> must match the record to delete. Returns <code>404</code> if no matching record is found.',
                body: [
                    {name: 'fqdn', type: 'string', required: true, desc: 'Fully-qualified domain name used when creating the challenge.'},
                    {name: 'validation', type: 'string', required: true, desc: 'ACME token value used when creating the challenge.'},
                ],
                response_status: '204',
            } %}
        </section>

    </div>{# /col #}
</div>{# /row #}

<script>
(function () {
    function openCollapseForHash(hash) {
        if (!hash) return;
        var target = document.querySelector(hash);
        if (!target) return;
        var section = target.closest('section[id]');
        if (!section) return;
        var collapseEl = document.getElementById('nav-' + section.id);
        if (!collapseEl) return;
        bootstrap.Collapse.getOrCreateInstance(collapseEl, {toggle: false}).show();
        var btn = document.querySelector('[data-bs-target="#nav-' + section.id + '"]');
        if (btn) btn.classList.remove('collapsed');
    }
    document.addEventListener('DOMContentLoaded', function () {
        openCollapseForHash(window.location.hash);
    });
    window.addEventListener('hashchange', function () {
        openCollapseForHash(window.location.hash);
    });
}());
</script>
{% endblock %}
