            <h2 class="h5 border-bottom pb-2 mb-3">Tags <code class="small fw-normal text-muted">/api/tags</code></h2>
            <p class="text-muted small mb-1">Tags are short labels applied to hosts and subnets for filtering and organization. The create endpoint is idempotent — existing tags are returned rather than duplicated.</p>
            <table class="table table-sm table-borderless mb-4 small">
                <tbody>
                    <tr><td style="width:3.5rem"><span class="badge bg-primary font-monospace">GET</span></td><td><code>/api/tags</code></td><td class="text-muted">Search tags by name (up to 20 results)</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/tags</code></td><td class="text-muted">Create a tag (idempotent)</td></tr>
                </tbody>
            </table>

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-tags-search',
                method: 'GET', path: '/api/tags', name: 'Search tags',
                notes: 'Returns up to 20 results. If no query is provided, returns the first 20 tags alphabetically.',
                query: [
                    {name: 'q', type: 'string', desc: 'Partial name match.'},
                ],
                response_example: '[\n  {"value": "1", "text": "production"},\n  {"value": "2", "text": "staging"}\n]',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-tags-create',
                method: 'POST', path: '/api/tags', name: 'Create tag',
                notes: 'Idempotent — if a tag with the given name already exists, it is returned rather than creating a duplicate.',
                body: [
                    {name: 'name', type: 'string', required: true, desc: 'Tag name.'},
                ],
                response_example: '{"value": "1", "text": "production"}',
                response_status: '200',
            } %}
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           DHCP LEASE
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="dhcp-lease" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">DHCP Lease <code class="small fw-normal text-muted">/api/dhcp/lease</code></h2>
            <p class="text-muted small mb-1">Write-only endpoint used by DHCP servers to record lease events. The subnet is matched automatically from the IP address. Typically called from a Kea <code>run_script</code> hook — see the <a href="{{ path('user_guide_integrations') }}#kea-lease-notifications">integrations guide</a> for setup instructions.</p>
            <table class="table table-sm table-borderless mb-4 small">
                <tbody>
                    <tr><td style="width:3.5rem"><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/dhcp/lease</code></td><td class="text-muted">Record a DHCP lease event</td></tr>
                </tbody>
            </table>

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-dhcp-lease-record',
                method: 'POST', path: '/api/dhcp/lease', name: 'Record DHCP lease',
                body: [
                    {name: 'ip-address', type: 'string', required: true, desc: 'Leased IP address.'},
                    {name: 'hw-address', type: 'string', required: true, desc: 'Client MAC address.'},
                    {name: 'hostname', type: 'string', required: false, desc: 'Client-provided hostname.'},
                    {name: 'expire', type: 'integer', required: false, desc: 'Lease expiry as a Unix timestamp.'},
                ],
                response_example: '{"id": 42}',
                response_status: '201',
            } %}
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           SWITCH PORTS
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="switch-ports" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Switch Ports <code class="small fw-normal text-muted">/api/switch</code></h2>
            <p class="text-muted small mb-1">Query live port-access client data and trigger port actions on Aruba CX switches. The target port is resolved by looking up the most recent ClearPass auth log for the given MAC or IP address. Aruba CX credentials must be configured in the application.</p>
            <table class="table table-sm table-borderless mb-4 small">
                <tbody>
                    <tr><td style="width:3.5rem"><span class="badge bg-primary font-monospace">GET</span></td><td><code>/api/switch/port-status</code></td><td class="text-muted">Get live port-access client data</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/switch/port-reauthenticate</code></td><td class="text-muted">Force 802.1X/MAC-auth reauthentication</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/switch/port-bounce</code></td><td class="text-muted">Shut port down and bring it back up</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/switch/port-poe-bounce</code></td><td class="text-muted">Power-cycle PoE on the port</td></tr>
                </tbody>
            </table>

            <h3 class="h6 mt-3 mb-2">Port resolution</h3>
            <p class="small">All four endpoints accept the same two ways to identify the target port:</p>
            <table class="table table-sm table-bordered mb-3 small">
                <thead class="table-light"><tr><th>Field</th><th>Description</th></tr></thead>
                <tbody>
                    <tr><td><code>mac</code></td><td>MAC address of the client (any format — <code>aa:bb:cc:dd:ee:ff</code>, <code>aa-bb-cc-dd-ee-ff</code>, or bare <code>aabbccddeeff</code>). Looks up the switch IP and port from the most recent ClearPass auth log for this MAC.</td></tr>
                    <tr><td><code>ip</code></td><td>IPv4 address of the client. Resolves to the interface's MAC address, then performs the same ClearPass lookup as above.</td></tr>
                </tbody>
            </table>
            <p class="small text-muted">The lookup is subject to the switch info max-age setting — if the most recent auth log for that address is older than the configured limit, a <code>404</code> is returned.</p>
            <p class="small text-muted mb-4">Port actions (reauthenticate, bounce, PoE bounce) connect to the switch over SSH and may take up to 15–20 seconds to complete due to the built-in pause between down and up states.</p>

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-switch-port-status',
                method: 'GET', path: '/api/switch/port-status', name: 'Get port-access clients',
                notes: 'Returns live port-access client data for the specified port. Tries the REST API first; falls back to SSH if REST is unavailable.',
                query: [
                    {name: 'mac', type: 'string', desc: 'Client MAC address (any common format).'},
                    {name: 'ip', type: 'string', desc: 'Client IPv4 address.'},
                ],
                response_example: '{\n  "clients": [\n    {\n      "mac": "20:4c:03:d7:c0:bf",\n      "vlan": "44",\n      "role": "CX_DUR_Local_VLAN44-3050-9",\n      "status": "Success",\n      "auth_method": "MAC-Auth"\n    }\n  ],\n  "raw": "...",\n  "via": "rest",\n  "error": null\n}',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-switch-port-reauth',
                method: 'POST', path: '/api/switch/port-reauthenticate', name: 'Reauthenticate port',
                notes: 'Sends a <code>port-access reauthenticate interface</code> command to the switch via SSH, forcing the connected client to re-run 802.1X or MAC-auth.',
                body: [
                    {name: 'mac', type: 'string', required: false, desc: 'Client MAC address. One of <code>mac</code> or <code>ip</code> is required.'},
                    {name: 'ip', type: 'string', required: false, desc: 'Client IPv4 address.'},
                ],
                response_example: '{\n  "success": true,\n  "error": null,\n  "output": "Last login: 2026-05-21 17:00:57 from 192.168.60.134\ncx-sas# port-access reauthenticate interface 1\/1\/18\ncx-sas#"\n}',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-switch-port-bounce',
                method: 'POST', path: '/api/switch/port-bounce', name: 'Bounce port',
                notes: 'Administratively shuts the port down, waits 10 seconds, then brings it back up. Tries the REST API first; falls back to SSH. Disconnects and reconnects any client on the port.',
                body: [
                    {name: 'mac', type: 'string', required: false, desc: 'Client MAC address. One of <code>mac</code> or <code>ip</code> is required.'},
                    {name: 'ip', type: 'string', required: false, desc: 'Client IPv4 address.'},
                ],
                response_example: '{\n  "success": true,\n  "error": null,\n  "output": "Last login: 2026-05-21 17:00:57 from 192.168.60.134\ncx-sas# configure terminal\ncx-sas(config)# interface 1\/1\/18\ncx-sas(config-if)# shutdown\ncx-sas(config-if)# no shutdown\ncx-sas(config-if)# end\ncx-sas#"\n}',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-switch-port-poe',
                method: 'POST', path: '/api/switch/port-poe-bounce', name: 'PoE bounce port',
                notes: 'Cuts PoE power to the port (<code>no power-over-ethernet</code>), shuts it down, waits 10 seconds, then restores both. Forces a full power cycle of any PoE-powered device (e.g. an AP or IP phone).',
                body: [
                    {name: 'mac', type: 'string', required: false, desc: 'Client MAC address. One of <code>mac</code> or <code>ip</code> is required.'},
                    {name: 'ip', type: 'string', required: false, desc: 'Client IPv4 address.'},
                ],
                response_example: '{\n  "success": true,\n  "error": null,\n  "output": "Last login: 2026-05-21 17:00:57 from 192.168.60.134\ncx-sas# configure terminal\ncx-sas(config)# interface 1\/1\/18\ncx-sas(config-if)# no power-over-ethernet\ncx-sas(config-if)# shutdown\ncx-sas(config-if)# no shutdown\ncx-sas(config-if)# power-over-ethernet\ncx-sas(config-if)# end\ncx-sas#"\n}',
            } %}
        </section>

    </div>{# /col #}
</div>{# /row #}

<script>
(function () {
    function openCollapseForHash(hash) {
        if (!hash) return;
        var target = document.querySelector(hash);
        if (!target) return;
        var section = target.closest('section[id]');
        if (!section) return;
        var collapseEl = document.getElementById('nav-' + section.id);
        if (!collapseEl) return;
        bootstrap.Collapse.getOrCreateInstance(collapseEl, {toggle: false}).show();
        var btn = document.querySelector('[data-bs-target="#nav-' + section.id + '"]');
        if (btn) btn.classList.remove('collapsed');
    }
    document.addEventListener('DOMContentLoaded', function () {
        openCollapseForHash(window.location.hash);
    });
    window.addEventListener('hashchange', function () {
        openCollapseForHash(window.location.hash);
    });
}());
</script>
{% endblock %}
