                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/interfaces</code></td><td class="text-muted">Create an interface (supports auto IP assignment)</td></tr>
                    <tr><td><span class="badge bg-warning text-dark font-monospace">PATCH</span></td><td><code>/api/interfaces/{id}</code></td><td class="text-muted">Update an interface</td></tr>
                    <tr><td><span class="badge bg-danger font-monospace">DELETE</span></td><td><code>/api/interfaces/{id}</code></td><td class="text-muted">Soft-delete an interface</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/interfaces/{id}/restore</code></td><td class="text-muted">Restore a soft-deleted interface</td></tr>
                    <tr><td><span class="badge bg-primary font-monospace">GET</span></td><td><code>/api/interfaces/search</code></td><td class="text-muted">Full-text search across host name, MAC, and IP</td></tr>
                </tbody>
            </table>

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-interfaces-list',
                method: 'GET', path: '/api/interfaces', name: 'List interfaces',
                query: [
                    {name: 'host_id', type: 'integer', desc: 'Filter by host ID.'},
                    {name: 'subnet_id', type: 'integer', desc: 'Filter by subnet ID.'},
                    {name: 'mac_address', type: 'string', desc: 'Exact MAC address match.'},
                    {name: 'deleted', type: 'string', desc: 'Omit or pass <code>false</code> for active interfaces only (default). Pass <code>true</code> for deleted interfaces only. Pass <code>all</code> to return both active and deleted.'},
