                    <tr><td><span class="badge bg-warning text-dark font-monospace">PATCH</span></td><td><code>/api/hosts/{id}</code></td><td class="text-muted">Update a host</td></tr>
                    <tr><td><span class="badge bg-danger font-monospace">DELETE</span></td><td><code>/api/hosts/{id}</code></td><td class="text-muted">Soft-delete a host and its interfaces</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/hosts/{id}/restore</code></td><td class="text-muted">Restore a soft-deleted host</td></tr>
                </tbody>
