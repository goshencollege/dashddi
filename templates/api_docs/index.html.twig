                    {name: 'protocol', type: 'string', required: false, desc: 'Redundancy protocol: <code>vrrp</code>, <code>hsrp</code>, <code>active_gateway</code>, or <code>other</code>. Defaults to <code>vrrp</code>.'},
                    {name: 'vrid', type: 'integer|null', required: false, desc: 'Virtual Router ID / group number (1–255). Applies to VRRP and HSRP.'},
