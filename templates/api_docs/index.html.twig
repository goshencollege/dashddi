           ═══════════════════════════════════════════════════════════════════ #}
        <section id="buildings" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Buildings <code class="small fw-normal text-muted">/api/buildings</code></h2>
            <p class="text-muted small mb-3">Simple CRUD for building records used to categorize hosts by physical location.</p>
            <table class="table table-sm table-borderless mb-4 small">
                <tbody>
                    <tr><td style="width:3.5rem"><span class="badge bg-primary font-monospace">GET</span></td><td><code>/api/buildings</code></td><td class="text-muted">List all buildings</td></tr>
                    <tr><td><span class="badge bg-primary font-monospace">GET</span></td><td><code>/api/buildings/{id}</code></td><td class="text-muted">Get a building</td></tr>
                    <tr><td><span class="badge bg-success font-monospace">POST</span></td><td><code>/api/buildings</code></td><td class="text-muted">Create a building</td></tr>
                    <tr><td><span class="badge bg-warning text-dark font-monospace">PATCH</span></td><td><code>/api/buildings/{id}</code></td><td class="text-muted">Update a building</td></tr>
                    <tr><td><span class="badge bg-danger font-monospace">DELETE</span></td><td><code>/api/buildings/{id}</code></td><td class="text-muted">Delete a building</td></tr>
                </tbody>
            </table>

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-buildings-list',
                method: 'GET', path: '/api/buildings', name: 'List buildings',
                query: [
                    {name: 'name', type: 'string', desc: 'Partial name match (case-insensitive).'},
                ],
                response_example: '[\n  {\n    "id": 1,\n    "name": "Science Hall",\n    "description": "Main science building"\n  }\n]',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-buildings-get',
                method: 'GET', path: '/api/buildings/{id}', name: 'Get building',
