                response_example: '[\n  {\n    "id": 1,\n    "name": "eth0",\n    "mac_address": "aa:bb:cc:dd:ee:ff",\n    "host_id": 1,\n    "subnet_id": 2,\n    "ip_address": "10.0.0.5",\n    "ipv6_address": null,\n    "deleted_at": null,\n    "created_at": "2024-01-01T00:00:00+00:00",\n    "updated_at": "2024-01-01T00:00:00+00:00",\n    "created_by": "user@example.com",\n    "updated_by": "user@example.com"\n  }\n]',
