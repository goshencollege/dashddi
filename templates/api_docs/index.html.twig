            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                anchor_id: 'ep-virtual-ips-create',
                method: 'POST', path: '/api/virtual-ips', name: 'Create virtual IP',
                notes: 'For <code>ip_address</code> and <code>ipv6_address</code>, pass <code>"auto"</code> to auto-assign the next available address from the subnet, a specific IP string to assign that address, or omit to leave unassigned. For IPv6 only, <code>"auto_v4"</code> derives the address from the VIP\'s IPv4 assignment.',
