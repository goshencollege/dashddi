{% extends 'base.html.twig' %}
{% block title %}API Documentation{% endblock %}

{% block content %}
<div class="row g-4">

    {# ── Sidebar ─────────────────────────────────────────────────────────── #}
    <div class="col-lg-2 d-none d-lg-block">
        <nav class="sticky-top pt-1" style="top:1rem">
            <div class="small fw-semibold text-uppercase text-muted mb-2 ps-2">Contents</div>
            <ul class="nav flex-column nav-pills nav-fill gap-1 small">
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#auth">Authentication</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#responses">Responses</a></li>
                <li class="nav-item mt-2">
                    <span class="small fw-semibold text-uppercase text-muted ps-2">Resources</span>
                </li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#buildings">Buildings</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#dns-servers">DNS Servers</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#dhcp-servers">DHCP Servers</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#hosts">Hosts</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#interfaces">Interfaces</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#interface-names">Interface Names</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#subnets">Subnets</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#address-blocks">Address Blocks</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#domains">Domains</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#domain-records">Domain Records</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#tags">Tags</a></li>
                <li class="nav-item"><a class="nav-link py-1 px-2 text-start" href="#dhcp-lease">DHCP Lease</a></li>
            </ul>
        </nav>
    </div>

    {# ── Main content ─────────────────────────────────────────────────────── #}
    <div class="col-lg-10">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0"><i class="bi bi-file-earmark-code me-2"></i>API Documentation</h1>
            <a href="{{ path('api_token_index') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-key me-1"></i>My Tokens
            </a>
        </div>

        {# ── Authentication ──────────────────────────────────────────────── #}
        <section id="auth" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Authentication</h2>
            <p>All API endpoints require a token. Tokens are created and managed on the <a href="{{ path('api_token_index') }}">API Tokens</a> page. Two header formats are supported:</p>

            <h3 class="h6 mt-3 mb-1">Bearer token <span class="text-muted fw-normal">(preferred)</span></h3>
            <pre class="bg-dark text-light rounded p-3 small"><code>Authorization: Bearer &lt;your-token&gt;</code></pre>

            <h3 class="h6 mt-3 mb-1">HTTP Basic Auth</h3>
            <p class="small">For clients that only support HTTP Basic Auth, send the token as the <strong>password</strong>. The username field is ignored.</p>
            <pre class="bg-dark text-light rounded p-3 small"><code>Authorization: Basic &lt;base64(anyuser:your-token)&gt;

# Example with curl:
curl -u "token:&lt;your-token&gt;" https://example.com/api/...</code></pre>

            <h3 class="h6 mt-3 mb-1">IP / CIDR restrictions</h3>
            <p class="small mb-0">Tokens can optionally be restricted to one or more source IP addresses or CIDR ranges (IPv4 and IPv6 both supported). Requests from addresses outside the allowlist are rejected with <code>403</code>. Tokens with no IP restriction accept requests from any address. Restrictions are configured when creating or editing a token.</p>

            <p class="mt-3 mb-0 text-muted small">Always use <strong>HTTPS</strong>. HTTP requests will be redirected and the Authorization header will be stripped by the redirect.</p>
        </section>

        {# ── Common responses ────────────────────────────────────────────── #}
        <section id="responses" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Common Response Codes</h2>
            <table class="table table-sm table-bordered mb-0">
                <thead class="table-light"><tr><th style="width:80px">Code</th><th>Meaning</th></tr></thead>
                <tbody>
                    <tr><td><code>200</code></td><td>Success — returns the resource or a list.</td></tr>
                    <tr><td><code>201</code></td><td>Created — returns the new resource.</td></tr>
                    <tr><td><code>204</code></td><td>No Content — successful delete, empty body.</td></tr>
                    <tr><td><code>401</code></td><td>Unauthorized — token missing or invalid.</td></tr>
                    <tr><td><code>403</code></td><td>Forbidden — token valid but not permitted on this endpoint, or request originates from a disallowed IP address.</td></tr>
                    <tr><td><code>404</code></td><td>Not Found — resource ID does not exist.</td></tr>
                    <tr><td><code>422</code></td><td>Unprocessable Entity — validation error; body contains <code>{"error": "…"}</code>.</td></tr>
                </tbody>
            </table>
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           BUILDINGS
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="buildings" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Buildings <code class="small fw-normal text-muted">/api/buildings</code></h2>

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/buildings', name: 'List buildings',
                query: [
                    {name: 'name', type: 'string', desc: 'Partial name match (case-insensitive).'},
                ],
                response_example: '[\n  {\n    "id": 1,\n    "name": "Science Hall",\n    "description": "Main science building"\n  }\n]',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/buildings/{id}', name: 'Get building',
                response_example: '{\n  "id": 1,\n  "name": "Science Hall",\n  "description": "Main science building"\n}',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'POST', path: '/api/buildings', name: 'Create building',
                body: [
                    {name: 'name', type: 'string', required: true, desc: 'Building name (must be unique).'},
                    {name: 'description', type: 'string', required: false, desc: 'Free-text description.'},
                ],
                response_status: '201',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'PATCH', path: '/api/buildings/{id}', name: 'Update building',
                notes: 'Only include fields you want to change.',
                body: [
                    {name: 'name', type: 'string', required: false, desc: 'Building name (must be unique).'},
                    {name: 'description', type: 'string|null', required: false, desc: 'Description, or null to clear.'},
                ],
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'DELETE', path: '/api/buildings/{id}', name: 'Delete building',
                response_status: '204',
            } %}
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           DNS SERVERS
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="dns-servers" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">DNS Servers <code class="small fw-normal text-muted">/api/dns-servers</code></h2>
            <p class="text-muted small">SSH keys are generated automatically when a server is created. The <code>ssh_public_key</code> value must be added to <code>authorized_keys</code> on the server. Private keys are never returned by the API.</p>

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/dns-servers', name: 'List DNS servers',
                response_example: '[\n  {\n    "id": 1,\n    "name": "ns1",\n    "hostname": "ns1.example.com",\n    "ssh_user": "root",\n    "ssh_public_key": "ssh-ed25519 AAAA...",\n    "remote_zone_path": "/etc/bind/zones",\n    "key_directory": null,\n    "server_type": "primary",\n    "primary_hostname": null,\n    "description": null,\n    "view_ids": [1],\n    "created_at": "2024-01-01T00:00:00+00:00",\n    "updated_at": "2024-01-01T00:00:00+00:00",\n    "created_by": "user@example.com",\n    "updated_by": "user@example.com"\n  }\n]',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/dns-servers/{id}', name: 'Get DNS server',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'POST', path: '/api/dns-servers', name: 'Create DNS server',
                notes: 'An SSH key pair is generated automatically. Copy the <code>ssh_public_key</code> from the response to <code>authorized_keys</code> on the target server.',
                body: [
                    {name: 'name', type: 'string', required: true, desc: 'Display name.'},
                    {name: 'hostname', type: 'string', required: true, desc: 'Hostname or IP used for SSH connections.'},
                    {name: 'ssh_user', type: 'string', required: false, desc: 'SSH login user. Default: <code>root</code>.'},
                    {name: 'remote_zone_path', type: 'string', required: false, desc: 'Path on the server where zone files are written. Default: <code>/etc/bind/zones</code>.'},
                    {name: 'key_directory', type: 'string', required: false, desc: 'DNSSEC key directory path.'},
                    {name: 'server_type', type: 'string', required: false, desc: 'Server role: <code>primary</code> or <code>secondary</code>. Default: <code>primary</code>.'},
                    {name: 'primary_hostname', type: 'string', required: false, desc: 'Primary server hostname (for secondary servers).'},
                    {name: 'description', type: 'string', required: false, desc: 'Free-text description.'},
                    {name: 'view_ids', type: 'integer[]', required: false, desc: 'DNS view IDs. Secondary servers may only have one view.'},
                ],
                response_status: '201',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'PATCH', path: '/api/dns-servers/{id}', name: 'Update DNS server',
                notes: 'Only include fields you want to change. SSH keys cannot be updated via this endpoint.',
                body: [
                    {name: 'name', type: 'string', required: false, desc: 'Display name.'},
                    {name: 'hostname', type: 'string', required: false, desc: 'Hostname or IP.'},
                    {name: 'ssh_user', type: 'string', required: false, desc: 'SSH login user.'},
                    {name: 'remote_zone_path', type: 'string', required: false, desc: 'Zone file path on server.'},
                    {name: 'key_directory', type: 'string|null', required: false, desc: 'DNSSEC key directory, or null to clear.'},
                    {name: 'server_type', type: 'string', required: false, desc: '<code>primary</code> or <code>secondary</code>.'},
                    {name: 'primary_hostname', type: 'string|null', required: false, desc: 'Primary hostname, or null to clear.'},
                    {name: 'description', type: 'string|null', required: false, desc: 'Description, or null to clear.'},
                    {name: 'view_ids', type: 'integer[]', required: false, desc: 'Replaces all current views.'},
                ],
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'DELETE', path: '/api/dns-servers/{id}', name: 'Delete DNS server',
                response_status: '204',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'POST', path: '/api/dns-servers/{id}/push', name: 'Push config to DNS server',
                notes: 'Generates zone files and deploys them to the server via SSH, then reloads BIND.',
                response_example: '{\n  "views": {\n    "internal": {"success": true, "zones_written": 3}\n  },\n  "reload": {"success": true, "output": ""}\n}',
            } %}
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           DHCP SERVERS
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="dhcp-servers" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">DHCP Servers <code class="small fw-normal text-muted">/api/dhcp-servers</code></h2>
            <p class="text-muted small">SSH keys are generated automatically when a server is created. The <code>ssh_public_key</code> value must be added to <code>authorized_keys</code> on the server. Private keys and control passwords are never returned by the API.</p>

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/dhcp-servers', name: 'List DHCP servers',
                response_example: '[\n  {\n    "id": 1,\n    "name": "dhcp1",\n    "hostname": "dhcp1.example.com",\n    "ssh_user": "root",\n    "ssh_public_key": "ssh-ed25519 AAAA...",\n    "remote_path": "/etc/kea",\n    "control_url": "http://localhost:8000",\n    "control_user": "kea",\n    "description": null,\n    "created_at": "2024-01-01T00:00:00+00:00",\n    "updated_at": "2024-01-01T00:00:00+00:00",\n    "created_by": "user@example.com",\n    "updated_by": "user@example.com"\n  }\n]',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/dhcp-servers/{id}', name: 'Get DHCP server',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'POST', path: '/api/dhcp-servers', name: 'Create DHCP server',
                notes: 'An SSH key pair is generated automatically. Copy the <code>ssh_public_key</code> from the response to <code>authorized_keys</code> on the target server.',
                body: [
                    {name: 'name', type: 'string', required: true, desc: 'Display name.'},
                    {name: 'hostname', type: 'string', required: true, desc: 'Hostname or IP used for SSH connections.'},
                    {name: 'ssh_user', type: 'string', required: false, desc: 'SSH login user. Default: <code>root</code>.'},
                    {name: 'remote_path', type: 'string', required: false, desc: 'Path on the server where config files are written. Default: <code>/etc/kea</code>.'},
                    {name: 'control_url', type: 'string', required: false, desc: 'Kea control agent URL for config reload (e.g. <code>http://localhost:8000</code>).'},
                    {name: 'control_user', type: 'string', required: false, desc: 'HTTP basic auth username for control agent.'},
                    {name: 'control_password', type: 'string', required: false, desc: 'HTTP basic auth password for control agent. Write-only — never returned.'},
                    {name: 'description', type: 'string', required: false, desc: 'Free-text description.'},
                ],
                response_status: '201',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'PATCH', path: '/api/dhcp-servers/{id}', name: 'Update DHCP server',
                notes: 'Only include fields you want to change. SSH keys cannot be updated via this endpoint. Sending <code>control_password</code> replaces the stored password.',
                body: [
                    {name: 'name', type: 'string', required: false, desc: 'Display name.'},
                    {name: 'hostname', type: 'string', required: false, desc: 'Hostname or IP.'},
                    {name: 'ssh_user', type: 'string', required: false, desc: 'SSH login user.'},
                    {name: 'remote_path', type: 'string', required: false, desc: 'Config file path on server.'},
                    {name: 'control_url', type: 'string|null', required: false, desc: 'Control agent URL, or null to clear.'},
                    {name: 'control_user', type: 'string|null', required: false, desc: 'Control agent username, or null to clear.'},
                    {name: 'control_password', type: 'string|null', required: false, desc: 'Control agent password, or null to clear.'},
                    {name: 'description', type: 'string|null', required: false, desc: 'Description, or null to clear.'},
                ],
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'DELETE', path: '/api/dhcp-servers/{id}', name: 'Delete DHCP server',
                response_status: '204',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'POST', path: '/api/dhcp-servers/{id}/push', name: 'Push config to DHCP server',
                notes: 'Generates Kea config files and deploys them to the server via SSH, then signals Kea to reload via the control agent.',
                response_example: '{\n  "dhcp4": {"success": true, "output": "", "file": "subnets4.json"},\n  "dhcp6": {"success": true, "output": "", "file": "subnets6.json"}\n}',
            } %}
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           HOSTS
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="hosts" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Hosts <code class="small fw-normal text-muted">/api/hosts</code></h2>

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/hosts', name: 'List hosts',
                query: [
                    {name: 'name', type: 'string', desc: 'Partial name match (case-insensitive).'},
                    {name: 'building_id', type: 'integer', desc: 'Filter by building ID.'},
                ],
                response_example: '[\n  {\n    "id": 1,\n    "name": "server01",\n    "room": "A101",\n    "building_id": 3,\n    "tag_ids": [1, 2],\n    "created_at": "2024-01-01T00:00:00+00:00",\n    "updated_at": "2024-01-01T00:00:00+00:00",\n    "created_by": "user@example.com",\n    "updated_by": "user@example.com"\n  }\n]',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/hosts/{id}', name: 'Get host',
                response_example: '{\n  "id": 1,\n  "name": "server01",\n  "room": "A101",\n  "building_id": 3,\n  "tag_ids": [1, 2],\n  "created_at": "2024-01-01T00:00:00+00:00",\n  "updated_at": "2024-01-01T00:00:00+00:00",\n  "created_by": "user@example.com",\n  "updated_by": "user@example.com"\n}',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'POST', path: '/api/hosts', name: 'Create host',
                body: [
                    {name: 'name', type: 'string', required: true, desc: 'Host name.'},
                    {name: 'room', type: 'string', required: false, desc: 'Room or location label.'},
                    {name: 'building_id', type: 'integer', required: false, desc: 'Building ID.'},
                    {name: 'tag_ids', type: 'integer[]', required: false, desc: 'Array of tag IDs.'},
                ],
                response_status: '201',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'PATCH', path: '/api/hosts/{id}', name: 'Update host',
                notes: 'Only include fields you want to change. Omitted fields are left unchanged.',
                body: [
                    {name: 'name', type: 'string', required: false, desc: 'Host name.'},
                    {name: 'room', type: 'string|null', required: false, desc: 'Room label, or null to clear.'},
                    {name: 'building_id', type: 'integer|null', required: false, desc: 'Building ID, or null to clear.'},
                    {name: 'tag_ids', type: 'integer[]', required: false, desc: 'Replaces all current tags.'},
                ],
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'DELETE', path: '/api/hosts/{id}', name: 'Delete host',
                response_status: '204',
            } %}
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           INTERFACES
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="interfaces" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Interfaces <code class="small fw-normal text-muted">/api/interfaces</code></h2>

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/interfaces', name: 'List interfaces',
                query: [
                    {name: 'host_id', type: 'integer', desc: 'Filter by host ID.'},
                    {name: 'subnet_id', type: 'integer', desc: 'Filter by subnet ID.'},
                    {name: 'mac_address', type: 'string', desc: 'Exact MAC address match.'},
                ],
                response_example: '[\n  {\n    "id": 1,\n    "name": "eth0",\n    "mac_address": "aa:bb:cc:dd:ee:ff",\n    "host_id": 1,\n    "host_name": "server01",\n    "subnet_id": 2,\n    "ip_address": "10.0.0.5",\n    "ipv6_address": null,\n    "canonical_name": "server01.example.com",\n    "created_at": "2024-01-01T00:00:00+00:00",\n    "updated_at": "2024-01-01T00:00:00+00:00",\n    "created_by": "user@example.com",\n    "updated_by": "user@example.com"\n  }\n]',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/interfaces/{id}', name: 'Get interface',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'POST', path: '/api/interfaces', name: 'Create interface',
                notes: 'For <code>ip_address</code> and <code>ipv6_address</code>, pass <code>"auto"</code> to auto-assign the next available address from the subnet, a specific IP string to assign that address, or omit the field to leave unassigned. For IPv6 only, <code>"auto_v4"</code> derives the address from the interface\'s IPv4 assignment. The interface must have a <code>subnet_id</code> with the appropriate CIDR for auto-assignment.',
                body: [
                    {name: 'host_id', type: 'integer', required: true, desc: 'Host this interface belongs to.'},
                    {name: 'mac_address', type: 'string', required: true, desc: 'MAC address (e.g. aa:bb:cc:dd:ee:ff).'},
                    {name: 'name', type: 'string', required: false, desc: 'Interface name (e.g. eth0).'},
                    {name: 'subnet_id', type: 'integer', required: false, desc: 'Subnet ID. Required for auto IP assignment.'},
                    {name: 'ip_address', type: 'string|null', required: false, desc: '<code>"auto"</code> to auto-assign, a specific IPv4, or omit to leave unassigned.'},
                    {name: 'ipv6_address', type: 'string|null', required: false, desc: '<code>"auto"</code> to auto-assign, <code>"auto_v4"</code> to derive from IPv4, a specific IPv6, or omit to leave unassigned.'},
                ],
                response_status: '201',
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'PATCH', path: '/api/interfaces/{id}', name: 'Update interface',
                notes: 'Only include fields you want to change. Sending <code>ip_address</code> or <code>ipv6_address</code> always releases the existing address first, then applies the new value. Pass <code>null</code> or <code>""</code> to clear without reassigning.',
                body: [
                    {name: 'mac_address', type: 'string', required: false, desc: 'MAC address.'},
                    {name: 'name', type: 'string|null', required: false, desc: 'Interface name, or null to clear.'},
                    {name: 'host_id', type: 'integer', required: false, desc: 'Move to a different host.'},
                    {name: 'subnet_id', type: 'integer|null', required: false, desc: 'Subnet ID, or null to clear.'},
                    {name: 'ip_address', type: 'string|null', required: false, desc: '<code>"auto"</code> to auto-assign, a specific IPv4, or null/empty to clear.'},
                    {name: 'ipv6_address', type: 'string|null', required: false, desc: '<code>"auto"</code> to auto-assign, <code>"auto_v4"</code> to derive from IPv4, a specific IPv6, or null/empty to clear.'},
                ],
            } %}

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'DELETE', path: '/api/interfaces/{id}', name: 'Delete interface',
                response_status: '204',
            } %}
        </section>

        {# ═══════════════════════════════════════════════════════════════════
           INTERFACE NAMES
           ═══════════════════════════════════════════════════════════════════ #}
        <section id="interface-names" class="mb-5">
            <h2 class="h5 border-bottom pb-2 mb-3">Interface Names <code class="small fw-normal text-muted">/api/interface-names</code></h2>

            {% include 'api_docs/_endpoint.html.twig' with {
                method: 'GET', path: '/api/interface-names', name: 'List interface names',
                query: [
                    {name: 'interface_id', type: 'integer', desc: 'Filter by interface ID.'},
                    {name: 'domain_id', type: 'integer', desc: 'Filter by domain ID.'},
                ],
