{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('servers_index') }}">Servers</a></li>
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
            <div class="card-body">
                <p class="text-muted small">These credentials are used for all Aruba CX switches. The management IP is taken from the ClearPass auth log for each connection.</p>

                {{ form_start(form) }}

                {% for field in ['username', 'password', 'restApiVersion', 'description'] %}
                    <div class="mb-3">
                        {{ form_label(form[field], null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form[field], {attr: {class: 'form-control' ~ (form[field].vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form[field]) }}
                        {% if form[field].vars.help is defined and form[field].vars.help %}
                            <div class="form-text text-muted">{{ form[field].vars.help }}</div>
                        {% endif %}
                    </div>
                {% endfor %}

                <div class="mb-3">
                    <div class="form-check">
                        {{ form_widget(form.verifyTls) }}
                        {{ form_label(form.verifyTls, null, {label_attr: {class: 'form-check-label'}}) }}
                    </div>
                    {% if form.verifyTls.vars.help is defined %}
                        <div class="form-text text-muted">{{ form.verifyTls.vars.help }}</div>
                    {% endif %}
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <a href="{{ path('servers_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        {% if creds.id %}
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-key me-2"></i>SSH Public Key</h5>
                <form method="post" action="{{ path('aruba_switch_regenerate_key') }}"
                      onsubmit="return confirm('Regenerate the SSH key pair? You will need to add the new public key to all switches.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('regen_key_aruba') }}">
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-arrow-repeat me-1"></i>Regenerate Key
                    </button>
                </form>
            </div>
            <div class="card-body">
                {% if creds.sshPublicKey %}
                    <p class="text-muted small mb-2">
                        Add this key to each switch for SSH fallback authentication:
                    </p>
                    <div class="input-group">
                        <textarea id="aruba-pubkey" class="form-control font-monospace small" rows="3" readonly>{{ creds.sshPublicKey }}</textarea>
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="navigator.clipboard.writeText(document.getElementById('aruba-pubkey').value).then(() => this.innerHTML = '<i class=\'bi bi-check-lg\'></i> Copied')">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        On each Aruba CX switch: <code>ssh authorized-key {{ creds.username }} &lt;key&gt;</code>
                    </p>
                {% else %}
                    <p class="text-muted mb-0">No key generated yet.</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
