{% extends 'base.html.twig' %}
{% block title %}{{ subnet.name }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('subnet_index') }}">Subnets</a></li>
        <li class="breadcrumb-item active">{{ subnet.name }}</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-{{ subnet.isContainer ? 'folder2-open' : 'diagram-2' }} me-2"></i>{{ subnet.name }}
        </h1>
        <div class="text-muted">
            {% if subnet.ipv4Cidr %}<code class="me-3">{{ subnet.ipv4Cidr }}</code>{% endif %}
            {% if subnet.ipv6Cidr %}<code>{{ subnet.ipv6Cidr }}</code>{% endif %}
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_subnets') }}#subnet-detail" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('subnet_edit', {id: subnet.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('subnet_delete', {id: subnet.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete subnet {{ subnet.name|e('js') }}?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_subnet_' ~ subnet.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    {% if subnet.vrf %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">VRF</div>
                <strong>{{ subnet.vrf.name }}</strong>
            </div>
        </div>
    {% endif %}
    {% if subnet.gateway %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">Gateway</div>
                <code>{{ subnet.gateway }}</code>
            </div>
        </div>
    {% endif %}
    {% if subnet.vlan %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">VLAN</div>
                <strong>{{ subnet.vlan }}</strong>
            </div>
        </div>
    {% endif %}
    {% if subnet.views is not empty %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">DNS Views</div>
                <div>{% for view in subnet.views %}<span class="badge bg-secondary me-1">{{ view.name }}</span>{% endfor %}</div>
            </div>
        </div>
    {% endif %}
    {% if subnet.ddnsDomain %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">DDNS Domain</div>
                <strong>{{ subnet.ddnsDomain.name }}</strong>
            </div>
        </div>
    {% endif %}
    {% if subnet.reverseZoneAggregatesV4 %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">IPv4 Reverse Zone</div>
                <div><span class="badge bg-info text-dark"><i class="bi bi-diagram-2 me-1"></i>Aggregates child PTRs</span></div>
            </div>
        </div>
    {% endif %}
    {% if subnet.reverseZoneAggregatesV6 %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">IPv6 Reverse Zone</div>
                <div><span class="badge bg-info text-dark"><i class="bi bi-diagram-2 me-1"></i>Aggregates child PTRs</span></div>
            </div>
        </div>
    {% endif %}
    {% if subnet.tags is not empty %}
        <div class="col-12">
            <div>
                {% for tag in subnet.tags %}
                    <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                {% endfor %}
            </div>
        </div>
    {% endif %}
    {% if subnet.description %}
        <div class="col-12">
            <p class="text-muted mb-0">{{ subnet.description }}</p>
        </div>
    {% endif %}
</div>

{% if subnet.dnssecPolicy %}
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-shield-check me-1"></i>DNSSEC</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-muted small">Policy</div>
                <div><a href="{{ path('dnssec_policy_edit', {id: subnet.dnssecPolicy.id}) }}" class="fw-semibold text-decoration-none"><code>{{ subnet.dnssecPolicy.name }}</code></a></div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">Inline Signing</div>
                <div><span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Yes</span></div>
            </div>
        </div>
        <div id="ds-record-result" class="mt-3" style="display:none">
            <div class="text-muted small mb-1">DS Record(s) — publish in parent zone</div>
            <pre id="ds-record-output" class="bg-body-secondary border rounded p-2 mb-1" style="white-space:pre-wrap;word-break:break-all;font-size:.85em;margin-bottom:0"></pre>
            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="ds-record-copy">
                <i class="bi bi-clipboard me-1"></i>Copy
            </button>
        </div>
        <div id="trust-chain-result" class="mt-3" style="display:none">
            <div class="text-muted small mb-2">Trust Chain Validation</div>
            <div id="trust-chain-steps" class="list-group list-group-flush small mb-2"></div>
            <div id="trust-chain-summary" class="small fw-semibold"></div>
        </div>
        <div id="key-info-result" class="mt-3" style="display:none">
            <div class="text-muted small mb-2">DNSSEC Keys</div>
            <div id="key-info-error" class="text-danger small" style="display:none"></div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-1" style="font-size:.85em">
                    <thead>
                        <tr>
                            <th>Key Tag</th>
                            <th>Type</th>
                            <th>Algorithm</th>
                            <th>Created</th>
                            <th>Published</th>
                            <th>Activated</th>
                            <th>Inactive</th>
                            <th>Deleted</th>
                        </tr>
                    </thead>
                    <tbody id="key-info-tbody"></tbody>
                </table>
            </div>
            <div id="key-info-warnings" class="text-warning small" style="display:none"></div>
        </div>
        <div class="card-footer d-flex align-items-center gap-2">
            <a href="{{ path('ksk_rollover_start') }}?subnet={{ subnet.id }}" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-key me-1"></i>Start KSK Rollover
            </a>
            <a href="{{ path('dnssec_disable_start') }}?subnet={{ subnet.id }}" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-shield-x me-1"></i>Disable DNSSEC
            </a>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="fetch-ds-btn"
                    data-url="{{ path('subnet_ds_record', {id: subnet.id}) }}">
                <i class="bi bi-search me-1"></i>Fetch DS Record
            </button>
            <span id="ds-spinner" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-hidden="true"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="fetch-keys-btn"
                    data-url="{{ path('subnet_keys', {id: subnet.id}) }}">
                <i class="bi bi-key-fill me-1"></i>Fetch Keys
            </button>
            <span id="keys-spinner" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-hidden="true"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="validate-chain-btn"
                    data-url="{{ path('subnet_validate_trust_chain', {id: subnet.id}) }}">
                <i class="bi bi-shield-check me-1"></i>Validate Trust Chain
            </button>
            <span id="chain-spinner" class="spinner-border spinner-border-sm text-secondary d-none" role="status" aria-hidden="true"></span>
        </div>
    </div>
</div>
{% endif %}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-list-ul me-1"></i>DNS Records
            <span class="badge bg-secondary ms-1">{{ subnet.records|length }}</span>
        </span>
        <a href="{{ path('subnet_record_new', {subnetId: subnet.id}) }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Record
        </a>
    </div>
    {% if subnet.records is empty %}
        <div class="card-body text-center text-muted py-3">
            No records yet. <a href="{{ path('subnet_record_new', {subnetId: subnet.id}) }}">Add one →</a>
        </div>
    {% else %}
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>TTL</th>
                    <th>Views</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            {% set type_colors = {'A': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'AAAA': 'bg-info-subtle text-info-emphasis border border-info-subtle', 'CNAME': 'bg-success-subtle text-success-emphasis border border-success-subtle', 'MX': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'NS': 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle', 'TXT': 'badge-orange-subtle', 'PTR': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'SRV': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'DS': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'CAA': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'HTTPS': 'badge-purple-subtle'} %}
            <tbody>
                {% for record in subnet.records %}
                <tr>
                    <td class="font-monospace">{{ record.hostname }}</td>
                    <td><span class="badge {{ type_colors[record.type.value] ?? 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' }}">{{ record.type.value }}</span></td>
                    <td class="font-monospace small" style="word-break:break-all">{{ record.value }}</td>
                    <td class="text-muted small">{{ record.ttl ?: '—' }}</td>
                    <td>
                        {% for view in record.views %}
                            <span class="badge bg-secondary me-1">{{ view.name }}</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endfor %}
                    </td>
                    <td class="text-end" style="white-space:nowrap">
                        <a href="{{ path('subnet_record_edit', {id: record.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('subnet_record_delete', {id: record.id}) }}" class="d-inline"
                              onsubmit="return confirm('Delete this record?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_subnet_record_' ~ record.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-grid me-1"></i>Address Blocks ({{ blocks|length }})</span>
        <a href="{{ path('block_new', {subnetId: subnet.id}) }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Block
        </a>
    </div>
    {% if blocks is empty %}
        <div class="card-body text-center text-muted py-3">
            No blocks defined — all addresses in the subnet are available for assignment.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="">
                    <tr>
                        <th>Type</th>
                        <th>Label</th>
                        <th>Start IP</th>
                        <th>End IP</th>
                        <th>Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ab in blocks %}
                        <tr>
                            <td>
                                <span class="badge bg-{{ ab.type.badgeClass() }}">{{ ab.type.label() }}</span>
                            </td>
                            <td class="text-muted">{{ ab.label ?: '—' }}</td>
                            <td><code>{{ ab.startIp }}</code></td>
                            <td><code>{{ ab.endIp }}</code></td>
                            <td class="text-muted small">
                                {{ ab.updatedAt|date('Y-m-d H:i') }}
                                {% if ab.updatedBy %}<br>{{ ab.updatedBy }}{% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('block_edit', {id: ab.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('block_delete', {id: ab.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Delete this block?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_block_' ~ ab.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{% if not subnet.isContainer %}
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-layers me-1"></i>Virtual IPs
            {% set active_vips = subnet.virtualIps|filter(v => not v.deleted) %}
            <span class="badge bg-secondary ms-1">{{ active_vips|length }}</span>
        </span>
        <a href="{{ path('virtual_ip_new', {subnetId: subnet.id}) }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Virtual IP
        </a>
    </div>
    {% if active_vips is empty %}
        <div class="card-body text-muted text-center py-3">No virtual IPs on this subnet.</div>
    {% else %}
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead><tr><th>Label</th><th>Protocol</th><th>VRID</th><th>IPv4</th><th>IPv6</th><th>Members</th><th></th></tr></thead>
            <tbody>
                {% for vip in active_vips %}
                <tr>
                    <td><a href="{{ path('virtual_ip_show', {id: vip.id}) }}">{{ vip.label }}</a></td>
                    <td><span class="badge bg-secondary">{{ vip.protocol.label() }}</span></td>
                    <td class="text-muted">{{ vip.vrid ?: '—' }}</td>
                    <td class="ip-address">{{ vip.ipAddress ? vip.ipAddress.address : '—' }}</td>
                    <td class="ip-address small">{{ vip.ipv6Address ? vip.ipv6Address.address : '—' }}</td>
                    <td class="text-muted small">{{ vip.memberInterfaces|length }}</td>
                    <td class="text-end" style="white-space:nowrap">
                        <a href="{{ path('virtual_ip_edit', {id: vip.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('virtual_ip_delete', {id: vip.id}) }}" class="d-inline"
                              onsubmit="return confirm('Delete {{ vip.label|e('js') }}?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_vip_' ~ vip.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
</div>
{% endif %}

<div class="row g-3">
    {% if subnet.ipv4Cidr %}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-4-square me-1"></i>IPv4 Allocations</span>
                <span class="badge bg-secondary">{{ ipv4_addresses|length }} assigned</span>
            </div>
            {% if ipv4_addresses is empty %}
                <div class="card-body text-muted text-center py-3">No allocations</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class=""><tr><th>Address</th><th>Interface</th><th>Host</th></tr></thead>
                        <tbody>
                            {% for ip in ipv4_addresses %}
                                {% set iface = subnet.interfaces|filter(i => i.ipAddress and i.ipAddress.id == ip.id)|first %}
                                {% set vip = null %}
                                {% if not iface %}
                                    {% set vip = subnet.virtualIps|filter(v => not v.deleted and v.ipAddress and v.ipAddress.id == ip.id)|first %}
                                {% endif %}
                                <tr>
                                    <td class="ip-address">{{ ip.address }}</td>
                                    <td>
                                        {% if iface %}
                                            <a href="{{ path('interface_show', {id: iface.id}) }}">
                                                <code>{{ iface.name ?: iface.macAddress }}</code>
                                            </a>
                                        {% elseif vip %}
                                            <a href="{{ path('virtual_ip_show', {id: vip.id}) }}">
                                                <i class="bi bi-layers text-muted me-1"></i>{{ vip.label }}
                                            </a>
                                        {% else %}—{% endif %}
                                    </td>
                                    <td>
                                        {% if iface and iface.host %}
                                            <a href="{{ path('host_show', {id: iface.host.id}) }}">{{ iface.host.name }}</a>
                                        {% else %}—{% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            {% if available_ipv4 %}
                <div class="card-footer text-muted small">
                    Next available: <code>{{ available_ipv4|first }}</code>
                    ({{ available_ipv4|length }} free)
                </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {% if subnet.ipv6Cidr %}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-6-square me-1"></i>IPv6 Allocations</span>
                <span class="badge bg-secondary">{{ ipv6_addresses|length }} assigned</span>
            </div>
            {% if ipv6_addresses is empty %}
                <div class="card-body text-muted text-center py-3">No allocations</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class=""><tr><th>Address</th><th>Interface</th><th>Host</th></tr></thead>
                        <tbody>
                            {% for ip in ipv6_addresses %}
                                {% set iface = subnet.interfaces|filter(i => i.ipv6Address and i.ipv6Address.id == ip.id)|first %}
                                {% set vip = null %}
                                {% if not iface %}
                                    {% set vip = subnet.virtualIps|filter(v => not v.deleted and v.ipv6Address and v.ipv6Address.id == ip.id)|first %}
                                {% endif %}
                                <tr>
                                    <td class="ip-address small">{{ ip.address }}</td>
                                    <td>
                                        {% if iface %}
                                            <a href="{{ path('interface_show', {id: iface.id}) }}">
                                                <code>{{ iface.name ?: iface.macAddress }}</code>
                                            </a>
                                        {% elseif vip %}
                                            <a href="{{ path('virtual_ip_show', {id: vip.id}) }}">
                                                <i class="bi bi-layers text-muted me-1"></i>{{ vip.label }}
                                            </a>
                                        {% else %}—{% endif %}
                                    </td>
                                    <td>
                                        {% if iface and iface.host %}
                                            <a href="{{ path('host_show', {id: iface.host.id}) }}">{{ iface.host.name }}</a>
                                        {% else %}—{% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block scripts %}
{% if subnet.dnssecPolicy %}
<script>
(function () {
    var btn     = document.getElementById('fetch-ds-btn');
    var spinner = document.getElementById('ds-spinner');
    var result  = document.getElementById('ds-record-result');
    var output  = document.getElementById('ds-record-output');
    var copyBtn = document.getElementById('ds-record-copy');

    if (!btn) return;

    btn.addEventListener('click', function () {
        btn.disabled = true;
        spinner.classList.remove('d-none');
        result.style.display = 'none';

        fetch(btn.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.error) {
                    output.textContent = 'Error: ' + data.error;
                } else if (!data.ds_records || data.ds_records.length === 0) {
                    output.textContent = 'No DS records found yet — BIND may still be generating keys. Try again in a moment.';
                    if (data.errors && data.errors.length) {
                        output.textContent += '\n\n' + data.errors.join('\n');
                    }
                } else {
                    output.textContent = data.ds_records.join('\n');
                    if (data.errors && data.errors.length) {
                        output.textContent += '\n\n(Warnings: ' + data.errors.join('; ') + ')';
                    }
                }
                result.style.display = '';
            })
            .catch(function (err) {
                output.textContent = 'Request failed: ' + err;
                result.style.display = '';
            })
            .finally(function () {
                btn.disabled = false;
                spinner.classList.add('d-none');
            });
    });

    copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(output.textContent).then(function () {
            copyBtn.innerHTML = '<i class="bi bi-clipboard-check me-1"></i>Copied';
            setTimeout(function () {
                copyBtn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy';
            }, 2000);
        });
    });

    var keysBtn      = document.getElementById('fetch-keys-btn');
    var keysSpinner  = document.getElementById('keys-spinner');
    var keyResult    = document.getElementById('key-info-result');
    var keyTbody     = document.getElementById('key-info-tbody');
    var keyError     = document.getElementById('key-info-error');
    var keyWarnings  = document.getElementById('key-info-warnings');

    var ALG_NAMES = {
        5: 'RSASHA1', 7: 'NSEC3RSASHA1', 8: 'RSASHA256', 10: 'RSASHA512',
        13: 'ECDSAP256SHA256', 14: 'ECDSAP384SHA384', 15: 'ED25519', 16: 'ED448'
    };

    function fmtDate(raw) {
        if (!raw) return '—';
        var s = String(raw).replace(/\D/g, '');
        if (s.length < 12) return raw;
        return s.slice(0, 4) + '-' + s.slice(4, 6) + '-' + s.slice(6, 8) + ' ' + s.slice(8, 10) + ':' + s.slice(10, 12);
    }

    function fmtAlg(num) {
        return ALG_NAMES[num] ? ALG_NAMES[num] + ' (' + num + ')' : String(num);
    }

    keysBtn.addEventListener('click', function () {
        keysBtn.disabled = true;
        keysSpinner.classList.remove('d-none');
        keyResult.style.display = 'none';

        fetch(keysBtn.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                keyError.style.display = 'none';
                keyWarnings.style.display = 'none';
                keyTbody.innerHTML = '';

                if (data.error) {
                    keyError.textContent = data.error;
                    keyError.style.display = '';
                } else if (!data.keys || data.keys.length === 0) {
                    keyError.textContent = 'No keys found yet — BIND may still be generating keys. Try again in a moment.';
                    keyError.style.display = '';
                } else {
                    data.keys.forEach(function (k) {
                        var tr = document.createElement('tr');
                        [
                            String(k.key_tag),
                            k.type === 'KSK' ? '<span class="badge bg-primary">KSK</span>' : '<span class="badge bg-secondary">ZSK</span>',
                            fmtAlg(k.algorithm),
                            fmtDate(k.created),
                            fmtDate(k.publish),
                            fmtDate(k.activate),
                            fmtDate(k.inactive),
                            fmtDate(k['delete'])
                        ].forEach(function (cell, i) {
                            var td = document.createElement('td');
                            if (i === 0) { td.className = 'font-monospace'; }
                            td.innerHTML = cell;
                            tr.appendChild(td);
                        });
                        keyTbody.appendChild(tr);
                    });
                    if (data.errors && data.errors.length) {
                        keyWarnings.textContent = 'Warnings: ' + data.errors.join('; ');
                        keyWarnings.style.display = '';
                    }
                }
                keyResult.style.display = '';
            })
            .catch(function (err) {
                keyError.textContent = 'Request failed: ' + err;
                keyError.style.display = '';
                keyResult.style.display = '';
            })
            .finally(function () {
                keysBtn.disabled = false;
                keysSpinner.classList.add('d-none');
            });
    });

    var chainBtn     = document.getElementById('validate-chain-btn');
    var chainSpinner = document.getElementById('chain-spinner');
    var chainResult  = document.getElementById('trust-chain-result');
    var chainSteps   = document.getElementById('trust-chain-steps');
    var chainSummary = document.getElementById('trust-chain-summary');

    function tcIcon(s) {
        return s === 'ok'      ? '<i class="bi bi-check-circle-fill text-success"></i>'
             : s === 'warning' ? '<i class="bi bi-exclamation-triangle-fill text-warning"></i>'
             :                   '<i class="bi bi-x-circle-fill text-danger"></i>';
    }

    function renderDsBlock(step) {
        var ok   = step.status === 'ok';
        var warn = step.status === 'warning';
        var h    = '<div class="py-1 mb-1">';
        if (step.ds_parsed && step.ds_parsed.length) {
            var signedBadge;
            if (ok) {
                var rrsigTags = step.rrsig_key_tags || [];
                var who = rrsigTags.length ? ' id=' + rrsigTags.join(', id=') : '';
                signedBadge = '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                            + '<i class="bi bi-check-lg me-1"></i>signed by' + who + '</span>';
            } else if (warn) {
                signedBadge = '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">no RRSIG</span>';
            } else {
                signedBadge = '<span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">missing</span>';
            }
            step.ds_parsed.forEach(function (ds) {
                h += '<div class="d-flex align-items-center gap-2 flex-wrap mb-1">'
                   + '<span class="badge bg-primary font-monospace">id=' + ds.key_tag + '</span>'
                   + signedBadge + '</div>';
            });
            if (step.records && step.records.length) {
                h += '<pre class="bg-body-secondary border rounded p-1 mt-1 mb-0" style="font-size:.8em;white-space:pre-wrap;word-break:break-all">'
                   + step.records.join('\n') + '</pre>';
            }
        } else {
            h += '<div class="small text-danger">' + tcIcon('error') + ' ' + step.detail + '</div>';
        }
        return h + '</div>';
    }

    function renderTrustChain(data) {
        if (data.error) {
            chainSteps.innerHTML = '<div class="text-danger small">' + data.error + '</div>';
            chainSummary.textContent = '';
            chainResult.style.display = '';
            return;
        }

        var signingByZone = {};
        var dsByParent    = {};
        (data.steps || []).forEach(function (s) {
            if (s.type === 'signing') { signingByZone[s.zone] = s; }
            if (s.type === 'ds')     { dsByParent[s.parent]   = s; }
        });

        var html = '';

        html += '<div class="d-flex align-items-center gap-2 small text-muted mb-2">'
              + '<i class="bi bi-globe2"></i>'
              + '<span class="font-monospace fw-semibold">.</span>'
              + '<span>(root — trust anchor)</span></div>';
        if (dsByParent['.']) { html += renderDsBlock(dsByParent['.']); }

        (data.steps || []).forEach(function (step) {
            if (step.type !== 'dnskey') { return; }

            var signing          = signingByZone[step.zone] || null;
            var dnskeySignerTags = step.dnskey_signer_key_tags || [];
            var anchors          = step.anchored_by || [];

            html += '<hr class="my-2" style="opacity:.15">';
            html += '<div class="d-flex align-items-center gap-2 mb-2">'
                  + tcIcon(step.status)
                  + '<span class="font-monospace fw-semibold">' + step.zone + '</span>'
                  + '<span class="text-muted small">DNSKEY</span></div>';

            if (step.dnskeys_parsed && step.dnskeys_parsed.length) {
                var order = step.dnskeys_parsed.map(function (_, i) { return i; });
                order.sort(function (a, b) {
                    return (step.dnskeys_parsed[b].flags || 0) - (step.dnskeys_parsed[a].flags || 0);
                });

                order.forEach(function (idx) {
                    var key      = step.dnskeys_parsed[idx];
                    var record   = step.records && step.records[idx];
                    var isKsk    = key.type === 'KSK';
                    var anchored = anchors.indexOf(key.key_tag) !== -1;

                    var idBadge   = '<span class="badge font-monospace ' + (anchored ? 'bg-primary' : 'bg-secondary') + '">id=' + key.key_tag + '</span>';
                    var typeBadge = isKsk
                        ? '<span class="badge bg-info-subtle text-info border border-info-subtle">KSK</span>'
                        : '<span class="badge bg-body-secondary text-body border">ZSK</span>';

                    var notes = [];
                    if (dnskeySignerTags.length) {
                        notes.push('<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                            + '<i class="bi bi-check-lg me-1"></i>signed by id=' + dnskeySignerTags.join(', id=') + '</span>');
                    }

                    if (anchored) { notes.push('<span class="text-success-emphasis small"><i class="bi bi-link-45deg me-1"></i>anchored by DS above</span>'); }

                    html += '<div class="d-flex align-items-center gap-2 flex-wrap mb-1">'
                          + idBadge + typeBadge + notes.join('') + '</div>';
                    if (record) {
                        html += '<pre class="bg-body-secondary border rounded p-1 mt-0 mb-2" style="font-size:.8em;white-space:pre-wrap;word-break:break-all">'
                              + record + '</pre>';
                    }
                });
            } else {
                html += '<div class="text-danger small">' + step.detail + '</div>';
            }

            if (dsByParent[step.zone]) { html += renderDsBlock(dsByParent[step.zone]); }

            if (signing) {
                if (signing.status === 'ok') {
                    var soaTags = signing.soa_signer_key_tags || [];
                    var soaSignedBadge = soaTags.length
                        ? '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                          + '<i class="bi bi-check-lg me-1"></i>signed by id=' + soaTags.join(', id=') + '</span>'
                        : '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">'
                          + '<i class="bi bi-check-lg me-1"></i>signed</span>';
                    html += '<div class="d-flex align-items-center gap-2 flex-wrap mb-1">'
                          + '<span class="badge bg-body-secondary text-body border font-monospace">SOA</span>'
                          + soaSignedBadge + '</div>';
                    if (signing.records && signing.records.length) {
                        html += '<pre class="bg-body-secondary border rounded p-1 mt-0 mb-2" style="font-size:.8em;white-space:pre-wrap;word-break:break-all">'
                              + signing.records.join('\n') + '</pre>';
                    }
                } else {
                    html += '<div class="d-flex align-items-center gap-2 small">'
                          + tcIcon('error') + ' <span class="text-danger small">' + signing.detail + '</span></div>';
                }
            }
        });

        chainSteps.innerHTML = html;

        if (data.valid) {
            chainSummary.innerHTML = '<i class="bi bi-shield-fill-check text-success me-1"></i>Trust chain is complete and valid';
            chainSummary.className = 'small fw-semibold text-success mt-1';
        } else {
            chainSummary.innerHTML = '<i class="bi bi-shield-fill-x text-danger me-1"></i>Trust chain has gaps — review the errors above';
            chainSummary.className = 'small fw-semibold text-danger mt-1';
        }
        chainResult.style.display = '';
    }

    if (chainBtn) {
        chainBtn.addEventListener('click', function () {
            chainBtn.disabled = true;
            chainSpinner.classList.remove('d-none');
            chainResult.style.display = 'none';
            chainSteps.innerHTML = '';
            chainSummary.textContent = '';
            chainSummary.className = 'small fw-semibold';

            fetch(chainBtn.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.json(); })
                .then(renderTrustChain)
                .catch(function (err) {
                    chainSteps.innerHTML = '<div class="text-danger small">Request failed: ' + err + '</div>';
                    chainResult.style.display = '';
                })
                .finally(function () {
                    chainBtn.disabled = false;
                    chainSpinner.classList.add('d-none');
                });
        });
    }
}());
</script>
{% endif %}
{% endblock %}
