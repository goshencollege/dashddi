{% extends 'base.html.twig' %}
{% block title %}{{ subnet.name }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('subnet_index') }}">Subnets</a></li>
        <li class="breadcrumb-item active">{{ subnet.name }}</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-diagram-2 me-2"></i>{{ subnet.name }}</h1>
        <div class="text-muted">
            {% if subnet.ipv4Cidr %}<code class="me-3">{{ subnet.ipv4Cidr }}</code>{% endif %}
            {% if subnet.ipv6Cidr %}<code>{{ subnet.ipv6Cidr }}</code>{% endif %}
        </div>
    </div>
    <div>
        <a href="{{ path('subnet_edit', {id: subnet.id}) }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('subnet_delete', {id: subnet.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete subnet {{ subnet.name|e('js') }}?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_subnet_' ~ subnet.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    {% if subnet.gateway %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">Gateway</div>
                <code>{{ subnet.gateway }}</code>
            </div>
        </div>
    {% endif %}
    {% if subnet.vlan %}
        <div class="col-auto">
            <div class="card px-3 py-2 text-center">
                <div class="small text-muted">VLAN</div>
                <strong>{{ subnet.vlan }}</strong>
            </div>
        </div>
    {% endif %}
    {% if subnet.description %}
        <div class="col-12">
            <p class="text-muted mb-0">{{ subnet.description }}</p>
        </div>
    {% endif %}
</div>

<div class="row g-3">
    {% if subnet.ipv4Cidr %}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-4-square me-1"></i>IPv4 Allocations</span>
                <span class="badge bg-secondary">{{ subnet.ipAddresses|length }} assigned</span>
            </div>
            {% if subnet.ipAddresses is empty %}
                <div class="card-body text-muted text-center py-3">No allocations</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Address</th><th>Interface</th><th>Host</th></tr></thead>
                        <tbody>
                            {% for ip in subnet.ipAddresses %}
                                {% set iface = subnet.interfaces|filter(i => i.ipAddress and i.ipAddress.id == ip.id)|first %}
                                <tr>
                                    <td class="ip-address">{{ ip.address }}</td>
                                    <td>
                                        {% if iface %}
                                            <a href="{{ path('interface_show', {id: iface.id}) }}">
                                                <code>{{ iface.macAddress }}</code>
                                            </a>
                                        {% else %}—{% endif %}
                                    </td>
                                    <td>
                                        {% if iface and iface.host %}
                                            <a href="{{ path('host_show', {id: iface.host.id}) }}">{{ iface.host.name }}</a>
                                        {% else %}—{% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            {% if available_ipv4 %}
                <div class="card-footer text-muted small">
                    Next available: <code>{{ available_ipv4|first }}</code>
                    ({{ available_ipv4|length }} free)
                </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {% if subnet.ipv6Cidr %}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-6-square me-1"></i>IPv6 Allocations</span>
                <span class="badge bg-secondary">{{ subnet.ipv6Addresses|length }} assigned</span>
            </div>
            {% if subnet.ipv6Addresses is empty %}
                <div class="card-body text-muted text-center py-3">No allocations</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Address</th><th>Interface</th></tr></thead>
                        <tbody>
                            {% for ip in subnet.ipv6Addresses %}
                                {% set iface = subnet.interfaces|filter(i => i.ipv6Address and i.ipv6Address.id == ip.id)|first %}
                                <tr>
                                    <td class="ip-address small">{{ ip.address }}</td>
                                    <td>
                                        {% if iface %}
                                            <a href="{{ path('interface_show', {id: iface.id}) }}">
                                                <code>{{ iface.macAddress }}</code>
                                            </a>
                                        {% else %}—{% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
