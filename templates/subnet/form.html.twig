{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('subnet_index') }}">Subnets</a></li>
        {% if subnet.id %}
            <li class="breadcrumb-item"><a href="{{ path('subnet_show', {id: subnet.id}) }}">{{ subnet.name }}</a></li>
        {% endif %}
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="{{ embed_blocks ? 'col-lg-8' : 'col-md-7' }}">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.name, {attr: {class: 'form-control' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.ipv4Cidr, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.ipv4Cidr, {attr: {class: 'form-control font-monospace' ~ (form.ipv4Cidr.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.ipv4Cidr) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.ipv6Cidr, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.ipv6Cidr, {attr: {class: 'form-control font-monospace' ~ (form.ipv6Cidr.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.ipv6Cidr) }}
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.gateway, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.gateway, {attr: {class: 'form-control font-monospace'}}) }}
                            {{ form_errors(form.gateway) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.vlan, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.vlan, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.vlan) }}
                        </div>
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.vrf, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.vrf, {attr: {class: 'form-select' ~ (form.vrf.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.vrf) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.description, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.description, {attr: {class: 'form-control'}}) }}
                    </div>
                    <hr class="my-3">
                    <h6 class="text-muted mb-3">Reverse Zone SOA</h6>
                    <div class="mb-3">
                        {{ form_label(form.soaNameserver, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.soaNameserver, {attr: {class: 'form-control' ~ (form.soaNameserver.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.soaNameserver) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.soaEmail, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.soaEmail, {attr: {class: 'form-control' ~ (form.soaEmail.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.soaEmail) }}
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_label(form.soaRefresh, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.soaRefresh, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.soaRefresh) }}
                        </div>
                        <div class="col-6">
                            {{ form_label(form.soaRetry, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.soaRetry, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.soaRetry) }}
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_label(form.soaExpire, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.soaExpire, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.soaExpire) }}
                        </div>
                        <div class="col-6">
                            {{ form_label(form.soaTtl, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.soaTtl, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.soaTtl) }}
                        </div>
                    </div>
                    <hr class="my-3">
                    {% if form.views|length > 0 %}
                    <div class="mb-4">
                        {{ form_label(form.views, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        <div class="d-flex flex-wrap gap-3">
                            {% for viewWidget in form.views %}
                                <div class="form-check">
                                    {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                                    {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        <div class="form-text">Reverse zones for this subnet will be generated for the selected views.</div>
                    </div>
                    {% endif %}
                    <hr class="my-3">
                    <h6 class="text-muted mb-3"><i class="bi bi-shield-check me-1"></i>DNSSEC</h6>
                    <div class="mb-4">
                        {{ form_label(form.dnssecPolicy, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.dnssecPolicy, {attr: {class: 'form-select'}}) }}
                        <div class="form-text">
                            Policy must be defined under <a href="{{ path('dnssec_policy_index') }}">DNSSEC Policies</a>.
                            The key directory is configured on the <a href="{{ path('dns_server_index') }}">DNS server</a> and a per-zone subdirectory is created automatically.
                        </div>
                        {{ form_errors(form.dnssecPolicy) }}
                    </div>
                    {% if embed_blocks %}
                    <hr class="my-4">

                    {% for block in [
                        {field: 'reservedBlock', label: 'Reserved Block', icon: 'bi-slash-circle'},
                        {field: 'fixedBlock',    label: 'Fixed Block',    icon: 'bi-pin-map'}
                    ] %}
                    <div class="mb-4">
                        <h6 class="fw-semibold mb-3">
                            <i class="bi {{ block.icon }} me-1"></i>{{ block.label }}
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-5">
                                {{ form_label(form[block.field].startIp, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form[block.field].startIp, {attr: {class: 'form-control font-monospace'}}) }}
                                {{ form_errors(form[block.field].startIp) }}
                            </div>
                            <div class="col-md-5">
                                {{ form_label(form[block.field].endIp, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form[block.field].endIp, {attr: {class: 'form-control font-monospace'}}) }}
                                {{ form_errors(form[block.field].endIp) }}
                            </div>
                            <div class="col-md-2">
                                {{ form_label(form[block.field].label, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form[block.field].label, {attr: {class: 'form-control'}}) }}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                    {% endif %}

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save
                        </button>
                        <a href="{{ subnet.id ? path('subnet_show', {id: subnet.id}) : path('subnet_index') }}" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
