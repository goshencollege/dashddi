{% extends 'base.html.twig' %}
{% block title %}Subnets{% endblock %}
{% block body_class %}page-list-view{% endblock %}

{% macro pager(pagination, route) %}
{% set p = pagination %}
<div class="card-footer d-flex align-items-center justify-content-between py-2">
    <span class="text-muted small">
        {% set first = (p.page - 1) * p.per_page + 1 %}
        {% set last  = min(p.page * p.per_page, p.total) %}
        {% if p.total == 0 %}
            No results
        {% elseif p.total == 1 %}
            1 subnet
        {% else %}
            {{ first }}–{{ last }} of {{ p.total }} subnets
        {% endif %}
    </span>
    {% if p.pages > 1 %}
    <nav aria-label="Subnet list pages">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item {{ p.page <= 1 ? 'disabled' }}">
                <a class="page-link" href="{{ path('subnet_index', p.link_params|merge({page: p.page - 1})) }}" aria-label="Previous">‹</a>
            </li>
            {% set win_start = max(1, p.page - 3) %}
            {% set win_end   = min(p.pages, p.page + 3) %}
            {% if win_start > 1 %}
                <li class="page-item"><a class="page-link" href="{{ path('subnet_index', p.link_params|merge({page: 1})) }}">1</a></li>
                {% if win_start > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            {% endif %}
            {% for n in range(win_start, win_end) %}
                <li class="page-item {{ n == p.page ? 'active' }}">
                    <a class="page-link" href="{{ path('subnet_index', p.link_params|merge({page: n})) }}">{{ n }}</a>
                </li>
            {% endfor %}
            {% if win_end < p.pages %}
                {% if win_end < p.pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                <li class="page-item"><a class="page-link" href="{{ path('subnet_index', p.link_params|merge({page: p.pages})) }}">{{ p.pages }}</a></li>
            {% endif %}
            <li class="page-item {{ p.page >= p.pages ? 'disabled' }}">
                <a class="page-link" href="{{ path('subnet_index', p.link_params|merge({page: p.page + 1})) }}" aria-label="Next">›</a>
            </li>
        </ul>
    </nav>
    {% endif %}
</div>
{% endmacro %}

{% block content %}
<div class="list-page-content">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-diagram-2 me-2"></i>Subnets</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_subnets') }}" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('subnet_import') }}" class="btn btn-outline-secondary">
            <i class="bi bi-upload me-1"></i>Import Config
        </a>
        <a href="{{ path('subnet_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Subnet
        </a>
    </div>
</div>

<div id="bulk-toolbar" class="d-none d-flex align-items-center gap-2 mb-3 px-3 py-2 rounded border border-primary-subtle bg-primary-subtle">
    <i class="bi bi-check2-square text-primary"></i>
    <span id="bulk-count" class="fw-semibold text-primary small">0 selected</span>
    <a id="bulk-edit-btn" href="#" class="btn btn-sm btn-primary ms-1">
        <i class="bi bi-pencil-square me-1"></i>Bulk Edit
    </a>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="bulk-deselect">
        <i class="bi bi-x me-1"></i>Clear selection
    </button>
</div>

<div class="d-flex align-items-center mb-3 gap-3">
    <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
        <a href="{{ path('subnet_index', {view: 'name'}) }}"
           class="btn {{ view == 'name' ? 'btn-secondary' : 'btn-outline-secondary' }}">
            <i class="bi bi-sort-alpha-down me-1"></i>By Name
        </a>
        <a href="{{ path('subnet_index', {view: 'ipv4'}) }}"
           class="btn {{ view == 'ipv4' ? 'btn-secondary' : 'btn-outline-secondary' }}">
            <i class="bi bi-diagram-3 me-1"></i>By IPv4
        </a>
        <a href="{{ path('subnet_index', {view: 'ipv6'}) }}"
           class="btn {{ view == 'ipv6' ? 'btn-secondary' : 'btn-outline-secondary' }}">
            <i class="bi bi-diagram-3 me-1"></i>By IPv6
        </a>
    </div>
    {% if view != 'name' %}
        <span class="text-muted small">
            <i class="bi bi-folder me-1"></i>Container subnets group children by CIDR containment.
            Subnets without a{{ view == 'ipv4' ? 'n IPv4' : 'n IPv6' }} CIDR are hidden in this view.
        </span>
    {% endif %}
</div>

{% if view == 'name' %}
<div class="mb-4">
    {# Simple search #}
    <form method="get" action="{{ path('subnet_index') }}" class="mb-2">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control" placeholder="Search by name, CIDR, gateway, VRF, or tag…" value="{{ query }}">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            {% if query or isAdvanced %}
                <a href="{{ path('subnet_index', {reset: 1}) }}" class="btn btn-outline-secondary">Clear</a>
            {% endif %}
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#advanced-search"
                    aria-expanded="{{ isAdvanced ? 'true' : 'false' }}">
                <i class="bi bi-sliders me-1"></i>Advanced
            </button>
        </div>
    </form>

    {# Advanced search #}
    <div class="collapse {{ isAdvanced ? 'show' : '' }}" id="advanced-search">
        <form method="get" action="{{ path('subnet_index') }}">
            <div class="card card-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Name</label>
                        <input type="text" name="name" class="form-control form-control-sm" value="{{ criteria.name ?? '' }}" placeholder="e.g. Office* or Lab">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">CIDR</label>
                        <input type="text" name="cidr" class="form-control form-control-sm font-monospace" value="{{ criteria.cidr ?? '' }}" placeholder="e.g. 10.0.*">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Gateway</label>
                        <input type="text" name="gateway" class="form-control form-control-sm font-monospace" value="{{ criteria.gateway ?? '' }}" placeholder="e.g. 192.168.1.*">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">VLAN</label>
                        <input type="text" name="vlan" class="form-control form-control-sm" value="{{ criteria.vlan ?? '' }}" placeholder="e.g. 100">
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">VRF</label>
                        <select name="vrf" class="form-select form-select-sm">
                            <option value="">— Any —</option>
                            {% for vrf in vrfs %}
                                <option value="{{ vrf.id }}" {{ (criteria.vrf ?? '') == (vrf.id ~ '') ? 'selected' }}>{{ vrf.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Tag</label>
                        <select name="tag" class="form-select form-select-sm">
                            <option value="">— Any —</option>
                            {% for tag in tags %}
                                <option value="{{ tag.id }}" {{ (criteria.tag ?? '') == (tag.id ~ '') ? 'selected' }}>{{ tag.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a href="{{ path('subnet_index', {reset: 1}) }}" class="btn btn-sm btn-outline-secondary">Clear</a>
                    <span class="text-muted small ms-2">Use <code>*</code> as a wildcard (e.g. <code>10.0.*</code>, <code>Office*</code>)</span>
                </div>
            </div>
        </form>
    </div>
</div>
{% endif %}

{% set isEmpty = (view == 'name' and subnets is empty and not (query or isAdvanced)) or (view != 'name' and tree is empty) %}

{% if view == 'name' and subnets is empty and (query or isAdvanced) %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-search fs-1 d-block mb-3 opacity-25"></i>
            No subnets matched your search. <a href="{{ path('subnet_index', {reset: 1}) }}">Clear search →</a>
        </div>
    </div>
{% elseif isEmpty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-diagram-2 fs-1 d-block mb-3 opacity-25"></i>
            No subnets yet. <a href="{{ path('subnet_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card list-scroll-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-3" style="width:2.5rem">
                            {% if view == 'name' %}
                            <input type="checkbox" class="form-check-input" id="select-all-subnets" title="Select all">
                            {% endif %}
                        </th>
                        <th>Name</th>
                        <th>VRF</th>
                        <th>IPv4 CIDR</th>
                        <th>IPv6 CIDR</th>
                        <th>VLAN</th>
                        <th>Gateway</th>
                        <th>Assigned IPs</th>
                        <th>DNSSEC</th>
                        <th>Tags</th>
                        <th>Last Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if view == 'name' %}
                        {% for subnet in subnets %}
                            {{ _self.subnet_row(subnet, 0, false, true) }}
                        {% endfor %}
                    {% else %}
                        {% for item in tree %}
                            {{ _self.subnet_row(item.subnet, item.depth, true, true) }}
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
        {% if view == 'name' %}
            {{ _self.pager(pagination) }}
        {% endif %}
    </div>
{% endif %}
</div>{# /list-page-content #}

{% macro subnet_row(subnet, depth, treeView, showCheckbox) %}
<tr class="{{ subnet.isContainer ? 'table-active' : '' }}"
    {% if treeView %}data-tree-row data-depth="{{ depth }}"{% if subnet.isContainer %} data-container-id="{{ subnet.id }}"{% endif %}{% endif %}>
    {% if showCheckbox %}
    <td class="ps-3">
        <input type="checkbox" class="form-check-input subnet-select" value="{{ subnet.id }}">
    </td>
    {% endif %}
    <td style="padding-left: {{ 0.75 + depth * 1.5 }}rem">
        {% if treeView and subnet.isContainer %}
            <button type="button" class="btn btn-sm btn-link p-0 me-1 text-muted container-toggle"
                    data-container-id="{{ subnet.id }}" style="line-height:1">
                <i class="bi bi-chevron-down"></i>
            </button>
            <i class="bi bi-folder2-open me-1 text-muted"></i>
        {% elseif not treeView and subnet.isContainer %}
            <i class="bi bi-folder2-open me-1 text-muted"></i>
        {% elseif depth > 0 %}
            <span class="text-muted me-1" style="font-size:.75rem">└</span>
        {% endif %}
        <a href="{{ path('subnet_show', {id: subnet.id}) }}" class="fw-semibold text-decoration-none">
            {{ subnet.name }}
        </a>
    </td>
    <td>{{ subnet.vrf ? subnet.vrf.name : '—' }}</td>
    <td class="ip-address">{{ subnet.ipv4Cidr ?: '—' }}</td>
    <td class="ip-address small">{{ subnet.ipv6Cidr ?: '—' }}</td>
    <td>{{ subnet.vlan ?: '—' }}</td>
    <td class="ip-address">{{ subnet.gateway ?: '—' }}</td>
    <td>
        {% if not subnet.isContainer %}
            <span class="badge bg-info text-dark">{{ subnet.ipAddresses|length }} v4</span>
            <span class="badge bg-warning text-dark ms-1">{{ subnet.ipv6Addresses|length }} v6</span>
        {% endif %}
    </td>
    <td>
        {% if subnet.dnssecPolicy %}
            <span class="badge bg-success-subtle text-success border border-success-subtle">
                <i class="bi bi-shield-check me-1"></i>{{ subnet.dnssecPolicy.name }}
            </span>
        {% else %}
            <span class="text-muted">—</span>
        {% endif %}
    </td>
    <td>
        {% for tag in subnet.tags %}
            <span class="badge bg-secondary me-1">{{ tag.name }}</span>
        {% else %}
            <span class="text-muted">—</span>
        {% endfor %}
    </td>
    <td class="text-muted small">
        {{ subnet.updatedAt|date('Y-m-d H:i') }}
        {% if subnet.updatedBy %}<br>{{ subnet.updatedBy }}{% endif %}
    </td>
    <td class="text-end">
        <a href="{{ path('subnet_edit', {id: subnet.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
            <i class="bi bi-pencil"></i>
        </a>
        <form method="post" action="{{ path('subnet_delete', {id: subnet.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete subnet {{ subnet.name|e('js') }}?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_subnet_' ~ subnet.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </td>
</tr>
{% endmacro %}
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
(function () {
    var toolbar    = document.getElementById('bulk-toolbar');
    var countEl    = document.getElementById('bulk-count');
    var editBtn    = document.getElementById('bulk-edit-btn');
    var deselectBtn = document.getElementById('bulk-deselect');
    var selectAll  = document.getElementById('select-all-subnets');

    function getChecked() {
        return Array.from(document.querySelectorAll('.subnet-select:checked'));
    }

    function updateToolbar() {
        var checked = getChecked();
        if (checked.length > 0) {
            toolbar.classList.remove('d-none');
            toolbar.classList.add('d-flex');
            countEl.textContent = checked.length + ' selected';
            var params = checked.map(cb => 'ids[]=' + encodeURIComponent(cb.value)).join('&');
            editBtn.href = '{{ path('subnet_bulk_edit') }}?' + params;
        } else {
            toolbar.classList.add('d-none');
            toolbar.classList.remove('d-flex');
        }
        if (selectAll) {
            var all = document.querySelectorAll('.subnet-select');
            selectAll.indeterminate = checked.length > 0 && checked.length < all.length;
            selectAll.checked = all.length > 0 && checked.length === all.length;
        }
    }

    var lastChecked = null;
    var allBoxes = Array.from(document.querySelectorAll('.subnet-select'));

    allBoxes.forEach(function (cb) {
        cb.addEventListener('click', function (e) {
            if (e.shiftKey && lastChecked && lastChecked !== cb) {
                var a = allBoxes.indexOf(lastChecked);
                var b = allBoxes.indexOf(cb);
                var lo = Math.min(a, b);
                var hi = Math.max(a, b);
                for (var i = lo; i <= hi; i++) {
                    allBoxes[i].checked = cb.checked;
                }
            }
            lastChecked = cb;
            updateToolbar();
        });
    });

    if (selectAll) {
        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.subnet-select').forEach(function (cb) {
                cb.checked = selectAll.checked;
            });
            updateToolbar();
        });
    }

    if (deselectBtn) {
        deselectBtn.addEventListener('click', function () {
            document.querySelectorAll('.subnet-select').forEach(function (cb) {
                cb.checked = false;
            });
            if (selectAll) selectAll.checked = false;
            updateToolbar();
        });
    }
})();

(function () {
    var collapsed = new Set();

    function updateVisibility() {
        var rows = Array.from(document.querySelectorAll('tr[data-tree-row]'));
        var stack = []; // depths of collapsed containers we're currently inside
        rows.forEach(function (row) {
            var depth = parseInt(row.dataset.depth, 10);
            while (stack.length > 0 && stack[stack.length - 1] >= depth) {
                stack.pop();
            }
            row.style.display = stack.length > 0 ? 'none' : '';
            var cid = row.dataset.containerId;
            if (cid && collapsed.has(cid)) {
                stack.push(depth);
            }
        });
    }

    document.querySelectorAll('.container-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var cid = this.dataset.containerId;
            var icon = this.querySelector('i');
            if (collapsed.has(cid)) {
                collapsed.delete(cid);
                icon.classList.replace('bi-chevron-right', 'bi-chevron-down');
            } else {
                collapsed.add(cid);
                icon.classList.replace('bi-chevron-down', 'bi-chevron-right');
            }
            updateVisibility();
        });
    });
})();
</script>
{% endblock %}
