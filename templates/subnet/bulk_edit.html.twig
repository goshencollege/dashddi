{% extends 'base.html.twig' %}
{% block title %}Bulk Edit Subnets{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css">
{% endblock %}

{% block page_styles %}
{{ include('_tom_select_dark.html.twig') }}
<style>
.bulk-edit-table .bulk-row.inactive td:not(:first-child) {
    opacity: 0.38;
}
.bulk-edit-table .bulk-row td {
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
}
.cursor-pointer { cursor: pointer; }
</style>
{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('subnet_index') }}">Subnets</a></li>
        <li class="breadcrumb-item active">Bulk Edit</li>
    </ol>
</nav>

<div class="row justify-content-center">
<div class="col-xl-8 col-lg-10">

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Bulk Edit Subnets</h5>
        <span class="badge bg-primary rounded-pill">{{ subnets|length }} subnet{{ subnets|length != 1 ? 's' }}</span>
    </div>
    <div class="card-body py-2 px-3">
        <div class="d-flex flex-wrap gap-1">
            {% for subnet in subnets %}
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fw-normal">
                    <i class="bi bi-diagram-2 me-1"></i>{{ subnet.name }}
                </span>
            {% endfor %}
        </div>
    </div>
</div>

{{ form_start(form, {attr: {id: 'bulk-edit-form', novalidate: 'novalidate'}}) }}

{% for id in ids %}
    <input type="hidden" name="subnet_ids[]" value="{{ id }}">
{% endfor %}

<div class="card">
    <div class="card-header">
        <span class="fw-semibold">Fields to Update</span>
        <span class="text-muted small ms-2">Check a row to include it in the update — unchecked fields are left unchanged on all selected subnets.</span>
    </div>

    <div class="table-responsive">
    <table class="table align-middle mb-0 bulk-edit-table">
        <colgroup>
            <col style="width:2.75rem">
            <col style="width:13rem">
            <col>
            <col style="width:13rem">
        </colgroup>
        <tbody>

        {# ── General ──────────────────────────────────────────── #}
        <tr class="table-section-header">
            <td colspan="4" class="small text-uppercase text-muted fw-semibold py-2 ps-3">General</td>
        </tr>

        <tr class="bulk-row inactive" data-field="vlan">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_vlan" id="apply_vlan">
            </td>
            <td><label for="apply_vlan" class="form-label fw-semibold mb-0 cursor-pointer">VLAN ID</label></td>
            <td>
                {{ form_widget(form.vlan, {attr: {class: 'form-control form-control-sm', style: 'max-width:10rem'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="description">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_description" id="apply_description">
            </td>
            <td><label for="apply_description" class="form-label fw-semibold mb-0 cursor-pointer">Description</label></td>
            <td>
                {{ form_widget(form.description, {attr: {class: 'form-control form-control-sm'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="tags">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_tags" id="apply_tags">
            </td>
            <td><label for="apply_tags" class="form-label fw-semibold mb-0 cursor-pointer">Tags</label></td>
            <td>
                {{ form_widget(form.tags, {attr: {class: 'form-select form-select-sm', id: 'bulk_tags'}}) }}
            </td>
            <td>
                <select name="tags_mode" class="form-select form-select-sm">
                    <option value="replace">Replace all</option>
                    <option value="add">Add to existing</option>
                    <option value="remove">Remove from existing</option>
                </select>
            </td>
        </tr>

        {# ── Reverse Zone SOA ─────────────────────────────────── #}
        <tr class="table-section-header">
            <td colspan="4" class="small text-uppercase text-muted fw-semibold py-2 ps-3">Reverse Zone SOA</td>
        </tr>

        <tr class="bulk-row inactive" data-field="soaNameserver">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_soaNameserver" id="apply_soaNameserver">
            </td>
            <td><label for="apply_soaNameserver" class="form-label fw-semibold mb-0 cursor-pointer">Primary Nameserver</label></td>
            <td>
                {{ form_widget(form.soaNameserver, {attr: {class: 'form-control form-control-sm'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="soaEmail">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_soaEmail" id="apply_soaEmail">
            </td>
            <td><label for="apply_soaEmail" class="form-label fw-semibold mb-0 cursor-pointer">Responsible Email</label></td>
            <td>
                {{ form_widget(form.soaEmail, {attr: {class: 'form-control form-control-sm'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="soaRefresh">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_soaRefresh" id="apply_soaRefresh">
            </td>
            <td><label for="apply_soaRefresh" class="form-label fw-semibold mb-0 cursor-pointer">Refresh (s)</label></td>
            <td>
                {{ form_widget(form.soaRefresh, {attr: {class: 'form-control form-control-sm', style: 'max-width:10rem'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="soaRetry">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_soaRetry" id="apply_soaRetry">
            </td>
            <td><label for="apply_soaRetry" class="form-label fw-semibold mb-0 cursor-pointer">Retry (s)</label></td>
            <td>
                {{ form_widget(form.soaRetry, {attr: {class: 'form-control form-control-sm', style: 'max-width:10rem'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="soaExpire">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_soaExpire" id="apply_soaExpire">
            </td>
            <td><label for="apply_soaExpire" class="form-label fw-semibold mb-0 cursor-pointer">Expire (s)</label></td>
            <td>
                {{ form_widget(form.soaExpire, {attr: {class: 'form-control form-control-sm', style: 'max-width:10rem'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="soaTtl">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_soaTtl" id="apply_soaTtl">
            </td>
            <td><label for="apply_soaTtl" class="form-label fw-semibold mb-0 cursor-pointer">Minimum TTL (s)</label></td>
            <td>
                {{ form_widget(form.soaTtl, {attr: {class: 'form-control form-control-sm', style: 'max-width:10rem'}}) }}
            </td>
            <td></td>
        </tr>

        <tr class="bulk-row inactive" data-field="defaultTtl">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_defaultTtl" id="apply_defaultTtl">
            </td>
            <td><label for="apply_defaultTtl" class="form-label fw-semibold mb-0 cursor-pointer">Default TTL (s)</label></td>
            <td>
                {{ form_widget(form.defaultTtl, {attr: {class: 'form-control form-control-sm', style: 'max-width:10rem'}}) }}
            </td>
            <td></td>
        </tr>

        {# ── DNS Views ─────────────────────────────────────────── #}
        <tr class="table-section-header">
            <td colspan="4" class="small text-uppercase text-muted fw-semibold py-2 ps-3">DNS</td>
        </tr>

        <tr class="bulk-row inactive" data-field="views">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_views" id="apply_views">
            </td>
            <td><label for="apply_views" class="form-label fw-semibold mb-0 cursor-pointer">DNS Views</label></td>
            <td>
                {{ form_widget(form.views, {attr: {class: 'form-select form-select-sm', id: 'bulk_views'}}) }}
                <div class="form-text">Reverse zones for selected subnets will be generated for these views.</div>
            </td>
            <td>
                <select name="views_mode" class="form-select form-select-sm">
                    <option value="replace">Replace all</option>
                    <option value="add">Add to existing</option>
                    <option value="remove">Remove from existing</option>
                </select>
            </td>
        </tr>

        {# ── DNSSEC ────────────────────────────────────────────── #}
        <tr class="table-section-header">
            <td colspan="4" class="small text-uppercase text-muted fw-semibold py-2 ps-3">
                <i class="bi bi-shield-check me-1"></i>DNSSEC
            </td>
        </tr>

        <tr class="bulk-row inactive" data-field="dnssecPolicy">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_dnssecPolicy" id="apply_dnssecPolicy">
            </td>
            <td><label for="apply_dnssecPolicy" class="form-label fw-semibold mb-0 cursor-pointer">DNSSEC Policy</label></td>
            <td>
                {{ form_widget(form.dnssecPolicy, {attr: {class: 'form-select form-select-sm', style: 'max-width:20rem'}}) }}
                <div class="form-text">Select "— None —" to remove the policy from selected subnets.</div>
            </td>
            <td></td>
        </tr>

        {# ── DHCP Lease Log ────────────────────────────────────── #}
        <tr class="table-section-header">
            <td colspan="4" class="small text-uppercase text-muted fw-semibold py-2 ps-3">
                <i class="bi bi-journal-text me-1"></i>DHCP Lease Log
            </td>
        </tr>

        <tr class="bulk-row inactive" data-field="leaseRetentionDays">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_leaseRetentionDays" id="apply_leaseRetentionDays">
            </td>
            <td><label for="apply_leaseRetentionDays" class="form-label fw-semibold mb-0 cursor-pointer">Retention (days)</label></td>
            <td>
                {{ form_widget(form.leaseRetentionDays, {attr: {class: 'form-control form-control-sm', style: 'max-width:10rem'}}) }}
                <div class="form-text">Leave blank to keep lease logs forever.</div>
            </td>
            <td></td>
        </tr>

        {# ── DDNS ──────────────────────────────────────────────── #}
        <tr class="table-section-header">
            <td colspan="4" class="small text-uppercase text-muted fw-semibold py-2 ps-3">
                <i class="bi bi-arrow-repeat me-1"></i>Dynamic DNS (DDNS)
            </td>
        </tr>

        <tr class="bulk-row inactive" data-field="ddnsDomain">
            <td class="text-center ps-2">
                <input type="checkbox" class="form-check-input apply-checkbox" name="apply_ddnsDomain" id="apply_ddnsDomain">
            </td>
            <td><label for="apply_ddnsDomain" class="form-label fw-semibold mb-0 cursor-pointer">DDNS Domain</label></td>
            <td>
                {{ form_widget(form.ddnsDomain, {attr: {class: 'form-select form-select-sm', style: 'max-width:24rem'}}) }}
                <div class="form-text">Select "— None —" to disable DDNS on all selected subnets.</div>
            </td>
            <td></td>
        </tr>

        </tbody>
    </table>
    </div>

    {# ── Add DNS Records ──────────────────────────────── #}
    <div class="border-top">
        <div class="px-3 py-3 d-flex align-items-center gap-2">
            <input type="checkbox" class="form-check-input" name="apply_records" id="apply_records">
            <label for="apply_records" class="fw-semibold cursor-pointer mb-0">
                <i class="bi bi-file-earmark-plus me-1"></i>Add DNS Records
            </label>
            <span class="text-muted small ms-1">Records will be appended to every selected subnet.</span>
        </div>
        <div id="records-panel" class="px-3 pb-3" style="display:none">
            <div class="table-responsive">
            <table class="table table-sm align-middle mb-2">
                <thead>
                    <tr>
                        <th style="width:9rem">Hostname</th>
                        <th style="width:6.5rem">Type</th>
                        <th>Value</th>
                        <th style="width:6rem">TTL</th>
                        {% if all_views is not empty %}
                        <th>Views <span class="text-muted fw-normal small">(only applied to subnets that have the view)</span></th>
                        {% endif %}
                        <th style="width:2.5rem"></th>
                    </tr>
                </thead>
                <tbody id="records-tbody"></tbody>
            </table>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="add-record-btn">
                <i class="bi bi-plus-lg me-1"></i>Add record
            </button>
        </div>
    </div>

    {# Row template – cloned by JS; __IDX__ is replaced with the row counter #}
    <template id="record-row-tpl">
        <tr>
            <td><input type="text" name="record_templates[__IDX__][hostname]" value="@" class="form-control form-control-sm font-monospace"></td>
            <td>
                <select name="record_templates[__IDX__][type]" class="form-select form-select-sm">
                    {% for rt in record_types %}
                    <option value="{{ rt.value }}"{% if rt.value == 'NS' %} selected{% endif %}>{{ rt.value }}</option>
                    {% endfor %}
                </select>
            </td>
            <td><input type="text" name="record_templates[__IDX__][value]" class="form-control form-control-sm font-monospace" placeholder="ns1.example.com."></td>
            <td><input type="number" name="record_templates[__IDX__][ttl]" class="form-control form-control-sm" placeholder="default" min="0"></td>
            {% if all_views is not empty %}
            <td>
                <div class="d-flex flex-wrap gap-3">
                    {% for view in all_views %}
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox"
                               name="record_templates[__IDX__][views][]"
                               value="{{ view.id }}"
                               id="rv___IDX____{{ view.id }}">
                        <label class="form-check-label small" for="rv___IDX____{{ view.id }}">{{ view.name }}</label>
                    </div>
                    {% endfor %}
                </div>
            </td>
            {% endif %}
            <td>
                <button type="button" class="btn btn-sm btn-outline-danger remove-record-row">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        </tr>
    </template>

    <div class="card-footer d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Apply Changes
        </button>
        <a href="{{ path('subnet_index') }}" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>

{{ form_end(form) }}

</div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<script>
(function () {
    // Track TomSelect instances so we can enable/disable them
    var tsInstances = {};

    // Tags — API-backed with create
    var tagsEl = document.getElementById('bulk_tags');
    if (tagsEl) {
        Array.from(tagsEl.options).forEach(opt => { if (!opt.selected) opt.remove(); });
        tsInstances['tags'] = new TomSelect(tagsEl, {
            plugins: ['remove_button'],
            persist: false,
            load: function (query, callback) {
                fetch('/api/tags?q=' + encodeURIComponent(query))
                    .then(r => r.json()).then(callback).catch(() => callback());
            },
            create: function (input, callback) {
                fetch('/api/tags', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: input }),
                })
                    .then(r => r.json().then(data => ({ ok: r.ok, data })))
                    .then(({ ok, data }) => { ok ? callback(data) : callback(); })
                    .catch(() => callback());
            },
            render: {
                option_create: (d, esc) => '<div class="create">Create tag <strong>' + esc(d.input) + '</strong></div>',
                no_results:    (d, esc) => '<div class="no-results">No tags matching <strong>' + esc(d.input) + '</strong></div>',
            },
        });
    }

    // Views — local multi-select
    var viewsEl = document.getElementById('bulk_views');
    if (viewsEl) {
        tsInstances['views'] = new TomSelect(viewsEl, {
            plugins: ['remove_button'],
            persist: false,
        });
    }

    // Apply-toggle behaviour
    document.querySelectorAll('.apply-checkbox').forEach(function (cb) {
        var row = cb.closest('.bulk-row');

        function sync() {
            if (cb.checked) {
                row.classList.remove('inactive');
                row.querySelectorAll('input:not([type=checkbox]), select, textarea').forEach(function (el) {
                    el.disabled = false;
                });
                // Enable TomSelect instances in this row
                Object.values(tsInstances).forEach(function (ts) {
                    if (row.contains(ts.input)) ts.enable();
                });
            } else {
                row.classList.add('inactive');
                row.querySelectorAll('input:not([type=checkbox]), select, textarea').forEach(function (el) {
                    el.disabled = true;
                });
                Object.values(tsInstances).forEach(function (ts) {
                    if (row.contains(ts.input)) ts.disable();
                });
            }
        }

        cb.addEventListener('change', sync);

        // Set initial disabled state (rows start inactive)
        row.querySelectorAll('input:not([type=checkbox]), select, textarea').forEach(function (el) {
            el.disabled = true;
        });
        Object.values(tsInstances).forEach(function (ts) {
            if (row.contains(ts.input)) ts.disable();
        });
    });
})();

// ── DNS Records section ───────────────────────────────────────────────────
(function () {
    var panel      = document.getElementById('records-panel');
    var tbody      = document.getElementById('records-tbody');
    var applyChk   = document.getElementById('apply_records');
    var addBtn     = document.getElementById('add-record-btn');
    var rowTpl     = document.getElementById('record-row-tpl');
    var rowCounter = 0;

    function disablePanelInputs() {
        panel.querySelectorAll('input, select, textarea').forEach(function (el) {
            el.disabled = true;
        });
    }

    function enablePanelInputs() {
        panel.querySelectorAll('input, select, textarea').forEach(function (el) {
            el.disabled = false;
        });
    }

    function addRow() {
        var frag = rowTpl.content.cloneNode(true);
        var tr   = frag.querySelector('tr');
        tr.innerHTML = tr.innerHTML.replaceAll('__IDX__', rowCounter++);
        tr.querySelector('.remove-record-row').addEventListener('click', function () {
            tr.remove();
        });
        tbody.appendChild(tr);
    }

    applyChk.addEventListener('change', function () {
        if (this.checked) {
            panel.style.display = '';
            enablePanelInputs();
            if (tbody.children.length === 0) addRow();
        } else {
            panel.style.display = 'none';
            disablePanelInputs();
        }
    });

    addBtn.addEventListener('click', addRow);

    // Start disabled
    disablePanelInputs();
})();
</script>
{% endblock %}

