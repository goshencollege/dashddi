{% extends 'base.html.twig' %}

{% block title %}Application Settings{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-sliders me-2"></i>Application Settings</h1>
</div>

{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><strong>General</strong></div>
            <div class="card-body">
                <div class="mb-0">
                    {{ form_label(form.timezone, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.timezone) }}
                    {{ form_errors(form.timezone) }}
                    {{ form_help(form.timezone) }}
                </div>
            </div>
        </div>
        <div class="card mt-4">
            <div class="card-header"><strong>DHCP Lease Log</strong></div>
            <div class="card-body">
                <div class="mb-3">
                    {{ form_label(form.defaultNewSubnetLeaseRetentionDays, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.defaultNewSubnetLeaseRetentionDays) }}
                    {{ form_errors(form.defaultNewSubnetLeaseRetentionDays) }}
                    {{ form_help(form.defaultNewSubnetLeaseRetentionDays) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.defaultLeaseRetentionDays, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.defaultLeaseRetentionDays) }}
                    {{ form_errors(form.defaultLeaseRetentionDays) }}
                    {{ form_help(form.defaultLeaseRetentionDays) }}
                </div>
            </div>
        </div>
        <div class="card mt-4">
            <div class="card-header"><strong>Push Logs</strong></div>
            <div class="card-body">
                <div class="mb-0">
                    {{ form_label(form.pushLogRetentionDays, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.pushLogRetentionDays) }}
                    {{ form_errors(form.pushLogRetentionDays) }}
                    {{ form_help(form.pushLogRetentionDays) }}
                </div>
            </div>
        </div>
        <div class="card mt-4">
            <div class="card-header"><strong>Deleted Hosts &amp; Interfaces</strong></div>
            <div class="card-body">
                <div class="mb-0">
                    {{ form_label(form.deletedHostRetentionDays, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.deletedHostRetentionDays) }}
                    {{ form_errors(form.deletedHostRetentionDays) }}
                    {{ form_help(form.deletedHostRetentionDays) }}
                </div>
            </div>
        </div>
        <div class="card mt-4">
            <div class="card-header"><strong>ClearPass Auth Logs</strong></div>
            <div class="card-body">
                <div class="mb-0">
                    {{ form_label(form.clearpassAuthLogRetentionDays, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.clearpassAuthLogRetentionDays) }}
                    {{ form_errors(form.clearpassAuthLogRetentionDays) }}
                    {{ form_help(form.clearpassAuthLogRetentionDays) }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><strong>SMTP Email Settings</strong></div>
            <div class="card-body">
                <p class="text-muted small">Used to send failure notifications for scheduled tasks.</p>

                <div class="mb-3">
                    {{ form_label(form.smtpHost, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.smtpHost, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.smtpHost) }}
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-5">
                        {{ form_label(form.smtpPort, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.smtpPort, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(form.smtpPort) }}
                    </div>
                    <div class="col-sm-7">
                        {{ form_label(form.smtpEncryption, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.smtpEncryption, {attr: {class: 'form-select'}}) }}
                        {{ form_errors(form.smtpEncryption) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.smtpUsername, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.smtpUsername, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.smtpUsername) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.smtpPassword, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.smtpPassword, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.smtpPassword) }}
                    {{ form_help(form.smtpPassword) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.smtpFromEmail, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.smtpFromEmail, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.smtpFromEmail) }}
                </div>

                <div class="mb-0">
                    {{ form_label(form.smtpFromName, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.smtpFromName, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.smtpFromName) }}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>Save Settings
    </button>
</div>
{{ form_end(form) }}

<div class="row g-4 mt-0">
    <div class="col-lg-6 offset-lg-6">
        <div class="card">
            <div class="card-header"><strong>Send Test Email</strong></div>
            <div class="card-body">
                <p class="text-muted small">Sends a test message using the SMTP settings above. Save your settings before testing.</p>
                <form method="post" action="{{ path('app_settings_test_email') }}" class="d-flex gap-2 align-items-start">
                    <input type="hidden" name="_token" value="{{ csrf_token('test_email') }}">
                    <div class="flex-grow-1">
                        <input type="email" name="test_recipient" class="form-control"
                               placeholder="recipient@example.com" required>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary text-nowrap">
                        <i class="bi bi-send me-1"></i>Send Test
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
