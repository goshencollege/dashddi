{# ── DNS Servers ──────────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-globe2 me-2"></i>DNS Servers</h2>
    <div class="d-flex gap-2">
        <button id="dns-push-btn" class="btn btn-sm btn-success" {% if dnsServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All
        </button>
        <a href="{{ path('dns_server_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="dns-push-results" class="mb-3" style="display:none"></div>

{% if dnsServers is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-globe2 fs-1 d-block mb-3 opacity-25"></i>
            No DNS servers configured yet. <a href="{{ path('dns_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Hostname / IP</th>
                        <th>SSH User</th>
                        <th>Remote Zone Path</th>
                        <th>Views</th>
                        <th>SSH Key</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in dnsServers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td>
                                {% if server.serverType == 'secondary' %}
                                    <span class="badge bg-info text-dark">secondary</span>
                                    {% if server.primaryHostname %}
                                        <span class="text-muted small ms-1">← {{ server.primaryHostname }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-primary">primary</span>
                                {% endif %}
                            </td>
                            <td class="font-monospace">{{ server.hostname }}</td>
                            <td class="font-monospace">{{ server.sshUser }}</td>
                            <td class="font-monospace small">{{ server.remoteZonePath }}</td>
                            <td>
                                {% for view in server.views %}
                                    <span class="badge bg-secondary me-1">{{ view.name }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% if server.sshPublicKey %}
                                    <span class="badge bg-success"><i class="bi bi-key-fill me-1"></i>Ready</span>
                                {% else %}
                                    <span class="badge bg-secondary">No key</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('dns_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('dns_server_delete', {id: server.id}) }}"
                                          onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_dns_server_' ~ server.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
(function () {
    function bindPushButton(btnId, resultsId, endpoint) {
        const btn     = document.getElementById(btnId);
        const results = document.getElementById(resultsId);
        if (!btn) return;

        btn.addEventListener('click', function () {
            btn.disabled  = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Queuing…';
            results.style.display = 'none';
            results.innerHTML = '';

            fetch(endpoint, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            })
            .then(r => r.json())
            .then(data => {
                if (data.error) {
                    results.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                } else {
                    const n = data.count === 1 ? '1 server' : `${data.count} servers`;
                    results.innerHTML = `<div class="alert alert-info mb-0"><i class="bi bi-send-check me-2"></i>Push queued for ${n} — deploying in the background. <a href="{{ path('push_log_index') }}">View Push Logs</a> to see the output.</div>`;
                }
                results.style.display = '';
            })
            .catch(err => {
                results.innerHTML = `<div class="alert alert-danger">Request failed: ${err}</div>`;
                results.style.display = '';
            })
            .finally(() => {
                btn.disabled  = false;
                btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Push to All';
            });
        });
    }

    bindPushButton('radius-push-btn', 'radius-push-results', '{{ path('radius_server_push') }}');
    bindPushButton('dhcp-push-btn',   'dhcp-push-results',   '{{ path('dhcp_server_push') }}');
    bindPushButton('dns-push-btn',    'dns-push-results',    '{{ path('dns_server_push') }}');
})();
</script>
{% endblock %}
