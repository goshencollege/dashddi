{% extends 'base.html.twig' %}
{% block title %}Servers{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-server me-2"></i>Servers</h1>
    <a href="{{ path('user_guide_servers') }}#servers-overview" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
</div>

{# ── ClearPass Servers ────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-shield-check me-2"></i>ClearPass Servers</h2>
    <div class="d-flex gap-2">
        <button id="clearpass-pull-logs-btn" class="btn btn-sm btn-success" {% if clearpassServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-download me-1"></i>Pull Auth Logs
        </button>
        <button id="clearpass-push-btn" class="btn btn-sm btn-success" {% if clearpassServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All
        </button>
        <a href="{{ path('clearpass_server_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="clearpass-pull-logs-results" class="mb-3" style="display:none"></div>
<div id="clearpass-push-results" class="mb-3" style="display:none"></div>

{% if clearpassServers is empty %}
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-25"></i>
            No ClearPass servers configured yet. <a href="{{ path('clearpass_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card mb-5">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>API URL</th>
                        <th>Client ID</th>
                        <th>TLS</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in clearpassServers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td class="font-monospace small">{{ server.apiUrl }}</td>
                            <td class="font-monospace">{{ server.clientId }}</td>
                            <td>
                                {% if server.verifyTls %}
                                    <span class="badge bg-success">Verified</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">Unverified</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('clearpass_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('clearpass_server_delete', {id: server.id}) }}"
                                          onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_clearpass_server_' ~ server.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{# ── Aruba CX Switches ────────────────────────────────────────────────────── #}
{% set arubaCreds = arubaSwitches|first %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-diagram-3 me-2"></i>Aruba CX Switches</h2>
    <a href="{{ path('aruba_switch_configure') }}" class="btn btn-sm btn-{{ arubaCreds ? 'outline-secondary' : 'primary' }}">
        <i class="bi bi-{{ arubaCreds ? 'pencil' : 'plus-lg' }} me-1"></i>{{ arubaCreds ? 'Edit Credentials' : 'Configure' }}
    </a>
</div>

{% if not arubaCreds %}
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-diagram-3 fs-1 d-block mb-3 opacity-25"></i>
            No Aruba CX credentials configured yet. <a href="{{ path('aruba_switch_configure') }}">Configure →</a>
        </div>
    </div>
{% else %}
    <div class="card mb-5">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="text-muted small">Username</div>
                    <code>{{ arubaCreds.username }}</code>
                </div>
                <div class="col-sm-2">
                    <div class="text-muted small">REST API</div>
                    <code>{{ arubaCreds.restApiVersion }}</code>
                </div>
                <div class="col-sm-3">
                    <div class="text-muted small">TLS</div>
                    {% if arubaCreds.verifyTls %}
                        <span class="badge bg-success">Verified</span>
                    {% else %}
                        <span class="badge bg-warning text-dark">Unverified</span>
                    {% endif %}
                </div>
                <div class="col-sm-3">
                    <div class="text-muted small">SSH Key</div>
                    {% if arubaCreds.sshPublicKey %}
                        <span class="badge bg-success"><i class="bi bi-key-fill me-1"></i>Ready</span>
                    {% else %}
                        <span class="badge bg-secondary">No key</span>
                    {% endif %}
                </div>
            </div>
            {% if arubaCreds.description %}
                <p class="text-muted small mt-2 mb-0">{{ arubaCreds.description }}</p>
            {% endif %}
        </div>
        <div class="card-footer d-flex justify-content-end">
            <form method="post" action="{{ path('aruba_switch_delete') }}"
                  onsubmit="return confirm('Remove Aruba CX credentials?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_aruba_creds') }}">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash me-1"></i>Remove Credentials
                </button>
            </form>
        </div>
    </div>
{% endif %}

{# ── DHCP Servers ─────────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-hdd-network me-2"></i>DHCP Servers</h2>
    <div class="d-flex gap-2">
        <button id="dhcp-push-btn" class="btn btn-sm btn-success" {% if dhcpServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All
        </button>
        <a href="{{ path('dhcp_server_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="dhcp-push-results" class="mb-3" style="display:none"></div>

{% if dhcpServers is empty %}
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-hdd-network fs-1 d-block mb-3 opacity-25"></i>
            No DHCP servers configured yet. <a href="{{ path('dhcp_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card mb-5">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Hostname / IP</th>
                        <th>SSH User</th>
                        <th>Remote Path</th>
                        <th>Versions</th>
                        <th>SSH Key</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in dhcpServers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td class="font-monospace">{{ server.hostname }}</td>
                            <td class="font-monospace">{{ server.sshUser }}</td>
                            <td class="font-monospace">{{ server.remotePath }}</td>
                            <td>
                                {% if server.versionScope == 'v4' %}
                                    <span class="badge bg-primary">IPv4 only</span>
                                {% elseif server.versionScope == 'v6' %}
                                    <span class="badge bg-info text-dark">IPv6 only</span>
                                {% else %}
                                    <span class="badge bg-secondary">IPv4 + IPv6</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if server.sshPublicKey %}
                                    <span class="badge bg-success"><i class="bi bi-key-fill me-1"></i>Ready</span>
                                {% else %}
                                    <span class="badge bg-secondary">No key</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('dhcp_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('dhcp_server_delete', {id: server.id}) }}"
                                          onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_dhcp_server_' ~ server.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{# ── Snipe-IT Servers ─────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-box-seam me-2"></i>Snipe-IT Servers</h2>
    <div class="d-flex gap-2">
        <button id="snipeit-pull-btn" class="btn btn-sm btn-success" {% if snipeItServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-download me-1"></i>Pull Now
        </button>
        <a href="{{ path('snipe_it_server_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="snipeit-pull-results" class="mb-3" style="display:none"></div>

{% if snipeItServers is empty %}
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-box-seam fs-1 d-block mb-3 opacity-25"></i>
            No Snipe-IT servers configured yet. <a href="{{ path('snipe_it_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card mb-5">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>API URL</th>
                        <th>MAC Fields</th>
                        <th>TLS</th>
                        <th>Last Sync</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in snipeItServers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td class="font-monospace small">{{ server.apiUrl }}</td>
                            <td class="small text-muted">{{ server.macCustomFields }}</td>
                            <td>
                                {% if server.verifyTls %}
                                    <span class="badge bg-success">Verified</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">Unverified</span>
                                {% endif %}
                            </td>
                            <td class="small">
                                {% if server.lastSyncAt %}
                                    {{ server.lastSyncAt|date('Y-m-d H:i') }}
                                {% else %}
                                    <span class="text-muted">Never</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('snipe_it_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('snipe_it_server_delete', {id: server.id}) }}"
                                          onsubmit="return confirm('Remove {{ server.name|e('js') }}? This will delete all hosts imported from this server.')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_snipe_it_server_' ~ server.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{# ── DNS Servers ──────────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-globe2 me-2"></i>DNS Servers</h2>
    <div class="d-flex gap-2">
        <button id="dns-push-btn" class="btn btn-sm btn-success" {% if dnsServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All
        </button>
        <a href="{{ path('dns_server_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="dns-push-results" class="mb-3" style="display:none"></div>

{% if dnsServers is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-globe2 fs-1 d-block mb-3 opacity-25"></i>
            No DNS servers configured yet. <a href="{{ path('dns_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Hostname / IP</th>
                        <th>SSH User</th>
                        <th>Remote Zone Path</th>
                        <th>Views</th>
                        <th>SSH Key</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in dnsServers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td>
                                {% if server.serverType == 'secondary' %}
                                    <span class="badge bg-info text-dark">secondary</span>
                                    {% if server.primaryHostname %}
                                        <span class="text-muted small ms-1">← {{ server.primaryHostname }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-primary">primary</span>
                                {% endif %}
                            </td>
                            <td class="font-monospace">{{ server.hostname }}</td>
                            <td class="font-monospace">{{ server.sshUser }}</td>
                            <td class="font-monospace small">{{ server.remoteZonePath }}</td>
                            <td>
                                {% for view in server.views %}
                                    <span class="badge bg-secondary me-1">{{ view.name }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% if server.sshPublicKey %}
                                    <span class="badge bg-success"><i class="bi bi-key-fill me-1"></i>Ready</span>
                                {% else %}
                                    <span class="badge bg-secondary">No key</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('dns_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('dns_server_delete', {id: server.id}) }}"
                                          onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_dns_server_' ~ server.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
(function () {
    function bindPushButton(btnId, resultsId, endpoint, csrfToken) {
        const btn     = document.getElementById(btnId);
        const results = document.getElementById(resultsId);
        if (!btn) return;

        btn.addEventListener('click', function () {
            btn.disabled  = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Queuing…';
            results.style.display = 'none';
            results.innerHTML = '';

            fetch(endpoint, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': csrfToken },
            })
            .then(r => r.json())
            .then(data => {
                if (data.error) {
                    results.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                } else {
                    const n = data.count === 1 ? '1 server' : `${data.count} servers`;
                    results.innerHTML = `<div class="alert alert-info mb-0"><i class="bi bi-send-check me-2"></i>Push queued for ${n} — deploying in the background. <a href="{{ path('push_log_index') }}">View Push Logs</a> to see the output.</div>`;
                }
                results.style.display = '';
            })
            .catch(err => {
                results.innerHTML = `<div class="alert alert-danger">Request failed: ${err}</div>`;
                results.style.display = '';
            })
            .finally(() => {
                btn.disabled  = false;
                btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Push to All';
            });
        });
    }

    function bindPullButton(btnId, resultsId, endpoint, resetLabel, csrfToken) {
        resetLabel = resetLabel || '<i class="bi bi-cloud-download me-1"></i>Pull Now';
        const btn     = document.getElementById(btnId);
        const results = document.getElementById(resultsId);
        if (!btn) return;

        btn.addEventListener('click', function () {
            btn.disabled  = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Queuing…';
            results.style.display = 'none';
            results.innerHTML = '';

            fetch(endpoint, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': csrfToken },
            })
            .then(r => r.json())
            .then(data => {
                if (data.error) {
                    results.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                } else {
                    const n = data.count === 1 ? '1 server' : `${data.count} servers`;
                    results.innerHTML = `<div class="alert alert-info mb-0"><i class="bi bi-send-check me-2"></i>Pull queued for ${n} — syncing in the background. <a href="{{ path('push_log_index') }}">View Push Logs</a> to see the result.</div>`;
                }
                results.style.display = '';
            })
            .catch(err => {
                results.innerHTML = `<div class="alert alert-danger">Request failed: ${err}</div>`;
                results.style.display = '';
            })
            .finally(() => {
                btn.disabled  = false;
                btn.innerHTML = resetLabel;
            });
        });
    }

    bindPullButton('clearpass-pull-logs-btn', 'clearpass-pull-logs-results', '{{ path('clearpass_server_pull_logs') }}', '<i class="bi bi-cloud-download me-1"></i>Pull Auth Logs', '{{ csrf_token('clearpass_pull_logs') }}');
    bindPushButton('clearpass-push-btn', 'clearpass-push-results', '{{ path('clearpass_server_push') }}', '{{ csrf_token('clearpass_push') }}');
    bindPushButton('dhcp-push-btn',     'dhcp-push-results',     '{{ path('dhcp_server_push') }}',     '{{ csrf_token('dhcp_push') }}');
    bindPushButton('dns-push-btn',      'dns-push-results',      '{{ path('dns_server_push') }}',      '{{ csrf_token('dns_push') }}');
    bindPullButton('snipeit-pull-btn',  'snipeit-pull-results',  '{{ path('snipe_it_server_pull') }}',  null, '{{ csrf_token('snipeit_pull') }}');
})();
</script>
{% endblock %}
