{% extends 'base.html.twig' %}
{% block title %}Servers{% endblock %}

{% block content %}

{# ── ClearPass Servers ────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-shield-check me-2"></i>ClearPass Servers</h2>
    <div class="d-flex gap-2">
        <button id="clearpass-push-btn" class="btn btn-sm btn-success" {% if clearpassServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All
        </button>
        <a href="{{ path('clearpass_server_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="clearpass-push-results" class="mb-3" style="display:none"></div>

{% if clearpassServers is empty %}
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-shield-check fs-1 d-block mb-3 opacity-25"></i>
            No ClearPass servers configured yet. <a href="{{ path('clearpass_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card mb-5">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>API URL</th>
                        <th>Client ID</th>
                        <th>TLS</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in clearpassServers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td class="font-monospace small">{{ server.apiUrl }}</td>
                            <td class="font-monospace">{{ server.clientId }}</td>
                            <td>
                                {% if server.verifyTls %}
                                    <span class="badge bg-success">Verified</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">Unverified</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('clearpass_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('clearpass_server_delete', {id: server.id}) }}"
                                          onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_clearpass_server_' ~ server.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{# ── Aruba CX Switches ────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-diagram-3 me-2"></i>Aruba CX Switches</h2>
    <a href="{{ path('aruba_switch_new') }}" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Switch
    </a>
</div>

{% if arubaSwitches is empty %}
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-diagram-3 fs-1 d-block mb-3 opacity-25"></i>
            No Aruba CX switches configured yet. <a href="{{ path('aruba_switch_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card mb-5">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Management IP</th>
                        <th>Username</th>
                        <th>REST API</th>
                        <th>TLS</th>
                        <th>SSH Key</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for switch in arubaSwitches %}
                        <tr>
                            <td class="fw-semibold">{{ switch.name }}</td>
                            <td class="font-monospace">{{ switch.managementIp }}</td>
                            <td class="font-monospace">{{ switch.username }}</td>
                            <td class="font-monospace small text-muted">{{ switch.restApiVersion }}</td>
                            <td>
                                {% if switch.verifyTls %}
                                    <span class="badge bg-success">Verified</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">Unverified</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if switch.sshPublicKey %}
                                    <span class="badge bg-success"><i class="bi bi-key-fill me-1"></i>Ready</span>
                                {% else %}
                                    <span class="badge bg-secondary">No key</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('aruba_switch_edit', {id: switch.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('aruba_switch_delete', {id: switch.id}) }}"
                                          onsubmit="return confirm('Remove {{ switch.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_aruba_switch_' ~ switch.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

