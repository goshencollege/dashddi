{% extends 'base.html.twig' %}
{% block title %}Servers{% endblock %}

{% block content %}

{# ── RADIUS Servers ───────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><i class="bi bi-shield-lock me-2"></i>RADIUS Servers</h2>
    <div class="d-flex gap-2">
        <button id="radius-push-btn" class="btn btn-sm btn-success" {% if radiusServers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All
        </button>
        <a href="{{ path('radius_server_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="radius-push-results" class="mb-3" style="display:none"></div>

{% if radiusServers is empty %}
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-shield-lock fs-1 d-block mb-3 opacity-25"></i>
            No RADIUS servers configured yet. <a href="{{ path('radius_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card mb-5">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Hostname / IP</th>
                        <th>SSH User</th>
                        <th>Remote Path</th>
                        <th>SSH Key</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in radiusServers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td class="font-monospace">{{ server.hostname }}</td>
                            <td class="font-monospace">{{ server.sshUser }}</td>
                            <td class="font-monospace">{{ server.remotePath }}</td>
                            <td>
                                {% if server.sshPublicKey %}
                                    <span class="badge bg-success"><i class="bi bi-key-fill me-1"></i>Ready</span>
                                {% else %}
                                    <span class="badge bg-secondary">No key</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <a href="{{ path('radius_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('radius_server_delete', {id: server.id}) }}"
                                          onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_radius_server_' ~ server.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

