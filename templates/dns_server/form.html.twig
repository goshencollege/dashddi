{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('dns_server_index') }}">DNS Servers</a></li>
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
            <div class="card-body">
                {{ form_start(form) }}

                <div class="mb-3">
                    {{ form_label(form.serverType, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.serverType, {attr: {class: 'form-select' ~ (form.serverType.vars.errors|length ? ' is-invalid' : ''), id: 'dns_server_serverType'}}) }}
                    {{ form_errors(form.serverType) }}
                </div>

                <div class="mb-3" id="primary-hostname-row" style="{{ form.vars.data.serverType == 'secondary' ? '' : 'display:none' }}">
                    {{ form_label(form.primaryHostname, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.primaryHostname, {attr: {class: 'form-select' ~ (form.primaryHostname.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.primaryHostname) }}
                    <div class="form-text text-muted">Zone data is pulled from this server via AXFR. Zone files are <strong>not</strong> pushed to secondary servers.</div>
                </div>

                {% for field in ['name', 'hostname', 'sshUser', 'remoteZonePath', 'keyDirectory', 'bindUser'] %}
                    <div class="mb-3">
                        {{ form_label(form[field], null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form[field], {attr: {class: 'form-control' ~ (form[field].vars.errors|length ? ' is-invalid' : '')}}) }}
                        {% if form[field].vars.help is defined and form[field].vars.help %}
                            <div class="form-text">{{ form_help(form[field]) }}</div>
                        {% endif %}
                        {{ form_errors(form[field]) }}
                    </div>
                {% endfor %}

                <div class="mb-3">
                    {{ form_label(form.views, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {% if form.views|length > 0 %}
                        <div class="d-flex flex-wrap gap-3">
                            {% for viewWidget in form.views %}
                                <div class="form-check">
                                    {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                                    {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted small mb-0">No DNS views configured yet.</p>
                    {% endif %}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.description, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <hr class="my-3">
                <h6 class="text-muted mb-3"><i class="bi bi-arrow-repeat me-1"></i>Dynamic DNS (DDNS)</h6>
                <div class="mb-3">
                    {{ form_label(form.ddnsAlgorithm, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.ddnsAlgorithm, {attr: {class: 'form-select'}}) }}
                    <div class="form-text">{{ form_help(form.ddnsAlgorithm) }}</div>
                    {{ form_errors(form.ddnsAlgorithm) }}
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <a href="{{ path('dns_server_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_widget(form._token) }}
                {{ form_end(form, {'render_rest': false}) }}
            </div>
        </div>

        {% if server.id %}
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-terminal me-2"></i>Test SSH Connection</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" id="ssh-test-btn"
                        onclick="runSshTest('{{ path('dns_server_test_ssh', {id: server.id}) }}', '{{ csrf_token('test_ssh_dns_' ~ server.id) }}')">
                    <i class="bi bi-play me-1"></i>Test Connection
                </button>
            </div>
            <div class="card-body">
                <div id="ssh-test-result" class="d-none">
                    <div id="ssh-test-alert" class="alert mb-2"></div>
                    <pre id="ssh-test-detail" class="bg-body-secondary rounded p-3 small mb-0" style="white-space: pre-wrap; max-height: 300px; overflow-y: auto;"></pre>
                </div>
                <p class="text-muted small mb-0" id="ssh-test-hint">Tests the SSH connection using the stored key. Results appear here without leaving the page.</p>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-key me-2"></i>SSH Public Key</h5>
                <form method="post" action="{{ path('dns_server_regenerate_key', {id: server.id}) }}"
                      onsubmit="return confirm('Regenerate the SSH key pair? You will need to update authorized_keys on the server with the new public key.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('regen_key_dns_' ~ server.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-arrow-repeat me-1"></i>Regenerate Key
                    </button>
                </form>
            </div>
            <div class="card-body">
                {% if server.sshPublicKey %}
                    <p class="text-muted small mb-2">Add this to <code>~{{ server.sshUser }}/.ssh/authorized_keys</code> on <strong>{{ server.hostname }}</strong>:</p>
                    <div class="input-group">
                        <textarea id="dns-pubkey-{{ server.id }}" class="form-control font-monospace small" rows="3" readonly>{{ server.sshPublicKey }}</textarea>
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="navigator.clipboard.writeText(document.getElementById('dns-pubkey-{{ server.id }}').value).then(() => this.innerHTML = '<i class=\'bi bi-check-lg\'></i> Copied')">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">No key generated yet.</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function runSshTest(url, token) {
    const btn    = document.getElementById('ssh-test-btn');
    const result = document.getElementById('ssh-test-result');
    const alert  = document.getElementById('ssh-test-alert');
    const detail = document.getElementById('ssh-test-detail');
    const hint   = document.getElementById('ssh-test-hint');

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Testing…';
    result.classList.add('d-none');

    const body = new URLSearchParams({ _token: token });
    fetch(url, { method: 'POST', body })
        .then(r => r.json())
        .then(data => {
            hint.classList.add('d-none');
            result.classList.remove('d-none');

            if (data.error) {
                alert.className = 'alert alert-danger mb-2';
                alert.textContent = data.error;
                detail.textContent = '';
                detail.classList.add('d-none');
                return;
            }

            alert.className = 'alert mb-2 ' + (data.success ? 'alert-success' : 'alert-danger');
            alert.textContent = data.success ? 'Connection successful.' : 'Connection failed.';

            const lines = [];
            if (data.serverIdentification) lines.push('Server: ' + data.serverIdentification);
            if (data.authMethods && data.authMethods.length)
                lines.push('Auth methods server will accept: ' + data.authMethods.join(', '));
            if (data.errors && data.errors.length)
                lines.push('Errors:\n' + data.errors.map(e => '  ' + e).join('\n'));
            if (data.log && data.log.length)
                lines.push('Message sequence:\n' + data.log.map(m => '  ' + m).join('\n'));

            detail.textContent = lines.join('\n\n');
            detail.classList.toggle('d-none', lines.length === 0);
        })
        .catch(err => {
            hint.classList.add('d-none');
            result.classList.remove('d-none');
            alert.className = 'alert alert-danger mb-2';
            alert.textContent = 'Request failed: ' + err.message;
            detail.classList.add('d-none');
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-play me-1"></i>Test Connection';
        });
}

(function () {
    const typeSelect    = document.getElementById('dns_server_serverType');
    const primaryRow    = document.getElementById('primary-hostname-row');
    const primarySelect = document.getElementById('dns_server_primaryHostname');
    const viewCheckboxes = Array.from(document.querySelectorAll('input[name="dns_server[views][]"]'));
    if (!typeSelect || !primaryRow) return;

    function onViewChange(e) {
        if (e.target.checked) {
            viewCheckboxes.forEach(cb => { if (cb !== e.target) cb.checked = false; });
        }
    }

    function applySecondaryViewMode() {
        // Keep only the first checked view
        let kept = false;
        viewCheckboxes.forEach(cb => {
            if (cb.checked) { if (kept) cb.checked = false; else kept = true; }
        });
        // Auto-check first view if none selected
        if (!kept && viewCheckboxes.length > 0) viewCheckboxes[0].checked = true;
        viewCheckboxes.forEach(cb => cb.addEventListener('change', onViewChange));
    }

    function removeSingleViewMode() {
        viewCheckboxes.forEach(cb => cb.removeEventListener('change', onViewChange));
    }

    typeSelect.addEventListener('change', function () {
        const isSecondary = this.value === 'secondary';
        primaryRow.style.display = isSecondary ? '' : 'none';
        if (isSecondary) {
            if (primarySelect && !primarySelect.value && primarySelect.options.length > 0) {
                primarySelect.selectedIndex = 0;
            }
            applySecondaryViewMode();
        } else {
            removeSingleViewMode();
        }
    });

    // Apply on page load if already secondary
    if (typeSelect.value === 'secondary') applySecondaryViewMode();
})();
</script>
{% endblock %}
