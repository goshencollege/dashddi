{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('dns_server_index') }}">DNS Servers</a></li>
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
            <div class="card-body">
                {{ form_start(form) }}

                {% for field in ['name', 'hostname', 'sshUser', 'remoteZonePath'] %}
                    <div class="mb-3">
                        {{ form_label(form[field], null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form[field], {attr: {class: 'form-control' ~ (form[field].vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form[field]) }}
                    </div>
                {% endfor %}

                <div class="mb-3">
                    {{ form_label(form.views, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {% if form.views|length > 0 %}
                        <div class="d-flex flex-wrap gap-3">
                            {% for viewWidget in form.views %}
                                <div class="form-check">
                                    {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                                    {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label'}}) }}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted small mb-0">No DNS views configured yet.</p>
                    {% endif %}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.description, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <a href="{{ path('dns_server_index') }}" class="btn btn-outline-secondary">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        {% if server.id %}
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-key me-2"></i>SSH Public Key</h5>
                <form method="post" action="{{ path('dns_server_regenerate_key', {id: server.id}) }}"
                      onsubmit="return confirm('Regenerate the SSH key pair? You will need to update authorized_keys on the server with the new public key.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('regen_key_dns_' ~ server.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-arrow-repeat me-1"></i>Regenerate Key
                    </button>
                </form>
            </div>
            <div class="card-body">
                {% if server.sshPublicKey %}
                    <p class="text-muted small mb-2">Add this to <code>~{{ server.sshUser }}/.ssh/authorized_keys</code> on <strong>{{ server.hostname }}</strong>:</p>
                    <div class="input-group">
                        <textarea id="dns-pubkey-{{ server.id }}" class="form-control font-monospace small" rows="3" readonly>{{ server.sshPublicKey }}</textarea>
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="navigator.clipboard.writeText(document.getElementById('dns-pubkey-{{ server.id }}').value).then(() => this.innerHTML = '<i class=\'bi bi-check-lg\'></i> Copied')">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">No key generated yet.</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
