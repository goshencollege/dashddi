{% extends 'base.html.twig' %}
{% block title %}DNS Servers{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-globe2 me-2"></i>DNS Servers</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_servers') }}#dns-servers" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <button id="push-btn" class="btn btn-success" {% if servers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All Servers
        </button>
        <a href="{{ path('dns_server_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="push-results" class="mb-4" style="display:none"></div>

{% if servers is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-globe2 fs-1 d-block mb-3 opacity-25"></i>
            No DNS servers configured yet. <a href="{{ path('dns_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>IP Address</th>
                        <th>SSH User</th>
                        <th>Remote Zone Path</th>
                        <th>Views</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in servers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td>
                                {% if server.serverType == 'secondary' %}
                                    <span class="badge bg-info text-dark">secondary</span>
                                    {% if server.primaryHostname %}
                                        <span class="text-muted small ms-1">← {{ server.primaryHostname }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-primary">primary</span>
                                {% endif %}
                            </td>
                            <td class="font-monospace">{{ server.hostname }}</td>
                            <td class="font-monospace">{{ server.sshUser }}</td>
                            <td class="font-monospace small">{{ server.remoteZonePath }}</td>
                            <td>
                                {% for view in server.views %}
                                    <span class="badge bg-secondary me-1">{{ view.name }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endfor %}
                            </td>
                            <td class="text-muted">{{ server.description ?: '—' }}</td>
                            <td class="text-end">
                                <a href="{{ path('dns_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('dns_server_delete', {id: server.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_dns_server_' ~ server.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
document.getElementById('push-btn')?.addEventListener('click', function () {
    const btn     = this;
    const results = document.getElementById('push-results');

    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Pushing…';
    results.style.display = 'none';
    results.innerHTML = '';

    fetch('{{ path('dns_server_push') }}', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (data.error) {
            results.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
            results.style.display = '';
            return;
        }

        let html = '<div class="card"><div class="card-header fw-semibold">Push Results</div><ul class="list-group list-group-flush">';

        for (const [serverName, result] of Object.entries(data)) {
            // Per-view, per-zone results
            for (const [viewName, viewResult] of Object.entries(result.views ?? {})) {
                // mkdir result
                if (viewResult.mkdir && !viewResult.mkdir.success) {
                    html += `<li class="list-group-item d-flex align-items-start gap-2">
                        <i class="bi bi-x-circle-fill text-danger mt-1 flex-shrink-0"></i>
                        <div>
                            <span class="fw-semibold">${serverName}</span>
                            <span class="badge bg-secondary ms-1">${viewName}</span>
                            <span class="text-danger ms-1 small">mkdir failed: ${viewResult.mkdir.output}</span>
                        </div>
                    </li>`;
                }

                for (const [domainName, zone] of Object.entries(viewResult.zones ?? {})) {
                    const icon = zone.success ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger';
                    html += `<li class="list-group-item d-flex align-items-start gap-2">
                        <i class="bi ${icon} mt-1 flex-shrink-0"></i>
                        <div>
                            <span class="fw-semibold">${serverName}</span>
                            <span class="badge bg-secondary ms-1">${viewName}</span>
                            <span class="text-muted mx-1">→</span>
                            <span class="font-monospace small">${zone.file}</span>
                            ${zone.output ? `<div class="text-danger small font-monospace mt-1">${zone.output}</div>` : ''}
                        </div>
                    </li>`;
                }
            }

            // views.conf result
            if (result.conf !== null && result.conf !== undefined) {
                const icon = result.conf.success ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger';
                html += `<li class="list-group-item d-flex align-items-start gap-2">
                    <i class="bi ${icon} mt-1 flex-shrink-0"></i>
                    <div>
                        <span class="fw-semibold">${serverName}</span>
                        <span class="text-muted mx-1">→</span>
                        <span class="font-monospace small">views.conf</span>
                        ${result.conf.output ? `<div class="text-danger small font-monospace mt-1">${result.conf.output}</div>` : ''}
                    </div>
                </li>`;
            }

            // rndc reload result
            if (result.reload !== null && result.reload !== undefined) {
                const r    = result.reload;
                const icon = r.success ? 'bi-arrow-repeat text-success' : 'bi-x-circle-fill text-danger';
                html += `<li class="list-group-item d-flex align-items-start gap-2">
                    <i class="bi ${icon} mt-1 flex-shrink-0"></i>
                    <div>
                        <span class="fw-semibold">${serverName}</span>
                        <span class="badge ${r.success ? 'bg-success' : 'bg-danger'} ms-1">rndc reload</span>
                        ${r.output ? `<div class="small font-monospace mt-1 ${r.success ? 'text-muted' : 'text-danger'}">${r.output}</div>` : ''}
                    </div>
                </li>`;
            }
        }

        html += '</ul></div>';
        results.innerHTML = html;
        results.style.display = '';
    })
    .catch(err => {
        results.innerHTML = `<div class="alert alert-danger">Request failed: ${err}</div>`;
        results.style.display = '';
    })
    .finally(() => {
        btn.disabled  = false;
        btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Push to All Servers';
    });
});
</script>
{% endblock %}
