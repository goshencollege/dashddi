{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-primary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ host_count }}</div>
                    <div>Hosts</div>
                </div>
                <i class="bi bi-pc-display fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pb-2">
                <a href="{{ path('host_index') }}" class="text-white text-decoration-none small">View all →</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ subnet_count }}</div>
                    <div>Subnets</div>
                </div>
                <i class="bi bi-diagram-2 fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pb-2">
                <a href="{{ path('subnet_index') }}" class="text-white text-decoration-none small">View all →</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-info">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ ip_count }}</div>
                    <div>IPv4 Assigned</div>
                </div>
                <i class="bi bi-4-square fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card text-bg-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-2 fw-bold">{{ ipv6_count }}</div>
                    <div>IPv6 Assigned</div>
                </div>
                <i class="bi bi-6-square fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i>Recent Hosts</span>
        <a href="{{ path('host_new') }}" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Host
        </a>
    </div>
    {% if recent_hosts is empty %}
        <div class="card-body text-muted text-center py-4">
            No hosts yet. <a href="{{ path('host_new') }}">Add the first one →</a>
        </div>
    {% else %}
        <div class="list-group list-group-flush">
            {% for host in recent_hosts %}
                <a href="{{ path('host_show', {id: host.id}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <strong>{{ host.name }}</strong>
                        {% if host.location %}
                            <span class="text-muted ms-2 small"><i class="bi bi-geo-alt me-1"></i>{{ host.location }}</span>
                        {% endif %}
                    </div>
                    <span class="badge bg-secondary rounded-pill">{{ host.interfaces|length }} interface{{ host.interfaces|length != 1 ? 's' }}</span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
