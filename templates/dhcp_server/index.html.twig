{% extends 'base.html.twig' %}
{% block title %}DHCP Servers{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-hdd-network me-2"></i>DHCP Servers</h1>
    <div class="d-flex gap-2">
        <button id="push-btn" class="btn btn-success" {% if servers is empty %}disabled{% endif %}>
            <i class="bi bi-cloud-upload me-1"></i>Push to All Servers
        </button>
        <a href="{{ path('dhcp_server_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Server
        </a>
    </div>
</div>

<div id="push-results" class="mb-4" style="display:none"></div>

{% if servers is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-hdd-network fs-1 d-block mb-3 opacity-25"></i>
            No DHCP servers configured yet. <a href="{{ path('dhcp_server_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Hostname / IP</th>
                        <th>SSH User</th>
                        <th>Remote Path</th>
                        <th>SSH Key</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in servers %}
                        <tr>
                            <td class="fw-semibold">{{ server.name }}</td>
                            <td class="font-monospace">{{ server.hostname }}</td>
                            <td class="font-monospace">{{ server.sshUser }}</td>
                            <td class="font-monospace">{{ server.remotePath }}</td>
                            <td class="font-monospace small text-muted">{{ server.sshKeyPath }}</td>
                            <td class="text-muted">{{ server.description ?: '—' }}</td>
                            <td class="text-end">
                                <a href="{{ path('dhcp_server_edit', {id: server.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('dhcp_server_delete', {id: server.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Remove {{ server.name|e('js') }}?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_dhcp_server_' ~ server.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
document.getElementById('push-btn')?.addEventListener('click', function () {
    const btn     = this;
    const results = document.getElementById('push-results');

    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Pushing…';
    results.style.display = 'none';
    results.innerHTML = '';

    fetch('{{ path('dhcp_server_push') }}', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (data.error) {
            results.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
            results.style.display = '';
            return;
        }

        let html = '<div class="card"><div class="card-header fw-semibold">Push Results</div><ul class="list-group list-group-flush">';
        let anyFail = false;

        for (const [serverName, files] of Object.entries(data)) {
            for (const [type, info] of Object.entries(files)) {
                const ok    = info.success;
                const icon  = ok ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger';
                const label = type === 'dhcp4' ? 'DHCPv4' : 'DHCPv6';
                if (!ok) anyFail = true;

                let reloadBadge = '';
                if (info.reload !== null) {
                    const rOk   = info.reload.success;
                    const rIcon = rOk ? 'bi-arrow-clockwise text-success' : 'bi-arrow-clockwise text-danger';
                    reloadBadge = ` <span class="badge ${rOk ? 'bg-success' : 'bg-danger'} ms-1" title="${info.reload.response}">reload ${rOk ? 'ok' : 'failed'}</span>`;
                }

                html += `<li class="list-group-item d-flex align-items-start gap-2">
                    <i class="bi ${icon} mt-1 flex-shrink-0"></i>
                    <div>
                        <span class="fw-semibold">${serverName}</span>
                        <span class="badge bg-secondary ms-1">${label}</span>
                        <span class="text-muted ms-1 font-monospace small">${info.file}</span>
                        ${reloadBadge}
                        ${info.output ? `<div class="text-danger small font-monospace mt-1">${info.output}</div>` : ''}
                        ${info.reload && !info.reload.success ? `<div class="text-danger small font-monospace mt-1">Reload: ${info.reload.response}</div>` : ''}
                    </div>
                </li>`;
            }
        }

        html += '</ul></div>';
        results.innerHTML = html;
        results.style.display = '';
    })
    .catch(err => {
        results.innerHTML = `<div class="alert alert-danger">Request failed: ${err}</div>`;
        results.style.display = '';
    })
    .finally(() => {
        btn.disabled  = false;
        btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Push to All Servers';
    });
});
</script>
{% endblock %}
