{% extends 'base.html.twig' %}
{% block title %}Interface {{ interface.macAddress }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        {% if interface.host %}
            <li class="breadcrumb-item"><a href="{{ path('host_show', {id: interface.host.id}) }}">{{ interface.host.name }}</a></li>
        {% endif %}
        <li class="breadcrumb-item active"><code>{{ interface.macAddress }}</code></li>
    </ol>
</nav>

{% if interface.deleted %}
<div class="alert alert-warning d-flex align-items-center justify-content-between mb-3" role="alert">
    <div>
        <i class="bi bi-trash me-2"></i>
        <strong>This interface was deleted</strong> on {{ interface.deletedAt|date('Y-m-d H:i') }}.
        It is excluded from all DNS, DHCP, and ClearPass pushes.
    </div>
    <form method="post" action="{{ path('interface_restore', {id: interface.id}) }}" class="ms-3 flex-shrink-0">
        <input type="hidden" name="_token" value="{{ csrf_token('restore_interface_' ~ interface.id) }}">
        <button type="submit" class="btn btn-warning btn-sm text-nowrap">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Restore Interface
        </button>
    </form>
</div>
{% endif %}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-hdd-network me-2"></i>{{ interface.name ?: 'Interface' }}</h1>
        <code class="fs-5">{{ interface.macAddress }}</code>
    </div>
    {% if not interface.deleted %}
    <div>
        <a href="{{ path('interface_edit', {id: interface.id}) }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('interface_delete', {id: interface.id}) }}" class="d-inline"
              onsubmit="return confirm({% if interface.host and interface.host.interfaces|filter(i => not i.deleted)|length == 1 %}'Delete this interface? It is the only active interface on {{ interface.host.name|e('js') }}, so the host will also be deleted.'{% else %}'Delete this interface?'{% endif %})">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_interface_' ~ interface.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
    {% endif %}
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-info-circle me-1"></i>Details</div>
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th class="text-muted fw-normal ps-3" style="width:20%">Host</th>
                        <td style="width:30%">
                            {% if interface.host %}
                                <a href="{{ path('host_show', {id: interface.host.id}) }}">{{ interface.host.name }}</a>
                            {% else %}—{% endif %}
                        </td>
                        <th class="text-muted fw-normal ps-3" style="width:20%">Last Auth</th>
                        <td>{{ interface.lastAuthAt ? interface.lastAuthAt|date('Y-m-d H:i') : '—' }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">Subnet</th>
                        <td>
                            {% if interface.subnet %}
                                <a href="{{ path('subnet_show', {id: interface.subnet.id}) }}">{{ interface.subnet.name }}</a>
                            {% else %}—{% endif %}
                        </td>
                        <th class="text-muted fw-normal ps-3">Last DHCP</th>
                        <td>{{ interface.lastDhcpAt ? interface.lastDhcpAt|date('Y-m-d H:i') : '—' }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">IPv4 Address</th>
                        <td class="ip-address">{{ interface.ipAddress ? interface.ipAddress.address : '—' }}</td>
                        {% if switchInfo and switchInfo.nasIp %}
                        <th class="text-muted fw-normal ps-3">Switch IP</th>
                        <td class="ip-address">
                            {% if switchIface and switchIface.host %}
                                <a href="{{ path('host_show', {id: switchIface.host.id}) }}">{{ switchIface.host.name }}</a>
                                <span class="text-muted small ms-1">({{ switchInfo.nasIp }})</span>
                            {% else %}
                                {{ switchInfo.nasIp }}
                            {% endif %}
                        </td>
                        {% else %}
                        <td colspan="2"></td>
                        {% endif %}
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">IPv6 Address</th>
                        <td class="ip-address small">{{ interface.ipv6Address ? interface.ipv6Address.address : '—' }}</td>
                        {% if switchInfo and switchInfo.nasIp %}
                        <th class="text-muted fw-normal ps-3">Switch Port</th>
                        <td>{{ switchInfo.nasPortId ?: '—' }}</td>
                        {% else %}
                        <td colspan="2"></td>
                        {% endif %}
                    </tr>
                    {% if interface.notes %}
                    <tr>
                        <th class="text-muted fw-normal ps-3">Notes</th>
                        <td colspan="3" style="white-space:pre-wrap">{{ interface.notes }}</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-globe me-1"></i>DNS Records</span>
        {% if not interface.deleted %}
        <a href="{{ path('interface_domain_record_new', {id: interface.id}) }}" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Record
        </a>
        {% endif %}
    </div>
    {% if interface.domainRecords is empty %}
        <div class="card-body text-muted text-center py-3">No DNS records assigned.</div>
    {% else %}
        <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>View</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            {% set type_colors = {'A': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'AAAA': 'bg-info-subtle text-info-emphasis border border-info-subtle', 'CNAME': 'bg-success-subtle text-success-emphasis border border-success-subtle', 'MX': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'NS': 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle', 'TXT': 'badge-orange-subtle', 'PTR': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'SRV': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'DS': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'CAA': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'HTTPS': 'badge-purple-subtle'} %}
            <tbody>
                {% for record in interface.domainRecords %}
                <tr>
                    <td class="font-monospace small">
                        {{ record.fullyQualifiedHostname }}
                        {% if record.canonical %}
                            <span class="badge bg-primary ms-1" title="Canonical — used for PTR reverse DNS">PTR</span>
                        {% endif %}
                    </td>
                    <td><span class="badge {{ type_colors[record.type.value] ?? 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' }}">{{ record.type.value }}</span></td>
                    <td class="font-monospace small">{{ record.value }}</td>
                    <td class="small">
                        {% if record.views is empty %}
                            <span class="text-muted">All views</span>
                        {% else %}
                            {% set view_palettes = ['bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'bg-success-subtle text-success-emphasis border border-success-subtle', 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'bg-info-subtle text-info-emphasis border border-info-subtle', 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle'] %}
                            {% for view in record.views %}
                                <span class="badge {{ view_palettes[view.id % (view_palettes|length)] }}">{{ view.name }}</span>
                            {% endfor %}
                        {% endif %}
                    </td>
                    <td class="text-end" style="white-space:nowrap">
                        <a href="{{ path('domain_record_edit', {id: record.id, from: 'interface'}) }}"
                           class="btn btn-sm btn-outline-secondary me-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('domain_record_unlink', {id: record.id}) }}"
                              class="d-inline" onsubmit="return confirm('Unlink this record from the interface? The record will remain in the domain.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('unlink_record_' ~ record.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-warning me-1" title="Unlink from interface">
                                <i class="bi bi-slash-circle"></i>
                            </button>
                        </form>
                        <form method="post" action="{{ path('domain_record_delete', {id: record.id}) }}"
                              class="d-inline" onsubmit="return confirm('Delete this record?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_record_' ~ record.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
</div>

{% if virtualIps is defined and virtualIps|length > 0 %}
<div class="card mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-layers me-1"></i>Participates in Virtual IPs</div>
    <table class="table table-sm mb-0">
        <thead><tr><th>Label</th><th>Protocol</th><th>VRID</th><th>IPv4</th><th>IPv6</th><th></th></tr></thead>
        <tbody>
            {% for vip in virtualIps %}
            <tr>
                <td><a href="{{ path('virtual_ip_show', {id: vip.id}) }}">{{ vip.label }}</a></td>
                <td><span class="badge bg-secondary">{{ vip.protocol.label() }}</span></td>
                <td class="text-muted">{{ vip.vrid ?: '—' }}</td>
                <td class="ip-address">{{ vip.ipAddress ? vip.ipAddress.address : '—' }}</td>
                <td class="ip-address small">{{ vip.ipv6Address ? vip.ipv6Address.address : '—' }}</td>
                <td class="text-end" style="white-space:nowrap">
                    <a href="{{ path('virtual_ip_edit', {id: vip.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form method="post" action="{{ path('virtual_ip_remove_member', {id: vip.id, interfaceId: interface.id}) }}" class="d-inline"
                          onsubmit="return confirm('Remove this interface from {{ vip.label|e('js') }}?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('remove_member_' ~ vip.id ~ '_' ~ interface.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-warning me-1" title="Unlink from this VIP">
                            <i class="bi bi-unlink"></i>
                        </button>
                    </form>
                    <form method="post" action="{{ path('virtual_ip_delete', {id: vip.id}) }}" class="d-inline"
                          onsubmit="return confirm('Delete {{ vip.label|e('js') }}?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_vip_' ~ vip.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete this VIP">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{% if arubaSwitch and switchInfo and switchInfo.nasPortId %}
{% set portId = switchInfo.nasPortId %}
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><i class="bi bi-plug me-1"></i>Switch Port — {{ portId }}</span>
        <div class="d-flex gap-2">
            <button id="port-status-btn" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-clockwise me-1"></i>Check Status
            </button>
            <button id="port-reauth-btn" class="btn btn-sm btn-outline-info"
                    onclick="if(!confirm('Reauthenticate port {{ portId|e('js') }}?')) return; doReauth()">
                <i class="bi bi-shield-check me-1"></i>Reauthenticate
            </button>
            <button id="port-bounce-btn" class="btn btn-sm btn-outline-warning"
                    onclick="if(!confirm('Bounce port {{ portId|e('js') }}? This will briefly disconnect any client on the port.')) return; doBounce()">
                <i class="bi bi-power me-1"></i>Bounce Port
            </button>
            <button id="port-poe-bounce-btn" class="btn btn-sm btn-outline-warning"
                    onclick="if(!confirm('PoE bounce port {{ portId|e('js') }}? This will cut power and disconnect the client.')) return; doPoeBounce()">
                <i class="bi bi-lightning me-1"></i>PoE Bounce
            </button>
        </div>
    </div>
    <div id="port-status-body" class="card-body text-muted small">
        Click <strong>Check Status</strong> to load live port-access client data from the switch.
    </div>
</div>
{% endif %}

{% if events is defined and events|length > 0 %}
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i>Event History</span>
        <div>
            <a href="{{ path('clearpass_auth_log_index', {mac: interface.macAddress}) }}" class="btn btn-sm btn-outline-secondary me-1">View Auth logs</a>
            <a href="{{ path('dhcp_lease_index', {mac: interface.macAddress}) }}" class="btn btn-sm btn-outline-secondary">View DHCP logs</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Type</th>
                    <th>IP Address</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td class="text-nowrap">{{ event.timestamp|date('Y-m-d H:i') }}</td>
                        <td>
                            {% if event.type == 'auth' %}
                                <span class="badge bg-primary">Auth</span>
                            {% else %}
                                <span class="badge bg-success">DHCP</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if event.entity.ipAddress %}
                                <code>{{ event.entity.ipAddress }}</code>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>
                            {% if event.type == 'auth' %}
                                {% if event.entity.username %}{{ event.entity.username }}{% endif %}
                                {% if event.entity.authProtocol %} · {{ event.entity.authProtocol }}{% endif %}
                                {% if event.entity.vlan %} · VLAN {{ event.entity.vlan }}{% endif %}
                                {% if event.entity.nasIp %} · {{ event.entity.nasIp }}{% if event.entity.nasPortId %} / {{ event.entity.nasPortId }}{% endif %}{% endif %}
                            {% else %}
                                {% if event.entity.subnet %}
                                    <a href="{{ path('subnet_show', {id: event.entity.subnet.id}) }}">{{ event.entity.subnet.name }}</a> ·
                                {% endif %}
                                {{ event.entity.hostname ?: '—' }}
                                {% if event.entity.leaseExpires %} · expires {{ event.entity.leaseExpires|date('Y-m-d H:i') }}{% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
{% if arubaSwitch and switchInfo and switchInfo.nasPortId %}
<script>
(function () {
    const statusBtn  = document.getElementById('port-status-btn');
    const statusBody = document.getElementById('port-status-body');
    const statusUrl    = {{ (path('api_switch_port_status') ~ '?mac=' ~ interface.macAddress|url_encode)|json_encode|raw }};
    const reauthUrl    = {{ path('api_switch_port_reauthenticate')|json_encode|raw }};
    const bounceUrl    = {{ path('api_switch_port_bounce')|json_encode|raw }};
    const poeBounceUrl = {{ path('api_switch_port_poe_bounce')|json_encode|raw }};
    const mac        = {{ interface.macAddress|json_encode|raw }};

    function renderClients(data) {
        if (data.error) {
            return `<div class="alert alert-danger mb-0 py-2">${data.error}</div>`;
        }
        const rawId = 'raw-' + Math.random().toString(36).slice(2);
        let rawContent = data.raw || '';
        try { rawContent = JSON.stringify(JSON.parse(rawContent), null, 2); } catch (e) { /* plain text */ }
        const rawPanel = rawContent ? `
            <div class="px-3 pb-2 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Source: ${data.via}</span>
                <button class="btn btn-link btn-sm p-0 text-muted small" onclick="document.getElementById('${rawId}').classList.toggle('d-none')">raw</button>
            </div>
            <div id="${rawId}" class="d-none mx-3 mb-2 alert alert-success p-0"><pre class="mb-0 p-2 small" style="max-height:200px;overflow:auto">${rawContent}</pre></div>` : `<div class="px-3 pb-2"><span class="text-muted small">Source: ${data.via}</span></div>`;
        if (!data.clients || data.clients.length === 0) {
            return `<div class="px-3 pt-2"><span class="text-muted">No port-access clients found on this port.</span></div>${rawPanel}`;
        }
        const rows = data.clients.map(c => `
            <tr>
                <td class="font-monospace">${c.mac ?? '—'}</td>
                <td>${c.vlan || '—'}</td>
                <td>${c.role ?? '—'}</td>
                <td>${c.status ?? '—'}</td>
                <td>${c.auth_method ?? '—'}</td>
            </tr>`).join('');
        return `<div class="table-responsive mb-0">
            <table class="table table-sm mb-0">
                <thead><tr>
                    <th>MAC</th><th>VLAN</th><th>Role</th><th>Status</th><th>Auth Method</th>
                </tr></thead>
                <tbody>${rows}</tbody>
            </table>
            ${rawPanel}
        </div>`;
    }

    statusBtn.addEventListener('click', function () {
        statusBtn.disabled = true;
        statusBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking…';
        statusBody.innerHTML = '<span class="text-muted">Loading…</span>';

        fetch(statusUrl)
            .then(r => {
                if (!r.ok) {
                    if (r.status === 401 || r.status === 403) throw new Error('Session expired — please reload the page and try again.');
                    throw new Error(`Server returned ${r.status} ${r.statusText}. Check the switch connection and server logs.`);
                }
                return r.json();
            })
            .then(data => { statusBody.innerHTML = renderClients(data); })
            .catch(err => {
                const msg = err instanceof SyntaxError ? 'Unexpected response from server — the switch may be unreachable or the session may have expired. Please reload the page.' : err.message;
                statusBody.innerHTML = `<div class="alert alert-danger mb-0 py-2">${msg}</div>`;
            })
            .finally(() => {
                statusBtn.disabled = false;
                statusBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Refresh';
            });
    });

    function portAction(url, btnId, busyLabel, successMsg, idleLabel) {
        const btn = document.getElementById(btnId);
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>${busyLabel}`;
        statusBody.innerHTML = `<span class="text-muted">${busyLabel}…</span>`;

        fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mac }) })
            .then(r => {
                if (!r.ok) {
                    if (r.status === 401 || r.status === 403) throw new Error('Session expired — please reload the page and try again.');
                    throw new Error(`Server returned ${r.status} ${r.statusText}. Check the switch connection and server logs.`);
                }
                return r.json();
            })
            .then(data => {
                const out = data.output ? `<pre class="mt-2 mb-0 p-2 border rounded small" style="max-height:120px;overflow:auto">${data.output}</pre>` : '';
                if (data.success) {
                    statusBody.innerHTML = `<div class="alert alert-success mb-0 py-2"><i class="bi bi-check-lg me-1"></i>${successMsg}${out}</div>`;
                } else {
                    statusBody.innerHTML = `<div class="alert alert-danger mb-0 py-2">Failed: ${data.error}${out}</div>`;
                }
            })
            .catch(err => {
                const msg = err instanceof SyntaxError ? 'Unexpected response from server — the switch may be unreachable or the session may have expired. Please reload the page.' : err.message;
                statusBody.innerHTML = `<div class="alert alert-danger mb-0 py-2">${msg}</div>`;
            })
            .finally(() => { btn.disabled = false; btn.innerHTML = idleLabel; });
    }

    window.doReauth    = () => portAction(reauthUrl,    'port-reauth-btn',      'Reauthenticating', 'Reauthentication triggered.',  '<i class="bi bi-shield-check me-1"></i>Reauthenticate');
    window.doBounce    = () => portAction(bounceUrl,    'port-bounce-btn',      'Bouncing',         'Port bounced successfully.',   '<i class="bi bi-power me-1"></i>Bounce Port');
    window.doPoeBounce = () => portAction(poeBounceUrl, 'port-poe-bounce-btn',  'PoE bouncing',     'PoE bounce complete.',         '<i class="bi bi-lightning me-1"></i>PoE Bounce');
})();
</script>
{% endif %}
{% endblock %}
