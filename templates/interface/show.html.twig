{% extends 'base.html.twig' %}
{% block title %}Interface {{ interface.macAddress }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        {% if interface.host %}
            <li class="breadcrumb-item"><a href="{{ path('host_show', {id: interface.host.id}) }}">{{ interface.host.name }}</a></li>
        {% endif %}
        <li class="breadcrumb-item active"><code>{{ interface.macAddress }}</code></li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-hdd-network me-2"></i>{{ interface.name ?: 'Interface' }}</h1>
        <code class="fs-5">{{ interface.macAddress }}</code>
    </div>
    <div>
        <a href="{{ path('interface_edit', {id: interface.id}) }}" class="btn btn-outline-secondary me-2">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form method="post" action="{{ path('interface_delete', {id: interface.id}) }}" class="d-inline"
              onsubmit="return confirm({% if interface.host and interface.host.interfaces|length == 1 %}'Delete this interface? It is the only interface on {{ interface.host.name|e('js') }}, so the host will also be deleted.'{% else %}'Delete this interface?'{% endif %})">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_interface_' ~ interface.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold"><i class="bi bi-info-circle me-1"></i>Details</div>
            <table class="table mb-0">
                <tbody>
                    <tr>
                        <th class="text-muted fw-normal ps-3" style="width:40%">Host</th>
                        <td>
                            {% if interface.host %}
                                <a href="{{ path('host_show', {id: interface.host.id}) }}">{{ interface.host.name }}</a>
                            {% else %}—{% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">Subnet</th>
                        <td>
                            {% if interface.subnet %}
                                <a href="{{ path('subnet_show', {id: interface.subnet.id}) }}">{{ interface.subnet.name }}</a>
                            {% else %}—{% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">IPv4 Address</th>
                        <td class="ip-address">{{ interface.ipAddress ? interface.ipAddress.address : '—' }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-normal ps-3">IPv6 Address</th>
                        <td class="ip-address small">{{ interface.ipv6Address ? interface.ipv6Address.address : '—' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-globe me-1"></i>DNS Names</span>
                <a href="{{ path('interface_name_new', {id: interface.id}) }}" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg me-1"></i>Add Name
                </a>
            </div>
            {% if interface.names is empty %}
                <div class="card-body text-muted text-center py-3">No DNS names assigned.</div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for name in interface.names %}
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>{{ name.fullyQualifiedName }}</strong>
                                {% if name.canonical %}
                                    <span class="badge bg-primary ms-2" title="Used for reverse DNS (PTR)">Canonical</span>
                                {% endif %}
                                {% if name.ttl %}
                                    <span class="text-muted small ms-2">TTL {{ name.ttl }}</span>
                                {% endif %}
                            </div>
                            <div>
                                <a href="{{ path('interface_name_edit', {interfaceId: interface.id, id: name.id}) }}"
                                   class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('interface_name_delete', {interfaceId: interface.id, id: name.id}) }}"
                                      class="d-inline" onsubmit="return confirm('Delete name {{ name.name|e('js') }}?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_name_' ~ name.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% if events is defined and events|length > 0 %}
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i>Event History</span>
        <div>
            <a href="{{ path('clearpass_auth_log_index', {mac: interface.macAddress}) }}" class="btn btn-sm btn-outline-secondary me-1">View Auth logs</a>
            <a href="{{ path('dhcp_lease_index', {mac: interface.macAddress}) }}" class="btn btn-sm btn-outline-secondary">View DHCP logs</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Type</th>
                    <th>IP Address</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td class="text-nowrap">{{ event.timestamp|date('Y-m-d H:i') }}</td>
                        <td>
                            {% if event.type == 'auth' %}
                                <span class="badge bg-primary">Auth</span>
                            {% else %}
                                <span class="badge bg-success">DHCP</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if event.entity.ipAddress %}
                                <code>{{ event.entity.ipAddress }}</code>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>
                            {% if event.type == 'auth' %}
                                {% if event.entity.authStatus == 'Access-Accept' %}
                                    <span class="badge bg-success">{{ event.entity.authStatus }}</span>
                                {% elseif event.entity.authStatus == 'Access-Reject' %}
                                    <span class="badge bg-danger">{{ event.entity.authStatus }}</span>
                                {% elseif event.entity.authStatus %}
                                    <span class="badge bg-secondary">{{ event.entity.authStatus }}</span>
                                {% endif %}
                                {% if event.entity.username %} · {{ event.entity.username }}{% endif %}
                                {% if event.entity.authProtocol %} · {{ event.entity.authProtocol }}{% endif %}
                                {% if event.entity.vlan %} · VLAN {{ event.entity.vlan }}{% endif %}
                                {% if event.entity.nasIp %} · {{ event.entity.nasIp }}{% if event.entity.nasPortId %} / {{ event.entity.nasPortId }}{% endif %}{% endif %}
                            {% else %}
                                {% if event.entity.subnet %}
                                    <a href="{{ path('subnet_show', {id: event.entity.subnet.id}) }}">{{ event.entity.subnet.name }}</a> ·
                                {% endif %}
                                {{ event.entity.hostname ?: '—' }}
                                {% if event.entity.leaseExpires %} · expires {{ event.entity.leaseExpires|date('Y-m-d H:i') }}{% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
