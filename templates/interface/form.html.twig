{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        {% if host %}
            <li class="breadcrumb-item"><a href="{{ path('host_show', {id: host.id}) }}">{{ host.name }}</a></li>
        {% endif %}
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
<div class="col-xl-10">
<div class="card">
    <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
    <div class="card-body">
        {{ form_start(form) }}

        {# Name + MAC Address + Subnet #}
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                {{ form_widget(form.name, {attr: {class: 'form-control' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.name) }}
            </div>
            <div class="col-md-4">
                {{ form_label(form.macAddress, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                {{ form_widget(form.macAddress, {attr: {class: 'form-control font-monospace' ~ (form.macAddress.vars.errors|length ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.macAddress) }}
            </div>
            <div class="col-md-4">
                {{ form_label(form.subnet, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                {{ form_widget(form.subnet, {attr: {class: 'form-select'}}) }}
            </div>
        </div>

        {# IPv4 + IPv6 Assignment #}
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-4-square me-1"></i>IPv4 Assignment
                        {% if interface.ipAddress %}
                            <span class="badge bg-success ms-2">Currently: <code class="text-white">{{ interface.ipAddress.address }}</code></span>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            {% for child in form.ipv4Assignment %}
                                <div class="form-check">
                                    {{ form_widget(child, {attr: {class: 'form-check-input', id: 'ipv4_' ~ loop.index}}) }}
                                    {{ form_label(child, null, {label_attr: {class: 'form-check-label', for: 'ipv4_' ~ loop.index}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        <div id="ipv4-input-section" class="mt-2" style="display:none">
                            {{ form_label(form.ipv4AddressInput, null, {label_attr: {class: 'form-label small'}}) }}
                            {{ form_widget(form.ipv4AddressInput, {attr: {class: 'form-control font-monospace'}}) }}
                            <datalist id="available-ipv4-list"></datalist>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-6-square me-1"></i>IPv6 Assignment
                        {% if interface.ipv6Address %}
                            <span class="badge bg-success ms-2">Currently: <code class="text-white">{{ interface.ipv6Address.address }}</code></span>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            {% for child in form.ipv6Assignment %}
                                <div class="form-check">
                                    {{ form_widget(child, {attr: {class: 'form-check-input', id: 'ipv6_' ~ loop.index}}) }}
                                    {{ form_label(child, null, {label_attr: {class: 'form-check-label', for: 'ipv6_' ~ loop.index}}) }}
                                </div>
                            {% endfor %}
                        </div>
                        <div id="ipv6-input-section" class="mt-2" style="display:none">
                            {{ form_label(form.ipv6AddressInput, null, {label_attr: {class: 'form-label small'}}) }}
                            {{ form_widget(form.ipv6AddressInput, {attr: {class: 'form-control font-monospace'}}) }}
                            <datalist id="available-ipv6-list"></datalist>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# DNS Names #}
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
                <span><i class="bi bi-globe me-1"></i>DNS Names</span>
                <button type="button" class="btn btn-sm btn-outline-primary" id="add-name-btn">
                    <i class="bi bi-plus-lg me-1"></i>Add Name
                </button>
            </div>
            {% set proto = form.names.vars.prototype %}
            {% set proto_html %}
            <div class="name-entry border rounded p-2 mb-2 d-flex align-items-center gap-2 flex-wrap">
                <div class="flex-fill" style="min-width:7rem">
                    {{ form_widget(proto.name, {attr: {class: 'form-control form-control-sm font-monospace'}}) }}
                    {{ form_errors(proto.name) }}
                </div>
                <span class="fw-semibold">.</span>
                <div class="flex-fill" style="min-width:10rem">
                    {{ form_widget(proto.domain, {attr: {class: 'form-select form-select-sm'}}) }}
                    {{ form_errors(proto.domain) }}
                </div>
                <div style="width:7rem">
                    {{ form_widget(proto.ttl, {attr: {class: 'form-control form-control-sm', placeholder: 'TTL'}}) }}
                </div>
                {% for viewWidget in proto.views %}
                    <div class="form-check form-check-inline mb-0" data-view-id="{{ viewWidget.vars.value }}">
                        {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label small'}}) }}
                    </div>
                {% else %}
                    <div class="d-none">{{ form_widget(proto.views) }}</div>
                {% endfor %}
                <button type="button" class="btn btn-sm btn-outline-danger remove-name-btn ms-auto">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            {% endset %}
            <div class="card-body" id="names-collection"
                 data-prototype="{{ proto_html|e('html_attr') }}">
                {% for nameForm in form.names %}
                    <div class="name-entry border rounded p-2 mb-2 d-flex align-items-center gap-2 flex-wrap">
                        <div class="flex-fill" style="min-width:7rem">
                            {{ form_widget(nameForm.name, {attr: {class: 'form-control form-control-sm font-monospace'}}) }}
                            {{ form_errors(nameForm.name) }}
                        </div>
                        <span class="fw-semibold">.</span>
                        <div class="flex-fill" style="min-width:10rem">
                            {{ form_widget(nameForm.domain, {attr: {class: 'form-select form-select-sm'}}) }}
                            {{ form_errors(nameForm.domain) }}
                        </div>
                        <div style="width:7rem">
                            {{ form_widget(nameForm.ttl, {attr: {class: 'form-control form-control-sm', placeholder: 'TTL'}}) }}
                        </div>
                        {% for viewWidget in nameForm.views %}
                            <div class="form-check form-check-inline mb-0" data-view-id="{{ viewWidget.vars.value }}">
                                {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label small'}}) }}
                            </div>
                        {% else %}
                            <div class="d-none">{{ form_widget(nameForm.views) }}</div>
                        {% endfor %}
                        <button type="button" class="btn btn-sm btn-outline-danger remove-name-btn ms-auto">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                {% else %}
                    <p class="text-muted small mb-0" id="no-names-msg">No DNS names added yet.</p>
                {% endfor %}
            </div>
        </div>

        {% do form.names.setRendered() %}

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Save
            </button>
            <a href="{{ host ? path('host_show', {id: host.id}) : path('interface_show', {id: interface.id}) }}"
               class="btn btn-outline-secondary">Cancel</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
</div>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
    // Show/hide the IP input section based on radio selection
    function bindIpRadios(prefix, sectionId) {
        const radios = document.querySelectorAll('input[name$="[' + prefix + 'Assignment]"]');
        const section = document.getElementById(sectionId);
        function update() {
            const val = document.querySelector('input[name$="[' + prefix + 'Assignment]"]:checked')?.value;
            section.style.display = val === 'select' ? '' : 'none';
        }
        radios.forEach(r => r.addEventListener('change', update));
        update();
    }
    bindIpRadios('ipv4', 'ipv4-input-section');
    bindIpRadios('ipv6', 'ipv6-input-section');

    // Fetch available IPs when subnet changes
    const subnetSelect = document.getElementById('interface_subnet');
    function loadAvailableIps(subnetId) {
        if (!subnetId) return;
        fetch('/api/subnets/' + subnetId + '/available-ips')
            .then(r => r.json())
            .then(ips => {
                const dl = document.getElementById('available-ipv4-list');
                dl.innerHTML = ips.map(ip => '<option value="' + ip + '">').join('');
            });
        fetch('/api/subnets/' + subnetId + '/available-ipv6')
            .then(r => r.json())
            .then(ips => {
                const dl = document.getElementById('available-ipv6-list');
                dl.innerHTML = ips.map(ip => '<option value="' + ip + '">').join('');
            });
    }
    if (subnetSelect) {
        subnetSelect.addEventListener('change', () => loadAvailableIps(subnetSelect.value));
        if (subnetSelect.value) loadAvailableIps(subnetSelect.value);
    }

    // DNS name collection: add / remove entries
    const collection = document.getElementById('names-collection');
    const addBtn = document.getElementById('add-name-btn');
    let index = collection.querySelectorAll('.name-entry').length;

    // ── View / domain cascade helpers ───────────────────────────────────────

    function getSubnetId() {
        return document.getElementById('interface_subnet')?.value || '';
    }

    async function fetchAvailableViewIds(domainId, subnetId) {
        if (!domainId) return null;
        let url = '/api/domains/' + domainId + '/views';
        if (subnetId) url += '?subnet=' + subnetId;
        try {
            const r = await fetch(url);
            const data = await r.json();
            return new Set(data.map(v => v.id));
        } catch { return null; }
    }

    async function fetchAvailableDomains(subnetId) {
        if (!subnetId) return null;
        try {
            const r = await fetch('/api/subnets/' + subnetId + '/available-domains');
            return r.ok ? await r.json() : null;
        } catch { return null; }
    }

    function applyDomainUsability(domainSelect, domainData) {
        if (!domainData) return;
        const byId = {};
        domainData.forEach(d => { byId[d.id] = d; });
        domainSelect.querySelectorAll('option[value]').forEach(opt => {
            const id = parseInt(opt.value, 10);
            if (!id) return;
            const info = byId[id];
            if (info && !info.usable) {
                opt.disabled = true;
                opt.title    = info.reason || 'Not available for this subnet';
            } else {
                opt.disabled = false;
                opt.title    = '';
            }
        });
    }

    function applyViewFilter(nameEntry, availableIds, autoCheck) {
        nameEntry.querySelectorAll('.form-check[data-view-id]').forEach(wrap => {
            const viewId = parseInt(wrap.dataset.viewId, 10);
            const cb     = wrap.querySelector('input[type="checkbox"]');
            if (availableIds === null || !availableIds.has(viewId)) {
                wrap.style.display = 'none';
                if (cb) cb.checked = false;
            } else {
                wrap.style.display = '';
                if (autoCheck && cb) cb.checked = true;
            }
        });
    }

    async function refreshAllRows() {
        const subnetId   = getSubnetId();
        const domainData = await fetchAvailableDomains(subnetId);
        const rows       = collection.querySelectorAll('.name-entry');

        for (const row of rows) {
            const domainSel = row.querySelector('select[name*="[domain]"]');
            if (!domainSel) continue;
            if (domainData) applyDomainUsability(domainSel, domainData);
            const ids = await fetchAvailableViewIds(domainSel.value, subnetId);
            applyViewFilter(row, ids, false);
        }
    }

    // Subnet change → refresh all rows
    if (subnetSelect) {
        subnetSelect.addEventListener('change', refreshAllRows);
    }

    // Domain change within a row → refresh just that row's views
    collection.addEventListener('change', async function (e) {
        const domainSel = e.target.closest('select[name*="[domain]"]');
        if (!domainSel) return;
        const row = domainSel.closest('.name-entry');
        if (!row) return;
        const subnetId = getSubnetId();
        const ids = await fetchAvailableViewIds(domainSel.value, subnetId);
        applyViewFilter(row, ids, true);
    });

    // Initial page load: apply cascade to existing rows
    refreshAllRows();

    // ── Add / remove entries ────────────────────────────────────────────────

    addBtn.addEventListener('click', async function () {
        document.getElementById('no-names-msg')?.remove();
        const div = document.createElement('div');
        div.innerHTML = collection.dataset.prototype.replace(/__name__/g, index++);
        const entry = div.firstElementChild;
        collection.appendChild(entry);

        // Apply domain usability for current subnet
        const subnetId = getSubnetId();
        if (subnetId) {
            const domainData = await fetchAvailableDomains(subnetId);
            const domainSel  = entry.querySelector('select[name*="[domain]"]');
            if (domainSel && domainData) applyDomainUsability(domainSel, domainData);
        }
        // Hide all views until a domain is chosen
        applyViewFilter(entry, null, false);
    });

    collection.addEventListener('click', function (e) {
        if (e.target.closest('.remove-name-btn')) {
            e.target.closest('.name-entry').remove();
        }
    });

})();
</script>
{% endblock %}
