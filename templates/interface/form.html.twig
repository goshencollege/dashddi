{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        {% if host %}
            <li class="breadcrumb-item"><a href="{{ path('host_show', {id: host.id}) }}">{{ host.name }}</a></li>
        {% endif %}
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
<div class="col-xl-10">
<div class="card">
    <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
    <div class="card-body">
        {{ form_start(form) }}

        {# Name + MAC Address + Subnet #}
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                {{ form_widget(form.name, {attr: {class: 'form-control' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.name) }}
            </div>
            <div class="col-md-4">
                {{ form_label(form.macAddress, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                {{ form_widget(form.macAddress, {attr: {class: 'form-control font-monospace' ~ (form.macAddress.vars.errors|length ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.macAddress) }}
            </div>
            <div class="col-md-4">
                {{ form_label(form.subnet, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                {{ form_widget(form.subnet, {attr: {class: 'form-select'}}) }}
            </div>
        </div>

        {% if form.duid is defined %}
        {# DUID (host-level) #}
        <div class="mb-4">
            {{ form_label(form.duid, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
            {{ form_widget(form.duid, {attr: {class: 'form-control font-monospace' ~ (form.duid.vars.errors|length ? ' is-invalid' : '')}}) }}
            {{ form_errors(form.duid) }}
            <div class="form-text">DHCPv6 client identifier — this is a host attribute, so changing it here updates it for all of this host's interfaces. You can paste directly from <code>networkctl status</code> output (e.g. <code>DUID-EN/Vendor:0000ab11...</code>) — the type label is detected automatically.</div>
        </div>
        {% endif %}

        {# Notes #}
        <div class="mb-4">
            {{ form_label(form.notes, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
            {{ form_widget(form.notes, {attr: {class: 'form-control' ~ (form.notes.vars.errors|length ? ' is-invalid' : '')}}) }}
            {{ form_errors(form.notes) }}
        </div>

        {# IPv4 + IPv6 Assignment #}
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-4-square me-1"></i>IPv4 Assignment
                        {% if interface.ipAddress %}
                            <span id="ipv4-current-badge" class="badge bg-success ms-2">Currently: <code class="text-white">{{ interface.ipAddress.address }}</code></span>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <div id="ipv4-assignment-options">
                            <div class="mb-2">
                                {% for child in form.ipv4Assignment %}
                                    <div class="form-check">
                                        {{ form_widget(child, {attr: {class: 'form-check-input', id: 'ipv4_' ~ loop.index}}) }}
                                        {{ form_label(child, null, {label_attr: {class: 'form-check-label', for: 'ipv4_' ~ loop.index}}) }}
                                    </div>
                                {% endfor %}
                            </div>
                            <div id="ipv4-input-section" class="mt-2" style="display:none">
                                {{ form_label(form.ipv4AddressInput, null, {label_attr: {class: 'form-label small'}}) }}
                                {{ form_widget(form.ipv4AddressInput, {attr: {class: 'form-control font-monospace'}}) }}
                                <datalist id="available-ipv4-list"></datalist>
                            </div>
                        </div>
                        <p id="ipv4-container-notice" class="text-muted small mb-0" style="display:none">
                            IP assignment is not available for container subnets.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-6-square me-1"></i>IPv6 Assignment
                        {% if interface.ipv6Address %}
                            <span id="ipv6-current-badge" class="badge bg-success ms-2">Currently: <code class="text-white">{{ interface.ipv6Address.address }}</code></span>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <div id="ipv6-assignment-options">
                            <div class="mb-2">
                                {% for child in form.ipv6Assignment %}
                                    <div class="form-check">
                                        {{ form_widget(child, {attr: {class: 'form-check-input', id: 'ipv6_' ~ loop.index}}) }}
                                        {{ form_label(child, null, {label_attr: {class: 'form-check-label', for: 'ipv6_' ~ loop.index}}) }}
                                    </div>
                                {% endfor %}
                            </div>
                            <div id="ipv6-input-section" class="mt-2" style="display:none">
                                {{ form_label(form.ipv6AddressInput, null, {label_attr: {class: 'form-label small'}}) }}
                                {{ form_widget(form.ipv6AddressInput, {attr: {class: 'form-control font-monospace'}}) }}
                                <datalist id="available-ipv6-list"></datalist>
                            </div>
                        </div>
                        <p id="ipv6-container-notice" class="text-muted small mb-0" style="display:none">
                            IP assignment is not available for container subnets.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Save
            </button>
            <a href="{{ host ? path('host_show', {id: host.id}) : path('interface_show', {id: interface.id}) }}"
               class="btn btn-outline-secondary">Cancel</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
</div>
</div>

{% if interface.id %}
<div class="row justify-content-center mt-4">
<div class="col-xl-10">
<div class="card" id="dns-records-card">
    <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
        <span><i class="bi bi-globe me-1"></i>DNS Records</span>
        <button type="button" class="btn btn-sm btn-outline-primary" id="add-dns-record-btn">
            <i class="bi bi-plus-lg me-1"></i>Add Record
        </button>
    </div>
    {% set dns_records = interface.domainRecords %}
    {% if dns_records is empty %}
        <div class="card-body text-muted small py-2" id="dns-records-empty">No DNS records assigned.</div>
    {% else %}
        <div class="table-responsive">
        <table class="table table-sm mb-0" id="dns-records-table">
            <thead>
                <tr>
                    <th>Hostname</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>View</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            {% set type_colors = {'A': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'AAAA': 'bg-info-subtle text-info-emphasis border border-info-subtle', 'CNAME': 'bg-success-subtle text-success-emphasis border border-success-subtle', 'MX': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'NS': 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle', 'TXT': 'badge-orange-subtle', 'PTR': 'bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'SRV': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'DS': 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'CAA': 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'HTTPS': 'badge-purple-subtle'} %}
            <tbody>
                {% for record in dns_records %}
                <tr data-record-id="{{ record.id }}">
                    <td class="font-monospace small">
                        {{ record.fullyQualifiedHostname }}
                        {% if record.canonical %}
                            <span class="badge bg-primary ms-1" title="Canonical — used for PTR reverse DNS">PTR</span>
                        {% endif %}
                    </td>
                    <td><span class="badge {{ type_colors[record.type.value] ?? 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' }}">{{ record.type.value }}</span></td>
                    <td class="font-monospace small text-muted">
                        {% if record.type.value == 'A' %}
                            {{ interface.ipAddress ? interface.ipAddress.address : '—' }}
                        {% elseif record.type.value == 'AAAA' %}
                            {{ interface.ipv6Address ? interface.ipv6Address.address : '—' }}
                        {% else %}
                            {{ record.value }}
                        {% endif %}
                    </td>
                    <td class="small">
                        {% if record.views is empty %}
                            <span class="text-muted">No views</span>
                        {% else %}
                            {% set view_palettes = ['bg-primary-subtle text-primary-emphasis border border-primary-subtle', 'bg-success-subtle text-success-emphasis border border-success-subtle', 'bg-danger-subtle text-danger-emphasis border border-danger-subtle', 'bg-warning-subtle text-warning-emphasis border border-warning-subtle', 'bg-info-subtle text-info-emphasis border border-info-subtle', 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle'] %}
                            {% for view in record.views %}
                                <span class="badge {{ view_palettes[view.id % (view_palettes|length)] }}">{{ view.name }}</span>
                            {% endfor %}
                        {% endif %}
                    </td>
                    <td class="text-end" style="white-space:nowrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 dns-edit-btn"
                                data-url="{{ path('domain_record_edit', {id: record.id}) }}">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form method="post" action="{{ path('domain_record_delete', {id: record.id}) }}"
                              class="d-inline dns-delete-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_record_' ~ record.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
</div>
</div>
</div>

<div class="modal fade" id="dns-record-modal" tabindex="-1" aria-labelledby="dns-record-modal-title" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dns-record-modal-title">DNS Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="dns-record-modal-body">
                <div class="text-center py-3"><span class="spinner-border spinner-border-sm"></span></div>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
(function () {
    const containerSubnetIds = new Set({{ containerSubnetIds|default([])|json_encode }});

    // Show/hide the IP input section based on radio selection
    function bindIpRadios(prefix, sectionId) {
        const radios = document.querySelectorAll('input[name$="[' + prefix + 'Assignment]"]');
        const section = document.getElementById(sectionId);
        function update() {
            const val = document.querySelector('input[name$="[' + prefix + 'Assignment]"]:checked')?.value;
            section.style.display = val === 'select' ? '' : 'none';
        }
        radios.forEach(r => r.addEventListener('change', update));
        update();
    }
    bindIpRadios('ipv4', 'ipv4-input-section');
    bindIpRadios('ipv6', 'ipv6-input-section');

    function setContainerSubnetMode(isContainer) {
        ['ipv4', 'ipv6'].forEach(prefix => {
            const options = document.getElementById(prefix + '-assignment-options');
            const notice  = document.getElementById(prefix + '-container-notice');
            if (options) options.style.display = isContainer ? 'none' : '';
            if (notice)  notice.style.display  = isContainer ? '' : 'none';
        });
    }

    // Fetch available IPs when subnet changes
    const subnetSelect = document.getElementById('network_interface_subnet');
    function loadAvailableIps(subnetId) {
        if (!subnetId) return;
        fetch('/api/subnets/' + subnetId + '/available-ips')
            .then(r => r.json())
            .then(ips => {
                const dl = document.getElementById('available-ipv4-list');
                dl.innerHTML = ips.map(ip => '<option value="' + ip + '">').join('');
            });
        fetch('/api/subnets/' + subnetId + '/available-ipv6')
            .then(r => r.json())
            .then(ips => {
                const dl = document.getElementById('available-ipv6-list');
                dl.innerHTML = ips.map(ip => '<option value="' + ip + '">').join('');
            });
    }
    function resetIpAssignmentsForSubnetChange() {
        ['ipv4', 'ipv6'].forEach(prefix => {
            const keepRadio = document.querySelector('input[name$="[' + prefix + 'Assignment]"][value="keep"]');
            const noneRadio = document.querySelector('input[name$="[' + prefix + 'Assignment]"][value="none"]');
            if (keepRadio?.checked && noneRadio) {
                noneRadio.checked = true;
                noneRadio.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
        document.getElementById('ipv4-current-badge')?.remove();
        document.getElementById('ipv6-current-badge')?.remove();
    }

    if (subnetSelect) {
        subnetSelect.addEventListener('change', () => {
            const isContainer = containerSubnetIds.has(parseInt(subnetSelect.value, 10));
            setContainerSubnetMode(isContainer);
            if (!isContainer) loadAvailableIps(subnetSelect.value);
            resetIpAssignmentsForSubnetChange();
        });
        const initialIsContainer = containerSubnetIds.has(parseInt(subnetSelect.value, 10));
        setContainerSubnetMode(initialIsContainer);
        if (subnetSelect.value && !initialIsContainer) loadAvailableIps(subnetSelect.value);
    }

})();
</script>

{% if interface.id %}
<script>
(function () {
    const modalEl  = document.getElementById('dns-record-modal');
    if (!modalEl) return;
    const modal     = new bootstrap.Modal(modalEl);
    const modalBody = document.getElementById('dns-record-modal-body');
    const modalTitle = document.getElementById('dns-record-modal-title');
    const addNewUrl       = {{ path('interface_domain_record_new', {id: interface.id})|json_encode|raw }};
    const availableViewsUrl = {{ path('interface_domain_record_views', {id: interface.id})|json_encode|raw }};

    function showSpinner() {
        modalBody.innerHTML = '<div class="text-center py-3"><span class="spinner-border spinner-border-sm"></span></div>';
    }

    function bindDomainViewsUpdater() {
        const domainSelect  = modalBody.querySelector('[name="domain_record[domain]"]');
        const viewsSection  = modalBody.querySelector('#modal-views-section');
        if (!domainSelect || !viewsSection) return;

        domainSelect.addEventListener('change', async function () {
            const domainId = domainSelect.value;
            if (!domainId) {
                viewsSection.innerHTML = '<p class="text-muted small mb-0">Select a domain first to see available views.</p>';
                return;
            }
            try {
                const res   = await fetch(availableViewsUrl + '?domain_id=' + encodeURIComponent(domainId));
                const views = await res.json();
                if (views.length === 0) {
                    viewsSection.innerHTML = '<p class="text-muted small mb-0">No views configured for this domain.</p>';
                } else {
                    viewsSection.innerHTML = '<div class="d-flex flex-wrap gap-3">' +
                        views.map(v =>
                            `<div class="form-check">` +
                            `<input class="form-check-input" type="checkbox" name="domain_record[views][]" value="${v.id}" id="modal_view_${v.id}" checked>` +
                            `<label class="form-check-label" for="modal_view_${v.id}">${v.name}</label>` +
                            `</div>`
                        ).join('') + '</div>';
                }
            } catch {
                viewsSection.innerHTML = '<p class="text-danger small mb-0">Failed to load views.</p>';
            }
        });
    }

    function bindCanonicalVisibility() {
        const typeSelect     = modalBody.querySelector('[name="domain_record[type]"]');
        const canonicalField = modalBody.querySelector('#canonical-field');
        if (!typeSelect || !canonicalField) return;
        function update() {
            const show = typeSelect.value === 'A' || typeSelect.value === 'AAAA';
            canonicalField.style.display = show ? '' : 'none';
            if (!show) {
                const cb = canonicalField.querySelector('input[type="checkbox"]');
                if (cb) cb.checked = false;
            }
        }
        typeSelect.addEventListener('change', update);
        update();
    }

    async function openModal(url, title) {
        modalTitle.textContent = title;
        showSpinner();
        modal.show();
        try {
            const res  = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            modalBody.innerHTML = data.html;
            bindDomainViewsUpdater();
            bindCanonicalVisibility();
        } catch {
            modalBody.innerHTML = '<div class="alert alert-danger mb-0">Failed to load form.</div>';
        }
    }

    document.getElementById('add-dns-record-btn').addEventListener('click', () => {
        openModal(addNewUrl, 'Add DNS Record');
    });

    document.getElementById('dns-records-card').addEventListener('click', e => {
        const editBtn = e.target.closest('.dns-edit-btn');
        if (editBtn) openModal(editBtn.dataset.url, 'Edit DNS Record');
    });

    // Submit form inside modal via AJAX
    modalEl.addEventListener('submit', async function (e) {
        const form = e.target.closest('form');
        if (!modalBody.contains(form)) return;
        e.preventDefault();
        const submitBtn = form.querySelector('[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        try {
            const res  = await fetch(form.action, {
                method:  'POST',
                body:    new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
            });
            const data = await res.json();
            if (data.success) {
                modal.hide();
                window.location.reload();
            } else {
                modalBody.innerHTML = data.html;
                bindDomainViewsUpdater();
                bindCanonicalVisibility();
            }
        } catch {
            if (submitBtn) submitBtn.disabled = false;
        }
    });

    // Delete via AJAX
    document.getElementById('dns-records-card').addEventListener('submit', async function (e) {
        const form = e.target.closest('.dns-delete-form');
        if (!form) return;
        e.preventDefault();
        if (!confirm('Delete this DNS record?')) return;
        await fetch(form.action, {
            method:  'POST',
            body:    new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });
        window.location.reload();
    });
})();
</script>
{% endif %}
{% endblock %}
