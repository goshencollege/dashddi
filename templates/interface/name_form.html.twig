{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        {% if interface %}
            {% if interface.host %}
                <li class="breadcrumb-item"><a href="{{ path('host_show', {id: interface.host.id}) }}">{{ interface.host.name }}</a></li>
            {% endif %}
            <li class="breadcrumb-item"><a href="{{ path('interface_show', {id: interface.id}) }}"><code>{{ interface.macAddress }}</code></a></li>
        {% endif %}
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

{% if interface and not interface.subnet %}
<div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <span>This interface has no subnet — view restrictions based on subnet are not applied.</span>
</div>
{% endif %}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.name, {attr: {class: 'form-control font-monospace' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.name) }}
                        <div class="form-text">DNS label portion (e.g. <code>web-server-01</code>)</div>
                    </div>
                    <div class="mb-4">
                        {{ form_label(form.domain, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.domain, {attr: {class: 'form-select' ~ (form.domain.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.domain) }}
                        {% if interface and interface.subnet %}
                            <div class="form-text">Greyed-out domains have no views in common with subnet <strong>{{ interface.subnet.name }}</strong>.</div>
                        {% endif %}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.ttl, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.ttl, {attr: {class: 'form-control' ~ (form.ttl.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.ttl) }}
                        <div class="form-text">Leave blank to use the domain default.</div>
                    </div>
                    {% if form.views is defined %}
                    <div class="mb-4">
                        {{ form_label(form.views, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {% if form.views|length > 0 %}
                            <div id="views-container" class="d-flex flex-wrap gap-3">
                                {% for viewWidget in form.views %}
                                    <div class="form-check" data-view-id="{{ viewWidget.vars.value }}">
                                        {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                                        {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label'}}) }}
                                    </div>
                                {% endfor %}
                            </div>
                            <p class="text-muted small mt-2 mb-0" id="views-hint" style="display:none"></p>
                        {% else %}
                            <p class="text-muted small mb-0">No DNS views have been configured in this system.</p>
                        {% endif %}
                        {{ form_errors(form.views) }}
                    </div>
                    {% endif %}
                    <div class="mb-4">
                        <div class="form-check">
                            {{ form_widget(form.isCanonical, {attr: {class: 'form-check-input'}}) }}
                            {{ form_label(form.isCanonical, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                        </div>
                        <div class="form-text">
                            The canonical name is used for PTR (reverse DNS) records. Checking this will verify
                            FCrDNS — the name must already resolve to this interface's IP address. A domain is required.
                        </div>
                        {{ form_errors(form.isCanonical) }}
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" id="save-btn">
                            <i class="bi bi-check-lg me-1"></i>Save
                        </button>
                        <a href="{{ interface ? path('interface_show', {id: interface.id}) : path('host_index') }}" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
    const subnetId   = {{ (interface and interface.subnet) ? interface.subnet.id : 'null' }};
    const domainSel  = document.getElementById('interface_name_domain');
    const container  = document.getElementById('views-container');
    const hint       = document.getElementById('views-hint');
    const saveBtn    = document.getElementById('save-btn');

    if (!domainSel || !container) return;

    async function fetchAvailableViews(domainId) {
        let url = '/api/domains/' + domainId + '/views';
        if (subnetId) url += '?subnet=' + subnetId;
        const r = await fetch(url);
        return r.ok ? r.json() : [];
    }

    function showHint(msg) {
        if (!hint) return;
        hint.textContent = msg;
        hint.style.display = msg ? '' : 'none';
    }

    async function updateViews(domainId, autoCheck) {
        const wrappers = container.querySelectorAll('.form-check[data-view-id]');

        if (!domainId) {
            wrappers.forEach(wrap => {
                wrap.style.display = 'none';
                wrap.querySelector('input[type="checkbox"]').checked = false;
            });
            showHint('Select a domain to see available views.');
            return;
        }

        const available    = await fetchAvailableViews(domainId);
        const availableIds = new Set(available.map(v => v.id));
        let   anyShown     = false;

        wrappers.forEach(wrap => {
            const viewId = parseInt(wrap.dataset.viewId, 10);
            const cb     = wrap.querySelector('input[type="checkbox"]');
            if (availableIds.has(viewId)) {
                wrap.style.display = '';
                if (autoCheck && cb) cb.checked = true;
                anyShown = true;
            } else {
                wrap.style.display = 'none';
                if (cb) cb.checked = false;
            }
        });

        if (!anyShown) {
            showHint('No views are available for this domain and subnet combination.');
        } else {
            showHint('');
        }
    }

    domainSel.addEventListener('change', () => updateViews(domainSel.value, true));

    // On initial load: preserve existing check state, just hide unavailable views.
    updateViews(domainSel.value, false);
})();
</script>
{% endblock %}
