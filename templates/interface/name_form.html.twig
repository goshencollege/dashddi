{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('host_index') }}">Hosts</a></li>
        {% if interface %}
            {% if interface.host %}
                <li class="breadcrumb-item"><a href="{{ path('host_show', {id: interface.host.id}) }}">{{ interface.host.name }}</a></li>
            {% endif %}
            <li class="breadcrumb-item"><a href="{{ path('interface_show', {id: interface.id}) }}"><code>{{ interface.macAddress }}</code></a></li>
        {% endif %}
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">{{ title }}</h5></div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.name, {attr: {class: 'form-control font-monospace' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.name) }}
                        <div class="form-text">DNS label portion (e.g. <code>web-server-01</code>)</div>
                    </div>
                    <div class="mb-4">
                        {{ form_label(form.domain, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.domain, {attr: {class: 'form-select' ~ (form.domain.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {{ form_errors(form.domain) }}
                    </div>
                    {% if form.views is defined %}
                    <div class="mb-4">
                        {{ form_label(form.views, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {% if form.views|length > 0 %}
                            <div class="d-flex flex-wrap gap-3">
                                {% for viewWidget in form.views %}
                                    <div class="form-check">
                                        {{ form_widget(viewWidget, {attr: {class: 'form-check-input'}}) }}
                                        {{ form_label(viewWidget, null, {label_attr: {class: 'form-check-label'}}) }}
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted small mb-0">No views configured for this domain.</p>
                        {% endif %}
                    </div>
                    {% endif %}
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save
                        </button>
                        <a href="{{ interface ? path('interface_show', {id: interface.id}) : path('host_index') }}" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
