{% extends 'base.html.twig' %}
{% block title %}DNS Views{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-eye me-2"></i>DNS Views</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('user_guide_dns') }}#views" class="btn btn-sm btn-outline-secondary" title="User Guide" target="_blank"><i class="bi bi-question-circle"></i></a>
        <a href="{{ path('dns_view_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add View
        </a>
    </div>
</div>

{% if views is empty %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-eye fs-1 d-block mb-3 opacity-25"></i>
            No DNS views yet. <a href="{{ path('dns_view_new') }}">Add the first one →</a>
        </div>
    </div>
{% else %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for view in views %}
                        <tr>
                            <td class="fw-semibold">{{ view.name }}</td>
                            <td class="text-muted">{{ view.description ?: '—' }}</td>
                            <td class="text-end">
                                <a href="{{ path('dns_view_edit', {id: view.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('dns_view_delete', {id: view.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Delete view {{ view.name|e('js') }}?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_dns_view_' ~ view.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
{% endblock %}
