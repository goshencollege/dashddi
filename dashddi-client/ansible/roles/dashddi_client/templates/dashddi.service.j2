[Unit]
Description=Renew certificates via DashDDI
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dashddi cert \
    --credentials {{ dashddi_credentials_path }} \
    -- \
    --dns-dashddi-propagation-seconds {{ dashddi_propagation_seconds }}{% if dashddi_deploy_hook %} \
    --deploy-hook {{ dashddi_deploy_hook }}{% endif %}
PrivateTmp=true
