# DashDDI credentials for the dashddi client (certbot DNS-01 validation, cert
# issuance, and optional CAA/HTTPS record publishing).
#
# You don't have to create this by hand: running `dashddi cert` with no file at
# /etc/dashddi/dashddi.ini (or whatever --credentials points at) prompts for the
# URL, token, ACME subscriber agreement, and email, and writes it for you. To
# create it manually instead, copy this file to a secure location and
# restrict permissions:
#   mkdir -p /etc/dashddi
#   cp dashddi.ini.example /etc/dashddi/dashddi.ini
#   chmod 600 /etc/dashddi/dashddi.ini

# Base URL of your DashDDI instance (no trailing slash)
dns_dashddi_url = https://dashddi.example.com

# Host-scoped API token — generate one from the host detail page in DashDDI
# (Hosts → select host → Host API Token → Generate Token).
# This token is tied to this host and is only accepted from this host's IP addresses.
dns_dashddi_token = your-host-scoped-token-here

# Required: agreement to your ACME CA's subscriber agreement (Let's Encrypt:
# https://letsencrypt.org/repository/, or your custom --server's terms).
# certbot runs with --non-interactive and refuses to issue without this.
dns_dashddi_agree_tos = true

# Optional: email address passed to certbot for renewal/expiry notices. If
# omitted, dashddi cert passes --register-unsafely-without-email instead.
#   dns_dashddi_email = admin@example.com

# Optional: SSL verification for the DashDDI API connection.
# Leave unset to use the system CA bundle (default, recommended for production).
# Set to the path of a PEM CA bundle to trust a custom/internal CA:
#   dns_dashddi_ca_cert = /etc/ssl/certs/my-internal-ca.pem
# Set to false to disable SSL verification entirely (self-signed certs, dev only):
#   dns_dashddi_ca_cert = false

# Optional: comma-separated explicit list of FQDNs to certify, replacing the
# default auto-discovery of every A/AAAA/CNAME FQDN this host owns in DashDDI.
# Use this for a subset of the host's names, or to add concrete names covered
# by a wildcard record (e.g. host owns "*.example.com" and you also want
# "foo.example.com" and "bar.example.com" as explicit SAN entries):
#   dns_dashddi_names = foo.example.com,bar.example.com

# Optional: after every successful (re)issuance, create/update a CAA and/or
# HTTPS record at each issued FQDN via the DashDDI self-service API. Each
# manages at most one record per name (matched by hostname+domain+type) — if
# you need more than one CAA line at a name (e.g. both "issue" and
# "issuewild"), manage the extras directly in the DashDDI DNS UI.
#
# dns_dashddi_caa just turns CAA publishing on — the CA is auto-detected from
# the ACME server certbot was told to use (Let's Encrypt by default, or
# whatever --server points at), so there's nothing else to configure:
#   dns_dashddi_caa = true
#
# HTTPS record content isn't derivable from the issuance itself. dns_dashddi_https
# turns it on using a generally-safe default ("1 . alpn=h2,h3"):
#   dns_dashddi_https = true
# Or set dns_dashddi_https_value for an explicit value (implies dns_dashddi_https):
#   dns_dashddi_https_value = 1 . alpn=h2,h3
